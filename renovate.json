{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "git-submodules": {
    "enabled": true
  },
  "schedule": ["before 9am on monday"],
  "timezone": "UTC",
  "packageRules": [
    {
      "matchManagers": ["git-submodules"],
      "groupName": "Zscaler upstream submodules",
      "commitMessageTopic": "Zscaler upstream submodules",
      "labels": ["upstream-bump"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["git-submodules"],
      "matchDepNames": [
        "vendor/terraform-provider-zia"
      ],
      "groupName": null,
      "commitMessageTopic": "{{{depName}}}",
      "dependencyDashboardApproval": true
    },
    {
      "matchFileNames": [".github/workflows/*"],
      "groupName": "GitHub Actions",
      "labels": ["ci"]
    },
    {
      "description": ".node-version is the Node that CI and version managers install, so its patch and minor releases (the security fixes) open PRs as usual; a new major waits for approval. The supported floor is MIN_NODE_VERSION in scripts/doctor.mjs, which the node-floor check tests.",
      "matchManagers": ["nodenv"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "addLabels": ["no-release"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0
}
