{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "git-submodules": {
    "enabled": true
  },
  "schedule": ["before 9am on monday"],
  "timezone": "UTC",
  "packageRules": [
    {
      "matchManagers": ["git-submodules"],
      "groupName": "Zscaler upstream submodules",
      "commitMessageTopic": "Zscaler upstream submodules",
      "labels": ["upstream-bump"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchManagers": ["git-submodules"],
      "matchDepNames": [
        "vendor/terraform-provider-zia"
      ],
      "groupName": null,
      "commitMessageTopic": "{{{depName}}}",
      "dependencyDashboardApproval": true
    },
    {
      "matchFileNames": [".github/workflows/*"],
      "groupName": "GitHub Actions",
      "labels": ["ci"]
    },
    {
      "description": ".node-version is the supported Node floor (scripts/doctor.mjs MIN_NODE_VERSION, package.json engines), so CI runs on the oldest Node users may have; raising it is a deliberate change to all three, not a bump.",
      "matchManagers": ["nodenv"],
      "enabled": false
    }
  ],
  "addLabels": ["no-release"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0
}
