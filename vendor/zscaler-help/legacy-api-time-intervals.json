    "paths": {
      "/timeIntervals": {
        "get": {
          "tags": [
            "Time Intervals"
          ],
          "description": "Retrieves a list of all configured time intervals. To learn more, see <a href=\"/zia/about-time-intervals\" target=\"_blank\">About Time Intervals</a>.",
          "operationId": "TimeIntervalResource_getTimeInterval",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "search",
              "in": "query",
              "description": "Search for a configured time interval",
              "required": false,
              "type": "string"
            },
            {
              "name": "page",
              "in": "query",
              "description": "Set the page number of the response",
              "required": false,
              "type": "integer",
              "default": 1,
              "format": "int32"
            },
            {
              "name": "pageSize",
              "in": "query",
              "description": "Set the size of the response",
              "required": false,
              "type": "integer",
              "default": 100,
              "format": "int32"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/TimeInterval"
                }
              }
            }
          }
        },
        "post": {
          "tags": [
            "Time Intervals"
          ],
          "description": "Adds a new time interval. To learn more, see <a href=\"/zia/defining-time-intervals\" target=\"_blank\">Defining Time Intervals</a>.",
          "operationId": "TimeIntervalResource_addTimeInterval",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "in": "body",
              "name": "body",
              "description": "Information about the defined time interval",
              "required": false,
              "schema": {
                "$ref": "#/definitions/TimeInterval"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/TimeInterval"
              }
            }
          }
        }
      },
      "/timeIntervals/{Id}": {
        "get": {
          "tags": [
            "Time Intervals"
          ],
          "description": "Retrieves the configured time interval based on the specified ID",
          "operationId": "TimeIntervalResource_getTimeIntervalById",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "Id",
              "in": "path",
              "description": "Unique identifier for the time interval",
              "required": true,
              "type": "integer",
              "format": "int32"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/TimeInterval"
              }
            }
          }
        },
        "put": {
          "tags": [
            "Time Intervals"
          ],
          "description": "Updates the time interval based on the specified ID",
          "operationId": "TimeIntervalResource_updateTimeInterval",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "Id",
              "in": "path",
              "description": "Unique identifier for the time interval",
              "required": true,
              "type": "integer",
              "format": "int32"
            }
          ],
          "responses": {
            "default": {
              "description": "Successful Operation"
            }
          }
        },
        "delete": {
          "tags": [
            "Time Intervals"
          ],
          "description": "Deletes a time interval based on the specified ID",
          "operationId": "TimeIntervalResource_deleteTimeInterval",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "Id",
              "in": "path",
              "description": "Unique identifier for the time interval",
              "required": true,
              "type": "integer",
              "format": "int32"
            }
          ],
          "responses": {
            "default": {
              "description": "Successful Operation"
            }
          }
        }
      }
    },
    "definitions": {
      "TimeInterval": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "System-generated identifier for the time interval"
          },
          "name": {
            "type": "string",
            "description": "Name to identify the time interval"
          },
          "startTime": {
            "type": "integer",
            "format": "int32",
            "description": "The time interval start time"
          },
          "endTime": {
            "type": "integer",
            "format": "int32",
            "description": "The time interval end time"
          },
          "daysOfWeek": {
            "type": "array",
            "description": "Specifies which days of the week apply to the time interval. If set to EVERYDAY, all the days of the week are chosen.",
            "items": {
              "type": "string",
              "enum": [
                "ANY",
                "NONE",
                "EVERYDAY",
                "SUN",
                "MON",
                "TUE",
                "WED",
                "THU",
                "FRI",
                "SAT"
              ]
            }
          }
        }
      }
    }
  }
