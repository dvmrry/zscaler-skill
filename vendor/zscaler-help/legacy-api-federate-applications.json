    "components": {
      "schemas": {
        "PageListGuestApplicationResourceDTO": {
          "properties": {
            "currentCount": {
              "type": "integer",
              "description": "The current count of resources per the search feature.",
              "format": "int64"
            },
            "list": {
              "type": "array",
              "description": "The total list of guest partner application resources.",
              "items": {
                "$ref": "#/components/schemas/GuestApplicationResource"
              }
            },
            "message": {
              "type": "string",
              "description": "The array of partner information with paginated search attributes."
            },
            "totalCount": {
              "type": "integer",
              "description": "The total count of resources per the search feature.",
              "format": "int64"
            },
            "totalPages": {
              "type": "integer",
              "description": "The total number of pages per the pagination attribute.",
              "format": "int32"
            }
          }
        },
        "ZPathAPIError": {
          "properties": {
            "reason": {
              "type": "string",
              "description": "The reason for the cause of the error status code. To learn more, see <a href=\"/zpa/api-response-codes-and-error-messages\" target= _blank>API Response Codes and Error Messages</a>."
            },
            "id": {
              "type": "string",
              "description": "The unique identifier of the error status code."
            },
            "params": {
              "type": "array",
              "description": "The parameters that were sent in the request body.",
              "items": {
                "type": "object"
              }
            },
            "hostname": {
              "type": "string",
              "description": "The client server address or domain name."
            }
          }
        },
        "ApplicationFederationRequest": {
          "required": [
            "applicationGid",
            "guestGids"
          ],
          "properties": {
            "applicationGid": {
              "type": "integer",
              "description": "The GID of the host application segment that you want to federate.",
              "format": "int64"
            },
            "guestGids": {
              "type": "array",
              "description": "The list of guest partner GIDs to share the application with. This array must be the partners that the host has an active federation with.",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        },
        "ApplicationFederationResponse": {
          "properties": {
            "applicationGid": {
              "type": "integer",
              "description": "The GID of the host application segment that you want to federate.",
              "format": "int64"
            },
            "guestIds": {
              "type": "array",
              "description": "The list of guest partner GIDs to share the application with. This array must be the partners that the host has an active federation with.",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            },
            "message": {
              "type": "string",
              "description": "The array of partner information with paginated search attributes."
            }
          }
        },
        "GuestApplicationResource": null
      }
