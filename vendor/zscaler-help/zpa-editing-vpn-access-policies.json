    {
      "text": "To edit a VPN access policy rule:"
    },
    {
      "item": "Go to Private Access > VPN (for Legacy Apps) > VPN Access Policy.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          44
        ],
        [
          47,
          64
        ]
      ]
    },
    {
      "item": "Locate the access policy rule you want to edit, and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          62,
          66
        ]
      ]
    },
    {
      "text": "To change the value of an access policy rule, click the value in the Rule Order column.",
      "strong": [
        [
          69,
          79
        ]
      ]
    },
    {
      "item": "On the Edit Rule page, modify fields as necessary. For more information about each field, see Configuring VPN Access Policies.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          16
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
