  "schema_version": 1,
  "kind": "help-article",
  "title": "Adding and Managing Custom Roles",
  "source": {
    "url": "https://help.zscaler.com/ai-asset-mgmt/adding-and-managing-custom-roles",
    "node": "1540159",
    "revision": "3212065",
    "updated": "2026-06-06",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "You can add or edit custom roles and assign them to users to manage tasks in specific modules or global modules."
    },
    {
      "heading": "Adding a Custom Role",
      "level": 1
    },
    {
      "text": "To add a custom role:"
    },
    {
      "item": "Go to Administration > Access Roles.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          35
        ]
      ]
    },
    {
      "item": "On the Access Roles page, click Add Role.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          19
        ],
        [
          32,
          40
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Add Role window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          12
        ]
      ]
    },
    {
      "item": "In the Add Role window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          15
        ]
      ]
    },
    {
      "item": "Role Name: Enter a unique name for the custom role.",
      "depth": 1,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
      "item": "The role name can include letters, numbers, or special characters (hyphen (-) or underscore (_)).",
      "depth": 1
    },
    {
      "item": "Permissions: Assign any of the following permissions:",
      "depth": 1,
      "strong": [
        [
          0,
          12
        ]
      ]
    },
    {
      "item": "Access: Select the checkbox for tasks that users can perform in each module or global module.",
      "depth": 2,
      "strong": [
        [
          0,
          6
        ]
      ]
    },
    {
      "item": "View Only: Select to provide view only access to specific modules or global modules.",
      "depth": 2,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
      "item": "None: Select to restrict users from accessing or viewing specific modules or global modules.",
      "depth": 2,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "For the Scan Settings module, you need to assign Access or View Only permissions for Cloud Accounts and permissions to start or stop the scan, or edit the scan settings.",
      "depth": 1,
      "strong": [
        [
          49,
          55
        ],
        [
          59,
          68
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "The custom role is created and displayed on the Access Roles page.",
      "depth": 0
    },
    {
      "heading": "Editing a Custom Role",
      "level": 1
    },
    {
      "text": "You can edit a custom role and modify the permissions to view, access, or restrict access to specific modules."
    },
    {
      "text": "You cannot edit or delete predefined roles."
    },
    {
      "text": "To edit a role:"
    },
    {
      "item": "Go to Administration > Access Roles.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          35
        ]
      ]
    },
    {
      "item": "On the Access Roles page, click the Edit icon for the custom role that you want to edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          19
        ],
        [
          36,
          40
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Edit Role window, change the Role Name or Permissions, as required.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          16
        ],
        [
          36,
          45
        ],
        [
          49,
          60
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Update.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "A message appears indicating that the role is updated successfully.",
      "depth": 0
    },
    {
      "heading": "Deleting a Custom Role",
      "level": 1
    },
    {
      "text": "To delete a custom role:"
    },
    {
      "item": "Go to Administration > Access Roles.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          35
        ]
      ]
    },
    {
      "item": "On the Access Roles page, click the Delete icon for the custom role that you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          19
        ],
        [
          36,
          42
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Delete Role window, click Delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          18
        ],
        [
          33,
          39
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The role is deleted from the AI Security Admin Portal.",
      "depth": 0
    }
  ]
}
