  "blocks": [
    {
      "text": "Watch a video about Application Bypass including adding an IP-Based bypass."
    },
    {
      "text": "In addition to using predefined applications (e.g., Microsoft Teams and Zoom), you can add IP-based applications to bypass traffic. Select the applications to bypass in App Profiles."
    },
    {
      "text": "To add an IP-based application to bypass traffic:"
    },
    {
      "item": "From the navigation menu, go to Infrastructure > Client Connector > IP Bypass.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          46
        ],
        [
          49,
          65
        ],
        [
          68,
          77
        ]
      ]
    },
    {
      "item": "On the IP-Based tab, click Custom.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          15
        ],
        [
          27,
          33
        ]
      ]
    },
    {
      "item": "Click Add Application.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          21
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Add Application window, complete the following fields:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          22
        ]
      ]
    },
    {
      "item": "Android only supports IP-based bypasses and does not support ports and protocols. All traffic that is associated with the specified IP is bypassed.",
      "depth": 0
    },
    {
      "item": "For General: Enter the application’s name in the Name field.",
      "depth": 1,
      "strong": [
        [
          4,
          11
        ],
        [
          49,
          53
        ]
      ]
    },
    {
      "item": "For IPv4 or IPv6 Addresses:",
      "depth": 1,
      "strong": [
        [
          4,
          8
        ],
        [
          12,
          16
        ],
        [
          17,
          26
        ]
      ]
    },
    {
      "item": "Port: Enter valid port numbers (1–65535) or a range of port numbers (e.g., 80–100) or an asterisk (*), separated by commas.",
      "depth": 2,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Protocol: Select one of the following protocols for your application:",
      "depth": 2,
      "strong": [
        [
          0,
          8
        ]
      ]
    },
    {
      "item": "UDP",
      "depth": 3,
      "strong": [
        [
          0,
          3
        ]
      ]
    },
    {
      "item": "TCP",
      "depth": 3,
      "strong": [
        [
          0,
          3
        ]
      ]
    },
    {
      "item": "Asterisk (*) to represent any protocol",
      "depth": 3
    },
    {
      "item": "IPv4 Addresses or IPv6 Addresses: Enter the IPv4/IPv6 addresses or subnet for the application, separated by commas.",
      "depth": 2,
      "strong": [
        [
          0,
          14
        ],
        [
          18,
          32
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
