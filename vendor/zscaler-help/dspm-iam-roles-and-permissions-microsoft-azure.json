        ],
        [
          "Microsoft.KeyVault/vaults/keys/read",
          "DSPM resource group",
          "DataActions",
          "To list the keys in a specified vault"
        ],
        [
          "Microsoft.KeyVault/vaults/keys/decrypt/action",
          "DSPM resource group",
