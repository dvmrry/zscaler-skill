  "blocks": [
    {
      "text": "You can edit or delete ThreatParse Rules that you configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a ThreatParse Rule",
      "level": 1
    },
    {
      "text": "To edit a ThreatParse rule:"
    },
    {
      "item": "Go to Miragemaker > ThreatParse Rules.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          37
        ]
      ]
    },
    {
      "item": "Under Actions, click the Edit icon for the rule you want to modify.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          29
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Rule Details window, modify the required fields.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          19
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The default ThreatParse rules cannot be edited."
    },
    {
      "heading": "Deleting a ThreatParse Rule",
      "level": 1
    },
    {
      "text": "To delete a ThreatParse rule:"
    },
    {
      "item": "Go to Miragemaker > ThreatParse.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          31
        ]
      ]
    },
    {
      "item": "Under Actions, click the Delete icon for the rule you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          31
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "text": "The default ThreatParse rules cannot be deleted."
    }
  ]
}
