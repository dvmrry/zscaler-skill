    {
      "text": "All WebSocket custom controls can be edited, even ones currently in use by an AppProtection profile."
    },
    {
      "text": "To edit a custom control:"
    },
    {
      "item": "Go to Private Access > Private App Protection > Protection Controls > WebSocket Controls.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          45
        ],
        [
          48,
          67
        ],
        [
          70,
          88
        ]
      ]
    },
    {
      "item": "Locate the WebSocket custom control you want to edit, and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          68,
          72
        ]
      ]
    },
    {
      "text": "The Edit WebSocket Custom Control window appears.",
      "strong": [
        [
          4,
          33
        ]
      ]
    },
    {
      "item": "Modify information as necessary on each tab. To learn more, see Configuring WebSocket Controls.",
      "depth": 0,
      "number": 3
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
