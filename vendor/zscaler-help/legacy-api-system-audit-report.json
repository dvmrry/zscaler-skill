{
  "schema_version": 1,
  "kind": "help-api-spec",
  "title": "System Audit Report",
  "source": {
    "url": "https://help.zscaler.com/legacy-apis/system-audit-report",
    "node": "1525836",
    "revision": "3103139",
    "file_url": "https://help.zscaler.com/sites/default/files/api-docs/System%20Audit%20Report_4.json?VersionId=uTSMnrfDpTLyRowF5hqD1QHMT87cW3BE",
    "updated": "2025-04-22",
    "updated_basis": "file-last-modified"
  },
  "captured_at": "2026-11-03",
  "spec": {
    "swagger": "2.0",
    "info": {
      "version": "v1",
      "title": "ZIA Cloud Service and Sandbox Submission APIs",
      "description": "API Reference Guide for the ZIA Cloud Service and Sandbox Submission APIs\n"
    },
    "host": "zsapi.[zscaler-cloud-name]",
    "basePath": "/api/v1",
    "schemes": [
      "https"
    ],
    "tags": [
      {
        "name": "System Audit Report"
      }
    ],
    "paths": {
      "/configAudit": {
        "get": {
          "tags": [
            "System Audit Report"
          ],
          "description": "<p>Retrieves the System Audit Report. To learn more, see <a href=\"/zia/about-system-audit-report\" target=\"_blank\">About the System Audit Report</a>.</p><p><b>Note</b>: This endpoint is accessible via <a href=\"/oneapi/understanding-oneapi\" target=\"_blank\">Zscaler OneAPI</a> only.</p>",
          "operationId": "ConfigAuditResource_getConfigReport",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/ConfigAudit"
              }
            }
          }
        }
      },
      "/configAudit/ipVisibility": {
        "get": {
          "tags": [
            "System Audit Report"
          ],
          "description": "<p>Retrieves the IP visibility audit report.</p><p><b>Note</b>: This endpoint is accessible via <a href=\"/oneapi/understanding-oneapi\" target=\"_blank\">Zscaler OneAPI</a> only.</p>",
          "operationId": "ConfigAuditResource_getIpVisibility",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/IpVisibilityAudit"
              }
            }
          }
        }
      },
      "/configAudit/pacFile": {
        "get": {
          "tags": [
            "System Audit Report"
          ],
          "description": "<p>Retrieves the PAC file audit report.</p><p><b>Note</b>: This endpoint is accessible via <a href=\"/oneapi/understanding-oneapi\" target=\"_blank\">Zscaler OneAPI</a> only.</p>",
          "operationId": "ConfigAuditResource_getPacFile",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/PacFileAudit"
              }
            }
          }
        }
      }
    },
    "definitions": {
      "ConfigAudit": {
        "type": "object",
        "description": "Configuration audit information",
        "properties": {
          "overallGrade": {
            "type": "string",
            "description": "The rubric used to grade the report containing the overall grades for High Availability Configuration and User Performance Configuration combined.",
            "enum": [
              "A",
              "B",
              "C",
              "NONE"
            ]
          },
          "highAvailabilityGrade": {
            "type": "string",
            "description": "The rubric used to grade the High Availability Configuration for GRE tunnels and PAC files",
            "enum": [
              "A",
              "B",
              "C",
              "NONE"
            ]
          },
          "userPerformanceGrade": {
            "type": "string",
            "description": "The rubric used to grade the User Performance Configuration for authentication frequency and PAC file",
            "enum": [
              "A",
              "B",
              "C",
              "NONE"
            ]
          },
          "otherGrade": {
            "type": "string",
            "description": "The rubric used to grade the Microsoft-Recommended Office 365 One Click Configuration and IP visibility",
            "enum": [
              "A",
              "B",
              "C",
              "NONE"
            ]
          },
          "greTunnelGrade": {
            "type": "string",
            "description": "The rubric used to grade GRE tunnels",
            "enum": [
              "A",
              "B",
              "C",
              "NONE"
            ]
          },
          "pacFileGrade": {
            "type": "string",
            "description": "The rubric used to grade PAC files",
            "enum": [
              "A",
              "B",
              "C",
              "NONE"
            ]
          },
          "authFrequency": {
            "description": "Authentication frequency",
            "$ref": "#/definitions/AuthFrequency"
          },
          "authFrequencyGrade": {
            "type": "string",
            "description": "The rubric used to grade the authentication frequency",
            "enum": [
              "A",
              "B",
              "C",
              "NONE"
            ]
          },
          "pacfileSizeGrade": {
            "type": "string",
            "description": "The rubric used to grade the PAC file size",
            "enum": [
              "A",
              "B",
              "C",
              "NONE"
            ]
          },
          "office365Flag": {
            "type": "boolean",
            "description": "Office 365 One Click flag"
          },
          "office365Grade": {
            "type": "string",
            "description": "Office 365 One Click grade",
            "enum": [
              "A",
              "B",
              "C",
              "NONE"
            ]
          },
          "ipVisibilityGrade": {
            "type": "string",
            "description": "The rubric used to grade IP visibility",
            "enum": [
              "A",
              "B",
              "C",
              "NONE"
            ]
          },
          "reportTimestamp": {
            "type": "integer",
            "format": "int64",
            "description": "Report timestamp"
          },
          "dataPresent": {
            "type": "boolean",
            "description": "Data present flag"
          },
          "greTunnelRecommendedConfiguration": {
            "type": "string",
            "description": "GRE tunnel recommended configuration"
          },
          "pacFileRecommendedConfiguration": {
            "type": "string",
            "description": "PAC file recommended configuration"
          },
          "authFrequencyRecommendedConfiguration": {
            "type": "string",
            "description": "Auth frequency recommended configuration"
          },
          "pacFileSizeRecommendedConfiguration": {
            "type": "string",
            "description": "Pac file size recommended configuration"
          },
          "office365RecommendedConfiguration": {
            "type": "string",
            "description": "Microsoft-recommended One Click Office 365 configuration"
          },
          "ipVisibilityRecommendedConfiguration": {
            "type": "string",
            "description": "IP visibility recommended configuration"
          }
        }
      },
      "IpVisibilityAudit": {
        "type": "object",
        "description": "IP visibility audit information",
        "properties": {
          "totalGreLocations": {
            "type": "integer",
            "format": "int32",
            "description": "Total GRE locations"
          },
          "locationsWithNat": {
            "type": "array",
            "description": "Locations with NAT",
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": "string",
            "description": "GRE tunnels audit recommendation"
          },
          "details": {
            "type": "string",
            "description": "GRE tunnels audit details"
          }
        }
      },
      "PacFileAudit": {
        "type": "object",
        "properties": {
          "totalPacFiles": {
            "type": "integer",
            "format": "int32",
            "description": "Total PAC files"
          },
          "pacWithStaticIPs": {
            "type": "array",
            "description": "Total PAC files with static IPs",
            "items": {
              "$ref": "#/definitions/PacWithStaticIp"
            }
          }
        }
      },
      "AuthFrequency": {
        "type": "object",
        "properties": {
          "authFrequency": {
            "type": "string",
            "enum": [
              "DAILY_COOKIE",
              "PERMANENT_COOKIE",
              "SESSION_COOKIE",
              "CUSTOM_COOKIE"
            ]
          },
          "authCustomFrequency": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PacWithStaticIp": {
        "type": "object",
        "properties": {
          "pacFileName": {
            "type": "string"
          },
          "staticServiceIps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "staticVirtualIps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
