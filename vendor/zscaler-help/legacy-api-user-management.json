              "type": "string"
            },
            {
              "name": "adminScopeSupport",
              "in": "query",
              "required": false,
              "type": "boolean",
              "description": "A Boolean value that indicates whether the group is part of the admin scope. When you set the value to <b>true</b>, the group is included in the admin scope."
            },
            {
              "name": "definedBy",
              "in": "query",
              "description": "The string value defined by the group name or other applicable attributes",
              "required": false,
              "type": "string"
            },
            {
              "name": "page",
              "in": "query",
              "description": "Specifies the page offset",
              "required": false,
              "type": "integer",
              "default": 1,
              "format": "int32"
            },
            {
              "name": "pageSize",
              "in": "query",
              "description": "Specifies the page size",
              "required": false,
              "type": "integer",
              "default": 100,
              "format": "int32"
            },
            {
              "name": "sortBy",
              "in": "query",
              "description": "Sorts the groups based on available values",
              "required": false,
              "type": "string",
              "default": "id",
              "enum": [
                "id",
                "name",
                "expiry",
                "status",
                "externalId",
                "rank",
                "modTime"
              ]
            },
            {
              "name": "sortOrder",
              "in": "query",
              "description": "Sorts the order of groups based on available values",
              "required": false,
              "type": "string",
              "default": "asc",
              "enum": [
                "asc",
                "desc",
                "ruleExecution"
              ]
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Group"
                }
              }
            }
          }
        },
        "post": {
          "tags": [
            "User Management"
          ],
          "description": "<p>Adds a new group. To learn more, see <a href=\"/zia/adding-groups\" target=\"_blank\">Adding Groups</a>.</p><p><b>Note</b>: This endpoint is accessible via <a href=\"/oneapi/understanding-oneapi\" target=\"_blank\">Zscaler OneAPI</a> only.</p>",
