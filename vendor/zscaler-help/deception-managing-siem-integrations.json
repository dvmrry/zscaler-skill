    {
      "text": "You can edit or delete a SIEM integration configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a SIEM Integration",
      "level": 1
    },
    {
      "text": "To edit a SIEM integration:"
    },
    {
      "item": "Go to Orchestrate > SIEM Integrations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          24
        ],
        [
          25,
          37
        ]
      ]
    },
    {
      "item": "In the table, locate the SIEM integration you want to modify, and then click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          81,
          85
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the SIEM details window, modify the fields as necessary.",
      "depth": 0,
      "number": 3
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting a SIEM Integration",
      "level": 1
    },
    {
      "text": "To delete a SIEM integration:"
    },
    {
      "item": "Go to Orchestrate > SIEM Integrations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          37
        ]
      ]
    },
    {
      "item": "In the table, locate the SIEM integration you want to delete, and then click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          81,
          87
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    }
  ]
