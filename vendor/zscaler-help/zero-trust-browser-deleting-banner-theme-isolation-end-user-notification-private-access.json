  "blocks": [
    {
      "text": "Admins manage the banner themes for the isolation session's end-user notification. You can delete any banner theme except the Default."
    },
    {
      "text": "To delete a banner theme:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Browser > Browser Isolation Private Apps > Isolation Banner.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          50
        ],
        [
          53,
          83
        ],
        [
          86,
          102
        ]
      ]
    },
    {
      "item": "Click the Delete icon for the banner you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Confirm: Delete Banner window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          26
        ]
      ]
    },
    {
      "item": "In the Confirm: Delete Banner window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          29
        ]
      ]
    },
    {
      "item": "Enter CONFIRM.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "Click Delete.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    }
  ]
}
