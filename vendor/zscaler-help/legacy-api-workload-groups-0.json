    "tags": [
      {
        "name": "Workload Groups"
      }
    ],
    "paths": {
      "/workloadGroups": {
        "get": {
          "operationId": "WorkloadGroupZResource_getWorkloadGroups",
          "description": "<p>Retrieves the list of workload groups.</p> \n <p><strong>&#9888; This API endpoint is accessible only via <a href=\"https://help.zscaler.com/oneapi\">OneAPI</a>.</strong></p>",
          "parameters": [
            {
              "in": "query",
              "name": "page",
              "description": "Specifies the page offset.",
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 1
              }
            },
            {
              "in": "query",
              "name": "pageSize",
              "description": "Specifies the page size. The default size is 250.",
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 250
              }
            }
          ],
          "responses": {
            "default": {
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/WorkloadGroup"
                    }
                  }
                }
              },
              "description": "default response"
            }
          },
          "tags": [
            "Workload Groups"
          ]
        }
      },
      "/workloadGroups/lite": {
        "get": {
          "operationId": "WorkloadGroupZResource_getWorkloadGroupsLite",
          "description": "<p>Retrieves the list of workload groups.</p> \n <p><strong>&#9888; This API endpoint is accessible only via <a href=\"https://help.zscaler.com/oneapi\">OneAPI</a>.</strong></p>",
          "parameters": [
            {
              "in": "query",
              "name": "page",
              "description": "Specifies the page offset.",
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 1
              }
            },
            {
              "in": "query",
              "name": "pageSize",
              "description": "Specifies the page size. The default size is 20.",
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 20
              }
            }
          ],
          "responses": {
            "default": {
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/EntityResponse"
                    }
                  }
                }
              },
              "description": "default response"
            }
          },
          "tags": [
            "Workload Groups"
          ]
        }
      }
    },
    "components": {
      "schemas": {
        "WorkloadGroup": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "description": "The description of the workload group."
            },
            "expression": {
              "type": "string",
              "description": "The workload group expression consisting of tag types, tags, and their relationships."
            },
            "expressionJson": {
              "$ref": "#/components/schemas/WorkloadTagExpression"
            },
            "id": {
              "type": "integer",
              "description": "A unique identifier assigned to the workload group.",
              "format": "int32"
            },
            "lastModifiedBy": {
              "$ref": "#/components/schemas/EntityReference"
            },
            "lastModifiedTime": {
              "description": "Timestamp of when the workload group was last modified.",
              "type": "integer",
              "format": "int32"
            },
            "name": {
              "description": "The name of the workload group.",
              "type": "string"
            }
          }
        },
        "EntityResponse": {
          "type": "object",
          "description": "An immutable reference to an entity, including ID and name.",
          "properties": {
            "id": {
              "type": "integer",
              "description": "The ID of the entity.",
              "format": "int32"
            },
            "name": {
              "type": "string",
              "description": "The name of the entity."
            }
          }
        },
        "WorkloadTagExpression": {
          "type": "object",
          "description": "The workload tag expression containing one or more tag types (and associated tags) combined using logical operators within a workload group.",
          "properties": {
            "expressionContainers": {
              "type": "array",
              "description": "One or more tag types (and associated tags) combined using logical operators within a workload group.",
              "items": {
                "$ref": "#/components/schemas/ExpressionContainer"
              }
            }
          }
        },
        "ExpressionContainer": {
          "type": "object",
          "description": "The workload group expression containing tag types, tags, and their relationships.",
          "properties": {
            "operator": {
              "type": "string",
              "description": "The operator used to create logical relationships between tag types.",
              "enum": [
                "AND",
                "OR",
                "OPEN_PARENTHESES",
                "CLOSE_PARENTHESES"
              ]
            },
            "tagContainer": {
              "$ref": "#/components/schemas/TagContainer"
            },
            "tagType": {
              "description": "The tag type selected from a predefined list.",
              "type": "string",
              "enum": [
                "ANY",
                "VPC",
                "SUBNET",
                "VM",
                "ENI",
                "ATTR"
              ]
            }
          }
        },
        "TagContainer": {
          "type": "object",
          "properties": {
            "operator": {
              "type": "string",
              "description": "The logical operator used to combine the tags within a tag type.",
              "enum": [
                "AND",
                "OR",
                "OPEN_PARENTHESES",
                "CLOSE_PARENTHESES"
              ]
            },
            "tags": {
              "type": "array",
              "description": "One or more tags, each consisting of a key-value pair, selected within a tag type.",
              "items": {
                "$ref": "#/components/schemas/Tag"
              }
            }
          }
        },
        "Tag": {
          "type": "object",
          "properties": {
            "key": {
              "description": "The key component present in the key-value pair contained in a tag.",
              "type": "string"
            },
            "value": {
              "description": "The value component present in the key-value pair contained in a tag.",
              "type": "string"
            }
          }
        },
        "EntityReference": {
          "type": "object",
          "description": "An immutable reference to an entity, which consists of ID, name, etc.",
          "properties": {
            "id": {
              "type": "integer",
              "format": "int64",
              "description": "An ID that uniquely identifies an entity."
            },
            "name": {
              "type": "string",
              "description": "The name of the entity."
            },
            "isNameL10nTag": {
              "type": "boolean",
              "description": "Indicates whether the entity is localized for internationalization."
            },
            "extensions": {
              "type": "object",
              "description": "An object for storing additional properties related to entity configuration.",
              "additionalProperties": {
                "type": "string",
                "description": "Custom attributes within the extensions object."
              }
            },
            "deleted": {
              "type": "boolean",
              "description": "Indicates the deletion status of the entity."
            },
            "externalId": {
              "type": "string",
              "description": "The external ID of the entity."
            },
            "associationTime": {
              "type": "integer",
              "format": "int32",
              "description": "The timestamp when the entity was linked or associated."
            }
          }
        }
      }
    }
  }
