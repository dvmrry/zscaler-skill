      "schemas": {
        "FilterAndSortDto": {
          "properties": {
            "sortBy": {
              "$ref": "#/components/schemas/SortDto"
            },
            "filterBy": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/UIFilterDto"
              }
            },
            "pageBy": {
              "$ref": "#/components/schemas/PaginationDto"
            }
          }
        },
        "ZPathAPIError": {
          "properties": {
            "reason": {
              "type": "string",
              "description": "The reason for the cause of the error status code. To learn more, see <a href=\"/zpa/api-response-codes-and-error-messages\" target= _blank>API Response Codes and Error Messages</a>."
            },
            "id": {
              "type": "string",
              "description": "The unique identifier of the error status code."
            },
            "params": {
              "type": "array",
              "description": "The parameters that were sent in the request body.",
              "items": {
                "type": "object"
              }
            },
            "hostname": {
              "type": "string",
              "description": "The client server address or domain name."
            }
          }
        },
        "PageListC2cIpRangesDTO": {
          "properties": {
            "totalPages": {
              "type": "integer",
              "description": "The total number of pages per the pagination attribute.",
              "format": "int32"
            },
            "currentCount": {
              "type": "integer",
              "description": "The current count of resources per the search feature.",
              "format": "int64"
            },
            "totalCount": {
              "type": "integer",
              "description": "The total count of resources per the search feature.",
              "format": "int64"
            },
            "list": {
              "type": "array",
              "description": "The total list of Zscaler virtual IP address range resources.",
              "items": {
                "$ref": "#/components/schemas/C2cIpRangesDTO"
              }
            }
          }
        },
        "C2cIpRangesDTO": {
          "required": [
            "customerId"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "description": "The unique identifier of the Zscaler virtual IP address range.",
              "format": "int64"
            },
            "modifiedTime": {
              "type": "integer",
              "description": "The time the Zscaler virtual IP address range is modified.",
              "format": "int32"
            },
            "creationTime": {
              "type": "integer",
              "description": "The time the Zscaler virtual IP address range is created.",
              "format": "int32"
            },
            "modifiedBy": {
              "type": "integer",
              "description": "The unique identifier of the tenant who modified the Zscaler virtual IP address range.",
              "format": "int64"
            },
            "isDeleted": {
              "type": "integer",
              "description": "Indicates if the Zscaler virtual IP address range is deleted or not (0). Any integer greater than 0 denotes that the Zscaler virtual IP address range is deleted.",
              "format": "int32"
            },
            "customerId": {
              "type": "integer",
              "description": "The unique identifier of the ZPA tenant.",
              "format": "int64"
            },
            "name": {
              "type": "string",
              "description": "The name of the Zscaler virtual IP address range."
            },
            "description": {
              "type": "string",
              "description": "The description of the Zscaler virtual IP address range."
            },
            "ipRangeBegin": {
              "type": "string",
              "description": "The beginning IP address range. The beginning IP address range must be less than the ending IP address range. The <code>subnetCidr</code> field is not required if <code>ipRangeBegin</code> or <code>ipRangeEnd</code> fields are passed."
            },
            "ipRangeEnd": {
              "type": "string",
              "description": "The ending IP address range. The ending IP address range must be greater than the beginning IP address range. The <code>subnetCidr</code> field is not required if <code>ipRangeBegin</code> or <code>ipRangeEnd</code> fields are passed."
            },
            "subnetCidr": {
              "type": "string",
              "description": "The IP address subnet in Classless Inter-Domain Routing (CIDR) notation used for server-to-client connectivity. The <code>ipRangeBegin</code> or <code>ipRangeEnd</code> fields are not required if <code>subnetCidr</code> is passed."
            },
            "latitudeInDb": {
              "type": "string",
              "description": "The latitude coordinate for the location of the Zscaler virtual IP address range."
            },
            "longitudeInDb": {
              "type": "string",
              "description": "The longitude coordinate for the location of the Zscaler virtual IP address range."
            },
            "location": {
              "type": "string",
              "description": "The location of the Zscaler virtual IP address range."
            },
            "countryCode": {
              "type": "string",
              "description": "The country code of the Zscaler virtual IP address range."
            },
            "enabled": {
              "type": "boolean",
              "description": "Indicates if the Zscaler virtual IP address range is enabled (true) or disabled (false)."
            },
            "totalIps": {
              "type": "integer",
              "description": "The total number of IP addresses in the Zscaler virtual IP address range.",
              "format": "int32"
            },
            "usedIps": {
              "type": "integer",
              "description": "The number of used IP addresses.",
              "format": "int32"
            },
            "availableIps": {
              "type": "integer",
              "description": "The number of available IP addresses.",
              "format": "int32"
            },
            "sccmFlag": {
              "type": "boolean",
