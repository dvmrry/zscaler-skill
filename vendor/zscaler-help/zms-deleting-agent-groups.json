  "title": "Deleting Agent Groups",
  "source": {
    "url": "https://help.zscaler.com/microsegmentation/deleting-agent-groups",
    "node": "1531958",
    "revision": "3246400",
    "updated": "2026-11-02",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "Admins can configure, edit, and delete agent groups as needed."
    },
    {
      "text": "To delete an agent group:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > Agent Groups.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          83
        ]
      ]
    },
    {
      "item": "Delete an agent group:",
      "depth": 0,
      "number": 2
    },
    {
      "item": "For agent groups with the Kubernetes Cluster type, click the Delete icon.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          61,
          67
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "For agent groups with the VM type, click the More icon, then click Delete in the menu.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          45,
          49
        ],
        [
          67,
          73
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "The Agent Group window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          15
        ]
      ]
    },
    {
      "item": "In the Agent Group window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          18
        ]
      ]
    },
    {
      "item": "Enter CONFIRM.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "Click Delete.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "text": "The page refreshes and removes the agent group from the list."
    }
  ]
}
