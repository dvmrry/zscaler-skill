      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          17
        ]
      ]
    },
    {
      "item": "Enter the following information:",
      "depth": 1,
      "number": 3
    },
    {
      "item": "Name: The name of the webhook for Microsoft Teams.",
      "depth": 2,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
