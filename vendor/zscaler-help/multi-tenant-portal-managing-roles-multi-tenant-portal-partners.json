    {
      "text": "The Multi-Tenant Portal for Partners allows you to create your own customized admin role templates. You can further edit or delete existing role templates in your Zscaler partner account."
    },
    {
      "heading": "Adding a New Role",
      "level": 1
    },
    {
      "text": "To create a new role template:"
    },
    {
      "item": "Go to Roles.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          11
        ]
      ]
    },
    {
      "item": "Click on the Add Role button. The Add Role window appears.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          13,
          21
        ],
        [
          34,
          42
        ]
      ]
    },
    {
      "item": "In the Add Role window, enter the following details:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          15
        ]
      ]
    },
    {
      "item": "Role Name: The name of the role.",
      "depth": 1,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
      "item": "Permissions: Define permissions for different sections.",
      "depth": 1,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "Description: Add a description for the role.",
      "depth": 1,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Editing Roles",
      "level": 1
    },
    {
      "text": "To edit a role template:"
    },
    {
      "item": "Go to Roles.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          11
        ]
      ]
    },
    {
      "item": "Click the Edit icon. The Edit Role window appears.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          14
        ],
        [
          25,
          34
        ]
      ]
    },
    {
      "item": "Modify the permissions.",
      "depth": 0,
      "number": 3
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting Roles",
      "level": 1
    },
    {
      "text": "To delete a role template:"
    },
    {
      "item": "Go to Roles.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          11
        ]
      ]
    },
    {
      "item": "Click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "Confirm your decision.",
      "depth": 0,
      "number": 3
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Delete.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    }
  ]
