    "definitions": {
      "FileTypeRule": {
        "type": "object",
        "description": "File Type rule",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "System-generated identifier for a file type policy"
          },
          "protocols": {
            "type": "array",
            "description": "Protocol for the given rule. This field is not applicable to the Lite API.",
            "items": {
              "type": "string",
              "enum": [
                "ANY_RULE",
                "SMRULEF_CASCADING_ALLOWED",
                "FOHTTP_RULE",
                "FTP_RULE",
                "HTTPS_RULE",
                "HTTP_RULE"
              ]
            }
          },
          "order": {
            "type": "integer",
            "format": "int32",
            "description": "Order of policy execution with respect to other file type policies. Order N indicates N-th file type policy is evaluated. This field is not applicable to the Lite API."
          },
          "timeQuota": {
            "type": "integer",
            "format": "int32",
            "description": "Time quota in minutes, after which the policy must be applied. If not set, no time quota is enforced. Ignored if action is BLOCK."
          },
          "sizeQuota": {
            "type": "integer",
            "format": "int32",
            "description": "Size quota in KB, beyond which the policy must be applied. If not set, size quota is not enforced. Ignored if action is BLOCK."
          },
          "description": {
            "type": "string",
            "description": "Comments provided by the administrator"
          },
          "locations": {
            "type": "array",
            "description": "Name-ID pairs of locations for which the policy must be applied. If not set, the policy is applied for all locations.",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "locationGroups": {
            "type": "array",
            "description": "Name-ID pairs of locations groups for which rule must be applied.",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "groups": {
            "type": "array",
            "description": "Name-ID pairs of groups for which the policy must be applied. If not set, the policy is applied for all groups.",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "departments": {
            "type": "array",
            "description": "Name-ID pairs of departments for which the rule is applied. If not set, the rule is applied for all departments.",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "users": {
            "type": "array",
            "description": "Name-ID pairs of users for which the policy must be applied. If not set, user criteria is not considered for policy enforcement.",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "urlCategories": {
            "type": "array",
            "description": "List of URL categories for which the policy must be applied. If not set, the policy is applied for all URL categories.",
            "items": {
              "$ref": "#/definitions/UrlCategoryForPolicy"
            }
          },
          "fileTypes": {
            "type": "array",
            "description": "This field is replaced with <b>fileTypeCategories</b>. Zscaler recommends updating your API configurations to use the <b>fileTypeCategories</b> attribute in place of fileTypes.",
            "items": {
              "type": "string",
              "enum": [
                "ANY",
                "NONE",
                "FTCATEGORY_JAVASCRIPT",
                "FTCATEGORY_FLASH",
                "FTCATEGORY_JAVA_APPLET",
