          "fileTypeCategories": {
            "type": "array",
            "description": "The list of file types to which the rule applies",
            "items": {
              "$ref": "#/definitions/FileTypeCategoryDTO"
            }
          },
          "devices": {
            "type": "array",
            "description": "Name-ID pairs of device for which the rule is applied",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "deviceGroups": {
            "type": "array",
            "description": "Name-ID pairs of device groups for which the rule is applied",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "deviceTrustLevels": {
            "type": "array",
            "description": "<p>List of device trust levels for which the rule must be applied. While the High Trust, Medium Trust, or Low Trust evaluation is applicable only to Zscaler Client Connector traffic, Unknown evaluation applies to all traffic. The trust levels are assigned to the devices based on your <a href=\"/client-connector/adding-zia-posture-profiles\" target=\"_blank\">posture configurations</a> in the Zscaler Client Connector Portal. If no value is set, this field  is ignored during the policy evaluation.</p>",
            "items": {
              "type": "string",
              "enum": [
                "ANY",
                "UNKNOWN_DEVICETRUSTLEVEL",
                "LOW_TRUST",
                "MEDIUM_TRUST",
                "HIGH_TRUST"
              ]
            }
          },
          "minSize": {
            "type": "integer",
            "format": "int32",
            "description": "Minimum file size (in KB) used for evaluation of the FTP rule"
          },
          "maxSize": {
            "type": "integer",
            "format": "int32",
            "description": "Maximum file size (in KB) used for evaluation of the FTP rule"
          },
          "filteringAction": {
            "type": "string",
            "description": "Action taken when traffic matches policy. This field is not applicable to the Lite API.",
            "enum": [
              "BLOCK",
              "CAUTION",
              "ALLOW"
            ]
          },
          "capturePCAP": {
            "type": "boolean",
            "description": "Enable or disable Capture PCAP Settings "
          },
          "operation": {
            "type": "string",
            "description": "File operation performed. This field is not applicable to the Lite API.",
            "enum": [
              "UPLOAD",
              "DOWNLOAD",
              "UPLOAD_DOWNLOAD"
            ]
          },
          "activeContent": {
            "type": "boolean",
            "description": "Flag to check whether a file has active content or not"
          },
          "unscannable": {
            "type": "boolean",
            "description": "Flag to check whether a file is unscannable or not"
          },
          "passwordProtected": {
            "type": "boolean",
            "description": "<p>A Boolean field indicating whether the rule applies to password-protected files. This criterion is used in combination with the fileTypes criterion and is applicable only to specific file types such as 7-Zip, RAR, ZIP, ZIPx, PDF, password-protected Microsoft Office files, and other password-protected and encrypted files. So, when the passwordProtected field is set to true, only the applicable file types can be specified using the <b>fileTypes</b> field.</p><p><b>Note</b>: Traffic is evaluated against this criterion only when uploading and downloading of password-protected files is allowed at the organization level via the Security Exceptions in the Malware Protection policy.</p>"
          },
          "state": {
            "type": "string",
            "description": "Administrative state of the policy. This field is not applicable to the Lite API.",
            "enum": [
              "DISABLED",
              "ENABLED"
            ]
          },
          "timeWindows": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "rank": {
            "type": "integer",
            "description": "Admin rank. This field is not applicable to the Lite API.",
            "format": "int32"
          },
          "lastModifiedTime": {
            "type": "integer",
            "format": "int32",
            "description": "Timestamp when the rule was last modified. Ignored if the request is POST or PUT. "
          },
          "lastModifiedBy": {
            "description": "Admin user that last modified the rule. Ignored if the request is POST or PUT.",
            "allOf": [
              {
                "$ref": "#/definitions/EntityReference"
              }
            ]
          },
          "accessControl": {
            "type": "string",
            "description": "Access privilege of this rule based on the admin's RBA state. Ignored if the request is POST or PUT.",
            "enum": [
              "NONE",
              "READ_ONLY",
              "READ_WRITE"
            ]
          },
          "name": {
            "type": "string",
            "description": "Rule Name"
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "zpaAppSegments": {
            "type": "array",
            "description": "List of Source IP Anchoring-enabled ZPA Application Segments for which this rule is applicable",
            "items": {
              "$ref": "#/definitions/AppSegment"
            }
          },
          "cloudApplications": {
            "type": "array",
            "description": "The list of cloud applications to which the File Type Control policy rule must be applied",
            "items": {
              "$ref": "#/definitions/PolicyWebApplication"
            },
            "maxItems": 12000,
            "minItems": 0
          }
        }
      },
