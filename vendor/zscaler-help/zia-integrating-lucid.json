  "schema_version": 1,
  "kind": "help-article",
  "title": "Integrating with Lucid",
  "source": {
    "url": "https://help.zscaler.com/zia/integrating-lucid",
    "node": "1538945",
    "revision": "3188674",
    "updated": "2026-03-24",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "You can connect your Lucid organization to Advanced SaaS Security Posture Management (SSPM) to continuously monitor and correct Software as a Service (SaaS) security posture and ensure regulatory compliance is maintained across the organization."
    },
    {
      "heading": "Prerequisite",
      "level": 1
    },
    {
      "text": "A user with Account Admin privileges is required to connect Advanced SSPM to your Lucid organization."
    },
    {
      "heading": "Connecting Lucid to Advanced SSPM",
      "level": 1
    },
    {
      "text": "To connect your Lucid organization to Advanced SSPM:"
    },
    {
      "item": "Click Connect in the upper-right corner of the SaaS Dashboard.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          13
        ],
        [
          47,
          61
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "From the drop-down menu, select Lucid.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          32,
          37
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Add Integration window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          19
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Generate the System for Cross-domain Identity Management (SCIM) token:",
      "depth": 0,
      "number": 3
    },
    {
      "item": "Log in to the Lucid admin console.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "Click App Integration in the left-side navigation.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          21
        ]
      ]
    },
    {
      "item": "Ensure SCIM integration is enabled.",
      "depth": 1,
      "number": 3
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click the Settings button.",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          10,
          18
        ]
      ]
    },
    {
      "item": "Under SCIM setup, copy the token that already exists, or click Regenerate token to generate a token, and then copy it.",
      "depth": 1,
      "number": 5,
      "strong": [
        [
          6,
          16
        ],
        [
          63,
          79
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Paste the token under SCIM token back in the Add Integration window.",
      "depth": 1,
      "number": 6,
      "strong": [
        [
          22,
          32
        ],
        [
          45,
          60
        ]
      ]
    },
    {
      "item": "Generate an API key:",
      "depth": 0,
      "number": 4
    },
    {
      "item": "Log in to the Lucid Developer console.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "Click API Keys in the left-side navigation.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          14
        ]
      ]
    },
    {
      "item": "Click the Create API Key button in the top-right corner.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          10,
          24
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "In the New API Key window, enter the Key name and set its expiration date. It is recommended to set the expiration date to at least one year away to avoid reintegrating the platform frequently.",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          7,
          18
        ],
        [
          37,
          45
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Set the following permissions:",
      "depth": 1,
      "number": 5
    },
    {
      "item": "Documents: Readonly",
      "depth": 2,
      "strong": [
        [
          0,
          9
        ],
        [
          11,
          19
        ]
      ]
    },
    {
      "item": "Folders: Readonly",
      "depth": 2,
      "strong": [
        [
          0,
          7
        ],
        [
          9,
          17
        ]
      ]
    },
    {
      "item": "Users: View",
      "depth": 2,
      "strong": [
        [
          0,
          5
        ],
        [
          7,
          11
        ]
      ]
    },
    {
      "item": "Accounts: Admin",
      "depth": 2,
      "strong": [
        [
          0,
          8
        ],
        [
          10,
          15
        ]
      ]
    },
    {
      "item": "Teams: Admin",
      "depth": 2,
      "strong": [
        [
          0,
          5
        ],
        [
          7,
          12
        ]
      ]
    },
    {
      "item": "Licenses: None",
      "depth": 2,
      "strong": [
        [
          0,
          8
        ],
        [
          10,
          14
        ]
      ]
    },
    {
      "item": "Click Generate API key.",
      "depth": 1,
      "number": 6,
      "strong": [
        [
          6,
          22
        ]
      ]
    },
    {
      "item": "Click Copy to copy the API key.",
      "depth": 1,
      "number": 7,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Paste the key under API key in the Add Integration window.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          20,
          27
        ],
        [
          35,
          50
        ]
      ]
    },
    {
      "item": "Click Connect to complete the integration.",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          6,
          13
        ]
      ]
    },
    {
      "text": "Your Lucid organization is now connected. After integration is completed, a success message appears, and the tenant details are updated on the Settings page."
    }
  ]
}
