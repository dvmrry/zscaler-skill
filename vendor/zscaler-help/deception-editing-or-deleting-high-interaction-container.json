  "schema_version": 1,
  "kind": "help-article",
  "title": "Editing or Deleting a High-Interaction Container",
  "source": {
    "url": "https://help.zscaler.com/deception/editing-or-deleting-high-interaction-container",
    "node": "1542529",
    "revision": "3221578",
    "updated": "2026-09-22",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete high-interaction containers that you configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a High-Interaction Container",
      "level": 1
    },
    {
      "text": "To edit a high-interaction container:"
    },
    {
      "item": "Go to Miragemaker > High-Interaction Containers.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          47
        ]
      ]
    },
    {
      "item": "Under Actions, click the Edit icon for the high-interaction container you want to modify.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          29
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Web Application Container Details window or the Other Custom Protocols Container Details window, modify the required fields. To learn more, see Configuring a Web Application Container and Configuring a Custom Protocol Container.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          40
        ],
        [
          55,
          95
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The default high-interaction containers cannot be edited."
    },
    {
      "heading": "Deleting a High-Interaction Container",
      "level": 1
    },
    {
      "text": "To delete a high-interaction container:"
    },
    {
      "item": "Go to Miragemaker > High-Interaction Containers.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          47
        ]
      ]
    },
    {
      "item": "Under Actions, click the Delete icon for the high-interaction container you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          31
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "text": "The default high-interaction containers cannot be deleted."
    }
  ]
}
