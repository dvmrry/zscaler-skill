    {
      "item": "The remediation is applied successfully.",
      "depth": 4
    },
    {
      "item": "Remediate multiple AD identities.",
      "depth": 1
    },
    {
      "item": "Do one of the following:",
      "depth": 2,
      "number": 1
    },
    {
      "item": "Under Detailed Findings and Recommendations, click an issue.",
      "depth": 3,
      "strong": [
        [
          6,
          43
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 3
    },
    {
      "item": "Under Top 10 Users & Computers:",
      "depth": 3,
      "strong": [
        [
          6,
          30
        ]
      ]
    },
    {
      "item": "Click an AD identity.",
      "depth": 4,
      "number": 1
    },
    {
      "item": "See image.",
      "depth": 4
    },
    {
      "item": "Select the Posture tab.",
      "depth": 4,
