      "strong": [
        [
          19,
          35
        ]
      ]
    },
    {
      "item": "Click Remediations, and then select an appropriate remediation action. For example, select Reset Password.",
      "depth": 2,
      "number": 3,
      "strong": [
        [
          6,
          18
        ],
        [
          91,
          105
        ]
