    },
    {
      "item": "The remediation is applied successfully.",
      "depth": 2
    },
    {
      "text": "If there are any pending remediations for an identity, and you try to run the same or any other remediations, a warning message appears. You can either click Resubmit to proceed with the request or click Close to exit.",
      "strong": [
        [
          158,
          166
        ],
        [
          204,
          209
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "text": "You can view the remediation logs or history for further analysis."
    },
    {
      "text": "You can take remediation actions on AD identities for which active changes are detected or identities that have compromised or weak passwords."
    }
  ]
