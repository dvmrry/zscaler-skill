  "schema_version": 1,
  "kind": "help-article",
  "title": "Editing or Deleting Threat Detection Policies",
  "source": {
    "url": "https://help.zscaler.com/itdr/editing-or-deleting-threat-detection-policies",
    "node": "1534844",
    "revision": "3162026",
    "updated": "2026-03-30",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete a threat detection policy that you configured in the Zscaler ITDR Admin Portal."
    },
    {
      "text": "Any changes made to a threat detection policy can take a few hours to reflect on the endpoints."
    },
    {
      "heading": "Editing a Threat Detection Policy",
      "level": 1
    },
    {
      "text": "To edit a threat detection policy:"
    },
    {
      "item": "Go to ITDR > Manage > Threat Detection.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          19
        ],
        [
          22,
          38
        ]
      ]
    },
    {
      "item": "Locate the threat detection policy you want to edit, and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          67,
          71
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the policy window, modify the policy configuration per your requirements. You can modify:",
      "depth": 0,
      "number": 3
    },
    {
      "item": "Policy Details",
      "depth": 1
    },
    {
      "item": "Endpoint Selection",
      "depth": 1
    },
    {
      "item": "Active Directory",
      "depth": 1
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting a Threat Detection Policy",
      "level": 1
    },
    {
      "text": "To delete a threat detection policy:"
    },
    {
      "item": "Go to ITDR > Manage > Threat Detection.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          19
        ],
        [
          22,
          38
        ]
      ]
    },
    {
      "item": "Locate the threat detection policy you want to delete, and click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          69,
          75
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Confirm your action when prompted.",
      "depth": 0,
      "number": 3
    },
    {
      "item": "A confirmation message appears indicating that the policy was deleted successfully.",
      "depth": 0
    },
    {
      "heading": "Deleting Selected Threat Detection Policies",
      "level": 1
    },
    {
      "text": "To delete selected threat detection policies:"
    },
    {
      "item": "Go to ITDR > Manage > Threat Detection.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          19
        ],
        [
          22,
          38
        ]
      ]
    },
    {
      "item": "Select the checkboxes next to the threat detection policies you want to delete.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Click Delete Selected.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          12
        ],
        [
          13,
          21
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The selected threat detection policies are deleted.",
      "depth": 0
    }
  ]
}
