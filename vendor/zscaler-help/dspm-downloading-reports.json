    {
      "text": "You can download reports related to alerts, data inventory, and policies to review and assess DSPM's performance in proactively monitoring and detecting sensitive data in your cloud resources."
    },
    {
      "text": "To download the reports:"
    },
    {
      "item": "From the navigation menu, go to Data Security > DSPM > Report Management.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          45
        ],
        [
          48,
          52
        ],
        [
          55,
          72
        ]
      ]
    },
    {
      "item": "You can view the following details:",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Downloads: The name of the report.",
      "depth": 1,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
      "item": "Report Type: The file format. Reports are available as Excel files only.",
      "depth": 1,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "Category: The type of report.",
      "depth": 1,
      "strong": [
        [
          0,
          8
        ]
      ]
    },
    {
      "item": "Generation Time: The date and time when the report was generated.",
      "depth": 1,
      "strong": [
        [
          0,
          15
        ]
      ]
    },
    {
      "item": "Status: The status of the report.",
      "depth": 1,
      "strong": [
        [
          0,
          6
        ]
      ]
    },
    {
      "item": "In Progress: When the report is being generated.",
      "depth": 2,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "Download: When the report is ready for download.",
      "depth": 2,
      "strong": [
        [
          0,
          8
        ]
      ]
    },
    {
      "item": "Click the Download icon for the required report and save the file on your local system.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          18
        ]
      ]
    }
  ]
