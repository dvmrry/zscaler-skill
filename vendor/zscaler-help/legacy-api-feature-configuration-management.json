        "ZPathConfigOverrideDTO": {
          "properties": {
            "id": {
              "type": "integer",
              "format": "int64",
              "description": "The unique identifier of the feature configuration.",
              "readOnly": true
            },
            "customerId": {
              "type": "integer",
              "description": "The unique identifier of the ZPA tenant.",
              "format": "int64"
            },
            "customerName": {
              "type": "string",
              "description": "The customer name of the feature configuration. This field is read only, and is applicable for only GET calls."
            },
            "targetType": {
              "type": "string",
              "description": "The target type of the feature configuration. The supported value is <code>feature_flag</code>."
            },
            "targetGid": {
              "type": "integer",
              "description": "The target GID of the feature configuration.",
              "format": "int64"
            },
            "targetName": {
              "type": "string",
              "description": "The name of the target."
            },
            "configKey": {
              "type": "string",
              "description": "The key for the feature configuration. The supported values are <code>config.feature.samesite_none</code> (refers to the SameSite Cookie Attribute option) and <code>config.feature.cors_enabled</code> (refers to the CORS Request option) when configuring authentication settings in ZPA. To learn more, see <a href =\"/zpa/configuring-feature-configurations-using-api\" target= _blank>Configuring Feature Configurations Using API</a>."
            },
            "configValue": {
              "type": "string",
              "description": "Indicates if the feature configuration is enabled (true) or disabled (false). This field must be passed with <code>configValueInt</code>."
            },
            "configValueInt": {
              "type": "integer",
              "description": "Indicates if the feature configuration is enabled (1) or disabled (0). This field must be passed with <code>configValue</code>.",
              "format": "int64"
            },
            "description": {
              "type": "string",
              "description": "The description of the feature configuration."
            },
            "modifiedTime": {
              "type": "integer",
              "description": "The time the feature configuration is modified.",
              "format": "int32",
              "readOnly": true
            },
            "creationTime": {
              "type": "integer",
              "description": "The time the feature configuration is created.",
              "format": "int32",
              "readOnly": true
            },
            "modifiedBy": {
              "type": "integer",
              "description": "The unique identifier of the tenant who modified the feature configuration.",
              "format": "int64",
              "readOnly": true
            },
            "brokerName": {
              "type": "string",
              "description": "The name of the Public or Private Service Edge."
            }
          }
        },
