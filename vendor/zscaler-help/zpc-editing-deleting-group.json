{
  "schema_version": 1,
  "kind": "help-article",
  "title": "Editing or Deleting a Group",
  "source": {
    "url": "https://help.zscaler.com/zpc/editing-deleting-group",
    "node": "1396786",
    "revision": "2442836",
    "updated": "2026-01-06",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "You can modify the group details and assign a different role and different set of business units to the group. All users in that group are assigned a new role and can view data or perform tasks on cloud accounts within the assigned business units."
    },
    {
      "heading": "Editing a Group",
      "level": 1
    },
    {
      "text": "To edit a group:"
    },
    {
      "item": "Go to Administration > Administrators and Groups.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          48
        ]
      ]
    },
    {
      "item": "On the Administrators and Groups page, select the Groups tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          32
        ],
        [
          50,
          56
        ]
      ]
    },
    {
      "item": "Click the Edit icon for the group that you want to edit.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the Edit Group window, change the Group Name, Role, Scope, enable or disable Single Sign-On, or update the Comments as required.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          17
        ],
        [
          37,
          47
        ],
        [
          49,
          53
        ],
        [
          55,
          60
        ],
        [
          80,
          94
        ],
        [
          110,
          118
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "A message appears indicating that the group has been updated successfully."
    },
    {
      "heading": "Deleting a Group",
      "level": 1
    },
    {
      "text": "To delete a group:"
    },
    {
      "item": "Go to Administration > Administrators and Groups.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          48
        ]
      ]
    },
    {
      "item": "On the Administrators and Groups page, select the Groups tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          32
        ],
        [
          50,
          56
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Click the Delete icon for the group that you want to delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "In the Delete Group window, click Delete.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          19
        ],
        [
          34,
          40
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "text": "If administrators are present in a group, then you need to move the administrators to other groups and then delete the selected group."
    },
    {
      "item": "In the Delete Group window, click Move Admins.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          7,
          19
        ],
        [
          34,
          45
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the Move Administrators window, select the required groups from the drop-down menu.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          26
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "A message appears indicating that the administrators have been moved to the new groups successfully."
    }
  ]
}
