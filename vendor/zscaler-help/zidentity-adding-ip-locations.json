    {
      "text": "This article describes how to add a single IP location. You can add up to 65,536 IP locations. You can also use a CSV file to import multiple locations."
    },
    {
      "text": "To add a location:"
    },
    {
      "item": "From the navigation menu, go to Administration > Authentication > Trusted IP Locations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          86
        ]
      ]
    },
    {
      "item": "On the Locations page, click Add Location.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          16
        ],
        [
          29,
          41
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Add Location drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          16
        ]
      ]
    },
    {
      "item": "In the Add Location drawer:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          19
        ]
      ]
    },
    {
      "item": "Name: Enter a name for the location.",
      "depth": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Country: Select the country of the IP location.",
      "depth": 1,
      "strong": [
        [
          0,
          7
        ]
      ]
    },
    {
      "item": "IP Address: Enter the IP address. You can add up to 2,048 IP addresses in this field.",
      "depth": 1,
      "strong": [
        [
          0,
          10
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
