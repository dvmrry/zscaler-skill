  "blocks": [
    {
      "text": "You can manage orchestration rules that you configured in the Zscaler ITDR Admin Portal."
    },
    {
      "heading": "Modifying Rule Priority",
      "level": 1
    },
    {
      "text": "The rule priority determines the order of how orchestration rules are processed."
    },
    {
      "text": "To modify the rule priority:"
    },
    {
      "item": "Go to Orchestrate > Rules.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          25
        ]
      ]
    },
    {
      "item": "Locate the rule that you want to modify, and drag its Priority value to the preferred position.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          54,
          62
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "A priority value is assigned only if the rule is enabled.",
      "depth": 0
    },
    {
      "heading": "Editing a Rule",
      "level": 1
    },
    {
      "text": "To edit a rule:"
    },
    {
      "item": "Go to Orchestrate > Rules.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          25
        ]
      ]
    },
    {
      "item": "Locate the rule that you want to modify, and click the Edit icon under the Actions column.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          55,
          59
        ],
        [
          75,
          82
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Rule Details window, modify the required fields.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          19
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting a Rule",
      "level": 1
    },
    {
      "text": "To delete a rule:"
    },
    {
      "item": "Go to Orchestrate > Rules.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          25
        ]
      ]
    },
    {
      "item": "Locate the rule that you want to delete, and click the Delete icon under the Actions column.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          55,
          61
        ],
        [
          77,
          84
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    }
  ]
}
