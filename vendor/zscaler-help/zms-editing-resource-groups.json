    {
      "text": "You can configure, edit, and delete resource groups at any time to provide flexibility in managing security posture."
    },
    {
      "text": "To edit a resource group:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > Resource Groups.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          86
        ]
      ]
    },
    {
      "item": "Click the Edit icon next to the resource group you want to edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Edit Resource Group window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          23
        ]
      ]
    },
    {
      "item": "In the Edit Resource Group window, edit the options as necessary. To learn more, see Configuring Resource Groups.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          26
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
