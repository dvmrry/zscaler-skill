  "schema_version": 1,
  "kind": "help-article",
  "title": "Editing or Deleting an IdP Configuration",
  "source": {
    "url": "https://help.zscaler.com/zpc/editing-or-deleting-idp-configuration",
    "node": "1402951",
    "revision": "2926461",
    "updated": "2026-01-06",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "You can edit or delete an IdP configuration you've configured."
    },
    {
      "text": "Only the Default Super Administrator has the permission to edit or delete an IdP configuration. Deleting an IdP configuration may result in SSO login failure."
    },
    {
      "heading": "Editing an IdP Configuration",
      "level": 1
    },
    {
      "text": "To edit an IdP configuration:"
    },
    {
      "item": "Go to Administration > Single Sign On.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          37
        ]
      ]
    },
    {
      "item": "On the Single Sign On page, click the Edit icon for the IdP that you wish to edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          21
        ],
        [
          38,
          42
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "text": "The Edit IdP Configuration window appears.",
      "strong": [
        [
          4,
          26
        ]
      ]
    },
    {
      "item": "In the Edit IdP Configuration window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          29
        ]
      ]
    },
    {
      "item": "Name, Identity Provider Issuer: Change the name or IP issuer.",
      "depth": 1,
      "strong": [
        [
          0,
          4
        ],
        [
          6,
          30
        ]
      ]
    },
    {
      "item": "Single sign-on URL: Change the single-sing-on (SSO) URL.",
      "depth": 1,
      "strong": [
        [
          0,
          18
        ]
      ]
    },
    {
      "item": "Login Name Attribute: Change the login name for the IdP.",
      "depth": 1,
      "strong": [
        [
          0,
          20
        ]
      ]
    },
    {
      "item": "Single Sign-On: By default, SSO is enabled for all users in the tenant. Disable the SSO if required.",
      "depth": 1,
      "strong": [
        [
          0,
          14
        ]
      ]
    },
    {
      "item": "Enable JIT: Select to enable or disable just-in-time (JIT) provisioning.",
      "depth": 1,
      "strong": [
        [
          0,
          10
        ]
      ]
    },
    {
      "item": "Auto Update group based on IdP: Select to allow the automatic update of user and user's group information from your IdP.",
      "depth": 1,
      "strong": [
        [
          0,
          30
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting an IdP Configuration",
      "level": 1
    },
    {
      "text": "To delete an IdP configuration:"
    },
    {
      "item": "Go to Administration > Single Sign On.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          37
        ]
      ]
    },
    {
      "item": "On the Single Sign On page, click the Delete icon for the IdP that you wish to edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          21
        ],
        [
          38,
          44
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "A confirmation message appears. Click Delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          38,
          44
        ]
      ]
    },
    {
      "text": "See image."
    }
  ]
}
