    {
      "text": "To delete a perimeter policy:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > Perimeter Policies.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          89
        ]
      ]
    },
    {
      "item": "Click the Delete icon for the perimeter policy you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Delete Perimeter Policy Rule window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          32
        ]
      ]
    },
    {
      "item": "In the Delete Perimeter Policy Rule window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          35
        ]
      ]
    },
    {
      "item": "Enter CONFIRM.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "Click Delete.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    }
  ]
}
