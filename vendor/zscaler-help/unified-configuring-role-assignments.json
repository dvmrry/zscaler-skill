  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "You can control access to the features in the Zscaler Admin Console by assigning roles to your administrators. After you create a role, assignments can be added to the role."
    },
    {
      "text": "To create a role assignment:"
    },
    {
      "item": "Go to Administration > Role Management > Role Management.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          38
        ],
        [
          41,
          56
        ]
      ]
    },
    {
      "item": "Find the role you want to create an assignment for, and click the number in the Assignments column for that role.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          80,
          91
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Assignments page for the role appears.",
      "depth": 0,
      "strong": [
        [
          4,
          15
        ]
      ]
    },
    {
      "item": "On the Assignments page, click Assign Members.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          18
        ],
        [
          31,
          45
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Create New Role Assignment drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          30
        ]
      ]
    },
    {
      "item": "In the Create New Role Assignment drawer:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          33
        ]
      ]
    },
    {
      "item": "Select either Users, User Groups, or API Clients.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          14,
          19
        ],
        [
          21,
          32
        ],
        [
          37,
          48
        ]
      ]
    },
    {
      "item": "Use the search bar to find and choose the user, user group, or API client you would like to make the assignment for.",
      "depth": 1,
      "number": 2
    },
    {
      "item": "Select the admin entitlements for which you want the role to apply.",
      "depth": 1,
      "number": 3
    },
    {
      "item": "Click Create.",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          6,
          13
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Activate the change.",
      "depth": 0,
      "number": 5
    }
  ]
}
