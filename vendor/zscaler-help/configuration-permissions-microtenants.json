  "captured_at": "2026-10-18",
  "blocks": [
    {
      "text": "Permissions for configurations in the Zscaler Admin Console can vary if you are using Microtenants for role-based administration control. Permissions are defined as follows:"
    },
    {
      "item": "Full: An admin or Microtenant has read or write access.",
      "depth": 0
    },
    {
      "item": "Read only: An admin or Microtenant has read-only access.",
      "depth": 0
    },
    {
      "item": "Read only*: An admin or Microtenant has read-only access, but can still perform actions on resources in specific scenarios.",
      "depth": 0
    },
    {
      "item": "Not visible: The configuration is not visible to the admin or Microtenant.",
      "depth": 0
    },
    {
