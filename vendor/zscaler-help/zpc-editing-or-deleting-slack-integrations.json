  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "From the Zscaler Posture Control (ZPC) Admin Portal, you can edit or delete any Slack integration as required."
    },
    {
      "heading": "Editing a Slack Integration",
      "level": 1
    },
    {
      "text": "To edit a Slack integration:"
    },
    {
      "item": "Go to Administration > Integrations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          35
        ]
      ]
    },
    {
      "item": "Under ChatOps (Slack), click the Edit icon for the Slack channel that you want to edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          21
        ],
        [
          33,
          37
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "On the Integration Details page:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          26
        ]
      ]
    },
    {
      "item": "Change the Integration Name.",
      "depth": 0,
      "strong": [
        [
          11,
          27
        ]
      ]
    },
    {
      "item": "Click Continue Editing if you want to add more channels.",
      "depth": 0,
      "strong": [
        [
          6,
          22
        ]
      ]
    },
    {
      "text": "You cannot edit the existing channel or Webhook details."
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Next.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "Review the integration details.",
      "depth": 0,
      "number": 5
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Finish.",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "heading": "Deleting a Slack Integration",
      "level": 1
    },
    {
      "text": "To delete a Slack integration:"
    },
    {
      "item": "Go to Administration > Integrations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          35
        ]
      ]
    },
    {
      "item": "Under ChatOps (Slack), click the Delete icon for the Slack integration that you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          21
        ],
        [
          33,
          39
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the Delete Integration window, read the message related to alert rules.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          25
        ]
      ]
    },
    {
      "text": "You cannot delete an integration if it is associated with alert rules. You must first move the alert rules to another integration."
    },
    {
      "text": "See image."
    },
    {
      "item": "After you've moved the alert rules, click Delete to delete the Slack integration.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          42,
          48
        ]
      ]
    }
  ]
}
