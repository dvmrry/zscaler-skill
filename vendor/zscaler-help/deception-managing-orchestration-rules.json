  "blocks": [
    {
      "text": "You can manage Zscaler Deception orchestration by editing or deleting rules, or pausing orchestration when needed."
    },
    {
      "heading": "Editing a Rule",
      "level": 1
    },
    {
      "text": "To edit a rule:"
    },
    {
      "item": "Go to Orchestrate > Rules.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          25
        ]
      ]
    },
    {
      "item": "Locate the rule that you want to modify, and click the Edit icon under the Actions column.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          55,
          59
        ],
        [
          75,
          82
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Rule Detail window, modify the required fields.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          18
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting a Rule",
      "level": 1
    },
    {
      "text": "To delete a rule:"
    },
    {
      "item": "Go to Orchestrate > Rules.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          25
        ]
      ]
    },
    {
      "item": "Locate the rule that you want to delete, and click the Delete icon under the Actions column.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          55,
          61
        ],
        [
          77,
          84
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "heading": "Pausing Orchestration",
      "level": 1
    },
    {
      "text": "You can pause orchestration to temporarily suspend orchestration rules without modifying their configuration."
    },
    {
      "text": "To pause orchestration:"
    },
    {
      "item": "Go to Orchestrate > Rules.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          25
        ]
      ]
    },
    {
      "item": "Click Pause Orchestration.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          25
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "text": "After pausing orchestration, no event is evaluated against any orchestration rules until the orchestration is resumed. To resume orchestration, click Resume Orchestration.",
      "strong": [
        [
          150,
          170
        ]
      ]
    },
    {
      "text": "See image."
    }
  ]
}
