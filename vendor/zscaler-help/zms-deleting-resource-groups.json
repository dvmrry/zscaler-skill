    {
      "text": "You can configure, edit, and delete resource groups at any time to provide flexibility in managing traffic that can change over time. To learn more, see About Resource Groups."
    },
    {
      "text": "To delete a resource group:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > Resource Groups.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          86
        ]
      ]
    },
    {
      "item": "Click the Delete icon next to the resource group you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Delete Resource Group window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          25
        ]
      ]
    },
    {
      "item": "In the Delete Resource Group window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          28
        ]
      ]
    },
    {
      "item": "Enter CONFIRM.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Delete.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    }
  ]
}
