  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit an existing or a saved query. But you can delete only saved investigation queries."
    },
    {
      "heading": "Editing an Investigation",
      "level": 1
    },
    {
      "text": "To edit an investigation query:"
    },
    {
      "item": "From the navigation menu, go to Data Security > DSPM > Investigation.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          45
        ],
        [
          48,
          52
        ],
        [
          55,
          68
        ]
      ]
    },
    {
      "item": "You can edit the investigation by using any of these options:",
      "depth": 0,
      "number": 2
    },
    {
      "item": "On the History tab:",
      "depth": 1,
      "strong": [
        [
          7,
          14
        ]
      ]
    },
    {
      "item": "Click the Query to view the drawer, then click the Edit icon at the top-right corner.",
      "depth": 2,
      "strong": [
        [
          10,
          15
        ],
        [
          51,
          55
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "Click the Actions icon () and select Open in Editor.",
      "depth": 2,
      "strong": [
        [
          10,
          17
        ],
        [
          37,
          51
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "On the Saved tab:",
      "depth": 1,
      "strong": [
        [
          7,
          12
        ]
      ]
    },
    {
      "item": "Click the Actions icon () and select Edit Query.",
      "depth": 2,
      "strong": [
        [
          10,
          17
        ],
        [
          37,
          47
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "Edit the query by adding or removing predicates, as required.",
      "depth": 0,
      "number": 3
    },
    {
      "item": "Click Run Query to view the results.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          15
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save Investigation to save the query.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          24
        ]
      ]
    },
    {
      "item": "Enter a name for the query.",
      "depth": 0,
      "number": 6
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 7,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting an Investigation",
      "level": 1
    },
    {
      "text": "You can delete only those investigations that you've saved."
    },
    {
      "text": "To delete an investigation:"
    },
    {
      "item": "Go to Data Security > DSPM > Investigation.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          19
        ],
        [
          22,
          26
        ],
        [
          29,
          42
        ]
      ]
    },
    {
      "item": "On the Investigation page, select the Saved tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          20
        ],
        [
          38,
          43
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "You can do the following:",
      "depth": 0,
      "number": 3
    },
    {
      "item": "Click the Actions icon () and select Delete.",
      "depth": 1,
      "strong": [
        [
          10,
          17
        ],
        [
          37,
          43
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click the Name or Query to view the drawer, then click the Delete icon.",
      "depth": 1,
      "strong": [
        [
          10,
          14
        ],
        [
          18,
          23
        ],
        [
          59,
          65
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Read the confirmation message, then click Delete.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          42,
          48
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The query is deleted.",
      "depth": 0
    }
  ]
}
