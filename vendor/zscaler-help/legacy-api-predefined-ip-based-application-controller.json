    "paths": {
      "/public/v2/predefined-ip-based-apps": {
        "get": {
          "summary": "List predefined IP-based applications",
          "description": "Retrieves a list of predefined IP-based applications with pagination support.",
          "tags": [
            "predefined-ip-based-application-controller"
          ],
          "operationId": "listPredefinedIPBasedApplications",
          "parameters": [
            {
              "name": "offset",
              "description": "Number of results to skip for pagination.",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 0
              }
            },
            {
              "name": "limit",
              "description": "Maximum number of results to return per page.",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 10
              }
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "description": "Response object containing an array of predefined IP-based applications and pagination metadata.",
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      },
      "/public/v2/predefined-ip-based-apps/{appId}": {
        "get": {
          "summary": "Get predefined IP-based application",
          "description": "Retrieves a specific predefined IP-based application by its ID.",
          "tags": [
            "predefined-ip-based-application-controller"
          ],
          "operationId": "getPredefinedIPBasedApplication",
          "parameters": [
            {
              "name": "appId",
              "description": "The unique identifier of the predefined IP-based application.",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "description": "Response object containing the predefined IP-based application details.",
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
