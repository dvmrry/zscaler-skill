              }
            }
          }
        },
        "ZPathAPIError": {
          "properties": {
            "reason": {
              "type": "string",
              "description": "The reason for the cause of the error status code. To learn more, see <a href=\"/zpa/api-response-codes-and-error-messages\" target= _blank>API Response Codes and Error Messages</a>."
            },
            "id": {
              "type": "string",
              "description": "The unique identifier of the error status code."
            },
            "params": {
              "type": "array",
              "description": "The parameters that were sent in the request body.",
              "items": {
                "type": "object"
              }
            },
            "hostname": {
              "type": "string",
              "description": "The client server address or domain name."
            }
          }
        },
        "EnrollmentCert": {
          "required": [
            "certificate",
            "name"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "description": "The unique identifier of the enrollment certificate.",
              "format": "int64"
            },
            "modifiedTime": {
              "type": "integer",
              "description": "The time the enrollment certificate is modified.",
              "format": "int32"
            },
            "creationTime": {
              "type": "integer",
              "description": "The time the enrollment certificate is created.",
              "format": "int32"
            },
            "modifiedBy": {
              "type": "integer",
              "description": "The unique identifier of the tenant who modified the enrollment certificate.",
              "format": "int64"
            },
            "microtenantId": {
              "type": "integer",
              "description": "The unique identifier of the Microtenant for the ZPA tenant. If you are within a Microtenant, you must pass the microtenantId field when making an API call to retrieve data from that Microtenant. The microtenantId can be obtained in the API Keys page, or can be obtained programmatically using the ZPA cloud service API. Access to certain operations are limited when you are within a Microtenant. If you are within the Default Microtenant, pass microtenantId as 0 when making requests to retrieve data from the Default Microtenant. If the microtenantId is not passed in the request when creating or updating a resource, then the resource is created or updated in the Default Microtenant.",
              "format": "int64"
            },
            "getcName": {
              "type": "string",
              "description": "This field is extracted from the enrollment certificate, and is not applicable for PUT and POST requests."
            },
            "validFromInEpochSec": {
              "type": "integer",
              "description": "The start date of the enrollment certificate. This field is extracted from the enrollment certificate, and is not applicable for PUT and POST requests.",
              "format": "int64"
            },
            "validToInEpochSec": {
              "type": "integer",
              "description": "The expiration date of the enrollment certificate. This field is extracted from the enrollment certificate, and is not applicable for PUT and POST requests.",
              "format": "int64"
            },
            "certificate": {
              "type": "string",
              "description": "The certificate text in PEM format."
            },
            "issuedTo": {
              "type": "string",
              "description": "The unique identifier of the tenant the enrollment certificate is issued to."
            },
            "issuedBy": {
              "type": "string",
              "description": "The unique identifier of the tenant the enrollment certificate is issued by."
            },
            "serialNo": {
              "type": "string",
              "description": "The serial number of the enrollment certificate."
            },
            "description": {
              "type": "string",
              "description": "The description of the enrollment certificate."
            },
            "name": {
              "type": "string",
              "description": "The name of the enrollment certificate."
            },
            "privateKey": {
              "type": "string",
              "description": "The private key of the enrollment certificate."
            },
            "zrsaencryptedprivatekey": {
              "type": "string",
              "description": "The RSA encrypted private key."
            },
            "zrsaencryptedsessionkey": {
              "type": "string",
              "description": "The RSA encrypted session key."
            },
            "allowSigning": {
              "type": "boolean",
              "description": "This field is extracted from the certificate and ignored in PUT and POST requests."
            },
            "parentCertId": {
              "type": "integer",
              "description": "The unique identifier of the parent certificate. This field has read-only properties, is only applicable for GET requests, and is ignored in PUT and POST requests.",
              "format": "int64"
            },
            "parentCertName": {
              "type": "string",
              "description": "The name of the parent certificate. This field has read-only properties, is only applicable for GET requests, and is ignored in PUT and POST requests."
            },
            "privateKeyPresent": {
              "type": "boolean",
              "description": "Indicates if the private key is present in the enrollment certificate. This field has read-only properties, is only applicable for GET requests, and is ignored in PUT and POST requests."
            },
            "clientCertType": {
              "type": "string",
              "description": "The client of the enrollment certificate. This field has read-only properties, is only applicable for GET requests, and is ignored in PUT and POST requests. The supported values are ZAPP_CLIENT (i.e., Zscaler Client Connector), ISOLATION_CLIENT (i.e., Isolation client), NONE (i.e., used for App Connector, ZPA Private Service Edge, Network Connector, and Private Cloud Controller enrollment), and AppProtection (i.e., AppProtection client).",
              "enum": [
                "ZAPP_CLIENT",
                "ISOLATION_CLIENT",
                "NONE",
                "APP_PROTECTION"
              ]
            },
            "csr": {
              "type": "string",
              "description": "The Certificate Signing Request (CSR) of the enrollment certificate."
            }
          }
        }
      }
    }
