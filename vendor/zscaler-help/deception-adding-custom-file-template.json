    {
      "text": "You can add a custom file template and use it as a baseline when adding dynamic file datasets. Before you can add a template, you must create a compressed (.zip) file that includes the template's files."
    },
    {
      "text": "To add a custom file template:"
    },
    {
      "item": "Go to Miragemaker > Files > File Templates.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          25
        ],
        [
          28,
          42
        ]
      ]
    },
    {
      "item": "Click Add Template.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          18
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the File Template Details window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          28
        ]
      ]
    },
    {
      "item": "Enter a Name for the template.",
      "depth": 1,
      "strong": [
        [
          8,
          12
        ]
      ]
    },
    {
      "item": "Click Upload and browse to upload the compressed (.zip) file.",
      "depth": 1,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "The custom file template is added.",
      "depth": 0
    },
    {
      "item": "See image.",
      "depth": 0
    }
  ]
}
