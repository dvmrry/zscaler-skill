            "nonceAssociationType": {
              "type": "string",
              "enum": [
                "ASSISTANT_GRP",
                "NP_ASSISTANT_GRP",
                "BROKER_GRP",
                "ZNF_GRP",
                "EDGE_CONNECTOR_GRP",
                "MACHINE_GRP",
                "BRANCH_CONNECTOR_GRP",
                "SITE_CONTROLLER_GRP",
                "ZVPN_GRP",
                "EXPORTER_GRP"
              ]
            },
            "tenantId": {
              "type": "integer",
              "format": "int64"
            },
            "userCodes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "zcomponentId": {
              "type": "integer",
