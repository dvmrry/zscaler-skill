    "components": {
      "schemas": {
        "UserCodeVerificationRequestDto": {
          "required": [
            "componentGroupId",
            "zcomponentId"
          ],
          "properties": {
            "componentGroupId": {
              "type": "integer",
              "format": "int64"
            },
            "configCloudName": {
              "type": "string"
            },
            "enrollmentServer": {
              "type": "string"
