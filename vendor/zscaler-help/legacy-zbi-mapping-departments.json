    {
      "text": "You can map departments to various divisions based on your requirements. You can add up to 32 divisions."
    },
    {
      "text": "To map departments:"
    },
    {
      "item": "Go to Workplace > Workplace Settings > Department Mapping.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          15
        ],
        [
          18,
          27
        ],
        [
          28,
          36
        ],
        [
          39,
          57
        ]
      ]
    },
    {
      "item": "Click Map Departments.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          21
        ]
      ]
    },
    {
      "item": "The Map Departments page appears.",
      "depth": 0,
      "strong": [
        [
          4,
          19
        ]
      ]
    },
    {
      "item": "On the Map Departments page:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          22
        ]
      ]
    },
    {
      "item": "Enter a name for the division in the first field.",
      "depth": 1
    },
    {
      "item": "Select the departments that you want to map to the division in the next field.",
      "depth": 1
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Add Division to map more departments.",
      "depth": 1,
      "strong": [
        [
          6,
          18
        ]
      ]
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "The departments are mapped to the division. You can start viewing workplace metrics based on the division.",
      "depth": 0
    }
  ]
}
