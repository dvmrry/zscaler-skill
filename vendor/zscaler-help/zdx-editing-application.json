    {
      "text": "To edit an application:"
    },
    {
      "item": "From the navigation menu, go to Digital Experience > Settings & Configurations > Probes, and select a collection or search for the application.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          50
        ],
        [
          53,
          78
        ],
        [
          81,
          87
        ]
      ]
    },
    {
      "item": "Under Actions, click Edit for the application you want to edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          21,
          25
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Edit Application drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          20
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Edit Application drawer, you can edit the following:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          23
        ]
      ]
    },
    {
      "item": "Name: Change the name of any custom application. You cannot change the name of predefined applications.",
      "depth": 1,
      "strong": [
        [
          0,
          5
        ]
      ]
    },
    {
      "item": "Status: Toggle to Enable or Disable the application.",
      "depth": 1,
      "strong": [
        [
          0,
          7
        ],
        [
          18,
          24
        ],
        [
          28,
          35
        ]
      ]
    },
    {
      "item": "Description: Change the description of the application.",
      "depth": 1,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "You cannot edit the Application type.",
      "depth": 1
    },
    {
      "item": "Click Update.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "Activate your changes.",
      "depth": 0,
      "number": 5
    }
  ]
}
