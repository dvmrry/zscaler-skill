      "item": "Click Add Tag.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Tag Details drawer, enter the name for the tag in the Name field.",
      "depth": 0,
      "number": 3,
      "strong": [
