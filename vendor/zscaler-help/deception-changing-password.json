    {
      "text": "You can change or reset your password for security reasons."
    },
    {
      "text": "To change the password:"
    },
    {
      "item": "Click the Account Settings icon () in the left-side navigation.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          10,
          26
        ]
      ]
    },
    {
      "item": "The Account Settings page opens.",
      "depth": 0,
      "strong": [
        [
          4,
          20
        ]
      ]
    },
    {
      "item": "On the Profile tab, under Change Password:",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          14
        ],
        [
          26,
          41
        ]
      ]
    },
    {
      "item": "Enter your current password.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "Enter your new password, and then confirm the new password.",
      "depth": 1,
      "number": 2
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "An estimator is used to determine the password strength. The color meter below New Password indicates the password strength. For example, a green line indicates a strong password and a red line indicates a weak password.",
      "depth": 0,
      "strong": [
        [
          79,
          91
        ]
      ]
    },
    {
      "item": "Click Change Password.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          21
        ]
      ]
    },
    {
      "item": "After the password is changed, you will receive a confirmation email.",
      "depth": 0
    }
  ]
