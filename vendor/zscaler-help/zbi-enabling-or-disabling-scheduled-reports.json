    {
      "text": "You can enable or disable scheduled reports based on your organization's requirements. Disabling a scheduled report stops report generation and distribution to the recipients and vice versa when you enable a report."
    },
    {
      "heading": "Enabling a Scheduled Report",
      "level": 1
    },
    {
      "text": "To enable a scheduled report:"
    },
    {
      "item": "From the navigation menu, go to Analytics > Reports > Business Insights Reports > Workplace Reports or Application Reports.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          41
        ],
        [
          44,
          51
        ],
        [
          54,
          71
        ],
        [
          72,
          79
        ],
        [
          82,
          99
        ],
        [
          103,
          122
        ]
      ]
    },
    {
      "item": "Locate the report you want to enable.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Select the Enabled option for the report.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          11,
          18
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The scheduled report is successfully enabled and resumes report distribution per the configuration.",
      "depth": 0
    },
    {
      "heading": "Disabling a Scheduled Report",
      "level": 1
    },
    {
      "text": "To disable a scheduled report:"
    },
    {
      "item": "From the navigation menu, go to Analytics > Reports > Business Insights Reports > Workplace Reports or Application Reports.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          41
        ],
        [
          44,
          51
        ],
        [
          54,
          71
        ],
        [
          72,
          79
        ],
        [
          82,
          99
        ],
        [
          103,
          122
        ]
      ]
    },
    {
      "item": "Locate the report you want to disable.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Deselect the Enabled option for the report.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          13,
          20
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The scheduled report is successfully disabled and halts report distribution until enabled.",
      "depth": 0
    }
  ]
