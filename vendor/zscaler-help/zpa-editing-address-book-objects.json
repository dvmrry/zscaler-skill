    {
      "item": "Go to Private Access > VPN (for Legacy Apps) > VPN Access Policy IP Address.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          75
        ]
      ]
    },
    {
      "item": "Locate the IP address object you want to edit, and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          61,
          65
        ]
      ]
    },
    {
      "item": "On the Edit IP Address Object page, modify fields as necessary. For more information about each field, see Configuring IP Address Objects.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          29
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
