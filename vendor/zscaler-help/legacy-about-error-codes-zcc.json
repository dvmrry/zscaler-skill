    {
      "text": "The following table lists the HTTP status codes returned by the Zscaler Client Connector API:"
    },
    {
      "table": [
        [
          "Code",
          "Description"
        ],
        [
          "200",
          "Successful"
        ],
        [
          "400",
          "Bad Request"
        ],
        [
          "401",
          "Unauthorized"
        ],
        [
          "403",
          "Forbidden"
        ],
        [
          "404",
          "Not Found"
        ],
        [
          "415",
          "Unsupported Media Type"
        ],
        [
          "429",
          "Too Many Requests The user has sent too many requests in a given amount of time and exceeded the rate limit or device threshold. To learn more, see Understanding Rate Limiting."
        ],
        [
          "500",
          "Not Implemented"
        ]
      ]
    }
  ]
}
