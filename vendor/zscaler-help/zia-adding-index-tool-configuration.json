    {
      "text": "To add an Index Tool configuration:"
    },
    {
      "item": "Go to Data Security > Common Resources > Index Tool.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          19
        ],
        [
          22,
          38
        ],
        [
          41,
          51
        ]
      ]
    },
    {
      "item": "Click Add Index Tool Configuration.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          34
        ]
      ]
    },
    {
      "text": "The Add Index Tool Configuration window appears.",
      "strong": [
        [
          4,
          32
        ]
      ]
    },
    {
      "item": "In the Add Index Tool Configuration window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          35
        ]
      ]
    },
    {
      "item": "VM Name: Enter a unique name for the virtual machine (VM).",
      "depth": 1,
      "strong": [
        [
          0,
          7
        ]
      ]
    },
    {
      "item": "Status: Make sure that the VM is Enabled.",
      "depth": 1,
      "strong": [
        [
          0,
          6
        ],
        [
          33,
          40
        ]
      ]
    },
    {
      "item": "Enable Single Sign-On: Select Enabled if you are configuring single sign-on (SSO) for the Index Tool. To learn more, see Configuring Single Sign-On for the Index Tool.",
      "depth": 1,
      "strong": [
        [
          0,
          21
        ],
        [
          30,
          37
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save and activate the change.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "After you save, you can download the SSL certificate for the configuration from the Index Tool page or from the Edit Index Tool Configuration window.",
      "depth": 0
    }
  ]
}
