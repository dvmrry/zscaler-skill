    {
      "text": "The Alert Status provides details on the current status of an alert. The alert status can be seen in the Alerts Overview, Ongoing Alerts, Alert History, and View Alert pages. To learn more, see About Alerts."
    },
    {
      "text": "An alert status can be:"
    },
    {
      "item": "Started: The alert has started.",
      "depth": 0,
      "strong": [
        [
          0,
          7
        ]
      ]
    },
    {
      "item": "Ongoing: The alert is ongoing.",
      "depth": 0,
      "strong": [
        [
          0,
          7
        ]
      ]
    },
    {
      "item": "Completed: The alert is completed.",
      "depth": 0,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
      "item": "Completed by Exceeded Time: The alert ended due to an expired time duration.",
      "depth": 0,
      "strong": [
        [
          0,
          26
        ]
      ]
    },
    {
      "item": "Completed by Rule Deletion: The alert ended due to a rule deletion.",
      "depth": 0,
      "strong": [
        [
          0,
          26
        ]
      ]
    },
    {
      "item": "Completed by Modified Rule: The alert ended due to a modification of the rule.",
      "depth": 0,
      "strong": [
        [
          0,
          26
        ]
      ]
    }
  ]
}
