    {
      "text": "You can modify or delete AI App Settings or Connection Settings from the Settings tab.",
      "strong": [
        [
          73,
          81
        ]
      ]
    },
    {
      "text": "To modify an existing AI App or connection setting, do the following:"
    },
    {
      "item": "Go to AI Infrastructure > AI Red Teaming > Overview.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          23
        ],
        [
          26,
          40
        ],
        [
          43,
          51
        ]
      ]
    },
    {
      "item": "Select the AI App from the Name & Business Unit column.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          27,
          47
        ]
      ]
    },
    {
      "item": "On the detailed information page, select Settings () icon.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          41,
          52
        ]
      ]
    },
    {
      "item": "Select any of the following options:",
      "depth": 0,
      "number": 4
    },
    {
      "item": "AI App Settings: To modify the AI App settings.",
      "depth": 1,
      "strong": [
        [
          0,
          15
        ]
      ]
    },
    {
      "item": "Connection Settings: To modify the connection settings.",
      "depth": 1,
      "strong": [
        [
          0,
          19
        ]
      ]
    },
    {
      "item": "Probe Settings: To modify probe settings. You can also create a new probe from this page. To learn more, see Configuring Probes.",
      "depth": 1,
      "strong": [
        [
          0,
          14
        ]
      ]
    },
    {
      "item": "Edit the required fields.",
      "depth": 0,
      "number": 5
    },
    {
      "item": "Click Update.",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          6,
          12
        ]
      ]
    }
  ]
}
