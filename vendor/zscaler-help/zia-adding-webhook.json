    {
      "text": "Webhook configuration in the Zscaler Admin Console allows you to deliver alerts for the configured events in the alert rule to third-party applications (e.g., ServiceNow, Splunk) for incident management. The feature comprises two parts:"
    },
    {
      "item": "Creating a webhook",
      "depth": 0,
      "number": 1
    },
    {
      "item": "Associating the webhook with the alert rules",
      "depth": 0,
      "number": 2
    },
    {
      "text": "To add a webhook:"
    },
    {
      "item": "From the navigation menu, go to Administration > Alerts > Security & UEBA Alerts > Webhooks.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          46
        ],
        [
          49,
          55
        ],
        [
          58,
          80
        ],
        [
          83,
          91
        ]
      ]
    },
    {
      "item": "Click Add Webhook.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          17
        ]
      ]
    },
    {
      "item": "The Add Webhook window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          15
        ]
      ]
    },
    {
      "item": "In the Add Webhook window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          18
        ]
      ]
    },
    {
      "item": "Name: Enter a name for the webhook.",
      "depth": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Status: Choose Disabled to disable the webhook. By default, the field is Enabled.",
      "depth": 1,
      "strong": [
        [
          0,
          6
        ],
        [
          15,
          23
        ],
        [
          73,
          80
        ]
      ]
    },
    {
      "item": "URL: Enter the URL of the webhook provider.",
      "depth": 1,
      "strong": [
        [
          0,
          3
        ]
      ]
    },
    {
      "item": "Authentication Type: Choose either Basic or Token for authentication. The webhook provider determines the authentication type used. Refer to your provider for details.",
      "depth": 1,
      "strong": [
        [
          0,
          19
        ],
        [
          35,
          40
        ],
        [
          44,
          49
        ]
      ]
    },
    {
      "item": "For Basic, enter the Username and Password.",
      "depth": 2,
      "strong": [
        [
          4,
          9
        ],
        [
          21,
          29
        ],
        [
          34,
          42
        ]
      ]
    },
    {
      "item": "For Token, enter the Bearer Token. A bearer token is a unique alphanumeric string used for authentication. You can obtain the bearer token from your webhook provider.",
      "depth": 2,
      "strong": [
        [
          4,
          9
        ],
        [
          21,
          33
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Test Webhook to check the configuration.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          18
        ]
      ]
    },
    {
      "item": "If the test is successful, a message indicating success appears.",
      "depth": 0,
      "number": 5
    },
    {
      "item": "Click Save and activate the change.",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
