  "schema_version": 1,
  "kind": "help-article",
  "title": "Editing or Deleting a Safe Process",
  "source": {
    "url": "https://help.zscaler.com/itdr/editing-or-deleting-safe-process",
    "node": "1534821",
    "revision": "3162043",
    "updated": "2026-03-30",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete a safe process that you configured in the Zscaler ITDR Admin Portal."
    },
    {
      "heading": "Editing a Safe Process",
      "level": 1
    },
    {
      "text": "To edit a safe process:"
    },
    {
      "item": "Go to Settings > Endpoint Settings > Safe Processes.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          34
        ],
        [
          37,
          51
        ]
      ]
    },
    {
      "item": "In the table, select the safe process you want to modify, and then click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          77,
          81
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Safe Process Details window, modify the fields as necessary.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          27
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "For internal safe processes, only the option to enable or disable is supported."
    },
    {
      "heading": "Deleting a Safe Process",
      "level": 1
    },
    {
      "text": "To delete a safe process:"
    },
    {
      "item": "Go to Settings > Endpoint Settings > Safe Processes.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          34
        ],
        [
          37,
          51
        ]
      ]
    },
    {
      "item": "In the table, select the safe process you want to delete, and then click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          77,
          83
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "item": "A confirmation message appears indicating that the safe process is deleted.",
      "depth": 0
    },
    {
      "text": "Internal safe processes cannot be deleted."
    }
  ]
}
