    {
      "text": "You can edit or delete a strategy that you configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a Strategy",
      "level": 1
    },
    {
      "text": "To edit a strategy:"
    },
    {
      "item": "Go to Miragemaker > Strategy Builder > Deception Strategy.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          36
        ],
        [
          39,
          57
        ]
      ]
    },
    {
      "item": "Under Actions, click the Edit icon for the Deception strategy you want to modify.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          29
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the Strategy Detail window, modify the required fields on each tab, and then click Validate.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          22
        ],
        [
          86,
          94
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "heading": "Deleting a Strategy",
      "level": 1
    },
    {
      "text": "To delete a strategy:"
    },
    {
      "item": "Go to Miragemaker > Strategy Builder > Deception Strategy.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          36
        ],
        [
          39,
          57
        ]
      ]
    },
    {
      "item": "Under Actions, click the Delete icon for the Deception strategy you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          31
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    }
  ]
