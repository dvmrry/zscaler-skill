    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "You can edit or delete the ignore filters that you've set up for alerts."
    },
    {
      "heading": "Editing an Ignore Filter",
      "level": 1
    },
    {
      "text": "To edit an ignore filter:"
    },
    {
      "item": "In the left-side navigation, select Alerts.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          36,
          42
        ]
      ]
    },
    {
      "item": "On the Alerts page, click Ignore Filters.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          13
        ],
        [
          26,
          40
        ]
      ]
    },
    {
      "item": "Under Actions, select the Actions icon () for the filter you want to edit.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          13
        ],
        [
          26,
          33
        ]
      ]
    },
    {
      "item": "Click Edit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "On the General Information page, change the Ignore Filter Name or Filter Description as required, then click Next.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          7,
          26
        ],
        [
          44,
          62
        ],
        [
          66,
          84
        ],
        [
          109,
          113
        ]
      ]
    },
    {
      "item": "Update the details on the Filter Scope page as required, then click Next.",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          26,
          38
        ],
        [
          68,
          72
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Review the changes and click Finish.",
      "depth": 0,
      "number": 7,
      "strong": [
        [
          29,
          35
        ]
      ]
    },
    {
      "heading": "Deleting an Ignore Filter",
      "level": 1
    },
    {
      "text": "To delete an ignore filter:"
    },
    {
      "item": "In the left-side navigation, select Alerts.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          36,
          42
        ]
      ]
    },
    {
      "item": "On the Alerts page, click Ignore Filters.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          13
        ],
        [
          26,
          40
        ]
      ]
    },
    {
      "item": "Under Actions, select the Actions icon () for the filter you want to edit.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          13
        ],
        [
          26,
          33
        ]
      ]
    },
    {
      "item": "Click Delete.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "A confirmation message appears. Click Delete.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          38,
          44
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "text": "The deleted filter is not applicable to any newly triggered alert. Existing ignored alerts under this filter will remain ignored even after deleting the filter."
    }
  ]
}
