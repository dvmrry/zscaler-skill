      "text": "You can schedule Data Explorer reports for your customized views."
    },
    {
      "text": "To schedule a report:"
    },
    {
      "item": "From the navigation menu, go to Analytics > Business Insights > Data Explorer.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          41
        ],
        [
          44,
          61
        ],
        [
          64,
          68
        ],
        [
          69,
          77
        ]
      ]
    },
    {
      "item": "Configure a Data Explorer view.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Click Save and Schedule.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          23
        ]
      ]
    },
    {
      "item": "The Save Report drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          15
        ]
      ]
    },
    {
      "item": "In the Save Report window:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          18
        ]
      ]
    },
    {
      "item": "Report Name: Enter a name for the scheduled report.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "Schedule Report: Enable to activate the report.",
