  "spec": {
    "swagger": "2.0",
    "info": {
      "version": "v1",
      "title": "ZIA Cloud Service and Sandbox Submission APIs",
      "description": "API Reference Guide for the ZIA Cloud Service and Sandbox Submission APIs\n"
    },
    "host": "zsapi.[zscaler-cloud-name]",
    "basePath": "/api/v1",
    "schemes": [
      "https"
    ],
    "tags": [
      {
        "name": "Root Certificates"
      }
    ],
    "paths": {
      "/rootCertificates": {
        "get": {
          "tags": [
            "Root Certificates"
          ],
          "description": "Retrieves a list of all configured root certificates for third-party proxy-chaining services and isolation profiles. To learn more, see <a href=\"/zia/about-root-certificates\" target=\"_blank\">About Root Certificates</a>.",
          "operationId": "RootCertificateResource_getCerts",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "certTypes",
              "in": "query",
              "description": "The type of root certificate",
              "required": false,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "PROXY_CHAINING",
                  "BROWSER_ISOLATION"
                ]
              },
              "collectionFormat": "multi"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/SslCertificate"
                }
              }
            }
          }
        },
        "post": {
          "tags": [
            "Root Certificates"
          ],
          "description": "Adds a custom root certificate for a third-party proxy-chaining service or isolation profile. To learn more, see <a href=\"/zia/adding-root-certificates\" target=\"_blank\">Adding Root Certificates</a>.",
          "operationId": "RootCertificateResource_createRootCertificate",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "in": "body",
              "name": "body",
              "description": "Information about the certificate",
              "required": false,
              "schema": {
                "$ref": "#/definitions/SslCertificate"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/SslCertificate"
              }
            },
            "201": {
              "description": "Created"
            },
            "400": {
              "description": "<p>If the file upload fails, one of the following responses is displayed: <ul> <li>Invalid request format</li> <li>Invalid file name</li> <li>No file selected</li> <li>Unsupported file format</li> <li>File size cannot exceed 64K</li> <li>Certificate has already expired</li> <li>Certificate not yet valid</li> <li>Invalid certificate contents, certificate and key do not match</li> <li>No CSR found</li> <li>Certificate cannot be parsed properly</li> <li>Not a valid root certificate</li> <li>Error in certificate format</li> </ul></p>\n"
            },
            "401": {
              "description": "Unauthorized"
            },
            "403": {
              "description": "Forbidden"
            }
          }
        }
      },
      "/rootCertificates/certDetail/{rootCertId}": {
        "get": {
          "tags": [
            "Root Certificates"
          ],
          "description": "Retrieves the root certificate for third-party proxy-chaining services or isolation profiles based on the specified root certificate ID",
          "operationId": "RootCertificateResource_showCert",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "rootCertId",
              "in": "path",
              "description": "Unique identifier for the root certificate",
              "required": true,
              "type": "string"
            },
            {
              "name": "certTypes",
              "in": "query",
              "description": "The type of root certificate",
              "required": false,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "PROXY_CHAINING",
                  "BROWSER_ISOLATION"
                ]
              },
              "collectionFormat": "multi"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/CustomCertificate"
              }
            }
          }
        }
      },
      "/rootCertificates/{rootCertId}": {
        "put": {
          "tags": [
            "Root Certificates"
          ],
          "description": "Updates the root certificate based on the specified root certificate ID",
          "operationId": "RootCertificateResource_updateRootCertificate",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "rootCertId",
              "in": "path",
              "description": "Unique identifier for the root certificate",
              "required": true,
              "type": "string"
            },
            {
              "in": "body",
              "name": "body",
              "description": "Information about the certificate",
              "required": false,
              "schema": {
                "$ref": "#/definitions/SslCertificate"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/SslCertificate"
              }
            }
          }
        },
        "delete": {
          "tags": [
            "Root Certificates"
          ],
          "description": "Deletes the root certificate based on the specified root certificate ID",
          "operationId": "RootCertificateResource_deleteCert",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "rootCertId",
              "in": "path",
              "description": "Unique identifier for the root certificate",
              "required": true,
              "type": "string"
            },
            {
              "name": "certTypes",
              "in": "query",
              "description": "The type of root certificate",
              "required": false,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "PROXY_CHAINING",
                  "BROWSER_ISOLATION"
                ]
              },
              "collectionFormat": "multi"
            }
          ],
          "responses": {
            "204": {
              "description": "Successful Operation"
            },
            "401": {
              "description": "Unauthorized"
            },
            "403": {
              "description": "Forbidden"
            },
            "404": {
              "description": "Not Found"
            }
          }
        }
      }
    },
    "definitions": {
      "SslCertificate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "System-generated identifier for the certificate"
          },
          "name": {
            "type": "string",
            "description": "Name of the certificate"
          },
          "cert": {
            "type": "string",
            "description": "The required root certificate that you want to upload from your system"
          },
          "createTime": {
            "type": "integer",
            "format": "int32",
            "description": "Timestamp of when the root certificate was created"
          },
          "lastModifiedTime": {
            "type": "integer",
            "format": "int32",
            "description": "Timestamp of when the root certificate was last modified"
          },
          "expiryTime": {
            "type": "integer",
            "format": "int64",
            "description": "The certificate expiration time"
          },
          "displayName": {
            "type": "string",
            "description": "The certificate display name"
          },
          "isolationCertificateId": {
            "type": "string",
            "description": "The isolation certificate ID"
          },
          "isDefault": {
            "type": "boolean",
            "description": "A Boolean value that indicates whether any of the root certificates is a default root certificate"
          },
          "certTypes": {
            "type": "array",
            "description": "The root certificate type",
            "items": {
              "type": "string",
              "enum": [
                "PROXY_CHAINING",
                "BROWSER_ISOLATION"
              ]
            }
          }
        }
      },
