    {
      "text": "You can enable phased updates for the landmine agents to selectively roll out the updates using agent update groups."
    },
    {
      "text": "To enable the phased updates:"
    },
    {
      "item": "Go to Settings > Endpoint Settings > Agent Update Groups.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          34
        ],
        [
          37,
          56
        ]
      ]
    },
    {
      "item": "Click Enable Phased Updates.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          27
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "text": "Enabling this feature stops any automatic updates for agents that are not a part of the groups."
    }
  ]
}
