    {
      "text": "AI Security scans your Microsoft Azure cloud accounts to detect vulnerabilities."
    },
    {
      "item": "AI Security supports the scanning of workloads that are created from images present in Azure Compute Gallery and Azure Marketplace.",
      "depth": 0
    },
    {
      "item": "AI Security does not support the vulnerability scanning of Azure workloads created from unmanaged OS disks (.vhd).",
      "depth": 0
    },
    {
      "heading": "Supported Regions",
      "level": 2
    },
