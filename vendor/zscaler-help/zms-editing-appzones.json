    {
      "text": "Admins can configure, edit, and delete AppZones as needed."
    },
    {
      "text": "To edit an AppZone:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > App Zones.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          80
        ]
      ]
    },
    {
      "item": "Click the Edit icon for the AppZone you want to edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "item": "The Edit AppZone wizard appears.",
      "depth": 0,
      "strong": [
        [
          4,
          16
        ]
      ]
    },
    {
      "item": "In the Edit AppZone wizard, modify the information as necessary. To learn more, see Configuring AppZones.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          19
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "Your updated AppZone appears in the list of AppZones."
    }
  ]
}
