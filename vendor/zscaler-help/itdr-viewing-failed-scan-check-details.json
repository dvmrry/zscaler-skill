    {
      "text": "After you scan an Active Directory (AD) domain, you can view the details of failed scan checks, if any."
    },
    {
      "text": "To view the details of failed scan checks:"
    },
    {
      "item": "Go to ITDR > Manage > Active Directory Posture.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          19
        ],
        [
          22,
          46
        ]
      ]
    },
    {
      "item": "For a scanned AD Domain whose Last Scan Status is Scan Completed and some of the scan checks have failed, click the fractional number. For example, click 18/31, which indicates that 18 scan checks out of 31 have failed.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          30,
          46
        ],
        [
          50,
          64
        ],
        [
          154,
          159
        ]
      ]
    },
    {
      "text": "The Failed Scans window appears with the following information:",
      "strong": [
        [
          4,
          16
        ]
      ]
    },
    {
      "item": "Name: The name of the scan check that failed.",
      "depth": 0,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Type: The type of failure.",
      "depth": 0,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Reason: The reason for failure.",
      "depth": 0,
      "strong": [
        [
          0,
          6
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Close.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          11
        ]
      ]
    }
  ]
}
