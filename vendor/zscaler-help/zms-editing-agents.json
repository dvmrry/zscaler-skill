  "blocks": [
    {
      "text": "Admins can edit and delete agents as needed."
    },
    {
      "text": "To edit an agent:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > Agents.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          77
        ]
      ]
    },
    {
      "item": "Click the Edit icon next to the agent you want to edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Edit <Agent Name> drawer opens.",
      "depth": 0,
      "strong": [
        [
          4,
          21
        ]
      ]
    },
    {
      "item": "In the Edit <Agent Name> drawer:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          24
        ]
      ]
    },
    {
      "item": "Name: Edit the name of the agent.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Admin Status: (Optional) Select Enabled, Disabled, or Inherit From Group.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          0,
          12
        ],
        [
          32,
          39
        ],
        [
          41,
          49
        ],
        [
          54,
          72
        ]
      ]
    },
    {
      "item": "Tamper Protection Status: (Optional) Select Disabled or Inherit From Group.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          0,
          24
        ],
        [
          44,
          52
        ],
        [
          56,
          74
        ]
      ]
    },
    {
      "item": "Policy Status: (Optional) Enable or disable the policy status.",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          0,
          13
        ]
      ]
    },
    {
      "item": "Description: (Optional) Edit the description.",
      "depth": 1,
      "number": 5,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "You cannot edit the additional information. Review it as necessary.",
      "depth": 0
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "Your updated agent appears in the list of Agents."
    }
  ]
}
