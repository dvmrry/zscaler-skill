    {
      "text": "You can add resources for which you define and set up policy rules. The admins can perform the following operations:"
    },
    {
      "item": "Adding a Printer Resource",
      "depth": 0
    },
    {
      "item": "From the navigation menu, go to Data Security > Endpoint DLP > Endpoint Data Scan > Resources > Printers.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          32,
          45
        ],
        [
          48,
          60
        ],
        [
          63,
          81
        ],
        [
          84,
          93
        ],
        [
          96,
          104
        ]
      ]
    },
    {
      "item": "Click Add.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          9
        ]
      ]
    },
    {
      "item": "The New Printer Resource drawer appears.",
      "depth": 1,
      "strong": [
        [
          4,
          24
        ]
      ]
    },
    {
      "item": "In the New Printer Resource drawer:",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          7,
          27
        ]
      ]
    },
    {
      "item": "Name: Enter a name for the device.",
      "depth": 2,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Description: Enter a description for the device.",
      "depth": 2,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "Add Criteria: Select one or all of the following options:",
      "depth": 2,
      "strong": [
        [
          0,
          12
        ]
      ]
    },
    {
      "item": "IP Address: Enter the IP Address or CIDR for the printer resource.",
      "depth": 3,
      "strong": [
        [
          0,
          10
        ]
      ]
    },
    {
      "item": "UNC Path: Enter the UNC path for the printer resource.",
      "depth": 3,
      "strong": [
        [
          0,
          8
        ]
      ]
    },
    {
      "item": "See Image.",
      "depth": 1
    },
    {
      "item": "Click Save and activate the change.",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
