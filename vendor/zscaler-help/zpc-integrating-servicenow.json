    {
      "text": "ZPC leverages ServiceNow APIs to automatically create tickets when a misconfiguration is detected. You can integrate ZPC with ServiceNow to create incidents on ServiceNow whenever a security policy violation occurs on the selected cloud accounts."
    },
    {
      "text": "Ensure that your ServiceNow instance is online."
    },
    {
      "heading": "Integrating with ServiceNow",
      "level": 1
    },
    {
      "text": "To integrate ZPC with ServiceNow:"
    },
    {
      "item": "Go to Administration > Integrations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          35
        ]
      ]
    },
    {
      "item": "Under ITSM Integrations, click Add.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          23
        ],
        [
          31,
          34
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Under Integration Information:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          29
        ]
      ]
    },
    {
      "item": "For Integration Name, enter a unique name for the integration.",
      "depth": 1,
      "strong": [
        [
          4,
          20
        ]
      ]
    },
    {
      "item": "For IT Service, select ServiceNow.",
      "depth": 1,
      "strong": [
        [
          4,
          14
        ],
        [
          23,
          33
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Next.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "Under ITSM Details:",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          18
        ]
      ]
    },
    {
      "item": "For ServiceNow Hostname, enter the ServiceNow hostname.",
      "depth": 1,
      "strong": [
        [
          4,
          23
        ]
      ]
    },
    {
      "item": "For ServiceNow Username, enter the username for ServiceNow.",
      "depth": 1,
      "strong": [
        [
          4,
          23
        ]
      ]
    },
    {
      "item": "For ServiceNow Password, enter the password for ServiceNow.",
      "depth": 1,
      "strong": [
        [
          4,
          23
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Test Connection to validate the ServiceNow connection. A confirmation message appears if the connection is successful. If not, then check the previous steps and try again. To learn more, see the ServiceNow Guide.",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          6,
          21
        ]
      ]
    },
    {
      "item": "If you need to reset the validation, click Reset Validation, if not, click Next.",
      "depth": 0,
      "number": 7,
      "strong": [
        [
          43,
          59
        ],
        [
          75,
          79
        ]
      ]
    },
    {
      "item": "Review the integration details on the Summary page. Click the Edit icon if you want to make any changes.",
      "depth": 0,
      "number": 8,
      "strong": [
        [
          38,
          45
        ],
        [
          62,
          66
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Finish.",
      "depth": 0,
      "number": 9,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The integration is added and the details are displayed on the Integrations page.",
      "strong": [
        [
          62,
          74
        ]
      ]
    }
  ]
}
