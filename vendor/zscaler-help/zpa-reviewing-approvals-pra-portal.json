  "schema_version": 1,
  "kind": "help-article",
  "title": "Reviewing Approvals in the PRA Portal",
  "source": {
    "url": "https://help.zscaler.com/zpa/reviewing-approvals-pra-portal",
    "node": "1520626",
    "revision": "3248801",
    "updated": "2026-10-23",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "After the admin has enabled privileged approvals in a portals policy, you can access the My Approvals page in the PRA Portal. You can review, approve, and reject requested approvals."
    },
    {
      "text": "To learn more about Privileged Remote Access (PRA), see Understanding Privileged Remote Access. To set up PRA, see Step-by-Step Configuration Guide for Privileged Remote Access."
    },
    {
      "heading": "Approving an Approval Request",
      "level": 1
    },
    {
      "text": "To approve a privileged approval request:"
    },
    {
      "item": "Click the My Approvals icon on the PRA Portal home page.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          10,
          22
        ]
      ]
    },
    {
      "item": "Click the My Approvals tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          22
        ]
      ]
    },
    {
      "item": "Click the Approve icon next to the approval request.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          17
        ]
      ]
    },
    {
      "text": "The Approve Request window appears.",
      "strong": [
        [
          4,
          19
        ]
      ]
    },
    {
      "item": "In the Approve Request window:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          22
        ]
      ]
    },
    {
      "item": "Review the approval request information.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "Enable Modify Time if you want to adjust the time window of the request.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          7,
          18
        ]
      ]
    },
    {
      "item": "(Optional) You can include a message to the requester.",
      "depth": 1,
      "number": 3
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Approve.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          13
        ]
      ]
    },
    {
      "text": "The approval request is displayed as Approved on the My Approvals page."
    },
    {
      "heading": "Rejecting an Approval Request",
      "level": 1
    },
    {
      "text": "To reject an approval request:"
    },
    {
      "item": "Click the My Approvals icon on the PRA Portal home page.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          10,
          22
        ]
      ]
    },
    {
      "item": "Click the My Approvals tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          22
        ]
      ]
    },
    {
      "item": "Click the Reject icon next to the approval request.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "text": "The Reject Request window appears.",
      "strong": [
        [
          4,
          18
        ]
      ]
    },
    {
      "item": "In the Reject Request window:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          21
        ]
      ]
    },
    {
      "item": "Review the approval request information.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "(Optional) You can include a message to the requester.",
      "depth": 1,
      "number": 2
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Reject.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The approval request is displayed as Rejected on the My Approvals page."
    }
  ]
}
