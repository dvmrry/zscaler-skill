    {
      "text": "Custom namespaces allow admins to specify the keys and values they want for certain tags. While you cannot edit or delete cloud and machine learning (ML) namespaces, you can edit and delete custom namespaces."
    },
    {
      "heading": "Prerequisites",
      "level": 1
    },
    {
      "text": "Enable policy enforcement for your organization. To learn more, see Enabling Microsegmentation Policy Settings."
    },
    {
      "heading": "Editing Custom Namespaces",
      "level": 1
    },
    {
      "text": "To edit a custom namespace for a tag:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > Tag Management.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          85
        ]
      ]
    },
    {
      "item": "Click the More icon (vertical ellipsis) on the chosen namespace.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "item": "Click Edit.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Edit Namespace drawer opens.",
      "depth": 0,
      "strong": [
        [
          4,
          18
        ]
      ]
    },
    {
      "item": "In the Edit Namespace drawer window:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          21
        ]
      ]
    },
    {
      "item": "Name: Edit the text to change the name of the custom namespace.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Description: (Optional) Add or remove information that describes the namespace.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Save.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "The page reloads and the changes to your custom namespace appear in the list."
    }
  ]
}
