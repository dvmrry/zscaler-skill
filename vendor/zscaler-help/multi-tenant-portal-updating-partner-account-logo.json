  "kind": "help-article",
  "title": "Updating Partner Account Logo",
  "source": {
    "url": "https://help.zscaler.com/multi-tenant-portal/updating-partner-account-logo",
    "node": "1540739",
    "revision": "3226322",
    "updated": "2026-07-28",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "You can update your account logo or set the background color in the Zscaler Multi-Tenant Portal for Partners. Your partner account logo is used for white labeling your tenant's ZIA Admin Portal if you've enabled white labeling."
    },
    {
      "text": "To update your account:"
    },
    {
      "item": "Upload an image for the logo",
      "depth": 0
    },
    {
      "item": "To update your account logo with an image:",
      "depth": 0
    },
    {
      "item": "Go to Settings page.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          6,
          14
        ]
      ]
    },
    {
      "item": "Click Upload Logo.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          17
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Upload the logo from your local directory. The service supports a logo with the following features:",
      "depth": 1,
      "number": 3
    },
    {
      "item": "Dimensions of 300 x 220 pixels or less.",
      "depth": 2
    },
    {
      "item": "Size of 10 KB or less.",
      "depth": 2
    },
    {
      "item": ".png, .jpg, or .gif file types.",
      "depth": 2
    },
    {
      "item": "Click Save.",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "Set the background color",
      "depth": 0
    },
    {
      "item": "To update the background color:",
      "depth": 0
    },
    {
      "item": "Go to Settings page.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          6,
          14
        ]
      ]
    },
    {
      "item": "Click Change Background Color.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          29
        ]
      ]
    },
    {
      "item": "Select a color from the list or enter the hexadecimal code of the color you want to update.",
      "depth": 1,
      "number": 3
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Save.",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
