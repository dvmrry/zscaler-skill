    "components": {
      "schemas": {
        "EcDnsGateway": {
          "type": "object",
          "properties": {
            "dnsGatewayType": {
              "description": "Specifies the type of DNS gateway.",
              "type": "string",
              "enum": [
                "OFW_PDNS_REDIR_GW",
                "EC_DNS_GW"
              ]
            },
            "ecDnsGatewayOptionsPrimary": {
              "type": "string",
              "description": "Specifies the primary DNS server for EC DNS gateway.",
              "enum": [
                "LAN_PRI_DNS_AS_PRI",
                "LAN_SEC_DNS_AS_PRI",
                "WAN_PRI_DNS_AS_PRI"
              ]
            },
            "ecDnsGatewayOptionsSecondary": {
              "type": "string",
              "description": "Specifies the secondary DNS server for EC DNS gateway.",
              "enum": [
                "LAN_PRI_DNS_AS_SEC",
                "LAN_SEC_DNS_AS_SEC",
                "WAN_SEC_DNS_AS_SEC"
              ]
            },
            "failureBehavior": {
              "type": "string",
              "description": "Specifies the failure behavior if the DNS server is unreachable.",
              "enum": [
                "FAIL_RET_ERR",
                "FAIL_ALLOW_IGNORE_DNAT",
                "FAIL_FORWARD_TO_ZTR"
              ]
            },
            "id": {
              "description": "ID of the DNS gateway.",
              "type": "integer",
              "format": "int32"
            },
            "lastModifiedBy": {
              "description": "The user who last modified the DNS gateway",
              "$ref": "#/components/schemas/EntityReference"
            },
            "lastModifiedTime": {
              "description": "Timestamp when the DNS gateway was last modified.",
              "type": "integer",
              "format": "int32"
            },
            "name": {
              "description": "Name of the DNS gateway.",
              "type": "string"
            },
            "primaryIp": {
              "description": "The primary IP address of the DNS gateway.",
              "type": "string"
            },
            "secondaryIp": {
              "description": "The secondary IP address of the DNS gateway.",
              "type": "string"
            }
          }
        },
        "EntityReference": {
          "type": "object",
          "description": "An immutable reference to an entity, which consists of ID, name, etc.",
          "properties": {
            "id": {
              "type": "integer",
              "format": "int64",
              "description": "An ID that uniquely identifies an entity."
            },
            "name": {
              "type": "string",
              "description": "The name of the entity."
            },
            "isNameL10nTag": {
              "type": "boolean",
              "description": "Indicates whether the entity is localized for internationalization."
            },
            "extensions": {
              "type": "object",
              "description": "An object for storing additional properties related to entity configuration.",
              "additionalProperties": {
                "type": "string",
                "description": "Custom attributes within the extensions object."
              }
            },
            "deleted": {
              "type": "boolean",
              "description": "Indicates the deletion status of the entity."
            },
            "externalId": {
              "type": "string",
              "description": "The external ID of the entity."
            },
            "associationTime": {
              "type": "integer",
              "format": "int32",
              "description": "The timestamp when the entity was linked or associated."
            }
          }
        }
      }
