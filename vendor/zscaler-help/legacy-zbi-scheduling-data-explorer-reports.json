  "blocks": [
    {
      "text": "You can schedule Data Explorer reports for your customized views."
    },
    {
      "text": "To schedule a report:"
    },
    {
      "item": "Go to Analytics > Data Explorer.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          15
        ],
        [
          18,
          22
        ],
        [
          23,
          31
        ]
      ]
    },
    {
      "item": "Configure a Data Explorer view. You can schedule Data Explorer reports only when the time period selected is Last Day, Last Week, or Last Month.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          109,
          117
        ],
        [
          119,
          128
        ],
        [
          133,
          143
        ]
      ]
    },
    {
      "item": "The Save Report window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          15
        ]
      ]
    },
    {
      "item": "In the Save Report window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          18
        ]
      ]
    },
    {
      "item": "Report Name: Enter a name for the scheduled report.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "Schedule Report: Enable to activate the report.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          0,
          15
        ]
      ]
    },
    {
      "item": "Deliver: Select the report generation frequency (i.e., Daily or Weekly).",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          0,
          7
        ],
        [
          55,
          60
        ],
        [
          64,
          70
        ]
      ]
    },
    {
      "item": "Email Recipients: Enter the email addresses of the users who must receive the report. Use a comma to separate multiple email addresses.",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          0,
          16
        ]
      ]
    },
    {
      "item": "Click Save and Schedule.",
      "depth": 1,
      "number": 5,
      "strong": [
        [
          6,
          23
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "text": "The report is successfully scheduled. You can view and manage the scheduled reports on the Data Explorer Reports page."
    }
  ]
}
