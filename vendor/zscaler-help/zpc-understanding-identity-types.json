  "blocks": [
    {
      "text": "ZPC classifies identities into the following types:"
    },
    {
      "item": "Human: Identities created for your organization employees and third-party vendors to access your cloud deployment resources.",
      "depth": 0,
      "strong": [
        [
          0,
          5
        ]
      ]
    },
    {
      "item": "Non-Human: Identities created to accommodate service-level needs, such as service accounts, virtual machines, or lambda functions.",
      "depth": 0,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
