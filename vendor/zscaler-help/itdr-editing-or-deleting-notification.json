  "blocks": [
    {
      "text": "You can edit or delete a notification configured in the Zscaler ITDR Admin Portal."
    },
    {
      "heading": "Editing a Notification",
      "level": 1
    },
    {
      "text": "To edit a notification:"
    },
    {
      "item": "Go to ITDR > Notifications > Configure.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          26
        ],
        [
          29,
          38
        ]
      ]
    },
    {
      "item": "Locate the notification that you want to edit.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Click the Edit icon for the notification under the Actions column.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          14
        ],
        [
          51,
          58
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Configure Notifications window, modify the fields as required.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          30
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting a Notification",
      "level": 1
    },
    {
      "text": "To delete a notification:"
    },
    {
      "item": "Go to ITDR > Notifications > Configure.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          26
        ],
        [
          29,
          38
        ]
      ]
    },
    {
      "item": "Locate the notification that you want to delete.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Click the Delete icon for the notification under the Actions column.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          16
        ],
        [
          53,
          60
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          34,
          36
        ]
      ]
    }
  ]
}
