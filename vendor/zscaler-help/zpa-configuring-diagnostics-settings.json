    {
      "text": "To configure settings for diagnostics pages in the Zscaler Admin Console:"
    },
    {
      "item": "From the navigation menu, go to Data Explorer> Private Access > Private Diagnostics.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          83
        ]
      ]
    },
    {
      "item": "Click the Settings icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          18
        ]
      ]
    },
    {
      "item": "The Settings drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          12
        ]
      ]
    },
    {
      "item": "In the Settings drawer, select the default filter operator (i.e., Equals or Contains) from the drop-down menu. The Default Filter Operator is set to Equals by default.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          15
        ],
        [
          66,
          72
        ],
        [
          76,
          84
        ],
        [
          115,
          138
        ],
        [
          149,
          155
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save to apply your changes.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "The selected filter operator is saved for future sessions.",
      "depth": 0
    }
  ]
}
