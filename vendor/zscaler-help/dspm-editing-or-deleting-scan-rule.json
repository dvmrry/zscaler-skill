  "blocks": [
    {
      "text": "You can edit or delete the scan rule as required."
    },
    {
      "heading": "Editing a Scan Rule",
      "level": 1
    },
    {
      "text": "To edit the scan rule:"
    },
    {
      "item": "From the navigation menu, go to Data Security > DSPM > Scan Settings.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          45
        ],
        [
          48,
          52
        ],
        [
          55,
          68
        ]
      ]
    },
    {
      "item": "Select the Scan Rules tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          11,
          21
        ]
      ]
    },
    {
      "item": "Do one of the following:",
      "depth": 0,
      "number": 3
    },
    {
      "item": "Click Actions (), and select Edit for the required scan rule.",
      "depth": 1,
      "strong": [
        [
          6,
          13
        ],
        [
          29,
          33
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click the name of the scan rule to open the scan rule details drawer, then click Actions, and select Edit.",
      "depth": 1,
      "strong": [
        [
          81,
          88
        ],
        [
          101,
          105
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "The Edit Scan Rules page appears.",
      "depth": 0,
      "strong": [
        [
          4,
          19
        ]
      ]
    },
    {
      "item": "On the Edit Scan Rules page, modify the configuration as required. To learn more about scan rules, see About Scan Settings.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          22
        ]
      ]
    },
    {
      "item": "Review the changes, then click Finish.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          31,
          37
        ]
      ]
    },
    {
      "item": "A message appears indicating that the scan setting is updated.",
      "depth": 0
    },
    {
      "heading": "Deleting a Scan Rule",
      "level": 1
    },
    {
      "text": "To delete the scan rule:"
    },
    {
      "item": "Go to Data Security > DSPM > Scan Settings.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          19
        ],
        [
          22,
          26
        ],
        [
          29,
          42
        ]
      ]
    },
    {
      "item": "Select the Scan Rules tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          11,
          21
        ]
      ]
    },
    {
      "item": "Do one of the following:",
      "depth": 0,
      "number": 3
    },
    {
      "item": "Click Actions (), and select Delete for the required scan rule.",
      "depth": 1,
      "strong": [
        [
          6,
          13
        ],
        [
          29,
          35
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click the name of the scan rule to open the scan rule details drawer, then click Actions, and select Delete.",
      "depth": 1,
      "strong": [
        [
          81,
          88
        ],
        [
          101,
          107
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "The Delete Scan Rule confirmation appears.",
      "depth": 0,
      "strong": [
        [
          4,
          20
        ]
      ]
    },
    {
      "item": "In the Delete Scan Rule confirmation window, click Confirm.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          23
        ],
        [
          51,
          58
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "text": "The scan rule is deleted from the Zscaler Admin Console."
    }
  ]
}
