    {
      "text": "You can edit or delete a configured SaaS tenant that you've added."
    },
    {
      "heading": "Editing a SaaS Tenant",
      "level": 1
    },
    {
      "text": "To edit a SaaS tenant:"
    },
    {
      "item": "From the navigation menu, go to Data Security > DSPM > SaaS Applications.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          45
        ],
        [
          48,
          52
        ],
        [
          55,
          72
        ]
      ]
    },
    {
      "item": "On the SaaS Applications page, locate the SaaS tenant you want to edit, click the Actions icon (), and select Edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          24
        ],
        [
          82,
          89
        ],
        [
          110,
          114
        ]
      ]
    },
    {
      "item": "The edit tenant drawer appears.",
      "depth": 0
    },
    {
      "item": "In the drawer, update the Configuration Details as required.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          26,
          47
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting a SaaS Tenant",
      "level": 1
    },
    {
      "text": "To delete a SaaS tenant:"
    },
    {
      "item": "Go to Data Security > DSPM > SaaS Applications.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          19
        ],
        [
          22,
          26
        ],
        [
          29,
          46
        ]
      ]
    },
    {
      "item": "On the SaaS Applications page, locate the SaaS tenant you want to delete, click the Actions icon (), and select Delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          24
        ],
        [
          84,
          91
        ],
        [
          112,
          118
        ]
      ]
    },
    {
      "item": "The Delete SaaS Tenant window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          22
        ]
      ]
    },
    {
      "item": "Read the message in the Delete SaaS Tenant window, enter CONFIRM, and then click Delete SaaS Tenant.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          24,
          42
        ],
        [
          81,
          99
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    }
  ]
