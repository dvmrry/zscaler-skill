    {
      "text": "To edit or delete an Index Tool configuration:"
    },
    {
      "item": "Go to Data Security > Common Resources > Index Tool.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          19
        ],
        [
          22,
          38
        ],
        [
          41,
          51
        ]
      ]
    },
    {
      "item": "Locate the Index Tool configuration in the table and click Edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          59,
          63
        ]
      ]
    },
    {
      "item": "The Edit Index Tool Configuration window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          33
        ]
      ]
    },
    {
      "item": "In the Edit Index Tool Configuration window, you cannot modify the VM Name. However, you can do the following:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          36
        ],
        [
          67,
          74
        ]
      ]
    },
    {
      "item": "Status: Select Enabled or Disabled.",
      "depth": 1,
      "strong": [
        [
          0,
          6
        ],
        [
          15,
          22
        ],
        [
          26,
          34
        ]
      ]
    },
    {
      "item": "SSL Certificate: Download the certificate or select Regenerate SSL Certificate to replace the old certificate. If you regenerate the certificate, make sure that you update the Index Tool virtual machine with the new file. To learn more, see Configuring the Index Tool with VMWare.",
      "depth": 1,
      "strong": [
        [
          0,
          15
        ],
        [
          17,
          25
        ],
        [
          52,
          78
        ]
      ]
    },
    {
      "item": "Enable Single Sign-On: Select Enabled to configure single sign-on (SSO) for the Index Tool configuration. To learn more, see Configuring Single Sign-On for the Index Tool.",
      "depth": 1,
      "strong": [
        [
          0,
          21
        ],
        [
          30,
          37
        ]
      ]
    },
    {
      "item": "Delete: Removes the configuration.",
      "depth": 1,
      "strong": [
        [
          0,
          6
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save and activate the change.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
