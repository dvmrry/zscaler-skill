    {
      "text": "Admins manage the banner themes for the isolation session's end-user notification. You can delete any banner theme except the Default."
    },
    {
      "text": "To delete a banner theme:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Browser > Browser Isolation Internet Access > Isolation Profile & Banner.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          50
        ],
        [
          53,
          86
        ],
        [
          89,
          115
        ]
      ]
    },
    {
      "item": "Click Isolation Banner.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          22
        ]
      ]
    },
    {
      "item": "On the Isolation Banner page, click the Delete icon for the banner.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          23
        ],
        [
          40,
          46
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Delete Isolation Banner window appears",
      "depth": 0,
      "strong": [
        [
          4,
          27
        ]
      ]
    },
    {
      "item": "In the Delete Isolation Banner window:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          30
        ]
      ]
    },
    {
      "item": "Enter CONFIRM.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "Click Delete.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    }
  ]
