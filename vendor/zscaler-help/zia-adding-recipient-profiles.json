    {
      "text": "Zscaler allows you to make custom sets of email recipient profiles and domain profiles that you can easily use with Data Loss Prevention (DLP) tools across channels. To learn more, see About Data Loss Prevention, About Data at Rest Scanning DLP, and About Outbound Email Policy."
    },
    {
      "text": "To add recipient profiles:"
    },
    {
      "item": "From the navigation menu, go to Data Security > Email DLP > Recipient Profiles.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          45
        ],
        [
          48,
          57
        ],
        [
          60,
          78
        ]
      ]
    },
    {
      "item": "Click Add Recipient Profile.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          27
        ]
      ]
    },
    {
      "item": "The Add Recipient Profile drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          25
        ]
      ]
    },
    {
      "item": "In the Add Recipient Profile drawer:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          28
        ]
      ]
    },
    {
      "item": "Profile Name: Enter a name for the profile.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          0,
          12
        ]
      ]
    },
    {
      "item": "Recipients: Enter one or more recipient email addresses separated by line breaks, then click Add.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          0,
          10
        ],
        [
          93,
          96
        ]
      ]
    },
    {
      "item": "Description (Optional): Enter additional notes or information. The description cannot exceed 256 characters.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          0,
          22
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
