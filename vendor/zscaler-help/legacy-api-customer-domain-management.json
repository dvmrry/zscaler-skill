              "description": "The client server address or domain name."
            }
          }
        },
        "CustomerDomain": {
          "properties": {
            "id": {
              "type": "integer",
              "description": "The unique identifier of the customer domain.",
              "format": "int64"
            },
            "modifiedTime": {
              "type": "integer",
              "description": "The time the customer domain is modified.",
              "format": "int32"
            },
            "creationTime": {
              "type": "integer",
              "description": "The time the customer domain is created.",
              "format": "int32"
            },
            "modifiedBy": {
              "type": "integer",
              "description": "The unique identifier of the tenant who modified the customer domain.",
              "format": "int64"
            },
            "microtenantId": {
              "type": "integer",
              "description": "The unique identifier of the Microtenant for the ZPA tenant. If you are within a Microtenant, you must pass the microtenantId field when making an API call to retrieve data from that Microtenant. The microtenantId can be obtained from the API keys page, or can be obtained programmatically using the ZPA cloud service API. Access to certain operations is limited when you are within a Microtenant. If you are within the Default Microtenant, pass microtenantId as 0 when making requests to retrieve data from the Default Microtenant. If the microtenantId is not passed in the request when creating or updating a resource, then the resource is created or updated in the Default Microtenant.",
              "format": "int64"
            },
            "domain": {
              "type": "string",
              "description": "The domain of the customer."
            },
            "associationType": {
              "type": "string",
              "description": "The association type of the customer domain. To create a DNS search domain, pass <code>SEARCH_SUFFIX</code> as the supported value.",
              "enum": [
                "SHARED",
                "SEARCH_SUFFIX"
              ]
            },
            "capture": {
              "type": "boolean",
              "description": "Indicates if Domain Validation in Zscaler Client Connector for ZPA Applications is enabled (true) or disabled (false)."
            },
            "name": {
              "type": "object",
              "description": "The name of the customer domain."
            }
          }
        }
