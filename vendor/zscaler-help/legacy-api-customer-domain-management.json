        },
        "post": {
          "tags": [
            "Customer Domain Management"
          ],
          "summary": "Add or update domains for a customer. Association type field in request body is ignored and is overwritten with association type provided as part of the URL.",
          "operationId": "addOrUpdateCustomerDomainsForAssociationType",
          "parameters": [
            {
              "name": "customerId",
              "in": "path",
              "required": true,
              "explode": false,
              "schema": {
