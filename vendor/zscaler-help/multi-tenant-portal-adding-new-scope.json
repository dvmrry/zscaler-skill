  "blocks": [
    {
      "text": "Zscaler partners can create scopes that encompass multiple tenants and clouds in the Zscaler Multi-Tenant Portal for Partners. These scopes are assigned to one or more admins in the Authentication Service Admin Portal as required."
    },
    {
      "text": "To create a scope:"
    },
    {
      "item": "Go to the Scopes page.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "Click Add Scope.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          15
        ]
      ]
    },
    {
      "item": "The Add Scope window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          13
        ]
      ]
    },
    {
      "item": "In the Add Scope window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          16
        ]
      ]
    },
    {
      "item": "Scope Name: Enter a name for the scope.",
      "depth": 1,
      "strong": [
        [
          0,
          10
        ]
      ]
    },
    {
      "item": "Cloud: Select the cloud on which the tenant is provisioned.",
      "depth": 1,
      "strong": [
        [
          0,
          5
        ]
      ]
    },
    {
      "item": "Tenants: Select tenants from the drop-down menu. The list of tenants available is based on the cloud selected.",
      "depth": 1,
      "strong": [
        [
          0,
          7
        ]
      ]
    },
    {
      "item": "Add Cloud: Click this button to add another cloud. You can add tenants under each selected cloud.",
      "depth": 1,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
