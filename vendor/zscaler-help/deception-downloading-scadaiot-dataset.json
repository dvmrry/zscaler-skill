    {
      "text": "You can download both default and custom SCADA/IoT datasets individually as a ZIP file."
    },
    {
      "text": "To download a SCADA/IoT dataset:"
    },
    {
      "item": "Go to Miragemaker > SCADA/IoT Datasets.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          38
        ]
      ]
    },
    {
      "item": "Click the Download icon for the dataset that you want to download.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          18
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The SCADA/IoT dataset is downloaded to your system as a ZIP file.",
      "depth": 0
    }
  ]
