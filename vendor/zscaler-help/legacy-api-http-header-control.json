    },
    "definitions": {
      "HttpHeaderProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "System-generated identifier for the HTTP header profile"
          },
          "name": {
            "type": "string",
            "description": "HTTP header profile name"
          },
          "description": {
            "type": "string",
            "description": "Additional information about the HTTP header profile"
          },
          "slotId": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP header profile slot ID"
          },
          "httpHeaderProfileCriteria": {
            "type": "array",
            "description": "The criteria (i.e., Origin, Referer, and User Agent) of the HTTP header profile",
            "items": {
              "$ref": "#/definitions/HttpHeaderProfileCriteria"
            }
          },
          "deleted": {
            "type": "boolean",
            "description": "A Boolean value that indicates whether or not a HTTP header profile is deleted"
          },
          "profileReadyForUse": {
            "type": "boolean",
            "description": "A Boolean value that indicates whether the configured HTTP header profile is ready for use"
          }
        }
      },
      "HttpHeaderActionProfile": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "System-generated identifier for the HTTP header insertion profile",
            "readOnly": true
          },
          "name": {
            "type": "string",
            "description": "Name of the HTTP header insertion profile"
          },
          "slotId": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP header insertion profile slot ID"
          },
          "deleted": {
            "type": "boolean",
            "description": "A Boolean value that indicates whether or not the HTTP header insertion profile is deleted"
          },
          "profileReadyForUse": {
            "type": "boolean",
            "description": "A Boolean value that indicates whether the configured HTTP header insertion profile is ready for use"
          },
          "description": {
            "type": "string",
            "description": "Additional information about the HTTP header insertion profile"
          },
          "httpHeaderActionProfileKeys": {
            "type": "array",
            "description": "List of HTTP header key-value pairs added to the profile",
            "items": {
              "$ref": "#/definitions/HttpHeaderActionProfileKeys"
            }
          }
        },
        "description": "Information about the HTTP header insertion profile"
      },
      "HttpHeaderProfileCriteria": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "System-generated HTTP header ID"
          },
          "header": {
            "type": "string",
            "description": "Specifies the type of HTTP header",
            "enum": [
              "USERAGENT",
              "REFERER",
              "ORIGIN"
            ]
          },
          "operator": {
            "type": "string",
            "description": "Specifies the operator used to create an expression between the user agents and its versions",
            "enum": [
              "UAVERSIONGT",
              "UAVERSIONLT",
              "UAVERSIONEQ",
              "UAVERSIONNEQ",
              "UAVERSIONANY"
            ]
          },
          "categoryBitmap": {
            "type": "array",
            "description": "Saves the <b>WebFilteringUrlCategory</b> information as a bitmap",
            "items": {
              "$ref": "#/definitions/WebFilteringUrlCategory"
            }
          },
          "cloudAppBitmap": {
            "type": "array",
            "description": "Saves the <b>PolicyWebApplication</b> information as a bitmap",
            "items": {
              "$ref": "#/definitions/PolicyWebApplication"
            }
          },
          "userAgent": {
            "type": "string",
            "description": "The user agent for which you want to control access"
          },
          "userAgentBitmap": {
            "type": "string",
            "description": "Saves the <b>userAgent</b> information as a bitmap",
            "enum": [
              "OPERA",
              "FIREFOX",
              "MSIE",
              "MSEDGE",
              "CHROME",
              "SAFARI",
              "OTHER",
              "MSCHREDGE",
              "BRAVE"
            ]
          },
          "userAgentVersion": {
            "type": "string",
            "description": "Version of the selected user agent"
          }
        }
      },
      "WebFilteringUrlCategory": {
        "type": "object",
        "properties": {
          "urlSupercategory": {
            "type": "string",
            "description": "Super category of the URL category. This field is required when creating custom URL categories.",
            "enum": [
              "ANY",
              "NONE",
              "ADVANCED_SECURITY",
              "ENTERTAINMENT_AND_RECREATION",
              "NEWS_AND_MEDIA",
              "USER_DEFINED",
              "EDUCATION",
              "BUSINESS_AND_ECONOMY",
              "JOB_SEARCH",
              "INFORMATION_TECHNOLOGY",
              "INTERNET_COMMUNICATION",
              "OFFICE_365",
              "CUSTOM_SUPERCATEGORY",
              "CUSTOM_BP",
              "CUSTOM_BW",
              "MISCELLANEOUS",
              "TRAVEL",
              "VEHICLES",
              "GOVERNMENT_AND_POLITICS",
              "GLOBAL_INT",
              "GLOBAL_INT_BP",
              "GLOBAL_INT_BW",
              "GLOBAL_INT_OFC365",
              "ADULT_MATERIAL",
              "DRUGS",
              "GAMBLING",
              "VIOLENCE",
              "WEAPONS_AND_BOMBS",
              "TASTELESS",
              "MILITANCY_HATE_AND_EXTREMISM",
              "ILLEGAL_OR_QUESTIONABLE",
              "SOCIETY_AND_LIFESTYLE",
              "HEALTH",
              "SPORTS",
              "SPECIAL_INTERESTS_SOCIAL_ORGANIZATIONS",
              "GAMES",
              "SHOPPING_AND_AUCTIONS",
              "SOCIAL_AND_FAMILY_ISSUES",
              "RELIGION",
              "SECURITY"
            ]
          },
          "deprecated": {
            "type": "boolean",
            "description": "List of deprecated URL categories"
          },
          "backendName": {
            "type": "string",
            "description": "URL category backend name"
          },
          "name": {
            "type": "string",
            "description": "The name of the URL category listed under the respective super category"
          },
          "userConfiguredName": {
            "type": "string",
            "description": "User-configured URL category name"
          },
          "comments": {
            "type": "string",
            "description": "Additional information about the URL category"
          }
        }
      },
      "PolicyWebApplication": {
        "type": "object",
        "properties": {
          "val": {
            "type": "integer",
            "format": "int32"
          },
          "webApplicationClass": {
            "type": "string",
            "description": "<p>The cloud application class selected from the available options</p>",
            "enum": [
              "ANY",
              "NONE",
              "WEB_MAIL",
              "SOCIAL_NETWORKING",
              "STREAMING",
              "P2P",
              "INSTANT_MESSAGING",
              "WEB_SEARCH",
              "GENERAL_BROWSING",
              "ADMINISTRATION",
              "ENTERPRISE_COLLABORATION",
              "BUSINESS_PRODUCTIVITY",
              "SALES_AND_MARKETING",
              "SYSTEM_AND_DEVELOPMENT",
              "CONSUMER",
              "FILE_SHARE",
              "HOSTING_PROVIDER",
              "IT_SERVICES",
              "DNS_OVER_HTTPS",
              "HUMAN_RESOURCES",
              "LEGAL",
              "HEALTH_CARE",
              "FINANCE",
              "CUSTOM_CAPP",
              "AI_ML"
            ]
          },
          "backendName": {
            "type": "string"
          },
          "originalName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "deprecated": {
            "type": "boolean"
          },
          "misc": {
            "type": "boolean"
          },
          "appNotReady": {
            "type": "boolean"
          },
          "underMigration": {
            "type": "boolean"
          },
          "appCatModified": {
            "type": "boolean"
          }
        }
      },
      "HttpHeaderActionProfileKeys": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "System-generated identifier for the HTTP header insertion profile"
          },
          "key": {
            "type": "string",
            "description": "The HTTP header key added to the profile"
          },
          "value": {
            "type": "string",
            "description": "The HTTP header value added to the profile"
          }
        }
      }
    }
  }
}
