          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/HttpHeaderActionProfile"
                }
              }
            }
          }
        },
        "post": {
          "tags": [
            "HTTP Header Control"
          ],
          "description": "Adds a new HTTP header insertion profile. To learn more, see <a href=\"/zia/adding-http-header-insertion-profile\" target=\"_blank\">Adding an HTTP Header Insertion Profile</a>.",
          "operationId": "HttpHeaderActionProfileResource_createHttpHeaderActionProfile",
          "consumes": [
            "application/json"
          ],
          "produces": [
