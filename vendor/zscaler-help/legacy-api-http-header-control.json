        "put": {
          "tags": [
            "HTTP Header Control"
          ],
          "description": "Updates the HTTP header insertion profile based on the specified ID",
          "operationId": "HttpHeaderActionProfileResource_updateHttpHeaderActionProfile",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "description": "Unique identifier for the HTTP header insertion profile",
              "required": true,
              "type": "integer",
              "format": "int32"
            },
            {
              "in": "body",
              "name": "body",
              "description": "Information about the HTTP header insertion profile",
              "required": false,
              "schema": {
