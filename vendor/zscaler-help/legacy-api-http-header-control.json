          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "id",
              "in": "path",
              "description": "Unique identifier for the HTTP header insertion profile",
              "required": true,
              "type": "integer",
