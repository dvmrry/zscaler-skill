    {
      "text": "You can edit or delete the configured items in your Zscaler Multi-Tenant Portal account. For example, you can edit or delete the configured users, or policy templates."
    },
    {
      "heading": "Editing Items",
      "level": 1
    },
    {
      "text": "To edit items:"
    },
    {
      "item": "Go to the item you want to edit.",
      "depth": 0,
      "number": 1
    },
    {
      "item": "Click the Edit icon, as shown in the following example.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "item": "Make the changes and click Save or Save & Sync.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          27,
          31
        ],
        [
          35,
          46
        ]
      ]
    },
    {
      "heading": "Deleting Items",
      "level": 1
    },
    {
      "text": "To delete items with the Edit icon:"
    },
    {
      "item": "Go to the item you want to delete.",
      "depth": 0,
      "number": 1
    },
    {
      "item": "Click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "item": "Click Delete & Sync.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          19
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "text": "To delete items with the Delete icon:"
    },
    {
      "item": "Go to the item you want to delete.",
      "depth": 0,
      "number": 1
    },
    {
      "item": "Click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "Read the warning message that appears. The following is an example.",
      "depth": 0,
      "number": 3
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Confirm to delete the item.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          13
        ]
      ]
    }
  ]
