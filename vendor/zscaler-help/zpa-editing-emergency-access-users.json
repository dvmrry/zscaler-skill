    {
      "text": "To edit an emergency access user:"
    },
    {
      "item": "From the navigation menu, go to Administration > Private Access Authentication > Emergency Access Users.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          46
        ],
        [
          49,
          78
        ],
        [
          81,
          103
        ]
      ]
    },
    {
      "item": "In the table, locate the Emergency Access user you want to modify and click Edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          76,
          80
        ]
      ]
    },
    {
      "text": "The Edit Emergency Access User window appears.",
      "strong": [
        [
          4,
          30
        ]
      ]
    },
    {
      "item": "In the Edit Emergency Access User window, modify fields as necessary.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          33
        ]
      ]
    },
    {
      "text": "You can only edit the First Name and Last Name fields.",
      "strong": [
        [
          22,
          32
        ],
        [
          37,
          46
        ]
      ]
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
