    "definitions": {
      "BandwidthClass": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "System-generated identifier for the bandwidth class"
          },
          "isNameL10nTag": {
            "type": "boolean",
            "description": "Indicates whether the bandwidth class name is localized"
          },
          "name": {
            "type": "string",
            "description": "Name of the bandwidth class"
          },
          "webApplications": {
            "type": "array",
            "description": "The web conferencing applications included in the bandwidth class. To learn more, see <a href=\"/zia/configuring-web-conferencing-applications-bandwidth-class\" target=\"_blank\">Configuring the Web Conferencing Applications Bandwidth Class</a>.",
            "items": {
              "$ref": "#/definitions/PolicyWebApplication"
            },
            "maxItems": 12000,
            "minItems": 0
          },
          "urls": {
            "type": "array",
            "description": "The URLs included in the bandwidth class. You can include multiple entries.",
            "items": {
              "type": "string"
            }
          },
          "applicationServiceGroups": {
            "type": "array",
            "description": "The application service groups included in the bandwidth class",
            "items": {
              "type": "string"
            }
          },
          "networkApplications": {
            "type": "array",
            "description": "The network applications included in the bandwidth class",
            "items": {
              "type": "string"
            }
          },
          "networkServices": {
            "type": "array",
            "description": "The network services included in the bandwidth class",
            "items": {
              "type": "string"
            }
          },
          "urlCategories": {
            "type": "array",
            "description": "The URL categories to add to the bandwidth class",
            "items": {
              "$ref": "#/definitions/UrlCategoryForPolicy"
            }
          },
          "applications": {
            "type": "array",
            "description": "The applications included in the bandwidth class",
            "items": {
              "type": "string",
              "enum": [
                "ANY",
                "NONE",
                "NETSUITE",
                "DROPBOX",
                "BOXNET",
                "YOUTUBE",
                "METACAFE",
                "HULU",
                "DAILYMOTION",
                "SHOUTCAST",
                "SALESFORCE_1",
                "SKYPE",
                "WEBEX",
                "GOTOMEETING",
                "LIVEMEETING",
                "CONNECT",
                "INTERCALL"
              ]
            }
          },
          "getfileSize": {
            "type": "string",
            "description": "The file size for a bandwidth class",
            "enum": [
              "ANY",
              "NONE",
              "FILE_5MB",
              "FILE_10MB",
              "FILE_50MB",
              "FILE_100MB",
              "FILE_250MB",
              "FILE_500MB",
              "FILE_1GB"
            ]
          },
          "type": {
            "type": "string",
            "description": "The application type for which the bandwidth class is configured",
            "readOnly": true,
            "enum": [
              "ANY",
              "NONE",
              "BANDWIDTH_CAT_WEBCONF",
              "BANDWIDTH_CAT_VOIP",
              "BANDWIDTH_CAT_GENERAL_SURFING",
              "BANDWIDTH_CAT_LARGE_FILE",
              "BANDWIDTH_CAT_SALES",
              "BANDWIDTH_CAT_FINANCE",
              "BANDWIDTH_CAT_MEDIA",
              "BANDWIDTH_CAT_FSHARE"
            ]
          }
        }
      },
      "BandwidthControlRule": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "System-generated identifier for bandwidth control rule"
          },
          "name": {
            "type": "string",
            "description": "Rule name"
          },
          "order": {
            "type": "integer",
            "format": "int32",
            "description": "Rule order. Policy rules are evaluated in ascending numerical order (Rule 1 before Rule 2, and so on), and the rule order reflects this rule's place in the order. You can change the value, but if you've enabled the Admin Rank, your assigned admin rank determines the rule order values you can select."
          },
          "state": {
            "type": "string",
            "description": "Indicates whether the rule is enabled or disabled. An enabled rule is actively enforced. A disabled rule is not actively enforced but does not lose its place in the rule order. The service skips it and moves to the next rule.",
            "enum": [
              "DISABLED",
              "ENABLED"
            ]
          },
          "locations": {
            "type": "array",
            "description": "The locations to which the Bandwidth Control policy rule applies",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "timeWindows": {
            "type": "array",
            "description": "The time interval in which the Bandwidth Control policy rule applies",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "description": {
            "type": "string",
            "description": "Additional information about the rule"
          },
          "protocols": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Select the protocols to which the rule applies. This field is not applicable to the Lite API.",
              "enum": [
                "ANY_RULE",
                "DOHTTPS_RULE",
                "TUNNELSSL_RULE",
                "HTTP_PROXY",
                "FOHTTP_RULE",
                "FTP_RULE",
                "HTTPS_RULE",
                "HTTP_RULE",
                "SSL_RULE",
                "TUNNEL_RULE"
              ]
            }
          },
          "locationGroups": {
            "type": "array",
            "description": "The location groups to which the rule applies",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "maxBandwidth": {
            "type": "integer",
            "format": "int32",
            "description": "The maximum percentage of a location's bandwidth to be guaranteed for each selected bandwidth class. This percentage includes bandwidth for uploads and downloads."
          },
          "minBandwidth": {
            "type": "integer",
            "format": "int32",
            "description": "The minimum percentage of a location's bandwidth you want to be guaranteed for each selected bandwidth class. This percentage includes bandwidth for uploads and downloads."
          },
          "bandwidthClasses": {
            "type": "array",
            "description": "The bandwidth classes to which you want to apply this rule. You first must add URLs or cloud applications to predefined or custom bandwidth classes.",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "rank": {
            "type": "integer",
            "format": "int32",
            "description": "Admin rank of the Bandwidth Control policy rule"
          },
          "lastModifiedTime": {
            "type": "integer",
            "format": "int32",
            "description": "Timestamp of when the rule was last modified. This field is not applicable to the Lite API."
          },
          "lastModifiedBy": {
            "description": "Last user that modified the rule. This field is not applicable to the Lite API.",
            "$ref": "#/definitions/EntityReference"
          },
          "accessControl": {
            "type": "string",
            "description": "Access privilege of this rule based on the admin's Role Based Authorization (RBA) state",
            "enum": [
              "NONE",
              "READ_ONLY",
              "READ_WRITE"
            ]
          },
          "labels": {
            "type": "array",
            "description": "Labels that are applicable to the rule. This field is not applicable to the Lite API.",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "devices": {
            "type": "array",
            "description": "Name-ID pairs of devices for which rule must be applied. Specifies devices that are managed using Zscaler Client Connector. If no value is set, this field is ignored during the policy evaluation.",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "deviceGroups": {
            "type": "array",
            "description": "Name-ID pairs of device groups for which the rule must be applied. This field is applicable for devices that are managed using Zscaler Client Connector. If no value is set, this field is ignored during the policy evaluation.",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "deviceTrustLevels": {
            "type": "array",
            "description": "List of device trust levels for which the rule must be applied. While the High Trust, Medium Trust, or Low Trust evaluation is applicable only to Zscaler Client Connector traffic, Unknown evaluation applies to all traffic. The trust levels are assigned to the devices based on your posture configurations in the Zscaler Client Connector Portal. If no value is set, this field is ignored during the policy evaluation.",
            "items": {
              "type": "string",
              "enum": [
                "ANY",
                "UNKNOWN_DEVICETRUSTLEVEL",
                "LOW_TRUST",
                "MEDIUM_TRUST",
                "HIGH_TRUST"
              ]
            }
          },
          "defaultRule": {
            "type": "boolean",
            "description": "Indicates whether the default rule is enabled. If set to true, the default rule is applied."
          }
        }
      },
      "PolicyWebApplication": {
        "type": "object",
        "properties": {
          "val": {
            "type": "integer",
            "format": "int32"
          },
          "webApplicationClass": {
            "type": "string",
            "description": "<p>The cloud application class selected from the available options</p>",
            "enum": [
              "ANY",
              "NONE",
              "WEB_MAIL",
              "SOCIAL_NETWORKING",
              "STREAMING",
              "P2P",
              "INSTANT_MESSAGING",
              "WEB_SEARCH",
              "GENERAL_BROWSING",
              "ADMINISTRATION",
              "ENTERPRISE_COLLABORATION",
              "BUSINESS_PRODUCTIVITY",
              "SALES_AND_MARKETING",
              "SYSTEM_AND_DEVELOPMENT",
              "CONSUMER",
              "FILE_SHARE",
              "HOSTING_PROVIDER",
              "IT_SERVICES",
              "DNS_OVER_HTTPS",
              "HUMAN_RESOURCES",
              "LEGAL",
              "HEALTH_CARE",
              "FINANCE",
              "CUSTOM_CAPP",
              "AI_ML"
            ]
          },
          "backendName": {
            "type": "string"
          },
          "originalName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "deprecated": {
            "type": "boolean"
          },
          "misc": {
            "type": "boolean"
          },
          "appNotReady": {
            "type": "boolean"
          },
          "underMigration": {
            "type": "boolean"
          },
          "appCatModified": {
            "type": "boolean"
          }
        }
      },
      "UrlCategoryForPolicy": {
        "type": "object",
        "properties": {
          "urlSupercategory": {
            "type": "string",
            "enum": [
              "ANY",
              "NONE",
              "ADVANCED_SECURITY",
              "ENTERTAINMENT_AND_RECREATION",
              "NEWS_AND_MEDIA",
              "USER_DEFINED",
              "EDUCATION",
              "BUSINESS_AND_ECONOMY",
              "JOB_SEARCH",
              "INFORMATION_TECHNOLOGY",
              "INTERNET_COMMUNICATION",
              "OFFICE_365",
              "CUSTOM_SUPERCATEGORY",
              "CUSTOM_BP",
              "CUSTOM_BW",
              "MISCELLANEOUS",
              "TRAVEL",
              "VEHICLES",
              "GOVERNMENT_AND_POLITICS",
              "GLOBAL_INT",
              "GLOBAL_INT_BP",
              "GLOBAL_INT_BW",
              "GLOBAL_INT_OFC365",
              "ADULT_MATERIAL",
              "DRUGS",
              "GAMBLING",
              "VIOLENCE",
              "WEAPONS_AND_BOMBS",
              "TASTELESS",
              "MILITANCY_HATE_AND_EXTREMISM",
              "ILLEGAL_OR_QUESTIONABLE",
              "SOCIETY_AND_LIFESTYLE",
              "HEALTH",
              "SPORTS",
              "SPECIAL_INTERESTS_SOCIAL_ORGANIZATIONS",
              "GAMES",
              "SHOPPING_AND_AUCTIONS",
              "SOCIAL_AND_FAMILY_ISSUES",
              "RELIGION",
              "SECURITY"
            ]
          },
          "deprecated": {
            "type": "boolean"
          },
          "backendName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "userConfiguredName": {
            "type": "string"
          },
          "comments": {
            "type": "string"
          }
        }
      },
      "EntityReference": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "A unique identifier for an entity"
          },
          "name": {
            "type": "string",
            "description": "The configured name of the entity",
            "readOnly": true
          },
          "externalId": {
            "type": "string",
            "description": "An external identifier used for an entity that is managed outside of ZIA. Examples include <code>zpaServerGroup</code> and <code>zpaAppSegments</code>. This field is not applicable to ZIA-managed entities."
          },
          "extensions": {
            "type": "object",
            "description": "Additional information about the entity",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "description": "This is an immutable reference to an entity that mainly consists of id and name"
      }
    }
  }
