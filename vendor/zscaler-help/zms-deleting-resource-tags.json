  "title": "Deleting Resource Tags",
  "source": {
    "url": "https://help.zscaler.com/microsegmentation/deleting-resource-tags",
    "node": "1538476",
    "revision": "3242984",
    "updated": "2026-11-02",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "Resource tags are used to define criteria when creating a resource group. You can manually delete individual tags from the list at any time."
    },
    {
      "text": "To delete a resource tag:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > Resources VM.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          83
        ]
      ]
    },
    {
      "item": "Click a resource.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "The resource drawer opens.",
      "depth": 0
    },
    {
      "item": "In the resource drawer, click Tags.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          30,
          34
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Tags section appears.",
      "depth": 0,
      "strong": [
        [
          4,
          8
        ]
      ]
    },
    {
      "item": "In the Tags section:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          11
        ]
      ]
    },
    {
      "item": "Click the Delete icon next to the tag you want to delete.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "The Delete Tag window appears.",
      "depth": 1,
      "strong": [
        [
          4,
          14
        ]
      ]
    },
    {
      "item": "In the Delete Tag window:",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          7,
          17
        ]
      ]
    },
    {
      "item": "Enter CONFIRM.",
      "depth": 2,
      "number": 1
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "Click Delete.",
      "depth": 2,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The page refreshes and removes the deleted tag from the list."
    }
  ]
}
