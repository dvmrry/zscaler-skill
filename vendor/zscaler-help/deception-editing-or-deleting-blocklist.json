    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete blocklists that you configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a Blocklist",
      "level": 1
    },
    {
      "text": "To edit a blocklist:"
    },
    {
      "item": "Go to Deceive > Deceive Settings > Blocklist.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          13
        ],
        [
          16,
          32
        ],
        [
          35,
          44
        ]
      ]
    },
    {
      "item": "In the table, locate the blocklist you want to modify, and then click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          74,
          78
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Modify the fields as necessary.",
      "depth": 0,
      "number": 3
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting a Blocklist",
      "level": 1
    },
    {
      "text": "To delete a blocklist:"
    },
    {
      "item": "Go to Deceive > Deceive Settings > Blocklist.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          13
        ],
        [
          16,
          32
        ],
        [
          35,
          44
        ]
      ]
    },
    {
      "item": "In the table, locate the blocklist you want to delete, and then click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          74,
          80
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "heading": "Deleting Multiple or All Blocklists",
      "level": 1
    },
    {
      "text": "To delete mutiple or all blocklists:"
    },
    {
      "item": "Go to Deceive > Deceive Settings > Blocklist.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          13
        ],
        [
          16,
          32
        ],
        [
          35,
          44
        ]
      ]
    },
    {
      "item": "In the table, select blocklists you want to delete.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Click Actions and choose Delete to delete the selected blocklists.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          31
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "You can click Delete All to delete all blocklists.",
      "depth": 0,
      "strong": [
        [
          14,
          24
        ]
      ]
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          34,
          36
        ]
      ]
    }
  ]
}
