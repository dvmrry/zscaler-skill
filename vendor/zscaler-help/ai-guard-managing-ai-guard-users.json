    {
      "text": "System users are managed through the Authentication Service Admin Portal, but you can view them within AI Guard. For more information about managing system users with Authentication Service, see About Users for Authentication Service and Adding Users for Authentication Service."
    },
    {
      "heading": "Viewing System Users",
      "level": 1
    },
    {
      "text": "To view system users:"
    },
    {
      "item": "In the AI Guard left-side navigation, go to System User Management. The System Users page appears.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          44,
          66
        ],
        [
          72,
          84
        ]
      ]
    },
    {
      "item": "On the System Users page, you can view the following information:",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          19
        ]
      ]
    },
    {
      "item": "Name: Name of the system user.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Email: Email address of the system user.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          0,
          5
        ]
      ]
    },
    {
      "item": "Login Type: Displays the method of user login.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          0,
          10
        ]
      ]
    },
    {
      "item": "Role: Role of the system user such as Administrator or Editor.",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Created At: Date that the system user was created.",
      "depth": 1,
      "number": 5,
      "strong": [
        [
          0,
          10
        ]
      ]
    },
    {
      "item": "Last Updated At: Date that the system user's information was last updated.",
      "depth": 1,
      "number": 6,
      "strong": [
        [
          0,
          15
        ]
      ]
    },
    {
      "item": "Action: All actions you are able to perform will be listed here.",
      "depth": 1,
      "number": 7,
      "strong": [
        [
          0,
          6
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "heading": "Adding System Users",
      "level": 1
    },
    {
      "text": "To add a system user:"
    },
    {
      "item": "In the AI Guard left-side navigation, go to System User Management. The System Users page appears.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          44,
          66
        ],
        [
          72,
          84
        ]
      ]
    },
    {
      "item": "Click Add More. The Add System User window appears.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          20,
          35
        ]
      ]
    },
    {
      "item": "Enter the Name, Email, and Role for the system user and click Submit.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          14
        ],
        [
          16,
          21
        ],
        [
          27,
          31
        ],
        [
          62,
          68
        ]
      ]
    },
    {
      "heading": "Editing System Users",
      "level": 1
    },
    {
      "item": "In the AI Guard left-side navigation, go to System User Management. The System Users page appears.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          44,
          66
        ],
        [
          72,
          84
        ]
      ]
    },
    {
      "item": "Under the Action column, click Edit. The Edit System User window appears.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          16
        ],
        [
          31,
          35
        ],
        [
          41,
          57
        ]
      ]
    },
    {
      "item": "Edit the Name, Email, or Role for the system user and click Update.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          9,
          13
        ],
        [
          15,
          20
        ],
        [
          25,
          29
        ],
        [
          60,
          66
        ]
      ]
    }
  ]
}
