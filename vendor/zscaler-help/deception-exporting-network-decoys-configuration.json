      "text": "You can export the network decoy configuration details as a CSV file."
    },
    {
      "text": "To export the network decoy configuration details:"
    },
    {
      "item": "Go to Deceive > Network Decoys.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          13
        ],
        [
          16,
          30
        ]
      ]
    },
    {
      "item": "Select the Internal or Zero Trust Network tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          11,
          19
        ],
        [
          23,
          41
        ]
      ]
    },
    {
      "item": "Click Export Decoy Configuration.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          32
        ]
      ]
    },
    {
      "text": "A CSV file with the decoy configuration details is downloaded to your local system."
    }
  ]
}
