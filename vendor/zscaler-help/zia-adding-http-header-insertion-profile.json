    {
      "text": "The HTTP header insertion profile allows you to add custom HTTP request headers and modify existing HTTP request headers. It consists of two parts: adding HTTP header insertion profiles and associating them to a URL Filtering policy rule."
    },
    {
      "text": "To add an HTTP header insertion profile:"
    },
    {
      "item": "From the navigation menu, go to Internet Access > Policy > HTTP Header Control.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          47
        ],
        [
          50,
          56
        ],
        [
          59,
          78
        ]
      ]
    },
    {
      "item": "Select the HTTP Header Insertion Profile tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          11,
          40
        ]
      ]
    },
    {
      "item": "On the HTTP Header Insertion Profile tab, click Add HTTP Header Insertion Profile.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          36
        ],
        [
          48,
          81
        ]
      ]
    },
    {
      "item": "The Add HTTP Header Insertion Profile page appears.",
      "depth": 0,
      "strong": [
        [
          4,
          37
        ]
      ]
    },
    {
      "item": "On the Add HTTP Header Insertion Profile page:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          40
        ]
      ]
    },
    {
      "item": "Name: Enter the name of the HTTP header insertion profile. This is displayed when configuring the URL Filtering policy rules.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Description (optional): Enter any additional comments or information. The description cannot exceed 10,240 characters.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          0,
          22
        ]
      ]
    },
    {
      "item": "In the Headers section, click Add.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          7,
          14
        ],
        [
          30,
          33
        ]
      ]
    },
    {
      "item": "The Add HTTP Header drawer appears.",
      "depth": 1,
      "strong": [
        [
          4,
          19
        ]
      ]
    },
    {
      "item": "In the Add HTTP Header drawer:",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          7,
          22
        ]
      ]
    },
    {
      "item": "HTTP Header: Enter the key for the HTTP header. It has a limit of 128 characters.",
      "depth": 2,
      "number": 1,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "Ensure to enter only request headers.",
      "depth": 2
    },
    {
      "item": "A list of HTTP header keys that are not allowed.",
      "depth": 3
    },
    {
      "item": "content-security-policy",
      "depth": 4
    },
    {
      "item": "etag",
      "depth": 4
    },
    {
      "item": "expires",
      "depth": 4
    },
    {
      "item": "last-modified",
      "depth": 4
    },
    {
      "item": "location",
      "depth": 4
    },
    {
      "item": "proxy-authenticate",
      "depth": 4
    },
    {
      "item": "public-key-pins",
      "depth": 4
    },
    {
      "item": "retry-after",
      "depth": 4
    },
    {
      "item": "server",
      "depth": 4
    },
    {
      "item": "set-cookie",
      "depth": 4
    },
    {
      "item": "strict-transport-security",
      "depth": 4
    },
    {
      "item": "timing-allow-origin",
      "depth": 4
    },
    {
      "item": "vary",
      "depth": 4
    },
    {
      "item": "www-authenticate",
      "depth": 4
    },
    {
      "item": "x-content-type-options",
      "depth": 4
    },
    {
      "item": "x-frame-options",
      "depth": 4
    },
    {
      "item": "Value: Enter the value for the HTTP header. It has a limit of 1,024 characters.",
      "depth": 2,
      "number": 2,
      "strong": [
        [
          0,
          5
        ]
      ]
    },
    {
      "item": "Click Save.",
      "depth": 2,
      "number": 3,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "You can add up to 16 HTTP headers by clicking the Add button.",
      "depth": 1,
      "strong": [
        [
          50,
          53
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save and activate the change.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
