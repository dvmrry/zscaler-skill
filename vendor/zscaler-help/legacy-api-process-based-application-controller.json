    "components": {
      "schemas": {
        "PublicProcessBasedApplication": {
          "type": "object",
          "description": "Process-based application configuration for defining applications based on process names, file paths, and certificate criteria.",
          "properties": {
            "id": {
              "description": "Unique identifier of the process-based application.",
              "type": "integer",
              "format": "int64"
            },
            "name": {
              "description": "Name of the process-based application.",
              "type": "string"
            },
            "fileNames": {
              "description": "List of executable file names to match for this application (e.g., chrome.exe, firefox.exe).",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "filePaths": {
              "description": "List of file paths to match for this application.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "matchingCriteria": {
              "description": "Criteria used to match and validate the application. 'NONE' means no signature validation, 'SHA2_SIGNATURE' validates SHA2 hash, 'CERTIFICATE_SIGNER' validates certificate signer, 'CERTIFICATE_SUBJECT' validates certificate subject, and combinations validate multiple criteria.",
              "type": "string",
              "enum": [
                "NONE",
                "SHA2_SIGNATURE",
                "CERTIFICATE_SIGNER",
                "CERTIFICATE_SUBJECT",
                "SHA2_SIGNATURE_CERTIFICATE_SIGNER",
                "SHA2_SIGNATURE_CERTIFICATE_SUBJECT",
                "NOT_ASSIGNED"
              ]
            },
            "signaturePayload": {
              "description": "Array of SHA2 signature payloads for application validation.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PublicBypassSignaturePayload"
              }
            },
            "certificateThumbprintPayload": {
              "description": "Array of certificate thumbprint payloads for certificate-based validation.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PublicCertificateThumbprintPayload"
              }
            },
            "certificateSubjectPayload": {
              "description": "Array of certificate subject payloads for certificate subject-based validation.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PublicCertificateSubjectPayload"
              }
            }
          }
        },
        "PublicBypassSignaturePayload": {
          "description": "SHA2 signature payload for application validation and verification.",
          "type": "object",
          "properties": {
            "signatureName": {
              "description": "Name or identifier of the signature.",
              "type": "string"
            },
            "signatureValue": {
              "description": "SHA2 hash value of the application executable for validation.",
              "type": "string"
            }
          }
        },
        "PublicCertificateThumbprintPayload": {
          "description": "Certificate thumbprint payload for certificate-based application validation.",
          "type": "object",
          "properties": {
            "certificateName": {
              "description": "Name or identifier of the certificate.",
              "type": "string"
            },
            "certificateThumbprint": {
              "description": "Thumbprint (hash) of the certificate used to sign the application.",
              "type": "string"
            }
          }
        },
        "PublicCertificateSubjectPayload": {
          "description": "Certificate subject payload for certificate subject-based application validation.",
          "type": "object",
          "properties": {
            "certificateName": {
              "description": "Name or identifier of the certificate.",
              "type": "string"
            },
            "certificateSubject": {
              "description": "Subject distinguished name of the certificate used to sign the application.",
              "type": "string"
            }
          }
        }
      }
    }
  }
