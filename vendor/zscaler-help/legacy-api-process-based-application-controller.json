      "/public/v2/process-based-apps": {
        "get": {
          "summary": "List process-based applications",
          "description": "Retrieves a list of process-based applications with optional keyword filtering and pagination support.",
          "tags": [
            "process-based-application-controller"
          ],
          "operationId": "listProcessBasedApplications",
          "parameters": [
            {
              "name": "offset",
              "description": "Number of results to skip for pagination.",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 0
              }
            },
            {
              "name": "limit",
              "description": "Maximum number of results to return per page.",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 50
              }
            },
            {
              "name": "keyword",
              "description": "Search keyword to filter process-based applications by name or other attributes.",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string",
                "default": ""
              }
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "description": "Response object containing an array of process-based applications and pagination metadata.",
                    "type": "object"
                  }
                }
              }
            }
          }
        },
