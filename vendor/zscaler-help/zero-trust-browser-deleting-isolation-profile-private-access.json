    {
      "text": "After creating a Private Access (ZPA) isolation profile, you can delete the profile at any time."
    },
    {
      "text": "To delete your Private Access isolation profile:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Browser > Browser Isolation Private Apps > Isolation Profile.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          50
        ],
        [
          53,
          83
        ],
        [
          86,
          103
        ]
      ]
    },
    {
      "item": "Click the Delete icon for the isolation profile that you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Confirm: Delete Profile window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          27
        ]
      ]
    },
    {
      "item": "In the Confirm: Delete Profile window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          30
        ]
      ]
    },
    {
      "item": "Enter CONFIRM.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Delete.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The page refreshes and removes the deleted profile from the list."
    }
  ]
}
