    {
      "text": "You can edit or delete Active Directory Custom Change Detection policies from the Zscaler ITDR Admin Portal."
    },
    {
      "heading": "Editing a Policy",
      "level": 1
    },
    {
      "text": "To edit a policy:"
    },
    {
      "item": "Go to ITDR > Manage > Active Directory Change Detection.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          19
        ],
        [
          22,
          38
        ],
        [
          39,
          55
        ]
      ]
    },
    {
      "item": "Locate the policy that you want to edit, and click the Edit icon under the Actions column.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          55,
          59
        ],
        [
          75,
          82
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Make changes to the policy as required.",
      "depth": 0,
      "number": 3
    },
    {
      "text": "The AD domain is monitored based on the changes made to the policy."
    },
    {
      "heading": "Deleting a Policy",
      "level": 1
    },
    {
      "text": "To delete a policy:"
    },
    {
      "item": "Go to ITDR > Manage > Active Directory Change Detection.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          19
        ],
        [
          22,
          38
        ],
        [
          39,
          55
        ]
      ]
    },
    {
      "item": "Locate the policy that you want to delete, and click the Delete icon under the Actions column.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          57,
          63
        ],
        [
          79,
          86
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Confirm your action.",
      "depth": 0,
      "number": 3
    },
    {
      "item": "The policy is removed from the ITDR Admin Portal.",
      "depth": 0
    }
  ]
}
