  "blocks": [
    {
      "text": "Zscaler Posture Control (ZPC) offers creating custom benchmarks and measures compliance posture. You can choose from 300+ security policies and add to your custom benchmarks to cater for your organization's specific compliance needs. To create a custom benchmark:"
    },
    {
      "item": "Go to Cloud Posture > Compliance.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          19
        ],
        [
          22,
          32
        ]
      ]
    },
    {
      "item": "Click Create Benchmark.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          22
        ]
      ]
    },
    {
      "item": "Enter the Benchmark Name.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          24
        ]
      ]
    },
    {
      "item": "(Optional) Enter the Description.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          21,
          32
        ]
      ]
    },
    {
      "item": "Filter your cloud infrastructure for benchmarks you want checked:",
      "depth": 0,
      "number": 5
    },
    {
      "item": "Business Units: Select one or multiple business units. Business units are logical groups of multiple cloud accounts.",
      "depth": 1,
      "strong": [
        [
          0,
          14
        ]
      ]
    },
    {
      "item": "Clouds: Select one or multiple cloud service providers.",
      "depth": 1,
      "strong": [
        [
          0,
          6
        ]
      ]
    },
    {
      "item": "Accounts: Select one or multiple cloud accounts.",
      "depth": 1,
      "strong": [
        [
          0,
          8
        ]
      ]
    },
    {
      "item": "In the Selected Policies pane, you need to add categories before moving security policies from the Available Policies pane:",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          7,
          24
        ],
        [
          99,
          117
        ]
      ]
    },
    {
      "item": "Click Add Category.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          6,
          18
        ]
      ]
    },
    {
      "item": "Enter the Category Name, then click Save. The new category appears in the Selected Policies pane.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          10,
          23
        ],
        [
          36,
          40
        ],
        [
          74,
          91
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the Available Policies pane, you can:",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          7,
          25
        ]
      ]
    },
    {
      "item": "Filter security policies by severity and benchmark name.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "Select security policies to move to the selected policies pane.",
      "depth": 1,
      "number": 2
    },
    {
      "item": "Click Add To, then select a policy category. The security policies appear under the selected policy category in the Selected Policies pane.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          6,
          12
        ],
        [
          116,
          133
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 7,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
