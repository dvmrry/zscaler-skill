    {
      "text": "You can edit or delete OpenID identity provider (IdP) configurations in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing an OpenID IdP Configuration",
      "level": 1
    },
    {
      "text": "To edit an OpenID IdP configuration:"
    },
    {
      "item": "Go to Settings > Users & Roles > IdP Providers.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          30
        ],
        [
          33,
          46
        ]
      ]
    },
    {
      "item": "In the table, locate an OpenID IdP configuration you want to modify, and then click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          88,
          92
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the OpenID Provider Details window, modify the required fields.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          30
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting an OpenID IdP Configuration",
      "level": 1
    },
    {
      "text": "To delete an OpenID IdP Configuration:"
    },
    {
      "item": "Go to Settings > Users & Roles > IdP Providers.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          30
        ],
        [
          33,
          46
        ]
      ]
    },
    {
      "item": "In the table, locate an OpenID IdP configuration you want to delete, and then click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          88,
          94
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    }
  ]
}
