              "type": "string",
              "description": "The unique identifier the certificate is issued to."
            },
            "issuedBy": {
              "type": "string",
              "description": "The unique identifier the certificate is issued by."
            },
            "serialNo": {
              "type": "string",
              "description": "The serial number of the certificate."
            },
            "status": {
              "type": "string",
              "description": "The status of the certificate."
            },
