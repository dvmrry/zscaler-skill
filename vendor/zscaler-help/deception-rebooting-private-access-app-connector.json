    {
      "text": "You can reboot a Private Access (ZPA) App Connector that you configured in the Zscaler Deception Admin Portal."
    },
    {
      "text": "To reboot an App Connector:"
    },
    {
      "item": "Go to Settings > Topology > ZPA App Connectors.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          25
        ],
        [
          28,
          47
        ]
      ]
    },
    {
      "item": "Select the App Connector you want to reboot, and then click Actions > Reboot.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          60,
          67
        ],
        [
          70,
          76
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    }
  ]
}
