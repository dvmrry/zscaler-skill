              "description": "Not Found",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ZAPIError"
                  }
                }
              }
            },
            "500": {
              "description": "Internal Server Error",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/ZAPIError"
                  }
                }
              }
            }
          }
        }
