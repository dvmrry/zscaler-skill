      "/userconfig/v1/customers/{customerId}/scimgroup/idpId/{idpId}": {
        "get": {
          "tags": [
            "SCIM Groups"
          ],
          "summary": "Gets details of all SCIM groups for the specified IdP.",
          "operationId": "getAllSCIMGroups",
          "parameters": [
            {
              "name": "customerId",
              "in": "path",
              "description": "The unique identifier of the ZPA tenant.",
              "required": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            },
            {
              "name": "idpId",
              "in": "path",
              "description": "The unique identifier of the IdP.",
              "required": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            },
            {
              "name": "search",
              "in": "query",
              "description": "The search string used to support search by features and fields for the API.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "idpGroupId",
              "in": "query",
              "description": "The unique identifier of the SCIM group.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "scimUserId",
              "in": "query",
              "description": "The unique identifier for the SCIM user.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            },
            {
              "name": "scimUserName",
              "in": "query",
              "description": "The name of the SCIM user.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "startTime",
              "in": "query",
              "description": "The start of a time range for requesting last updated data (modified_time) for the SCIM group. This requires setting the endTime parameter as well.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            },
            {
              "name": "endTime",
              "in": "query",
              "description": "The end of a time range for requesting last updated data (modified_time) for the SCIM group. This requires setting the startTime parameter as well.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            },
            {
              "name": "sortBy",
              "in": "query",
              "description": "Specifies the field name to sort the results. The supported Sort fields are id, name, creationTime, and modifiedTime. If not provided, the results are sorted by the modifiedTime field.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "sortOrder",
              "in": "query",
              "description": "Sort the last updated time (modified_time) by ascending (ASC) or descending (DSC) order.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "string",
                "default": "DSC"
              }
            },
            {
              "name": "page",
              "in": "query",
              "description": "Specifies the page number.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": "1"
              },
              "example": "1"
            },
            {
              "name": "pagesize",
              "in": "query",
              "description": "Specifies the page size. If not provided, the default page size is 20. The max page size is 500.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": "20"
              },
              "example": "20"
            },
            {
              "name": "allEntries",
              "in": "query",
              "description": "Return all SCIM groups including the deleted ones if set to true",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "boolean",
                "default": false
              }
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/PageListSCIMGroup"
                  }
                }
              }
            },
