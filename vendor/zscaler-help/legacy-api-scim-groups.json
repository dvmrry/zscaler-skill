      "/userconfig/v1/customers/{customerId}/scimgroup/{scimGroupId}": {
        "get": {
          "tags": [
            "SCIM Groups"
          ],
          "summary": "Gets the SCIM group details for the specified ID.",
          "operationId": "getSCIMGroup",
          "parameters": [
            {
              "name": "customerId",
              "in": "path",
              "description": "The unique identifier of the ZPA tenant.",
              "required": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            },
            {
              "name": "scimGroupId",
              "in": "path",
              "description": "The unique identifier for the SCIM group.",
              "required": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            },
            {
              "name": "allEntries",
              "in": "query",
              "description": "Return all SCIM groups (including the deleted ones) if set to true.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "boolean",
                "default": false
              }
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "*/*": {
