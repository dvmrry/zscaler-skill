  "schema_version": 1,
  "kind": "help-article",
  "title": "Editing or Deleting a Landmine Decoy Personality",
  "source": {
    "url": "https://help.zscaler.com/deception/editing-or-deleting-landmine-decoy-personality",
    "node": "1542510",
    "revision": "3221600",
    "updated": "2026-09-22",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete landmine decoy personalities that you configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a Landmine Decoy Personality",
      "level": 1
    },
    {
      "text": "To edit a landmine decoy personality:"
    },
    {
      "item": "Go to Miragemaker > Strategy Builder > Landmine.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          36
        ],
        [
          39,
          47
        ]
      ]
    },
    {
      "item": "Under Actions, click the Edit icon for the decoy personality you want to modify.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          29
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the policy configuration window, modify the following configurations as required:",
      "depth": 0,
      "number": 3
    },
    {
      "item": "Policy",
      "depth": 1
    },
    {
      "item": "Selection Criterion",
      "depth": 1
    },
    {
      "item": "Password Settings",
      "depth": 1
    },
    {
      "item": "Defense Evasion",
      "depth": 1
    },
    {
      "item": "Privilege Escalation",
      "depth": 1
    },
    {
      "item": "Cloud Lures",
      "depth": 1
    },
    {
      "item": "Browser Lures",
      "depth": 1
    },
    {
      "item": "Session Lures",
      "depth": 1
    },
    {
      "item": "File Decoys",
      "depth": 1
    },
    {
      "item": "Lure Settings",
      "depth": 1
    },
    {
      "item": "Advanced Deception Capabilities",
      "depth": 1
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The default landmine decoy personalities cannot be edited."
    },
    {
      "heading": "Deleting a Landmine Decoy Personality",
      "level": 1
    },
    {
      "text": "To delete a landmine decoy personality:"
    },
    {
      "item": "Go to Miragemaker > Strategy Builder > Landmine.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          36
        ],
        [
          39,
          47
        ]
      ]
    },
    {
      "item": "Under Actions, click the Delete icon for the decoy personality you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          31
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "text": "The default landmine decoy personalities cannot be deleted."
    }
  ]
}
