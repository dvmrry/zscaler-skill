    {
      "text": "To edit a VPN Service Edge:"
    },
    {
      "item": "Go to Private Access > VPN (for Legacy Apps) > VPN Service Edges.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          44
        ],
        [
          47,
          65
        ]
      ]
    },
    {
      "item": "Locate the VPN Service Edge you want to edit, and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          60,
          64
        ]
      ]
    },
    {
      "item": "The Edit VPN Service Edges drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          26
        ]
      ]
    },
    {
      "item": "In the Edit VPN Service Edge drawer, modify fields as necessary. For more information about each field, see Configuring VPN Service Edges.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          28
        ]
      ]
    },
    {
      "item": "You cannot edit the Default UDP Listen Port.",
      "depth": 0,
      "strong": [
        [
          20,
          43
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
