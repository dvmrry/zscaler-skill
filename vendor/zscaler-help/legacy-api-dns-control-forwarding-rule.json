          "type": "object",
          "description": "An immutable reference to an entity, which consists of ID, name, etc.",
          "properties": {
            "id": {
              "type": "integer",
              "format": "int64",
              "description": "An ID that uniquely identifies an entity."
            },
            "name": {
              "type": "string",
              "description": "The name of the entity."
            },
            "isNameL10nTag": {
              "type": "boolean",
              "description": "Indicates whether the entity is localized for internationalization."
            },
            "extensions": {
              "type": "object",
              "description": "An object for storing additional properties related to entity configuration.",
              "additionalProperties": {
                "type": "string",
                "description": "Custom attributes within the extensions object."
              }
            },
            "deleted": {
              "type": "boolean",
              "description": "Indicates the deletion status of the entity."
            },
            "externalId": {
              "type": "string",
              "description": "The external ID of the entity."
            },
            "associationTime": {
              "type": "integer",
              "format": "int32",
              "description": "The timestamp when the entity was linked or associated."
            }
          }
