    "paths": {
      "/ecRules/ecDns": {
        "get": {
          "operationId": "EcRuleZResource_getEcDnsRules",
          "description": "<p>Retrieves the list of DNS forwarding rules.</p> \n <p><strong>&#9888; This API endpoint is accessible only via <a href=\"https://help.zscaler.com/oneapi\">OneAPI</a>.</strong></p>",
          "parameters": [
            {
              "in": "query",
              "name": "ruleName",
              "description": "The search string used to match against the rule name.",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "ruleOrder",
              "description": "The search string used to match against the rule order.",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "ruleDescription",
              "description": "The search string used to match against the rule description.",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "ruleAction",
              "description": "Specifies the rule action.",
              "schema": {
                "type": "string",
                "enum": [
                  "ALLOW",
                  "BLOCK",
                  "REDIR_REQ",
                  "REDIR_RES",
                  "REDIR_ZPA",
                  "REDIR_REQ_DOH",
                  "REDIR_REQ_KEEP_SENDER",
                  "REDIR_REQ_TCP",
                  "REDIR_REQ_UDP",
                  "BLOCK_WITH_RESPONSE",
                  "BLOCK_WITH_EUN"
                ]
              }
            },
            {
              "in": "query",
              "name": "location",
              "description": "The search string used to match against the locations or sublocations used in rule configurations.",
              "schema": {
                "type": "string"
              }
            },
            {
              "in": "query",
              "name": "page",
              "description": "Specifies the page offset.",
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 1
              }
            },
            {
              "in": "query",
              "name": "pageSize",
              "description": "Specifies the page size. The default size is 50.",
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 50
              }
            },
            {
              "in": "query",
              "name": "sortBy",
              "description": "The rule parameter by which the list must be sorted.",
              "schema": {
                "type": "string",
                "default": "order"
              }
            },
            {
              "in": "query",
              "name": "sortOrder",
              "description": "Specifies whether the list must be sorted by ascending or descending rule order or by rule processing order.",
              "schema": {
                "type": "string",
                "default": "ruleExecution",
                "enum": [
                  "asc",
                  "desc",
                  "ruleExecution"
                ]
              }
            }
          ],
          "responses": {
            "default": {
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/EcDnsRule"
                    }
                  }
                }
              },
              "description": "default response"
            }
          },
          "tags": [
            "DNS Control Forwarding Rule"
          ]
        },
        "post": {
          "operationId": "EcRuleZResource_createEcDnsForwardingRule",
          "description": "<p>Creates a DNS forwarding rule.</p> \n <p><strong>&#9888; This API endpoint is accessible only via <a href=\"https://help.zscaler.com/oneapi\">OneAPI</a>.</strong></p>",
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EcDnsRule"
                }
              }
            },
            "required": true
          },
          "responses": {
            "default": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/EcDnsRule"
                  }
                }
              },
              "description": "default response"
            }
          },
          "tags": [
            "DNS Control Forwarding Rule"
          ]
        }
      },
      "/ecRules/ecDns/{ruleId}": {
        "get": {
          "operationId": "EcRuleZResource_getEcDnsById",
          "description": "<p>Retrieves a DNS forwarding rule configuration based on the specified ID.</p> \n <p><strong>&#9888; This API endpoint is accessible only via <a href=\"https://help.zscaler.com/oneapi\">OneAPI</a>.</strong></p>",
          "parameters": [
            {
              "in": "path",
              "name": "ruleId",
              "description": "ID of the rule.",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int32"
              }
            }
          ],
          "responses": {
            "default": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/EcDnsRule"
                  }
                }
              },
              "description": "default response"
            }
          },
          "tags": [
            "DNS Control Forwarding Rule"
          ]
        },
        "put": {
          "operationId": "EcRuleZResource_updateEcDnsRule",
          "description": "<p>Updates DNS forwarding rule configuration based on the specified ID.</p> \n <p><strong>&#9888; This API endpoint is accessible only via <a href=\"https://help.zscaler.com/oneapi\">OneAPI</a>.</strong></p>",
          "parameters": [
            {
              "in": "path",
              "name": "ruleId",
              "description": "ID of the rule.",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int32"
              }
            }
          ],
          "requestBody": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EcDnsRule"
                }
              }
            },
            "required": true
          },
          "responses": {
            "default": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/EcDnsRule"
                  }
                }
              },
              "description": "default response"
            }
          },
          "tags": [
            "DNS Control Forwarding Rule"
          ]
        },
        "delete": {
          "operationId": "EcRuleZResource_deleteEcDnsRule",
          "description": "<p>Deletes a DNS forwarding rule based on the specified ID.</p> \n <p><strong>&#9888; This API endpoint is accessible only via <a href=\"https://help.zscaler.com/oneapi\">OneAPI</a>.</strong></p>",
          "parameters": [
            {
              "in": "path",
              "name": "ruleId",
              "description": "ID of the rule.",
              "required": true,
              "schema": {
                "type": "integer",
                "format": "int32"
              }
            }
          ],
          "responses": {
            "default": {
              "content": {
                "application/json": {}
              },
              "description": "default response"
            }
          },
          "tags": [
            "DNS Control Forwarding Rule"
          ]
        }
      }
