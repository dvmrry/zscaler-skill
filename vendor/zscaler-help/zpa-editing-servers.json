    {
      "text": "To edit a server:"
    },
    {
      "item": "From the navigation menu, go to Private Access > Steering > Servers.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          46
        ],
        [
          49,
          57
        ],
        [
          60,
          67
        ]
      ]
    },
    {
      "item": "Locate the server you want to modify, and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          52,
          56
        ]
      ]
    },
    {
      "item": "The Edit Server drawer opens.",
      "depth": 0,
      "strong": [
        [
          4,
          15
        ]
      ]
    },
    {
      "item": "In the Edit Server drawer, modify fields as necessary. To learn more about each field, see Explicitly Defining Servers.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          18
        ]
      ]
    },
    {
      "text": "If there are required fields missing, the Incomplete Configuration icon appears next to the missing item.",
      "strong": [
        [
          42,
          66
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
