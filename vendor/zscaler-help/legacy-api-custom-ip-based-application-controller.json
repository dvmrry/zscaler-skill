    "components": {
      "schemas": {
        "PublicCustomIPBasedApplication": {
          "type": "object",
          "description": "Custom IP-based application configuration for defining applications with custom IP addresses and service endpoints.",
          "properties": {
            "id": {
              "description": "Unique identifier of the custom IP-based application.",
              "type": "integer",
              "format": "int64"
            },
            "name": {
              "description": "Name of the custom IP-based application.",
              "type": "string"
            },
            "isActive": {
              "description": "Indicates whether the custom IP-based application is active or inactive.",
              "type": "boolean"
            },
            "uid": {
              "description": "Unique identifier (UID) for the application.",
              "type": "string"
            },
            "appData": {
              "description": "Array of IPv4-based service endpoints for the application.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PublicAppServiceBlobContract"
              }
            },
            "appDataV6": {
              "description": "Array of IPv6-based service endpoints for the application.",
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PublicAppServiceBlobContract"
              }
            }
          }
        },
        "PublicAppServiceBlobContract": {
          "type": "object",
          "description": "Represents a service endpoint for an application with protocol, port, and network address information.",
          "properties": {
            "protocol": {
              "description": "Protocol used by the application service (e.g., TCP, UDP, HTTP, HTTPS).",
              "type": "string"
            },
            "port": {
              "description": "Port number on which the service listens.",
              "type": "string"
            },
            "ipAddress": {
              "description": "IPv4 address of the application service endpoint.",
              "type": "string"
            },
            "fqdn": {
              "description": "Fully qualified domain name (FQDN) of the application service endpoint.",
              "type": "string"
            }
          }
        }
