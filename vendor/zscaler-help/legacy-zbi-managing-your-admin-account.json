    {
      "text": "The My Profile page displays your basic account information (i.e., username, organization ID, and cloud name) for your Business Insights Admin Portal account. Additionally, you can change your account password on this page."
    },
    {
      "heading": "Changing Your Password",
      "level": 1
    },
    {
      "text": "To change your password:"
    },
    {
      "item": "Go to My Profile.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          16
        ]
      ]
    },
    {
      "item": "Click Change Password.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          21
        ]
      ]
    },
    {
      "text": "The Change Password window appears.",
      "strong": [
        [
          4,
          19
        ]
      ]
    },
    {
      "item": "In the Change Password window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          22
        ]
      ]
    },
    {
      "item": "Old Password: Enter your current password used for logging in to the Business Insights Admin Portal.",
      "depth": 1,
      "strong": [
        [
          0,
          12
        ]
      ]
    },
    {
      "item": "New Password: Enter a new password.",
      "depth": 1,
      "strong": [
        [
          0,
          12
        ]
      ]
