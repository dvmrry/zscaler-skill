      "depth": 1,
      "strong": [
        [
          0,
          20
        ]
      ]
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "After you change your password, the current Business Insights Admin Portal session expires, and the service prompts you to log in using the new password."
    }
