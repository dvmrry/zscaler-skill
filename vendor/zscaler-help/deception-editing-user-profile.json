    {
      "text": "The user profile consists of your name and time zone. It is configured when an administrator provisions an account for you in the Zscaler Deception Admin Portal."
    },
    {
      "text": "Zscaler Deception uses your profile information to configure the portal as follows:"
    },
    {
      "item": "Your name is displayed during specific configurations. It is also used when submitting a ticket to Zscaler Support.",
      "depth": 0
    },
    {
      "item": "The time zone is used when sending automated email alerts.",
      "depth": 0
    },
    {
      "text": "To edit your user profile:"
    },
    {
      "item": "Click the Account Settings icon () in the left-side navigation.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          10,
          26
        ]
      ]
    },
    {
      "item": "The Account Settings page opens.",
      "depth": 0,
      "strong": [
        [
          4,
          20
        ]
      ]
    },
    {
      "item": "On the Profile tab, under Edit Profile:",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          14
        ],
        [
          26,
          38
        ]
      ]
    },
    {
      "item": "Enter your name.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "Select a time zone from the Time Zone drop-down menu.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          28,
          37
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
