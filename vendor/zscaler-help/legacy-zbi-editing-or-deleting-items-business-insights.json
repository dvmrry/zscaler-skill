    {
      "text": "In the Business Insights Admin Portal, you can edit or delete items you've configured, such as admins and roles."
    },
    {
      "heading": "Editing Items",
      "level": 1
    },
    {
      "text": "To edit items:"
    },
    {
      "item": "Navigate to the item you want to edit. In this example, it's an office.",
      "depth": 0,
      "number": 1
    },
    {
      "item": "Click the Edit icon for that item.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "item": "Make your edits and save the changes.",
      "depth": 0,
      "number": 3
    },
    {
      "text": "See image."
    },
    {
      "heading": "Deleting Items",
      "level": 1
    },
    {
      "text": "To delete items:"
    },
    {
      "item": "Navigate to the item you want to delete. In this example, it's an office.",
      "depth": 0,
      "number": 1
    },
    {
      "item": "Click the Delete icon for that item.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "A confirmation message appears. If you are sure you want to delete the item, click Delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          83,
          89
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    }
  ]
