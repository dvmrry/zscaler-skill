    "updated": "2026-06-19",
    "updated_basis": "file-last-modified"
  },
  "captured_at": "2026-11-03",
  "spec": {
    "swagger": "2.0",
    "info": {
      "version": "v1",
      "title": "ZIA Cloud Service and Sandbox Submission APIs",
      "description": "API Reference Guide for the ZIA Cloud Service and Sandbox Submission APIs\n"
    },
    "host": "zsapi.[zscaler-cloud-name]",
    "basePath": "/api/v1",
    "schemes": [
      "https"
    ],
    "tags": [
      {
        "name": "Adaptive Access Profiles"
      }
    ],
    "paths": {
      "/adaptiveAccessProfiles": {
        "get": {
          "tags": [
            "Adaptive Access Profiles"
          ],
          "description": "Retrieves a list of all Adaptive Access profiles. To learn more, see <a href=\"/unified/about-adaptive-access-profiles\" target=\"_blank\">About Adaptive Access Profiles</a>.",
          "operationId": "AdaptiveAccessProfileResource_getAdaptiveAccessProfiles",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/AdaptiveAccessProfile"
                }
              }
            }
          }
        }
      },
      "/adaptiveAccessProfiles/profiles/rules": {
        "get": {
          "tags": [
            "Adaptive Access Profiles"
          ],
          "description": "Retrieves the Adaptive Access profile information based on the specified ID",
          "operationId": "AdaptiveAccessProfileResource_getRuleNamesAssociatedWithProfiles",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "iamAapIds",
              "in": "query",
              "description": "Filters based on the Adaptive Access profile IDs",
              "required": false,
              "type": "array",
              "items": {
                "type": "string"
              },
              "collectionFormat": "multi"
            },
            {
              "name": "orgId",
              "in": "query",
              "description": "Filters based on the organization ID",
              "required": false,
              "type": "integer",
              "format": "int32"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/AdaptiveAccessProfile"
                }
              }
            }
          }
        }
      }
    },
    "definitions": {
      "AdaptiveAccessProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "The Adaptive Access profile ID"
          },
          "name": {
            "type": "string",
            "description": "The Adaptive Access profile name"
          },
          "type": {
            "type": "string",
            "description": "The Adaptive Access profile type",
            "enum": [
              "USER",
              "DEVICE"
            ]
          },
          "aapIndex": {
            "type": "integer",
            "format": "int32",
            "description": "The Adaptive Access profile index"
          },
          "iamAapId": {
            "type": "string",
            "description": "The Adaptive Access profile ID that is used by the API for policy configuration. This field allows you to specify which Adaptive Access profiles are applied in the access policy criteria."
          },
          "deleted": {
            "type": "boolean",
            "description": "A Boolean value that indicates whether the Adaptive Access profile is deleted"
          }
        }
      }
    }
  }
}
