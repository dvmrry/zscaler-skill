    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete network decoys that you configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a Network Decoy",
      "level": 1
    },
    {
      "item": "Stop the decoys.",
      "depth": 0,
      "number": 1
    },
    {
      "item": "Go to Deceive > Network Decoys.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          16,
          30
        ]
      ]
    },
    {
      "item": "Select the Internal or Zero Trust Network tab.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          11,
          19
        ],
        [
          23,
          41
        ]
      ]
    },
    {
      "item": "Navigate to the network decoy you want to edit, and click the Edit icon.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          62,
          66
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the Network Decoy Detail window, modify the decoy configuration per your requirements.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          7,
          27
        ]
      ]
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Start the decoys.",
      "depth": 0,
      "number": 7
    },
    {
      "heading": "Deleting a Network Decoy",
      "level": 1
    },
    {
      "item": "Stop the decoys.",
      "depth": 0,
      "number": 1
    },
    {
      "item": "Select the Internal or Zero Trust Network tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          11,
          19
        ],
        [
          23,
          41
        ]
      ]
    },
    {
      "item": "Navigate to the network decoy you want to delete, and click the Delete icon.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          64,
          70
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "item": "Start the decoys.",
      "depth": 0,
      "number": 5
    }
  ]
}
