  "blocks": [
    {
      "text": "This article provides the list of AWS IAM condition operators and keys that AISPM supports for managing principal-based (identity-based) and resource-based access for scanning data."
    },
    {
      "heading": "Condition Operators",
      "level": 1
    },
    {
      "text": "The following operators are supported:"
    },
    {
      "item": "String",
      "depth": 0
    },
    {
      "item": "StringEquals",
      "depth": 1
    },
    {
      "item": "StringNotEquals",
      "depth": 1
    },
    {
      "item": "StringEqualsIgnoreCase",
      "depth": 1
    },
    {
      "item": "StringNotEqualsIgnoreCase",
      "depth": 1
    },
    {
      "item": "StringLike",
      "depth": 1
    },
    {
      "item": "StringNotLike",
      "depth": 1
    },
    {
      "item": "StringEqualsIfExists",
      "depth": 1
    },
    {
      "item": "StringNotEqualsIfExists",
      "depth": 1
    },
    {
      "item": "StringEqualsIgnoreCaseIfExists",
      "depth": 1
    },
    {
      "item": "StringNotEqualsIgnoreCaseIfExists",
      "depth": 1
    },
    {
      "item": "StringLikeIfExists",
      "depth": 1
    },
    {
      "item": "StringNotLikeIfExists",
      "depth": 1
    },
    {
      "item": "ARN",
      "depth": 0
    },
    {
      "item": "ArnEquals",
      "depth": 1
    },
    {
      "item": "ArnNotEquals",
      "depth": 1
    },
    {
      "item": "ArnLike",
      "depth": 1
    },
    {
      "item": "ArnNotLike",
      "depth": 1
    },
    {
      "item": "ArnEqualsIfExists",
      "depth": 1
    },
    {
      "item": "ArnLikeIfExists",
      "depth": 1
    },
    {
      "item": "ArnNotEqualsIfExists",
      "depth": 1
    },
    {
      "item": "ArnNotLikeIfExists",
      "depth": 1
    },
    {
      "item": "Boolean",
      "depth": 0
    },
    {
      "item": "BoolAI Security supports NotPrincipal element in IAM policies. To learn more, refer to the AWS documentation.",
      "depth": 0
    },
    {
      "text": "The following operators are not supported:"
    },
    {
      "item": "Numeric operators (NumericEquals, NumericNotEquals, NumericLessThan, etc.)",
      "depth": 0
    },
    {
      "item": "Date operators (DateEquals, DateNotEquals, DateLessThan, etc.)",
      "depth": 0
    },
    {
      "item": "IP Address operators (IpAddress, NotIpAddress)",
      "depth": 0
    },
    {
      "item": "Binary operators (BinaryEquals)",
      "depth": 0
    },
    {
      "text": "To learn more, refer to the AWS documentation."
    },
    {
      "heading": "Condition Keys",
      "level": 1
    },
    {
      "text": "The following keys are supported:"
    },
    {
      "item": "Principal-Based Keys",
      "depth": 0
    },
    {
      "item": "aws:PrincipalTag/tag-key",
      "depth": 1
    },
    {
      "item": "aws:PrincipalOrgID",
      "depth": 1
    },
    {
      "item": "aws:PrincipalArn",
      "depth": 1
    },
    {
      "item": "aws:PrincipalAccount",
      "depth": 1
    },
    {
      "item": "aws:PrincipalIsAWSService",
      "depth": 1
    },
    {
      "item": "aws:PrincipalServiceName",
      "depth": 1
    },
    {
      "item": "aws:PrincipalServiceNamesList",
      "depth": 1
    },
    {
      "item": "aws:PrincipalType",
      "depth": 1
    },
    {
      "item": "aws:userid",
      "depth": 1
    },
    {
      "item": "aws:username",
      "depth": 1
    },
    {
      "item": "Resource-Based Keys",
      "depth": 0
    },
    {
      "item": "aws:ResourceTag/tag-key",
      "depth": 1
    },
    {
      "item": "aws:ResourceAccount",
      "depth": 1
    },
    {
      "item": "aws:ResourceOrgID",
      "depth": 1
    },
    {
      "text": "The following keys are not supported:"
    },
    {
      "item": "Principal-based condition keys: aws:PrincipalOrgPaths: AWS organizations path evaluation",
      "depth": 0
    },
    {
      "item": "Resource-based condition keys: aws:ResourceOrgPaths: AWS organizations path evaluation",
      "depth": 0
    },
    {
      "item": "Network and request context keys:",
      "depth": 0
    },
    {
      "item": "aws:SourceIp: Source IP address",
      "depth": 1
    },
    {
      "item": "aws:SourceVpc: Source VPC ID",
      "depth": 1
    },
    {
      "item": "aws:SourceVpce: Source VPC endpoint ID",
      "depth": 1
    },
    {
      "item": "aws:VpcSourceIp: VPC source IP address",
      "depth": 1
    },
    {
      "item": "aws:CurrentTime: Current date or time",
      "depth": 1
    },
    {
      "item": "aws:EpochTime: Epoch time",
      "depth": 1
    },
    {
      "item": "aws:RequestedRegion: Requested AWS region",
      "depth": 1
    },
    {
      "item": "aws:SecureTransport: HTTPS or TLS usage",
      "depth": 1
    },
    {
      "item": "aws:UserAgent: User agent string",
      "depth": 1
    },
    {
      "item": "aws:referer: HTTP referer header",
      "depth": 1
    },
    {
      "item": "Advanced context keys:",
      "depth": 0
    },
    {
      "item": "aws:CalledVia: Service call chain",
      "depth": 1
    },
    {
      "item": "aws:CalledViaFirst: First service in call chain",
      "depth": 1
    },
    {
      "item": "aws:CalledViaLast: Last service in call chain",
      "depth": 1
    },
    {
      "item": "aws:ViaAWSService: Called via AWS service",
      "depth": 1
    },
    {
      "item": "aws:SourceAccount: Source account for service calls",
      "depth": 1
    },
    {
      "item": "aws:SourceArn: Source ARN for service calls",
      "depth": 1
    },
    {
      "item": "aws:SourceOrgID: Source organization ID",
      "depth": 1
    },
    {
      "item": "aws:MultiFactorAuthPresent: MFA authentication",
      "depth": 1
    },
    {
      "item": "aws:MultiFactorAuthAge: MFA age",
      "depth": 1
    },
    {
      "item": "aws:TokenIssueTime: Token issue time",
      "depth": 1
    },
    {
      "text": "When condition keys are not supported, then evaluation of the condition is skipped (e.g., aws:PrincipalOrgPaths)."
    },
    {
      "heading": "Unsupported Features",
      "level": 1
    },
    {
      "text": "The following features are not supported:"
    },
    {
      "item": "Numeric and Date Conditions: No support for numeric or date-based comparisons.",
      "depth": 0,
      "strong": [
        [
          0,
          27
        ]
      ]
    },
    {
      "item": "Network Context: No IP address, VPC, or network-based conditions.",
      "depth": 0,
      "strong": [
        [
          0,
          15
        ]
      ]
    },
    {
      "item": "Time-Based Access: No support for time-based access controls.",
      "depth": 0,
      "strong": [
        [
          0,
          17
        ]
      ]
    },
    {
      "item": "MFA Conditions: No support for MFA validation.",
      "depth": 0,
      "strong": [
        [
          0,
          14
        ]
      ]
    },
    {
      "item": "Service Integration Context: Limited support for cross-service condition keys.",
      "depth": 0,
      "strong": [
        [
          0,
          27
        ]
      ]
    },
    {
      "item": "Organization Paths: No support for AWS organizations path-based conditions.",
      "depth": 0,
      "strong": [
        [
          0,
          18
        ]
      ]
    },
    {
      "item": "Dynamic Conditions: Dynamic conditions like <pre> tag where we have to deduce a value are not supported.",
      "depth": 0,
      "strong": [
        [
          0,
          18
        ]
      ]
    }
  ]
}
