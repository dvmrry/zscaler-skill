    {
      "text": "In the Zscaler Admin Console, you can edit or delete an existing location from the Locations page. You can also use a CSV file to add and remove multiple locations and sublocations."
    },
    {
      "heading": "Editing Locations",
      "level": 1
    },
    {
      "text": "To edit an existing location:"
    },
    {
      "item": "From the navigation menu, go to Infrastructure > Location Management > Legacy Locations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          87
        ]
      ]
    },
    {
      "item": "Click Edit for the location you want to modify. The Edit Location window appears.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          10
        ],
        [
          52,
          65
        ]
      ]
    },
    {
      "item": "In the Edit Location window, modify the location parameters.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          20
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save and activate the change.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting Locations",
      "level": 1
    },
    {
      "text": "To delete an existing location:"
    },
    {
      "item": "From the navigation menu, go to Infrastructure > Location Management > Legacy Locations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          87
        ]
      ]
    },
    {
      "item": "Click Edit for the location you want to delete. The Edit Location window appears.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          10
        ],
        [
          52,
          65
        ]
      ]
    },
    {
      "item": "In the Edit Location window, click Delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          20
        ],
        [
          35,
          41
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Read the warning message that appears and then click Confirm to delete the location.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          53,
          60
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    }
  ]
}
