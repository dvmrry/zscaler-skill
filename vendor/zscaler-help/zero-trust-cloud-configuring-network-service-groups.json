    {
      "text": "You can group network services into a service group for easy application of firewall policies."
    },
    {
      "text": "To create a network services group:"
    },
    {
      "item": "From the navigation menu, go to Internet Access > Resources > Network Services > Service Groups.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          47
        ],
        [
          50,
          59
        ],
        [
          62,
          78
        ],
        [
          81,
          95
        ]
      ]
    },
    {
      "item": "On the Service Groups page, click Add Network Service Group.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          21
        ],
        [
          34,
          59
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Add Network Service Group window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          32
        ]
      ]
    },
    {
      "item": "Name: Enter a name for the network services group.",
      "depth": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Service: From the drop-down menu, select any number of custom and predefined services you want to include in the group",
      "depth": 1,
      "strong": [
        [
          0,
          7
        ]
      ]
    },
    {
      "item": "Description: Enter additional notes or information about the network services group. The description cannot exceed 10,240 characters.",
      "depth": 1,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Save and activate the change.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
