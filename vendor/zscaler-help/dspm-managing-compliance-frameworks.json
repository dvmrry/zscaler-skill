  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can enable or disable a predefined framework and edit, delete, enable, or disable a custom framework."
    },
    {
      "heading": "Enabling or Disabling a Compliance Framework",
      "level": 1
    },
    {
      "text": "Failed policies are not calculated for disabled frameworks."
    },
    {
      "text": "When you click a disabled framework, you are directed to the Configuration tab and the Summary, Policies, and Resources tabs are disabled."
    },
    {
      "text": "To enable or disable a compliance framework:"
    },
    {
      "item": "From the navigation menu, go to Data Security > DSPM > Compliance.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          45
        ],
        [
          48,
          52
        ],
        [
          55,
          65
        ]
      ]
    },
    {
      "item": "On the Compliance page, click the Actions () icon for the required compliance framework.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          17
        ],
        [
          34,
          41
        ]
      ]
    },
    {
      "item": "Select Enable or Disable.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          13
        ],
        [
          17,
          24
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The disabled frameworks are displayed at the end and grayed out.",
      "depth": 0
    },
    {
      "heading": "Editing a Custom Compliance Framework",
      "level": 1
    },
    {
      "text": "To edit a custom compliance framework:"
    },
    {
      "item": "Go to Data Security > DSPM > Compliance.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          19
        ],
        [
          22,
          26
        ],
        [
          29,
          39
        ]
      ]
    },
    {
      "item": "On the Compliance page, click the Actions () icon for the required compliance framework and select Edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          17
        ],
        [
          34,
          41
        ],
        [
          99,
          103
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "You are directed to the Summary page.",
      "depth": 0,
      "strong": [
        [
          24,
          31
        ]
      ]
    },
    {
      "item": "On the Summary page, change the Framework Name or Framework Description as required.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          14
        ],
        [
          32,
          46
        ],
        [
          50,
          71
        ]
      ]
    },
    {
      "item": "Click the Edit icon for Categories, Policies, or DLP Engines, and update the fields as required.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          10,
          14
        ],
        [
          24,
          34
        ],
        [
          36,
          44
        ],
        [
          49,
          61
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Finish.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "heading": "Deleting a Custom Compliance Framework",
      "level": 1
    },
    {
      "text": "To delete a custom compliance framework:"
    },
    {
      "item": "Go to Data Security > DSPM > Compliance.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          19
        ],
        [
          22,
          26
        ],
        [
          29,
          39
        ]
      ]
    },
    {
      "item": "On the Compliance page, click the Actions () icon for the required compliance framework and select Delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          17
        ],
        [
          34,
          41
        ],
        [
          99,
          105
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "On the Delete Framework window, enter CONFIRM, and then click Confirm.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          23
        ],
        [
          62,
          69
        ]
      ]
    },
    {
      "item": "The custom framework is deleted from the Zscaler Admin Console.",
      "depth": 0
    }
  ]
}
