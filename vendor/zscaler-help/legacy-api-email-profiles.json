  "spec": {
    "swagger": "2.0",
    "info": {
      "version": "v1",
      "title": "ZIA Cloud Service and Sandbox Submission APIs",
      "description": "API Reference Guide for the ZIA Cloud Service and Sandbox Submission APIs\n"
    },
    "host": "zsapi.[zscaler-cloud-name]",
    "basePath": "/api/v1",
    "schemes": [
      "https"
    ],
    "tags": [
      {
        "name": "Email Profiles"
      }
    ],
    "paths": {
      "/emailRecipientProfile": {
        "get": {
          "tags": [
            "Email Profiles"
          ],
          "description": "Retrieves a list of all recipient email profiles in an organization. To learn more, see <a href=\"/zia/about-email-profiles\" target=\"_blank\">About Email Profiles</a>.",
          "operationId": "EmailRecipientProfileResource_getEmailRecipientProfiles",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "name",
              "in": "query",
              "description": "Filters the profiles based on the recipient profile name",
              "required": false,
              "type": "string"
            },
            {
              "name": "emailRecipient",
              "in": "query",
              "description": "Filters based on the recipient email included in each profile",
              "required": false,
              "type": "string"
            },
            {
              "name": "description",
              "in": "query",
              "description": "Filters the profiles based on the description field",
              "required": false,
              "type": "string"
            },
            {
              "name": "page",
              "in": "query",
              "description": "Specifies the page offset",
              "required": false,
              "type": "integer",
              "default": 1,
              "format": "int32"
            },
            {
              "name": "pageSize",
              "in": "query",
              "description": "Specifies the page size",
              "required": false,
              "type": "integer",
              "default": 100,
              "format": "int32"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/EmailRecipientProfile"
                }
              }
            }
          }
        },
        "post": {
          "tags": [
            "Email Profiles"
          ],
          "description": "Adds a new recipient profile. To learn more, see <a href=\"/zia/adding-email-profiles\" target=\"_blank\">Adding Email Profiles</a>.",
          "operationId": "EmailRecipientProfileResource_createEmailRecipientProfile",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "in": "body",
              "name": "body",
              "description": "Information about the email recipient profile",
              "required": false,
              "schema": {
                "$ref": "#/definitions/EmailRecipientProfile"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/EmailRecipientProfile"
              }
            }
          }
        }
      },
      "/emailRecipientProfile/{profileId}": {
        "get": {
          "tags": [
            "Email Profiles"
          ],
          "description": "Retrieves the recipient email profile based on the specified ID",
          "operationId": "EmailRecipientProfileResource_getEmailRecipientProfileById",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "profileId",
              "in": "path",
              "description": "Specifies the recipient profile ID",
              "required": true,
              "type": "integer",
              "format": "int32"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/EmailRecipientProfile"
              }
            }
          }
        },
        "put": {
          "tags": [
            "Email Profiles"
          ],
          "description": "Updates the recipient email profile based on the specified ID",
          "operationId": "EmailRecipientProfileResource_updateEmailRecipientProfile",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "profileId",
              "in": "path",
              "description": "Specifies the recipient profile ID",
              "required": true,
              "type": "integer",
              "format": "int32"
            },
            {
              "in": "body",
              "name": "body",
              "description": "Information about the email recipient profile",
              "required": false,
              "schema": {
                "$ref": "#/definitions/EmailRecipientProfile"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/EmailRecipientProfile"
              }
            }
          }
        },
        "delete": {
          "tags": [
            "Email Profiles"
          ],
          "description": "Deletes the recipient email profile based on the specified ID",
          "operationId": "EmailRecipientProfileResource_deleteEmailRecipientProfile",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "profileId",
              "in": "path",
              "description": "Specifies the recipient profile ID",
              "required": true,
              "type": "integer",
              "format": "int32"
            }
          ],
          "responses": {
            "default": {
              "description": "Successful Operation"
            }
          }
        }
      },
      "/emailRecipientProfile/lite": {
        "get": {
          "tags": [
            "Email Profiles"
          ],
          "description": "Retrieves a list of all recipient email profiles in an organization",
          "operationId": "EmailRecipientProfileResource_getEmailRecipientProfilesLite",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "name",
              "in": "query",
              "description": "Filters the profiles based on the recipient profile name",
              "required": false,
              "type": "string"
            },
            {
              "name": "description",
              "in": "query",
              "description": "Filters the profiles based on the description field",
              "required": false,
              "type": "string"
            },
            {
              "name": "consumer",
              "in": "query",
              "description": "Filters the profiles based on the type of consumer",
              "required": false,
              "type": "string",
              "default": "EMAIL_DLP",
              "enum": [
                "SAAS_TENANT",
                "WEB_DLP",
                "CASB_DLP",
                "EMAIL_DLP"
              ]
            },
            {
              "name": "tenantIds",
              "in": "query",
              "description": "Filters the profiles based on the tenant ID",
              "required": false,
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              },
              "collectionFormat": "multi"
            },
            {
              "name": "page",
              "in": "query",
              "description": "Specifies the page offset",
              "required": false,
              "type": "integer",
              "default": 1,
              "format": "int32"
            },
            {
              "name": "pageSize",
              "in": "query",
              "description": "Specifies the page size",
              "required": false,
              "type": "integer",
              "default": 100,
              "format": "int32"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/EmailRecipientProfile"
                }
              }
            }
          }
        }
      },
      "/emailRecipientProfile/count": {
        "get": {
          "tags": [
            "Email Profiles"
          ],
          "description": "Retrieves the count of recipient email profiles",
          "operationId": "EmailRecipientProfileResource_getEmailRecipientProfilesCount",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "name",
              "in": "query",
              "description": "Specifies the recipient profile name",
              "required": false,
              "type": "string"
            },
            {
              "name": "emailRecipient",
              "in": "query",
              "description": "Specifies the recipient email included in each profile",
              "required": false,
              "type": "string"
            },
            {
              "name": "description",
              "in": "query",
              "description": "Additional information about the recipient profile",
              "required": false,
              "type": "string"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "type": "integer",
                "format": "int32"
              }
            }
          }
        }
      }
    },
    "definitions": {
      "EmailRecipientProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Unique identifier for the recipient email profile"
          },
          "name": {
            "type": "string",
            "description": "The recipient email profile name"
          },
          "description": {
            "type": "string",
            "description": "Additional information about the recipient email profile"
          },
          "emails": {
            "type": "array",
            "description": "List of email addresses for the recipient email profile",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
