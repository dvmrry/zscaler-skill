      "item": "(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {",
      "depth": 3
    },
    {
      "item": "// implement resource here",
      "depth": 3
    },
    {
      "item": "var headers = request.headers;",
      "depth": 3
    },
    {
      "item": "var authHeader = request.getHeader('authorization');",
      "depth": 3
    },
    {
      "item": "var token = authHeader.split(\" \");",
      "depth": 3
    },
    {
      "item": "if (token[1] != gs.getProperty(\"risk.360.token\"))",
      "depth": 3
    },
    {
      "item": "response.setError(new sn_ws_err.BadRequestError('Bad token'));",
      "depth": 3
