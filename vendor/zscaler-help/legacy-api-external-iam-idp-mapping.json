    },
    "components": {
      "schemas": {
        "IamIdpMapping": {
          "properties": {
            "iamIdpIdToIamIdMapping": {
              "$ref": "#/components/schemas/IamIdpIdToIamIdMapping"
            },
            "id": {
              "type": "integer",
              "description": "The unique identifier of the external IAM IdP.",
              "format": "int32"
            },
            "sequence": {
              "type": "integer",
              "description": "A monotonically increasing, database-generated sequence number that tracks record revisions and change order.",
              "format": "int64"
            }
          }
        },
        "ZPathAPIError": {
          "properties": {
            "reason": {
              "type": "string",
              "description": "The reason for the cause of the error status code. To learn more, see <a href=\"/zpa/api-response-codes-and-error-messages\" target= _blank>API Response Codes and Error Messages</a>."
            },
            "id": {
              "type": "string",
              "description": "The unique identifier of the error status code."
            },
            "params": {
              "type": "array",
              "description": "The parameters that were sent in the request body.",
              "items": {
                "type": "object"
              }
            },
            "hostname": {
              "type": "string",
              "description": "The client server address or domain name."
            }
          }
        },
        "IamIdpIdToIamIdMapping": {
          "required": [
            "orgId"
          ],
          "properties": {
            "deliveryTag": {
              "type": "integer",
              "description": "The message delivery identifier assigned by the messaging system or message broker (e.g., AMQP, RabbitMQ, or Authentication Service messaging pipeline) when delivering the sync event.",
              "format": "int64"
            },
            "mappings": {
              "type": "array",
              "description": "A list of mapping objects representing the associations between the local ZPA identity providers and external Authentication Service or IAM identity providers.",
              "items": {
                "$ref": "#/components/schemas/Mapping"
              }
            },
            "orgId": {
              "type": "string",
              "description": "The customer organization or tenant ID represented as a string."
            },
            "syncVersion": {
              "type": "integer",
              "description": "A monotonically increasing version number used for optimistic concurrency ocntrol and sync ordering between Authentication Service and ZPA.",
              "format": "int64",
              "writeOnly": true
            }
          }
        },
        "Mapping": {
          "properties": {
            "iamIdpId": {
              "type": "string",
              "description": "The unique identifier of the external IAM IdP."
            },
            "idpId": {
              "type": "integer",
              "format": "int64",
              "description": "The ID of the IdP."
            },
            "idpName": {
              "type": "string",
              "description": "The name of the IdP."
            }
          }
        }
      }
