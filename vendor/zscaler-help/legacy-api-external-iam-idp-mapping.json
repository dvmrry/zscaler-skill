    "paths": {
      "/mgmtconfig/v1/admin/customers/{customerId}/iamidpmapping": {
        "get": {
          "tags": [
            "External IAM IdP Mapping"
          ],
          "summary": "Gets the external IAM identity provider (IdP) mapping details for the specified customer.",
          "operationId": "getIamIdpMapping",
          "parameters": [
            {
              "name": "customerId",
              "in": "path",
              "required": true,
              "description": "The ZPA tenant ID of the customer.",
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "*/*": {
                  "schema": {
                    "$ref": "#/components/schemas/IamIdpMapping"
                  }
                }
              }
            },
