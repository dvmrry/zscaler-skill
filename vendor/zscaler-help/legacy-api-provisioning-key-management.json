          ],
          "description": "Gets details of the provisioning key for the specified ID.",
          "operationId": "getNonce_1",
          "parameters": [
            {
              "name": "customerId",
              "in": "path",
              "description": "The unique identifier of the ZPA tenant.",
              "required": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            },
            {
              "name": "associationType",
              "in": "path",
              "description": "Specifies the provisioning key type for App Connectors, ZPA Private Service Edges, or Network Connectors. The supported values are App Connector group (i.e., CONNECTOR_GRP), Network Connector group (i.e., NP_ASSISTANT_GRP), and ZPA Private Service Edge group (i.e., SERVICE_EDGE_GRP).",
              "required": true,
              "explode": false,
              "schema": {
                "type": "string"
              }
