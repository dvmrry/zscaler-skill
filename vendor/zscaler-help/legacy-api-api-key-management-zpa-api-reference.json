    "components": {
      "schemas": {
        "ZPathAPIError": {
          "properties": {
            "reason": {
              "type": "string",
              "description": "The reason for the cause of the error status code. To learn more, see <a href=\"/zpa/api-response-codes-and-error-messages\" target= _blank>API Response Codes and Error Messages</a>."
            },
            "id": {
              "type": "string",
              "description": "The unique identifier of the error status code."
            },
            "params": {
              "type": "array",
              "description": "The parameters that were sent in the request body.",
              "items": {
                "type": "object"
              }
            },
            "hostname": {
              "type": "string",
              "description": "The client server address or domain name."
            }
          }
        },
        "PageListClientCredentialsResource": {
          "properties": {
            "totalPages": {
              "type": "integer",
              "description": "The total number of pages per the pagination attribute.",
              "format": "int32"
            },
            "currentCount": {
              "type": "integer",
              "description": "The current count of resources per the search feature.",
              "format": "int64"
            },
            "totalCount": {
              "type": "integer",
              "description": "The total count of resources per the search feature.",
              "format": "int64"
            },
            "list": {
              "type": "array",
              "description": "The total list of API key resources.",
              "items": {
                "$ref": "#/components/schemas/ClientCredentialsResource"
              }
            }
          }
        },
        "ClientCredentials": {
          "required": [
            "name"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "description": "The unique identifier of the API key.",
              "format": "int64"
            },
            "modifiedTime": {
              "type": "integer",
              "description": "The time the API key is modified.",
              "format": "int32"
            },
            "creationTime": {
              "type": "integer",
              "description": "The time the API key is created.",
              "format": "int32"
            },
            "modifiedBy": {
              "type": "integer",
              "description": "The unique identifier of the tenant who modified the API key.",
              "format": "int64"
            },
            "name": {
              "type": "string",
              "description": "The name of the API key."
            },
            "microtenantId": {
              "type": "integer",
              "description": "The unique identifier of the Microtenant for the ZPA tenant. If you are within a Microtenant, you must pass the microtenantId field when making an API call to retrieve data from that Microtenant. The microtenantId can be obtained from the API Keys page, or can be obtained programmatically using the ZPA cloud service API. Access to certain operations is limited when you are within a Microtenant. If you are within the Default Microtenant, pass microtenantId as 0 when making requests to retrieve data from the Default Microtenant. If the microtenantId is not passed in the request when creating or updating a resource, then the resource is created or updated in the Default Microtenant.",
              "format": "int64"
            },
            "microtenantName": {
              "type": "string",
              "description": "The name of the Microtenant."
            },
            "restrictionType": {
              "type": "string",
              "description": "Indicates if the API key is managed by Zscaler (<code>ZSCALER_MANAGED</code>) or is created by Zscaler Deception (<code>DECEPTION</code>)."
            },
            "clientId": {
              "type": "string",
              "description": "The ID for the API key. It is needed to access the ZPA API Portal."
            },
            "clientSecret": {
              "type": "string",
              "description": "The secret for the API key. It is needed to access the ZPA API Portal."
            },
            "enabled": {
              "type": "boolean",
              "description": "Indicates if the API key is enabled (true) or disabled (false)."
            },
            "tokenExpiryTimeInSec": {
              "type": "integer",
              "description": "The amount of time the API key is available to use. The maximum amount of time is 3,600 seconds.",
              "format": "int32"
            },
            "roleId": {
              "type": "integer",
              "description": "The unique identifier of the administrator role. To learn more, see <a href =\"/zpa/managing-administrator-roles-using-api\" target= _blank>Managing Administrator Roles Using API</a>.",
              "format": "int64"
            },
            "pinSessionEnabled": {
              "type": "boolean"
            },
            "isLocked": {
              "type": "boolean",
              "description": "Indicates if the API Keys are locked (true) or not (false)."
            },
            "syncVersion": {
              "type": "integer",
              "format": "int64"
            },
            "iamClientId": {
              "type": "string",
              "description": "The client ID of the API key created in ZIdentity. This field is read only and is ignored in POST and PUT requests."
            },
            "readOnly": {
