    {
      "item": "Click Export.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "All datalists are downloaded to your system as a collection in a ZIP file.",
      "depth": 0
    },
    {
