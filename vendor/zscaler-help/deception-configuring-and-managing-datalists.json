        ],
        [
          20,
          33
        ],
        [
          36,
          44
        ]
      ]
    },
    {
      "item": "Locate the datalist that you want to download, and click the Download icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          61,
          69
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The datalist is downloaded to your system as a JSON file.",
      "depth": 0
    },
    {
      "text": "To download all datalists:"
