    {
      "text": "The AI Security API uses the following response codes and error messages."
    },
    {
      "table": [
        [
          "Code",
          "Description"
        ],
        [
          "200",
          "The request was successful"
        ],
        [
          "400",
          "The server could not understand the request due to invalid syntax"
        ],
        [
          "401",
          "Access is unauthorized"
        ],
        [
          "403",
          "Access is forbidden"
        ],
        [
          "404",
          "The server cannot find the requested resource"
        ],
        [
          "429",
          "Client error"
        ],
        [
          "500",
          "Server error"
        ]
      ]
    }
  ]
}
