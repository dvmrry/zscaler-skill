  "blocks": [
    {
      "text": "You can schedule executive summary reports for regular distribution to specified recipients."
    },
    {
      "text": "To schedule an executive report:"
    },
    {
      "item": "Go to Analytics > Executive Report.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          15
        ],
        [
          18,
          34
        ]
      ]
    },
    {
      "item": "Click the Schedule Report icon in the top right-hand corner.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          25
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the Add Schedule Report window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          26
        ]
      ]
    },
    {
      "item": "Schedule Name: Enter a unique name for the report.",
      "depth": 1,
      "strong": [
        [
          0,
          13
        ]
      ]
    },
    {
      "item": "Report: Select the report for scheduling. By default, the default Executive Report page is selected.",
      "depth": 1,
      "strong": [
        [
          0,
          6
        ]
      ]
    },
    {
      "item": "Recipients: Enter the email addresses of the recipients.",
      "depth": 1,
      "strong": [
        [
          0,
          10
        ]
      ]
    },
    {
      "item": "Status: Select the status (Enabled or Disabled) to enable or disable scheduling.",
      "depth": 1,
      "strong": [
        [
          0,
          6
        ],
        [
          27,
          34
        ],
        [
          38,
          46
        ]
      ]
    },
    {
      "item": "Frequency: Select a schedule as follows:",
      "depth": 1,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
      "item": "Select Daily and select the time and timezone.",
      "depth": 2,
      "strong": [
        [
          7,
          12
        ],
        [
          28,
          32
        ],
        [
          37,
          45
        ]
      ]
    },
    {
      "item": "Select Weekly and select the day, time, and timezone.",
      "depth": 2,
      "strong": [
        [
          7,
          13
        ],
        [
          29,
          32
        ],
        [
          34,
          38
        ],
        [
          44,
          52
        ]
      ]
    },
    {
      "item": "Select Monthly and select the date, time, and timezone.",
      "depth": 2,
      "strong": [
        [
          7,
          14
        ],
        [
          30,
          34
        ],
        [
          36,
          40
        ],
        [
          46,
          54
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "A message appears indicating that the schedule report is created successfully and can be viewed under Scheduled Reports."
    }
  ]
}
