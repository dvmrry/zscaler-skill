    {
      "text": "If you want to reset the orchestrator or monitoring scope subscriptions after deploying the onboarding template, run the terraform destroy command to purge the template and delete any resource that was created."
    },
    {
      "text": "To reset the configured subscriptions:"
    },
    {
      "item": "Select Orchestrator & Monitoring Scope and click Reset.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          7,
          38
        ],
        [
          49,
          54
        ]
      ]
    },
    {
      "item": "In the Reset Configured Subscription window, click Confirm.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          36
        ],
        [
          51,
          58
        ]
      ]
    },
    {
      "item": "Configure new subscriptions.",
      "depth": 0,
