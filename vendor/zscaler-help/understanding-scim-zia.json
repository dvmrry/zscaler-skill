      "heading": "Operations Supported by Zscaler SCIM Servers",
      "level": 1
    },
    {
      "table": [
        [
          "Operation",
          "HTTP Request"
        ],
        [
          "Endpoint /Users",
          ""
        ],
        [
          "Create User",
          "POST /Users"
        ],
        [
          "Retrieve All Users (up to 1,000 entries)",
          "GET /Users"
        ],
        [
          "Retrieve All Users (1,000 users from specified index value)",
          "GET /Users?startIndex=<value>"
        ],
        [
          "Retrieve a Specific User",
          "GET /Users/{UserID}"
        ],
        [
          "Filter Users by Username",
          "GET /Users?filter=userName eq <value>"
        ],
        [
          "Filter Users by External ID",
          "GET /Users?filter=externalID eq <value>"
        ],
        [
          "Filter Users by ID",
          "GET /Users?filter=id eq <value>"
        ],
        [
          "Filter Users by Date Created After",
          "GET /Users?filter=meta.lastModified gt <value>"
        ],
        [
          "Update User",
          "PUT /Users/{UserID} or PATCH /Users/{UserID}"
        ],
        [
          "Delete User",
          "DELETE /Users/{UserID}"
        ]
