                  "$ref": "#/definitions/VirtualZenCluster"
                }
              }
            }
          }
        },
        "post": {
          "tags": [
            "Service Edges"
          ],
          "description": "Adds a new Virtual Service Edge cluster. To learn more, see <a href=\"/zia/adding-virtual-service-edge-clusters\" target=\"_blank\">Adding Virtual Service Edge Clusters</a>.",
          "operationId": "VirtualZenClusterResource_addVirtualZenCluster",
          "consumes": [
