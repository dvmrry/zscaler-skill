  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete a Threat Intelligence (TI) decoy that you have configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a Threat Intelligence Decoy",
      "level": 1
    },
    {
      "text": "To edit a TI decoy:"
    },
    {
      "item": "Stop the decoys.",
      "depth": 0,
      "number": 1
    },
    {
      "item": "Go to Deceive > Threat Intelligence Decoys.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          16,
          42
        ]
      ]
    },
    {
      "item": "Click the Edit icon for the decoy you want to modify.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the decoy details window, modify the decoy configuration per your requirements.",
      "depth": 0,
      "number": 4
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "Start the decoys.",
      "depth": 0,
      "number": 6
    },
    {
      "heading": "Deleting a Threat Intelligence Decoy",
      "level": 1
    },
    {
      "text": "To delete a TI decoy:"
    },
    {
      "item": "Stop the decoys.",
      "depth": 0,
      "number": 1
    },
    {
      "item": "Go to Deceive > Threat Intelligence Decoys.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          16,
          42
        ]
      ]
    },
    {
      "item": "Click the Delete icon for the decoy you want to delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "item": "Start the decoys.",
      "depth": 0,
      "number": 5
    }
  ]
}
