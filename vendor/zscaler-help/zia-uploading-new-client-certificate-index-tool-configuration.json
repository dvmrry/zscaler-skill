  "schema_version": 1,
  "kind": "help-article",
  "title": "Uploading New Client Certificate for an Index Tool Configuration",
  "source": {
    "url": "https://help.zscaler.com/zia/uploading-new-client-certificate-index-tool-configuration",
    "node": "1546796",
    "revision": "3253364",
    "updated": "2026-11-06",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-07",
  "blocks": [
    {
      "text": "To upload a new client certificate for an Index Tool configuration:"
    },
    {
      "item": "From the navigation menu, go to Data Security > Common Resources > Index Tool.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          45
        ],
        [
          48,
          64
        ],
        [
          67,
          77
        ]
      ]
    },
    {
      "item": "Click the Upload New Client Certificate icon next to the Index Tool configuration in the table.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          39
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The New Client Certificate drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          26
        ]
      ]
    },
    {
      "item": "In the New Client Certificate drawer, you can do the following:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          29
        ]
      ]
    },
    {
      "item": "Click Download Config to download the instance information required for generating a new client certificate.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          6,
          21
        ]
      ]
    },
    {
      "item": "Upload Provisioning Blob:",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          0,
          24
        ]
      ]
    },
    {
      "item": "Click Enter Blob Data to enter the provisioning blob data manually.",
      "depth": 2,
      "strong": [
        [
          6,
          21
        ]
      ]
    },
    {
      "item": "Click Upload Blob File to upload the provisioning blob data as a file.",
      "depth": 2,
      "strong": [
        [
          6,
          22
        ]
      ]
    },
    {
      "item": "Click Upload.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "View the provisioning blob details in the View Details section.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          42,
          54
        ]
      ]
    },
    {
      "item": "Click Close.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          11
        ]
      ]
    },
    {
      "text": "The uploaded client certificate is required for deploying new virtual instances."
    }
  ]
}
