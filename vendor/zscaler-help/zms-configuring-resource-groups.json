    {
      "text": "Resource groups are collections of resources. Policies are applied to traffic between two resource groups. To learn more, see About Resource Groups, About System Resource Groups, and About Microsegmentation Policies."
    },
    {
      "heading": "Prerequisites",
      "level": 1
    },
    {
      "text": "Enable policy enforcement for your organization. To learn more, see Enabling Microsegmentation Policy Settings."
    },
    {
      "heading": "Configuring a Resource Group",
      "level": 1
    },
    {
      "text": "To configure a resource group:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > Resource Groups.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          86
        ]
      ]
    },
    {
      "item": "Click Add Resource Group.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          24
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Add Resource Group wizard appears.",
      "depth": 0,
      "strong": [
        [
          4,
          22
        ]
      ]
    },
    {
      "item": "In the Add Resource Group wizard:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          25
        ]
      ]
    },
    {
      "item": "In the General Information section:",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          7,
          26
        ]
      ]
    },
    {
      "item": "Name: Enter a name for the new resource group.",
      "depth": 2,
      "number": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Description: (Optional) Enter a description.",
      "depth": 2,
      "number": 2,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "Click Next.",
      "depth": 2,
      "number": 3,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "In the Criteria section:",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          7,
          15
        ]
      ]
    },
    {
      "item": "Select one of the following options:",
      "depth": 2,
      "number": 1
    },
    {
      "item": "Managed: The resources have agents and are actively protected.",
      "depth": 3,
      "strong": [
        [
          0,
          7
        ]
      ]
    },
    {
      "item": "Unmanaged: The resources are not actively protected by agents. Unmanaged resource groups are defined as Classless Inter-Domain Routing (CIDR) blocks or IP ranges.",
      "depth": 3,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
      "item": "Static Membership: Select any or all resources.",
      "depth": 2,
      "number": 2,
      "strong": [
        [
          0,
          17
        ]
      ]
    },
    {
      "item": "Dynamic Membership: Click + Add/Edit Criteria.",
      "depth": 2,
      "number": 3,
      "strong": [
        [
          0,
          18
        ],
        [
          26,
          45
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "The Dynamic Membership Criteria drawer appears.",
      "depth": 2,
      "strong": [
        [
          4,
          31
        ]
      ]
    },
    {
      "item": "In the Dynamic Membership Criteria drawer:",
      "depth": 2,
      "number": 4,
      "strong": [
        [
          7,
          34
        ]
      ]
    },
    {
      "item": "Select one of the following tag scopes:",
      "depth": 3,
      "number": 1
    },
    {
      "item": "Host: Allows users to define criteria for Host Name, Platform, Platform Distro, Platform Version, and CPU Architecture.",
      "depth": 4,
      "strong": [
        [
          0,
          4
        ],
        [
          42,
          51
        ],
        [
          53,
          61
        ],
        [
          63,
          78
        ],
        [
          80,
          96
        ],
        [
          102,
          118
        ]
      ]
    },
    {
      "item": "Environment: Allows users to define criteria for AMI ID, Account/Subscription ID, Cloud Provider, Cloud Region, VPC/VNET ID, Subnet ID, Security Group ID, Classless Inter-Domain Routing (CIDR), and IP Range.",
      "depth": 4,
      "strong": [
        [
          0,
          11
        ],
        [
          49,
          55
        ],
        [
          57,
          80
        ],
        [
          82,
          96
        ],
        [
          98,
          110
        ],
        [
          112,
          123
        ],
        [
          125,
          134
        ],
        [
          136,
          153
        ],
        [
          186,
          192
        ],
        [
          198,
          206
        ]
      ]
    },
    {
      "item": "ZMS: Allows the users to select different Zscaler Microsegmentation (ZMS) agent groups.",
      "depth": 4,
      "strong": [
        [
          0,
          3
        ]
      ]
    },
    {
      "item": "Cloud: Allows the users to select different clouds.",
      "depth": 4,
      "strong": [
        [
          0,
          5
        ]
      ]
    },
    {
      "item": "ML: Allows users to select machine learning (ML) recommended tags. To learn more, see About ML Tag Recommendations Page.",
      "depth": 4,
      "strong": [
        [
          0,
          2
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 3
    },
    {
      "item": "The Static Membership and Dynamic Membership options are only for Managed resource groups.",
      "depth": 3
    },
    {
      "item": "Click Done.",
      "depth": 3,
      "number": 2,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "Create Perimeter: The option to create a perimeter policy for the resource group is selected by default.",
      "depth": 2,
      "number": 5,
      "strong": [
        [
          0,
          16
        ]
      ]
    },
    {
      "item": "In the Review section:",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          7,
          13
        ]
      ]
    },
    {
      "item": "In the General Information and Criteria sections, edit the fields as needed.",
      "depth": 2,
      "number": 1,
      "strong": [
        [
          7,
          26
        ],
        [
          31,
          39
        ]
      ]
    },
    {
      "item": "In the Create Perimeter section:",
      "depth": 2,
      "number": 2,
      "strong": [
        [
          7,
          23
        ]
      ]
    },
    {
      "item": "Description: (Optional) Add a description.",
      "depth": 3,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "AppZones: Click the checkbox to Include all AppZones or select your preferred AppZones.",
      "depth": 3,
      "strong": [
        [
          0,
          8
        ],
        [
          32,
          52
        ]
      ]
    },
    {
      "item": "Inbound Traffic Enforcement: Select Sim Block, Block, or Disable.",
      "depth": 3,
      "strong": [
        [
          0,
          27
        ],
        [
          36,
          45
        ],
        [
          47,
          52
        ],
        [
          57,
          64
        ]
      ]
    },
    {
      "item": "Outbound Traffic Enforcement: Select Sim Block, Block, or Disable.",
      "depth": 3,
      "strong": [
        [
          0,
          28
        ],
        [
          37,
          46
        ],
        [
          48,
          53
        ],
        [
          58,
          65
        ]
      ]
    },
    {
      "item": "Internal Traffic Enforcement: Select Allow or Disable.",
      "depth": 3,
      "strong": [
        [
          0,
          28
        ],
        [
          37,
          42
        ],
        [
          46,
          53
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "Click Save.",
      "depth": 2,
      "number": 3,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "Your new resource group appears in the list. If you added a perimeter policy to your resource group, the policy appears at the bottom of the Perimeter Policies page."
    }
  ]
