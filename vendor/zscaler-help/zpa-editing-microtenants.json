    {
      "text": "To edit a Microtenant:"
    },
    {
      "item": "Go to Private Access > B2B Exchange > Microtenants.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          50
        ]
      ]
    },
    {
      "item": "In the table, locate the Microtenant you want to modify and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          70,
          74
        ]
      ]
    },
    {
      "text": "The Edit Microtenant drawer appears.",
      "strong": [
        [
          4,
          20
        ]
      ]
    },
    {
      "item": "In the Edit Microtenant drawer, you can modify any field. To learn more, see Configuring Microtenants.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          23
        ]
      ]
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
