{
  "schema_version": 1,
  "kind": "help-article",
  "title": "Creating an API Token",
  "source": {
    "url": "https://help.zscaler.com/deception/creating-api-token",
    "node": "1542404",
    "revision": "3221714",
    "updated": "2026-09-22",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can add and configure API tokens for authentication and making API calls."
    },
    {
      "text": "To create an API token:"
    },
    {
      "item": "Go to Orchestrate > API Tokens.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          30
        ]
      ]
    },
    {
      "item": "Click Add API Token.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          19
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the API Token Details window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          24
        ]
      ]
    },
    {
      "item": "Enabled: Select to enable the API token.",
      "depth": 0,
      "strong": [
        [
          0,
          7
        ]
      ]
    },
    {
      "item": "Name: Enter the name of the API token.",
      "depth": 0,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Description: Enter the description of the API token.",
      "depth": 0,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "Roles: Select a role for the API token from the drop-down menu. To learn more, see About Users & Roles.",
      "depth": 0,
      "strong": [
        [
          0,
          5
        ]
      ]
    },
    {
      "item": "Expiration (in days): Enter the API token expiration period in days.",
      "depth": 0,
      "strong": [
        [
          0,
          20
        ]
      ]
    },
    {
      "text": "You cannot modify the expiration period after the API token is created. You must create a new token after it expires."
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "In the API Token generated window, copy the API token.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          7,
          26
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "text": "You cannot retrieve the API token after you close the window."
    },
    {
      "item": "Click Close.",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          6,
          11
        ]
      ]
    },
    {
      "text": "The API token is created."
    },
    {
      "text": "See image."
    }
  ]
}
