  "blocks": [
    {
      "text": "You can configure the scan rule to scan on-premises unmanaged databases. DSPM scans the databases for any sensitive data and vulnerabilities and displays the scan results on the Resource Inventory page."
    },
    {
      "heading": "Prerequisites",
      "level": 1
    },
    {
      "text": "Before configuring the scan rule, you need to configure the on-premises data center. To learn more, see About On-Premises Data Centers."
    },
    {
      "heading": "Configuring Scan Rule",
      "level": 1
    },
    {
      "text": "To configure a scan rule for on-premises unmanaged databases, complete the following steps in the Zscaler Admin Console:"
    },
    {
      "item": "1. Provide the general information.",
      "depth": 0
    },
    {
      "item": "From the navigation menu, go to Data Security > DSPM > Scan Settings.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          32,
          45
        ],
        [
          48,
          52
        ],
        [
          55,
          68
        ]
      ]
    },
    {
      "item": "Select the Scan Rules tab.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          11,
          21
        ]
      ]
    },
    {
      "item": "If you are configuring the scan rule for the first time, the following page appears:",
      "depth": 1
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Add Scan Rule.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          6,
          19
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "The General Information page appears.",
      "depth": 1,
      "strong": [
        [
          4,
          23
        ]
      ]
    },
    {
      "item": "On the General Information page:",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          7,
          26
        ]
      ]
    },
    {
      "item": "Scan Rule Name: Enter a unique and descriptive name for the scan rule.",
      "depth": 2,
      "number": 1,
      "strong": [
        [
          0,
          14
        ]
      ]
    },
    {
      "item": "Scan Rule Description (Optional): Enter a description of the scan rule (maximum 500 characters).",
      "depth": 2,
      "number": 2,
      "strong": [
        [
          0,
          32
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Next.",
      "depth": 1,
      "number": 5,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "2. Select the cloud and resource type.",
      "depth": 0
    },
    {
      "item": "On the Select Cloud and Resource Type page:",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          7,
          37
        ]
      ]
    },
    {
      "item": "Cloud Type: Select On-Premises.",
      "depth": 2,
      "strong": [
        [
          0,
          10
        ],
        [
          19,
          30
        ]
      ]
    },
    {
      "item": "Resource Type: Select Database.",
      "depth": 2,
      "strong": [
        [
          0,
          13
        ],
        [
          22,
          30
        ]
      ]
    },
    {
      "item": "Database Type: Select Unmanaged Database.",
      "depth": 2,
      "strong": [
        [
          0,
          13
        ],
        [
          22,
          40
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Next.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "3. Select the resources that must be scanned.",
      "depth": 0
    },
    {
      "item": "On the Select Resources to Scan page, choose one of the following options:",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          7,
          31
        ]
      ]
    },
    {
      "item": "Scan All Resources: Scan all the resources across all the registered workspaces.",
      "depth": 2,
      "number": 1,
      "strong": [
        [
          0,
          18
        ]
      ]
    },
    {
      "item": "Scan Specific Resources: Select the checkbox for specific resources that must be scanned.",
      "depth": 2,
      "number": 2,
      "strong": [
        [
          0,
          23
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Next.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "4. Select the scan type.",
      "depth": 0
    },
    {
      "item": "On the Scan Type page:",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          7,
          16
        ]
      ]
    },
    {
      "item": "Data Sampling Scan: Scan a sample of recent data in the database.",
      "depth": 2,
      "strong": [
        [
          0,
          18
        ]
      ]
    },
    {
      "item": "DSPM cannot detect files that are deleted from the unmanaged database server.",
      "depth": 1
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Next.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "5. Set up the scan schedule.",
      "depth": 0
    },
    {
      "item": "On the Scan Schedule page, select the scan frequency:",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          7,
          20
        ]
      ]
    },
    {
      "item": "On-Demand Scan (Default): The scan runs only when it is initiated manually by the user.",
      "depth": 2,
      "strong": [
        [
          0,
          14
        ]
      ]
    },
    {
      "item": "Daily: Scan the data daily at the specified time (e.g., 11:59 PM).",
      "depth": 2,
      "strong": [
        [
          0,
          5
        ]
      ]
    },
    {
      "item": "Weekly: Scan the data once a week. Select the day from the drop-down menu and specify the time (e.g., Tuesday at 11:59 PM).",
      "depth": 2,
      "strong": [
        [
          0,
          6
        ]
      ]
    },
    {
      "item": "Monthly: Scan the data once a month. Select the day of the month from the drop-down menu and specify the time (e.g., the 24th at 11:59 PM).",
      "depth": 2,
      "strong": [
        [
          0,
          7
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Next.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "6. Select the scan scope.",
      "depth": 0
    },
    {
      "item": "On the Scan Scope page, choose a scan scope from the drop-down menu to set up your scan settings.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          7,
          17
        ]
      ]
    },
    {
      "item": "To learn more about configuring and creating a scan scope, see Configuring Scan Scope.",
      "depth": 1
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Next.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "7. Review and complete the configuration.",
      "depth": 0
    },
    {
      "item": "Review the scan settings. Click the Edit icon to change any values, if needed.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          36,
          40
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Finish.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    }
  ]
}
