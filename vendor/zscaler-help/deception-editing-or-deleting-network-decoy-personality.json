    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete network decoy personalities that you configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a Network Decoy Personality",
      "level": 1
    },
    {
      "text": "To edit a network decoy personality:"
    },
    {
      "item": "Go to Miragemaker > Strategy Builder > Network Decoy.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          36
        ],
        [
          39,
          52
        ]
      ]
    },
    {
      "item": "Under Actions, click the Edit icon for the decoy personality you want to modify.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          29
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the Personality Details window, modify the fields under each tab (General, Services, and Active Directory) as required.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          26
        ],
        [
          69,
          76
        ],
        [
          78,
          86
        ],
        [
          92,
          108
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The default network decoy personalities cannot be edited."
    },
    {
      "heading": "Deleting a Network Decoy Personality",
      "level": 1
    },
    {
      "text": "To delete a network decoy personality:"
    },
    {
      "item": "Go to Miragemaker > Strategy Builder > Network Decoy.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          36
        ],
        [
          39,
          52
        ]
      ]
    },
    {
      "item": "Under Actions, click the Delete icon for the decoy personality you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          31
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "text": "The default network decoy personalities cannot be deleted."
    }
  ]
}
