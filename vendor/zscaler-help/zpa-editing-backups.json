  "blocks": [
    {
      "text": "To edit a backup:"
    },
    {
      "item": "Go to Administration > Back Up and Restore > Private Access.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          42
        ],
        [
          45,
          59
        ]
      ]
    },
    {
      "item": "Locate the Backup Name within the table and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          11,
          22
        ],
        [
          54,
          58
        ]
      ]
    },
    {
      "item": "The Edit Backup drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          15
        ]
      ]
    },
    {
      "item": "In the Edit Backup drawer, you can only modify the following fields:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          18
        ]
      ]
    },
    {
      "item": "Name: The name of the backup.",
      "depth": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Golden Backup: Enable or disable the Golden Backup. A golden backup is the last known good backup of the policies and configuration settings. There can only be one golden backup at any given time.",
      "depth": 1,
      "strong": [
        [
          0,
          13
        ]
      ]
    },
    {
      "item": "Description: The description of the backup.",
      "depth": 1,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "If the backup status has failed, it can't be marked as a golden backup."
    }
  ]
}
