  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete an Active Directory (AD) scan that you configured."
    },
    {
      "heading": "Editing a Scan",
      "level": 1
    },
    {
      "text": "To edit a scan:"
    },
    {
      "item": "Go to ITDR > Manage > Active Directory Posture.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          19
        ],
        [
          22,
          46
        ]
      ]
    },
    {
      "item": "Locate the AD domain for which you want to modify the scan, and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          74,
          78
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Scan Agents Details window, modify the fields as necessary.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          26
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "If an endpoint agent has not checked in for more than 7 days, it is removed from the scan and its Current State status is set to Error.",
      "depth": 0,
      "strong": [
        [
          98,
          111
        ],
        [
          129,
          134
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "heading": "Deleting a Scan",
      "level": 1
    },
    {
      "text": "To delete a scan:"
    },
    {
      "item": "Go to ITDR > Manage > Active Directory Posture.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          19
        ],
        [
          22,
          46
        ]
      ]
    },
    {
      "item": "Locate the AD domain for which you want to delete the scan, and click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          74,
          80
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "item": "After you delete a scan, all the identity vulnerability results pertaining to that AD domain on the Active Directory Posture dashboard are deleted.",
      "depth": 0
    }
  ]
}
