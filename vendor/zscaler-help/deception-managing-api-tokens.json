    {
      "text": "You can edit or delete API tokens configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing an API Token",
      "level": 1
    },
    {
      "item": "Go to Orchestrate > API Tokens.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          30
        ]
      ]
    },
    {
      "item": "Select the API token you want to modify, and under Actions, click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          51,
          58
        ],
        [
          70,
          74
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the API Token Details window, modify the required fields.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          24
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "You cannot edit the API token expiration period.",
      "depth": 0
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "heading": "Deleting an API Token",
      "level": 1
    },
    {
      "item": "Go to Orchestrate > API Tokens.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          30
        ]
      ]
    },
    {
      "item": "Select the API token you want to delete, and under Actions, click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          51,
          58
        ],
        [
          70,
          76
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    }
  ]
