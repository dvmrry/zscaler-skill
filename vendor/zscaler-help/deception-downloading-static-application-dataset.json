    {
      "text": "You can download both default and custom static application datasets individually as a ZIP file."
    },
    {
      "text": "To download a static application dataset:"
    },
    {
      "item": "Go to Miragemaker > Static Application Datasets.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          47
        ]
      ]
    },
    {
      "item": "Click the Download icon for the dataset that you want to download.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          18
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The static application dataset is downloaded to your system as a ZIP file.",
      "depth": 0
    }
  ]
