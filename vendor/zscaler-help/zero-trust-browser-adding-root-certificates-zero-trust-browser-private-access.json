    {
      "text": "The default Zscaler Root Certificate is deployed automatically as a placeholder root certificate for any new isolation profile. However, you can create your own root certificates to use for profiles instead."
    },
    {
      "text": "To add a root certificate:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Browser > Browser Isolation Private Apps > Root Certificates.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          50
        ],
        [
          53,
          83
        ],
        [
          86,
          103
        ]
      ]
    },
    {
      "item": "Click Add.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          9
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Add Root Certificate drawer opens.",
      "depth": 0,
      "strong": [
        [
          4,
          24
        ]
      ]
    },
    {
      "item": "In the Add Root Certificate drawer:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          27
        ]
      ]
    },
    {
      "item": "Enter a Name.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          8,
          12
        ]
      ]
    },
    {
      "item": "Click Upload File to choose a PEM file.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          17
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "The page refreshes, and the new root certificate displays in the page list."
    }
  ]
}
