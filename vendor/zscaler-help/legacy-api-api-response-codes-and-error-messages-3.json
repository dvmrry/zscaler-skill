    {
      "text": "The following table lists the HTTP status codes returned by the API."
    },
    {
      "table": [
        [
          "Code",
          "Description"
        ],
        [
          "200",
          "Successful"
        ],
        [
          "400",
          "Bad Request (e.g., incorrect filter keys are used in the URL)"
        ],
        [
          "401",
          "Unauthorized (e.g., an incorrect token is used)"
        ],
        [
          "404",
          "Resource Not Found"
        ],
        [
          "500",
          "Internal Server Error"
        ]
      ]
    }
  ]
}
