    {
      "text": "You can use the On-Demand scan option to run a scan instantly on the database or virtual machine. The On-Demand scan overrides the scheduled scan. To learn more, see About Scan Settings."
    },
    {
      "text": "To run an On-Demand scan, complete the following steps in the AI Security Admin Portal:"
    },
    {
      "item": "Go to Administration > Scan Settings.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          36
        ]
      ]
    },
    {
      "item": "Select the Scan Rules tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          11,
          21
        ]
      ]
    },
    {
      "item": "Click the Actions icon () for the scan rule you want to run.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          17
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Select the On-Demand Scan option.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          11,
          25
        ]
      ]
    },
    {
      "item": "The On-Demand Scan confirmation window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          18
        ]
      ]
    },
    {
      "item": "Read the message that appears, then click Confirm.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          42,
          49
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    }
  ]
}
