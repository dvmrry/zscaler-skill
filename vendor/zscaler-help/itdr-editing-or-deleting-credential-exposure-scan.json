    {
      "text": "You can edit or delete a credential exposure scan that you configured."
    },
    {
      "heading": "Editing a Credential Exposure Scan",
      "level": 1
    },
    {
      "text": "To edit a credential exposure scan:"
    },
    {
      "item": "Go to ITDR > Manage > Endpoint Credential Exposure.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          19
        ],
        [
          22,
          50
        ]
      ]
    },
    {
      "item": "Locate the endpoint you want to edit, and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          52,
          56
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the configuration window, modify the details as necessary. You can modify:",
      "depth": 0,
      "number": 3
    },
    {
      "item": "Configuration",
      "depth": 1
    },
    {
      "item": "Endpoint Selection",
      "depth": 1
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting a Credential Exposure Scan",
      "level": 1
    },
    {
      "text": "To delete a credential exposure scan:"
    },
    {
      "item": "Go to ITDR > Manage > Endpoint Credential Exposure.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          19
        ],
        [
          22,
          50
        ]
      ]
    },
    {
      "item": "Locate the endpoint you want to delete, and click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          54,
          60
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "text": "After you delete a scan, all the identity vulnerability results pertaining to that credential exposure on the Endpoint Credential Exposure dashboard are deleted."
    }
  ]
}
