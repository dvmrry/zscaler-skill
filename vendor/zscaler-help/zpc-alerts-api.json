    "paths": {
      "/alerts/cloud": {
        "get": {
          "description": "Gets a list of cloud alerts for the specified criteria.",
          "parameters": [
            {
              "description": "Indicates the page size. If not provided, the default page size is 100. The maximum limit for page size is 100.",
              "explode": false,
              "in": "query",
              "name": "limit",
              "required": false,
              "schema": {
                "format": "int64",
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              "style": "form"
            },
            {
              "description": "Specifies the page number.",
              "explode": false,
              "in": "query",
              "name": "offset",
              "required": false,
              "schema": {
                "format": "int64",
                "maximum": 2000,
                "minimum": 1,
                "type": "integer"
              },
              "style": "form"
            },
            {
              "description": "The created starting date for the alert in epoch seconds. Zscaler recommends you are aware of the following:<p><ul><li>If start and end times are not specified, then alerts are retreived for the last 48 hours by default.</li><li>If only the start time is specified, then alerts are retrieved for up to 48 hours from start time.</li><li>If only the end time is specified, then alerts are retrieved from end time to 48 hours before.</li><li>If both the created and updated start and end times are specified, then only the alerts within the specified time range are retrieved.",
              "explode": true,
              "in": "query",
              "name": "created[start]",
              "required": false,
              "schema": {
                "format": "int32",
                "type": "integer"
              },
              "style": "form"
            },
            {
              "description": "The created ending date for the alert in epoch seconds. Zscaler recommends you are aware of the following:<p><ul><li>If start and end times are not specified, then alerts are retreived for the last 48 hours by default.</li><li>If only the start time is specified, then alerts are retrieved for up to 48 hours from start time.</li><li>If only the end time is specified, then alerts are retrieved from end time to 48 hours before.</li><li>If both the created and updated start and end times are specified, then only the alerts within the specified time range are retrieved.",
              "explode": true,
              "in": "query",
              "name": "created[end]",
              "required": false,
              "schema": {
                "format": "int32",
                "type": "integer"
              },
              "style": "form"
            },
            {
              "description": "The updated starting date for the alert in epoch seconds. Zscaler recommends you are aware of the following:<p><ul><li>If neither start or end times are specified, then alerts are retreived for the next 48 hours by default.</li><li>If only the start time is specified, then alerts are retrieved for the next 48 hours.</li><li>If only the end time is specified, then only the alerts from the previous 48 hours are retrieved.</li><li>If both the created and updated start and end times are specified, then only the alerts within the specified time range are retrieved.",
              "explode": true,
              "in": "query",
              "name": "updated[start]",
              "required": false,
              "schema": {
                "format": "int32",
                "type": "integer"
              },
              "style": "form"
            },
            {
              "description": "The updated ending date for the alert in epoch seconds. Zscaler recommends you are aware of the following:<p><ul><li>If neither start or end times are specified, then alerts are retreived for the next 48 hours by default.</li><li>If only the start time is specified, then alerts are retrieved for the next 48 hours.</li><li>If only the end time is specified, then only the alerts from the previous 48 hours are retrieved.</li><li>If both the created and updated start and end times are specified, then only the alerts within the specified time range are retrieved.",
              "explode": true,
              "in": "query",
              "name": "updated[end]",
              "required": false,
              "schema": {
                "format": "int32",
                "type": "integer"
              },
              "style": "form"
            },
            {
              "description": "Indicates the cloud account type of the alert based on the specified filter.",
              "explode": true,
              "in": "query",
              "name": "cloud_account_type",
              "required": false,
              "schema": {
                "items": {
                  "enum": [
                    "AWS",
                    "GCP",
                    "AZURE",
                    "KUBERNETES"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "style": "form"
            },
            {
              "description": "Filters the alert by business unit name based on the specified filter.",
              "explode": true,
              "in": "query",
              "name": "business_units",
              "required": false,
              "schema": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "style": "form"
            },
            {
              "description": "Filters the alerts based on the specified regions.",
              "explode": true,
              "in": "query",
              "name": "regions",
              "required": false,
              "schema": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "style": "form"
            },
            {
              "description": "Filters alerts by the specified <code>AlertStatus</code> value.",
              "explode": true,
              "in": "query",
              "name": "alert_status",
              "required": false,
              "schema": {
                "items": {
                  "enum": [
                    "OPEN",
                    "CLOSED",
                    "RESOLVED",
                    "IGNORED"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "style": "form"
            },
            {
              "description": "Filters alerts by the specified <code>RiskLevel</code> value.",
              "explode": true,
              "in": "query",
              "name": "risk_level",
              "required": false,
              "schema": {
                "items": {
                  "enum": [
                    "LOW",
                    "MEDIUM",
                    "HIGH",
                    "CRITICAL"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "style": "form"
            },
            {
              "description": "Orders the alerts by the specified <code>order_by</code> value.",
              "explode": true,
              "in": "query",
              "name": "order_by",
              "required": false,
              "schema": {
                "enum": [
                  "severity",
                  "severity:asc",
                  "severity:desc",
                  "created",
                  "created:asc",
                  "created:desc",
                  "updated",
                  "updated:asc",
                  "updated:desc",
                  "alert_status",
                  "alert_status:asc",
                  "alert_status:desc"
                ],
                "type": "string"
              },
              "style": "form"
            },
            {
              "description": "Filters the alerts by the specified <code>fields</code> value.",
              "explode": true,
              "in": "query",
              "name": "fields",
              "required": false,
              "schema": {
                "items": {
                  "enum": [
                    "alert_id",
                    "alert_type",
                    "alert_desc",
                    "alert_status",
                    "alert_status_desc",
                    "alert_url",
                    "csp",
                    "severity",
                    "risk_level",
                    "risk_score",
                    "threat_category",
                    "mitre_attack",
                    "theme",
                    "asset_category",
                    "asset_type",
                    "audit_procedure",
                    "recommendations",
                    "remediation_procedure",
                    "alert_focus",
                    "reason",
                    "updated_by",
                    "policy",
                    "cloud_resource",
                    "business_unit",
                    "cloud_account",
                    "identity",
                    "compliance",
                    "kubernetes",
                    "created",
                    "updated"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "style": "form"
            }
          ],
          "responses": {
            "200": {
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/CloudAlertsResult"
                  }
                }
              },
              "description": "OK"
            },
            "400": {
              "description": "Bad Request"
            },
            "401": {
              "description": "Unauthorized"
            },
            "403": {
              "description": "Forbidden"
            },
            "429": {
              "description": "Rate Limit Fail"
            },
            "500": {
              "description": "Internal Server Error"
            }
          },
          "tags": [
            "Alerts"
          ]
        }
      },
