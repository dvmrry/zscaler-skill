              "type": "string"
            },
            "risk_score": {
              "description": "The numeric representation of the risk.",
              "type": "string"
            },
            "threat_category": {
              "description": "The threat category the policy belongs to.",
              "type": "string"
            },
            "mitre_attack": {
              "description": "The link to the technique on the MITRE ATT&CK website.",
              "type": "string"
