    {
      "text": "You can export a ZIP file containing all Threat Intelligence (TI) decoy personalities, each in its own JSON file."
    },
    {
      "text": "To export TI decoy personalities:"
    },
    {
      "item": "Go to Miragemaker > Strategy Builder > Threat Intelligence Decoy.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          36
        ],
        [
          39,
          64
        ]
      ]
    },
    {
      "item": "Click Export.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "text": "All TI decoy personalities are downloaded to your system in a compressed (.zip) file."
    }
  ]
}
