    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete any cloud storage, ITSM, or ChatOps integration as required."
    },
    {
      "heading": "Editing an Integration",
      "level": 1
    },
    {
      "text": "To edit an integration:"
    },
    {
      "item": "From the navigation menu, go to Data Security > DSPM > DSPM Integrations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          45
        ],
        [
          48,
          52
        ],
        [
          55,
          59
        ],
        [
          60,
          72
        ]
      ]
    },
    {
      "item": "Click the Actions icon for the integration that you want to edit, and select Edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          17
        ],
        [
          77,
          81
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Edit Integration window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          20
        ]
      ]
    },
    {
      "item": "In the Edit Integration window, change the values as required. If you change the values, you must test the connection again.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          23
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting an Integration",
      "level": 1
    },
    {
      "text": "To delete an integration:"
    },
    {
      "item": "Go to Data Security > DSPM > DSPM Integrations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          19
        ],
        [
          22,
          26
        ],
        [
          29,
          33
        ],
        [
          34,
          46
        ]
      ]
    },
    {
      "item": "Click the Actions icon for the integration that you want to delete, and select Delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          17
        ],
        [
          79,
          85
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Delete Integration window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          22
        ]
      ]
    },
    {
      "item": "In the Delete Integration window, read the message related to alert rules.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          25
        ]
      ]
    },
    {
      "item": "You cannot delete an integration if it is associated with alert rules. You must first move the alert rules to another integration. Until then, the Delete button is disabled.",
      "depth": 0,
      "strong": [
        [
          147,
          153
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "After you've moved the alert rules, click Delete.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          42,
          48
        ]
      ]
    }
  ]
}
