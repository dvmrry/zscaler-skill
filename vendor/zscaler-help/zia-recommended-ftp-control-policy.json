    {
      "text": "The Zscaler service includes the recommended FTP Control policy on the FTP Control page. The recommended policy has the following settings:"
    },
    {
      "item": "Disable Allow FTP over HTTP",
      "depth": 0,
      "strong": [
        [
          8,
          27
        ]
      ]
    },
    {
      "item": "Disable Allow Native FTP",
      "depth": 0,
      "strong": [
        [
          8,
          24
        ]
      ]
    },
    {
      "item": "Disable Allow Any URL Category",
      "depth": 1,
      "strong": [
        [
          8,
          30
        ]
      ]
    },
    {
      "item": "Set Allowed URL Categories to None",
      "depth": 1,
      "strong": [
        [
          4,
          26
        ],
        [
          30,
          34
        ]
      ]
    }
  ]
}
