    {
      "text": "This article contains the recommended policy for URL Filtering."
    },
    {
      "text": "Zscaler recommends that you configure the following for URL Filtering policy:"
    },
    {
      "item": "Rule Order: Select a Rule Order that is appropriate for your organization. Rules are evaluated in ascending numerical order (Rule 1 before Rule 2, and so on).",
      "depth": 0,
      "strong": [
        [
          0,
          10
        ]
      ]
    },
    {
      "item": "Rule Status: Select Enabled. Enabled rules are actively enforced.",
      "depth": 0,
      "strong": [
        [
          0,
          11
        ],
        [
          20,
          27
        ]
      ]
    },
    {
      "item": "URL Categories: Select Adult Material, Drugs, Gambling, Illegal or Questionable, and Militancy/Hate and Extremism to apply the rule to these URL categories.",
      "depth": 0,
      "strong": [
        [
          0,
          14
        ],
        [
          23,
          37
        ],
        [
          39,
          44
        ],
        [
          46,
          54
        ],
        [
          56,
          63
        ],
        [
          67,
          79
        ],
        [
          85,
          99
        ],
        [
          100,
          103
        ],
        [
          104,
          113
        ]
      ]
    },
    {
      "item": "HTTP Requests: Select All so that the rule is applied to all HTTP requests.",
      "depth": 0,
      "strong": [
        [
          0,
          13
        ],
        [
          22,
          25
        ]
      ]
    },
    {
      "item": "Users: Select Any to apply the rule to all users.",
      "depth": 0,
      "strong": [
        [
          0,
          5
        ],
        [
          14,
          17
        ]
      ]
    },
    {
      "item": "Groups: Select Any to apply the rule to all groups.",
      "depth": 0,
      "strong": [
        [
          0,
          6
        ],
        [
          15,
          18
        ]
      ]
    },
    {
      "item": "Departments: Select Any to apply the rule to all departments.",
      "depth": 0,
      "strong": [
        [
          0,
          11
        ],
        [
          20,
          23
        ]
      ]
    },
    {
      "item": "Locations: Select Any to apply the rule to all locations.",
      "depth": 0,
      "strong": [
        [
          0,
          9
        ],
        [
          18,
          21
        ]
      ]
    },
    {
      "item": "Location Groups: Select Any to apply the rule to all location groups.",
      "depth": 0,
      "strong": [
        [
          0,
          15
        ],
        [
          24,
          27
        ]
      ]
    },
    {
      "item": "Time: Select Always to apply the rule to all time intervals.",
      "depth": 0,
      "strong": [
        [
          0,
          4
        ],
        [
          13,
          19
        ]
      ]
    },
    {
      "item": "Protocols: Select HTTP and HTTPS to apply the rule to these two protocols.",
      "depth": 0,
      "strong": [
        [
          0,
          9
        ],
        [
          18,
          22
        ],
        [
          27,
          32
        ]
      ]
    },
    {
      "item": "Action: Select Block to block access to all sites in the selected URL categories.",
      "depth": 0,
      "strong": [
        [
          0,
          6
        ],
        [
          15,
          20
        ]
      ]
    },
    {
      "item": "Device Groups: Select OS Type, No Client Connector, and Cloud Browser isolation to apply the rule to these device groups.",
      "depth": 0,
      "strong": [
        [
          0,
          13
        ],
        [
          22,
          29
        ],
        [
          31,
          50
        ],
        [
          56,
          79
        ]
      ]
    },
    {
      "item": "Device Trust Level: Select device trust levels based on posture definition.",
      "depth": 0,
      "strong": [
        [
          0,
          18
        ]
      ]
    }
  ]
}
