    {
      "text": "You can edit or delete a subnet that you have configured in the Zscaler Deception Admin Portal."
    },
    {
      "text": "Zscaler Deception uses Private Access (ZPA) or Threat Intelligence (TI) subnets to deploy decoys in a dedicated Deception cloud. You cannot edit or delete these subnets. Contact Zscaler Support to manage them."
    },
    {
      "heading": "Editing a Subnet",
      "level": 1
    },
    {
      "item": "Go to Settings > Topology > Interfaces.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          25
        ],
        [
          28,
          38
        ]
      ]
    },
    {
      "item": "Select the subnet you want to modify, and under Actions, click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          48,
          55
        ],
        [
          67,
          71
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Edit Subnet window, modify the required fields.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          18
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting a Subnet",
      "level": 1
    },
    {
      "item": "Go to Settings > Topology > Interfaces.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          25
        ],
        [
          28,
          38
        ]
      ]
    },
    {
      "item": "Select the subnet you want to delete, and under Actions, click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          48,
          55
        ],
        [
          67,
