  "blocks": [
    {
      "text": "You can customize the email notification subject and the event fields included in email notifications using event notification templates."
    },
    {
      "text": "To customize the email notification template:"
    },
    {
      "item": "Go to Orchestrate > Event Templates.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          35
        ]
      ]
    },
    {
      "item": "The Event Templates window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          19
        ]
      ]
    },
    {
      "item": "In the Event Templates window:",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          22
        ]
      ]
    },
    {
      "item": "Select Enable Custom Templates.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          7,
          30
        ]
      ]
    },
    {
      "item": "Under Email Subject, enter the text and built-in events (within the curly braces).",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          19
        ]
      ]
    },
    {
      "item": "Under Email Custom Fields, enter the built-in events that you want to include in the email body. If Email Custom Fields is blank, the default list of events is sent in the email body.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          6,
          25
        ],
        [
          100,
          119
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
