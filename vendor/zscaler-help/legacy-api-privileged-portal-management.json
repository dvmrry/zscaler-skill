              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "page",
              "in": "query",
              "description": "Specifies the page number.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int32"
