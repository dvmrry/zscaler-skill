            },
            "params": {
              "type": "array",
              "description": "The parameters that were sent in the request body.",
              "items": {
                "type": "object"
              }
            },
            "hostname": {
              "type": "string",
              "description": "The client server address or domain name."
            }
          }
        },
        "PraPortal": {
          "required": [
            "name"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "description": "The unique identifier of the privileged portal.",
              "format": "int64"
            },
            "modifiedTime": {
              "type": "integer",
              "description": "The time the privileged portal is modified.",
              "format": "int32"
            },
            "creationTime": {
              "type": "integer",
              "description": "The time the privileged portal is created.",
              "format": "int32"
            },
            "modifiedBy": {
              "type": "integer",
              "description": "The unique identifier of the tenant who modified the privileged portal.",
              "format": "int64"
            },
            "name": {
              "type": "string",
              "description": "The name of the privileged portal."
            },
            "microtenantId": {
              "type": "integer",
              "description": "The unique identifier of the Microtenant for the ZPA tenant. If you are within a Microtenant, you must pass the microtenantId field when making an API call to retrieve data from that Microtenant. The microtenantId can be obtained in the API Keys page, or can be obtained programmatically using the ZPA cloud service API. Access to certain operations are limited when you are within a Microtenant. If you are within the Default Microtenant, pass microtenantId as 0 when making requests to retrieve data from the Default Microtenant. If the microtenantId is not passed in the request when creating or updating a resource, then the resource is created or updated in the Default Microtenant.",
              "format": "int64"
            },
            "microtenantName": {
              "type": "string",
              "description": "The name of the Microtenant."
            },
            "enabled": {
              "type": "boolean",
              "description": "Indicates whether or not the privileged portal is enabled."
            },
            "description": {
              "type": "string",
              "description": "The description of the privileged portal."
            },
            "certificateId": {
              "type": "integer",
              "description": "The unique identifier of the certificate.",
              "format": "int64"
            },
            "certificateName": {
              "type": "string",
              "description": "The name of the certificate."
            },
            "getcName": {
              "type": "string",
              "description": "This field is extracted from the enrollment certificate, and is not applicable for PUT and POST requests."
            },
            "domain": {
              "type": "string",
              "description": "The domain of the privileged portal."
            },
            "userNotification": {
              "type": "string",
              "description": "The notification message displayed in the banner of the privileged portal link, if enabled."
            },
            "userNotificationEnabled": {
              "type": "boolean",
              "description": "If set to true, displays a notification message in the banner of the privileged portal link."
            },
            "userPortalGid": {
              "type": "integer",
              "description": "The unique identifier of the user portal.",
              "format": "int64"
            },
            "extLabel": {
              "type": "string",
              "description": "The domain prefix for the privileged portal URL. The supported string can include numbers, lower case characters, and only supports a hyphen (-)."
            },
            "extDomainTranslation": {
              "type": "string",
              "description": "The translation of the external domain name prefix of the Browser Access application that is used for Zscaler-managed certificates when creating a privileged portal."
            },
            "extDomain": {
              "type": "string",
              "description": "The external domain name prefix of the Browser Access application that is used for Zscaler-managed certificates when creating a privileged portal. This field is returned when making GET requests to get privileged portal details or when retreiving application segment details. The supported value must be a string, but doesn't support special characters (e.g., periods) as the FQDN wouldn't match the CNAME entry."
            },
            "extDomainName": {
              "type": "string",
              "description": "The domain suffix for the privileged portal URL. This field must be one of the customer's authentication domains."
            },
            "userPortalName": {
              "type": "string",
              "description": "The name of the user portal."
            }
          }
        }
      }
    }
  }
}
