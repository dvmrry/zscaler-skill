    {
      "text": "To disable access to an application that was explicitly defined or dynamically discovered:"
    },
    {
      "item": "From the navigation menu, go to Private Access > Private Applications > Defined Application Segments.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          46
        ],
        [
          49,
          69
        ],
        [
          72,
          100
        ]
      ]
    },
    {
      "item": "Locate the application segment to which the application belongs, and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          79,
          83
        ]
      ]
    },
    {
      "item": "In the Edit Application Segment window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          31
        ]
      ]
    },
    {
      "item": "Click Next to go to the General Information tab.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          24,
          43
        ]
      ]
    },
    {
      "item": "For Status, select Disabled.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          4,
          10
        ],
        [
          19,
          27
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "To learn more, see Configuring Defined Application Segments.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "Users will not be able to access the applications within the application segment until it is re-enabled."
    }
  ]
}
