  "blocks": [
    {
      "text": "To revoke an API key:"
    },
    {
      "item": "Go to Administration > Authentication & Authorization > API Keys.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          53
        ],
        [
          56,
          64
        ]
      ]
    },
    {
      "item": "In the table, locate the key you want to revoke, click the Menu icon, and then click Revoke.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          59,
          63
        ],
        [
          85,
          91
        ]
      ]
    },
    {
      "text": "The Revoke API Key window appears.",
      "strong": [
        [
          4,
          18
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the Revoke API Key window, confirm you want to revoke the API key, and then click Revoke.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          21
        ],
        [
          85,
          91
        ]
      ]
    },
    {
      "text": "Revoking an API key cannot be undone. If you revoke an API key, that API key no longer has access to authenticate."
    }
  ]
}
