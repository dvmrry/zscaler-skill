    "components": {
      "schemas": {
        "ZIAPostureProfileContractV2": {
          "type": "object",
          "description": "Internet & SaaS (ZIA) posture profile contract that defines trust criteria for different trust levels (high, medium, low).",
          "properties": {
            "id": {
              "description": "Unique identifier of the Internet & SaaS (ZIA) posture profile.",
              "type": "integer",
              "format": "int64"
            },
            "name": {
              "description": "Name of the Internet & SaaS (ZIA) posture profile.",
              "type": "string"
            },
            "platform": {
              "description": "Platform identifier for the posture profile.",
              "type": "integer",
              "format": "int32"
            },
            "highTrustCriteria": {
              "description": "Trust criteria for high trust level devices.",
              "$ref": "#/components/schemas/TrustCriteria"
            },
            "mediumTrustCriteria": {
              "description": "Trust criteria for medium trust level devices.",
              "$ref": "#/components/schemas/TrustCriteria"
            },
            "lowTrustCriteria": {
              "description": "Trust criteria for low trust level devices.",
              "$ref": "#/components/schemas/TrustCriteria"
            },
            "createdBy": {
              "description": "User ID of the creator of this profile.",
              "type": "integer",
              "format": "int64"
            },
            "editedBy": {
              "description": "User ID of the user who last edited this profile.",
              "type": "integer",
              "format": "int64"
            },
            "createTime": {
              "description": "Timestamp indicating when the profile was created.",
              "type": "string"
            },
            "updateTime": {
              "description": "Timestamp indicating when the profile was last updated.",
              "type": "string"
            }
          }
        },
        "TrustCriteria": {
          "type": "object",
          "description": "Trust criteria containing multiple condition sets used to determine device trust levels.",
          "properties": {
            "conditionSets": {
              "type": "array",
              "description": "Array of condition sets that define the trust criteria.",
              "items": {
                "$ref": "#/components/schemas/ConditionSet"
              }
            }
          }
        },
        "ConditionSet": {
          "type": "object",
          "description": "A collection of conditions grouped together as a set.",
          "properties": {
            "conditions": {
              "type": "array",
              "description": "Array of conditions in this set.",
              "items": {
                "$ref": "#/components/schemas/Condition"
              }
            }
          }
        },
        "Condition": {
          "type": "object",
          "description": "Represents a single condition with an identifier, name, and UDID.",
          "properties": {
            "id": {
              "description": "Unique identifier of the condition.",
              "type": "string"
            },
            "name": {
              "description": "Name of the condition.",
              "type": "string"
            },
            "udid": {
              "description": "Unique device identifier associated with the condition.",
              "type": "string"
            }
          }
        }
      }
    }
