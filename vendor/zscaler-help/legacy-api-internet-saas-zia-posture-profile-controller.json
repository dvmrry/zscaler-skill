          "summary": "List Internet & SaaS (ZIA) posture profiles",
          "description": "Retrieves a list of Internet & SaaS (ZIA) posture profiles with optional filtering and pagination.",
          "tags": [
            "zia-posture-profile-controller"
          ],
          "operationId": "listZIAPostureProfiles",
          "parameters": [
            {
              "name": "keyword",
              "description": "Search keyword to filter Internet & SaaS (ZIA) posture profiles by name or other attributes.",
              "in": "query",
              "required": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "platformType",
              "description": "Platform type filter (0 for all platforms, or specific platform identifier).",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 0
              }
            },
            {
              "name": "offset",
              "description": "Number of results to skip for pagination.",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
