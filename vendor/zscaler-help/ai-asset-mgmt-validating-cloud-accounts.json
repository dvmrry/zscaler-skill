  "title": "Validating Cloud Accounts",
  "source": {
    "url": "https://help.zscaler.com/ai-asset-mgmt/validating-cloud-accounts",
    "node": "1540297",
    "revision": "3198956",
    "updated": "2026-06-30",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "AI Security validates the cloud accounts every hour to check if the onboarding templates are deployed successfully and roles and permissions are configured for each account. You can also run an on-demand validation without waiting for AI Security's hourly validations."
    },
    {
      "heading": "Validating a Single Account",
      "level": 1
    },
    {
      "text": "To validate a single account:"
    },
    {
      "item": "Go to Administration > Cloud Accounts.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          37
        ]
      ]
    },
    {
      "item": "Select the cloud account.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Select the Accounts tab for AWS, Subscriptions tab for Azure, or Projects tab for GCP.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          11,
          19
        ],
        [
          33,
          46
        ],
        [
          65,
          73
        ]
      ]
    },
    {
      "item": "The tab name varies depending on the selected cloud account.",
      "depth": 0
    },
    {
      "item": "Click the Actions icon for the account you want to validate, and click On Demand Validation.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          10,
          17
        ],
        [
          71,
          91
        ]
      ]
    },
    {
      "item": "In the On Demand Validation window, click Confirm.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          7,
          27
        ],
        [
          42,
          49
        ]
      ]
    },
    {
      "heading": "Validating all Accounts in the Organization",
      "level": 1
    },
    {
      "text": "To validate all accounts in the organization:"
    },
    {
      "item": "Go to Administration > Cloud Accounts.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          37
        ]
      ]
    },
    {
      "item": "Select the cloud account.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Click Manage, and then select On Demand Validation from the drop-down menu.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          12
        ],
        [
          30,
          50
        ]
      ]
    },
    {
      "item": "In the On Demand Validation window, click Confirm.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          27
        ],
        [
          42,
          49
        ]
      ]
    }
  ]
}
