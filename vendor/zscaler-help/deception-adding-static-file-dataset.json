    {
      "text": "You can configure a static file dataset if you don't want the files to be modified before deploying. Each decoy configured with a static dataset contains an exact copy of the files in the static dataset."
    },
    {
      "text": "Before adding a static file dataset, you must have the required files in a compressed (.zip) file."
    },
    {
      "text": "To add a static file dataset:"
    },
    {
      "item": "Go to Miragemaker > File > File Datasets.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          24
        ],
        [
          27,
          40
        ]
      ]
    },
    {
      "item": "Click Add Dataset > Add Static.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          30
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the File Dataset Details window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          27
        ]
      ]
    },
    {
      "item": "Enter a Name for the dataset.",
      "depth": 1,
      "strong": [
        [
          8,
          12
        ]
      ]
    },
    {
      "item": "Click Upload and browse to upload the compressed (.zip) file.",
      "depth": 1,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "The static file dataset is added.",
      "depth": 0
    },
    {
      "item": "See image.",
      "depth": 0
    }
  ]
}
