  "blocks": [
    {
      "text": "You can edit or delete a reporting schedule when required."
    },
    {
      "heading": "Editing a Scheduled Report",
      "level": 1
    },
    {
      "text": "To edit a reporting schedule:"
    },
    {
      "item": "Go to Administration > Scheduled Reports.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          40
        ]
      ]
    },
    {
      "item": "Click the Edit icon for the scheduled report that you want to edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "item": "Click the Edit icon for the fields you want to edit.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Next.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "Click Finish.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "A message appears indicating that the schedule is updated successfully."
    },
    {
      "heading": "Deleting a Scheduled Report",
      "level": 1
    },
    {
      "text": "To delete a reporting schedule:"
    },
    {
      "item": "Go to Administration > Scheduled Reports.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          40
        ]
      ]
    },
    {
      "item": "Click the Delete icon for the scheduled report that you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "A confirmation message appears. Click Delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          38,
          44
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "text": "A message appears indicating that the schedule is deleted successfully."
    }
  ]
}
