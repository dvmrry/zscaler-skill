    {
      "text": "Watch a video on Entra ID Change Detection."
    },
    {
      "text": "You can configure an Entra ID Custom Change Detection policy to detect changes in an Entra ID tenant based on users, service principals, or roles. You can also notify specific users via email if the configured changes are detected."
    },
    {
      "text": "To create an Entra ID Custom Change Detection policy:"
    },
    {
      "item": "Go to ITDR > Manage > Entra Change Detection.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          10
        ],
        [
          13,
          19
        ],
        [
          22,
          44
        ]
      ]
    },
    {
      "item": "Click Add Policy.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          16
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Policy Details window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          18
        ]
      ]
    },
    {
      "item": "In the Policy Details window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          21
        ]
      ]
    },
    {
      "item": "Enabled: Select to enable the policy.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          0,
          7
        ]
      ]
    },
    {
      "item": "Policy Name: Enter a name for the policy.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "Tenant: Select an Entra ID tenant from the drop-down menu to which the policy must be applied.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          0,
          6
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "The policy is added to the table.",
      "depth": 0
    },
    {
      "item": "Locate the policy that you added, and click the Edit icon under the Actions column.",
