  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "Microsegmentation allows admins to configure, edit, and delete tags at any time, as long as they are custom-type tags. Admins cannot delete tags within cloud and machine learning (ML) namespaces."
    },
    {
      "heading": "Prerequisites",
      "level": 1
    },
    {
      "text": "Enable policy enforcement for your organization. To learn more, see Enabling Microsegmentation Policy Settings."
    },
    {
      "heading": "Deleting Custom Tags",
      "level": 1
    },
    {
      "text": "To delete a custom tag:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > Tag Management.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          85
        ]
      ]
    },
    {
      "item": "Select the namespace that contains the tag you want to delete.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Click the Delete icon on the chosen tag.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          10,
          16
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Delete Tag Key window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          18
        ]
      ]
    },
    {
      "item": "In the Delete Tag Key window:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          21
        ]
      ]
    },
    {
      "item": "Enter CONFIRM.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Delete.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The page reloads and your tag is removed from the list."
    }
  ]
}
