    {
      "text": "Configuring a Zscaler Authentication Bridge (ZAB) is one of the tasks you must complete when deploying a ZAB. For a complete list of tasks, see Deploying a Zscaler Authentication Bridge."
    },
    {
      "text": "To add a ZAB:"
    },
    {
      "item": "From the navigation menu, go to Administration > Internet & SaaS Authentication > Internet Authentication Settings.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          46
        ],
        [
          49,
          79
        ],
        [
          82,
          114
        ]
      ]
    },
    {
      "item": "Select the Authentication Bridges tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          11,
          33
        ]
      ]
    },
    {
      "item": "On the Authentication Bridges tab, click Add Authentication Bridge.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          29
        ],
        [
          41,
          66
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Add Authentication Bridge window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          29
        ]
      ]
    },
    {
      "item": "In the Add Authentication Bridge window:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          32
        ]
      ]
    },
    {
      "item": "Name: Enter a name for the ZAB.",
      "depth": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Status: Enable or Disable the ZAB. The ZAB is enabled by default.",
      "depth": 1,
      "strong": [
        [
          0,
          6
        ],
        [
          8,
          14
        ],
        [
          18,
          25
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save and activate the change.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
