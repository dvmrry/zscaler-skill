    "components": {
      "schemas": {
        "VersionProfileDto": {
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "id": {
              "type": "integer",
              "format": "int64",
              "description": "The ID of the version profile."
            },
            "name": {
              "type": "string",
              "description": "The name of the version profile."
            },
            "selectedUpgradePriority": {
              "type": "string",
              "enum": [
                "WEEK",
                "DAY",
                "FORCE_NOW",
                "NOW"
              ]
            },
            "upgradePriorities": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "WEEK",
                  "DAY",
                  "FORCE_NOW",
                  "NOW"
                ]
              }
            },
            "upgradePriority": {
              "type": "string",
              "enum": [
                "WEEK",
                "DAY",
                "FORCE_NOW",
                "NOW"
              ]
            },
            "versionDetails": {
              "type": "array",
              "description": "Version profile details",
              "items": {
                "$ref": "#/components/schemas/VersionDTO"
              }
            },
            "visibilityScope": {
              "type": "string",
              "enum": [
                "ALL",
                "NONE",
                "CUSTOM"
              ]
            }
          }
        },
        "ZPathAPIError": {
          "properties": {
            "reason": {
              "type": "string",
              "description": "The reason for the cause of the error status code. To learn more, see <a href=\"/zpa/api-response-codes-and-error-messages\" target= _blank>API Response Codes and Error Messages</a>."
            },
            "id": {
              "type": "string",
              "description": "The unique identifier of the error status code."
            },
            "params": {
              "type": "array",
              "description": "The parameters that were sent in the request body.",
              "items": {
                "type": "object"
              }
            },
            "hostname": {
              "type": "string",
              "description": "The client server address or domain name."
            }
          }
        },
        "UpdateCustomerVersionProfileDto": {
          "properties": {
            "removeOverrideFlag": {
              "type": "boolean"
            },
            "selectedUpgradePriority": {
              "type": "string",
              "enum": [
                "WEEK",
                "DAY",
                "FORCE_NOW",
                "NOW"
              ]
            }
          }
        },
        "PageListVersionProfile": {
          "properties": {
            "totalPages": {
              "type": "integer",
              "description": "The total number of pages per the pagination attribute.",
              "format": "int32"
            },
            "currentCount": {
              "type": "integer",
              "description": "The current count of resources per the search feature.",
              "format": "int64"
            },
            "totalCount": {
              "type": "integer",
              "description": "The total count of resources per the search feature.",
              "format": "int64"
            },
            "list": {
              "type": "array",
              "description": "The total list of version profile resources.",
              "items": {
                "$ref": "#/components/schemas/VersionProfile"
              }
            }
          }
        },
        "VersionDTO": {
          "properties": {
            "latestPlatform": {
              "type": "string",
              "description": "The latest platform for the version."
            },
            "role": {
              "type": "string",
              "description": "The role of the version."
            },
            "version": {
              "type": "The version."
            }
          }
        },
        "VersionProfile": {
          "required": [
            "name",
            "upgradePriority"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "description": "The unique identifier of the version profile.",
              "format": "int64"
            },
            "modifiedTime": {
              "type": "integer",
              "description": "The time the version profile is modified.",
              "format": "int32"
            },
            "creationTime": {
              "type": "integer",
              "description": "The time the version profile is created.",
              "format": "int32"
            },
            "modifiedBy": {
              "type": "integer",
              "description": "The unique identifier of the tenant who modified the version profile.",
              "format": "int64"
            },
            "name": {
              "type": "string",
              "description": "The name of the version profile."
            },
            "description": {
              "type": "string",
              "description": "The description of the version profile."
            },
            "upgradePriority": {
              "type": "string",
              "description": "The upgrade priority of the version profile.",
              "enum": [
                "WEEK",
                "DAY",
                "FORCE_NOW",
                "NOW"
              ]
            },
            "visibilityScope": {
              "type": "string",
              "description": "Indicates whether or not the version profile is visible to all of the tenants, none of the tenants, or a custom set of tenants. This field is only applicable for GET requests and is ignored in POST, PUT, and DELETE requests.",
              "enum": [
                "ALL",
                "NONE",
                "CUSTOM"
              ]
            },
            "versions": {
              "type": "array",
              "description": "The builds of the version profile.",
              "items": {
                "$ref": "#/components/schemas/Version"
              }
            },
            "customScopeCustomerIds": {
              "type": "array",
              "description": "The ZPA tenant IDs and names of the customer when the visibilityScope is set to CUSTOM. This field is only applicable for GET requests and is ignored in POST and PUT requests.",
              "items": {
                "$ref": "#/components/schemas/CustomerIdNameDTO"
              }
            },
            "customScopeRequestCustomerIds": {
              "$ref": "#/components/schemas/CustomScopeRequestCustomerIds"
            },
            "numberOfAssistants": {
              "type": "integer",
              "description": "The number of App Connectors for the version profile.",
              "format": "int64"
            },
            "numberOfPrivateBrokers": {
              "type": "integer",
              "description": "The number of ZPA Private Service Edges for the version profile.",
              "format": "int64"
            },
            "numberOfUpdatedAssistants": {
              "type": "integer",
              "description": "The number of updated App Connectors for the version profile.",
              "format": "int64"
            },
            "numberOfUpdatedPrivateBrokers": {
              "type": "integer",
              "description": "The number of updated ZPA Private Service Edges for the version profile.",
              "format": "int64"
            },
            "numberOfSiteControllers": {
              "type": "integer",
              "description": "The number of Private Cloud Controllers for the version profile.",
              "format": "int64"
            },
            "numberOfUpdatedSiteControllers": {
              "type": "integer",
              "description": "The number of updated Private Cloud Controllers for the version profile.",
              "format": "int64"
            },
            "numberOfCustomers": {
              "type": "integer",
              "description": "The number of customers for the version prfoile.",
              "format": "int64"
            },
            "customerId": {
              "type": "integer",
              "description": "The unique identifier of the ZPA tenant.",
              "format": "int64"
            }
          }
        },
        "Version": {
          "required": [
            "platform",
            "role",
            "version",
            "version_profile_gid"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "description": "The unique identifier of the version.",
              "format": "int64"
            },
            "modifiedTime": {
              "type": "integer",
              "description": "The time the version is modified.",
              "format": "int32"
            },
            "creationTime": {
              "type": "integer",
              "description": "The time the version is created.",
              "format": "int32"
            },
            "modifiedBy": {
              "type": "integer",
              "description": "The unique identifier of the tenant who modified the version.",
              "format": "int64"
            },
            "version_profile_gid": {
              "type": "integer",
              "description": "The group ID of the version profile.",
              "format": "int64"
            },
            "role": {
              "type": "string",
              "description": "The role of the verison."
            },
            "platform": {
              "type": "string",
              "description": "The platform the component is deployed on."
            },
            "version": {
              "type": "string",
              "description": "The version the platform is deployed in."
            },
            "restartAfterUptimeInDays": {
              "type": "integer",
              "description": "The number of days after uptime that the component restarts.",
              "format": "int32"
            },
            "upgradeOrder": {
              "type": "integer",
              "description": "The upgrade order of the version.",
              "format": "int32"
            },
            "upgradeWithoutRestart": {
              "type": "boolean",
              "description": "Indicates if the version is upgraded without a restart (true) or not (false)."
            },
            "customerId": {
              "type": "integer",
              "description": "The unique identifier of the ZPA tenant.",
              "format": "int64"
            }
          }
        },
        "CustomerIdNameDTO": {
          "properties": {
            "customerId": {
              "type": "integer",
              "description": "The unique identifier of the ZPA tenant.",
              "format": "int64"
            },
            "name": {
              "type": "string",
              "description": "The name of the customer."
            },
            "excludeConstellation": {
              "type": "boolean"
            },
            "isPartner": {
              "type": "boolean",
              "description": "Indicates if a customer is an additional tenant and is using a separate tunnel to connect between Zscaler Client Connector and a ZPA Public Service Edge, or between an App Connector and a ZPA Private Service Edge. To learn more, see <a href=\"/zpa/about-client-connector-support-multiple-tenants\" target=\"_blank\" >About Client Connector Support for Multiple Tenants</a>."
            }
          }
        },
        "CustomScopeRequestCustomerIds": {
          "properties": {
            "addCustomerIds": {
              "type": "array",
              "description": "Used to update a version profile for a custom version. This field is not applicable for a GET request.",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            },
            "deleteCustomerIds": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        }
      }
    }
  }
