    {
      "text": "Tags are resource components used when configuring criteria for resource groups. You can create and delete tags individually. To learn more, see About Resource Groups and About Resources."
    },
    {
      "heading": "Prerequisites",
      "level": 1
    },
    {
      "text": "Enable policy enforcement for your organization. To learn more, see Enabling Microsegmentation Policy Settings."
    },
    {
      "heading": "Configuring Resource Tags",
      "level": 1
    },
    {
      "text": "To create a new resource tag:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > Resources VM.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          83
        ]
      ]
    },
    {
      "item": "Click a resource.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "The resource drawer opens.",
      "depth": 0
    },
    {
      "item": "In the resource drawer, click Tags.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          30,
          34
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Tags section appears.",
      "depth": 0,
      "strong": [
        [
          4,
          8
        ]
      ]
    },
    {
      "item": "In the Tags section, click Add Tag.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          11
        ],
        [
          27,
          34
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Add a tag:",
      "depth": 0,
      "number": 5
    },
    {
      "item": "Namespace: Select a namespace for the tag.",
      "depth": 1,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
      "item": "Key: Select a key name to title the tag.",
      "depth": 1,
      "strong": [
        [
          0,
          3
        ]
      ]
    },
    {
      "item": "Value: Select value components for which the tag qualifies.",
      "depth": 1,
      "strong": [
        [
          0,
          5
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "Your new resource tag appears in the list."
