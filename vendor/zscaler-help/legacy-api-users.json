    "paths": {
      "/users": {
        "get": {
          "description": "Retrieves a list of users with optional query parameters for pagination and filtering.\n\n To learn more, see <a href=\"/zidentity/about-users\">About Users</a>.",
          "operationId": "UsersOps_list",
          "parameters": [
            {
              "name": "offset",
              "description": "The starting point for pagination, with the number of records that can be skipped before fetching results.",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "explode": false
            },
            {
              "name": "limit",
              "description": "The maximum number of records to return per request. Minimum: <code>0</code>, Maximum: <code>1000</code>",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "minimum": 0,
                "maximum": 1000
              },
              "explode": false
            },
            {
              "$ref": "#/components/parameters/UsersQueryParameter.loginname"
            },
            {
              "$ref": "#/components/parameters/UsersQueryParameter.loginnamelike"
            },
            {
              "$ref": "#/components/parameters/UsersQueryParameter.displaynamelike"
            },
            {
              "$ref": "#/components/parameters/UsersQueryParameter.primaryemaillike"
            },
            {
              "$ref": "#/components/parameters/UsersQueryParameter.domainname"
            },
            {
              "$ref": "#/components/parameters/UsersQueryParameter.idpname"
            }
          ],
          "responses": {
            "200": {
              "description": "The request was successful, and a paginated list of users are returned.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "results_total",
                        "pageOffset",
                        "pageSize",
                        "next_link",
                        "prev_link",
                        "records"
                      ],
                      "properties": {
                        "results_total": {
                          "type": "integer",
                          "format": "int64",
                          "description": "The total number of users available."
                        },
                        "pageOffset": {
                          "type": "integer",
                          "format": "int64",
                          "description": "The starting point of the current page in pagination. Helps determine which set of records is being displayed."
                        },
                        "pageSize": {
                          "type": "integer",
                          "format": "int64",
                          "description": "The number of records included in a single response page."
                        },
                        "next_link": {
                          "type": "string",
                          "description": "URL link to the next page of users records, if available. Helps to navigate through paginated results."
                        },
                        "prev_link": {
                          "type": "string",
                          "description": "URL link to the previous page of users records, if available."
                        },
                        "records": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/UserProfilePubRespDto"
                          },
                          "description": "List of users and the details of each individual users."
                        }
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "description": "Authentication failed or missing authorization credentials.\n\nThe request requires a valid Bearer Token. However, either no token was provided, or the provided token is invalid or expired.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Zscaler.Core.UnauthorizedError"
                  }
                }
              }
            }
          },
          "tags": [
            "Users"
          ],
          "security": [
            {
              "BearerAuth": []
            }
          ]
        },
        "post": {
          "description": "Creates a new user using the provided details.",
          "operationId": "UsersOps_add",
          "parameters": [],
          "responses": {
            "202": {
              "description": "The request has been accepted for processing, but processing has not yet completed.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/UserProfilePubRespDto"
                  }
                }
              }
            },
            "401": {
              "description": "Authentication failed or missing authorization credentials.\n\nThe request requires a valid Bearer Token. However, either no token was provided, or the provided token is invalid or expired.",
              "content": {
                "application/json": {
                  "schema": {
                    "$ref": "#/components/schemas/Zscaler.Core.UnauthorizedError"
                  }
                }
              }
            }
          },
          "tags": [
            "Users"
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "loginName",
                    "displayName",
                    "primaryEmail",
                    "status"
                  ],
                  "properties": {
                    "loginName": {
                      "description": "Unique login name of the user.",
                      "type": "string",
                      "maxLength": 255
                    },
                    "displayName": {
                      "description": "Display name of the user.",
                      "type": "string",
                      "maxLength": 255
                    },
                    "firstName": {
                      "description": "First name of the user.",
                      "type": "string",
                      "maxLength": 255
                    },
                    "lastName": {
                      "description": "Last name of the user.",
                      "type": "string",
                      "maxLength": 255
                    },
                    "primaryEmail": {
                      "description": "Primary email address of the user.",
                      "type": "string",
                      "maxLength": 255
                    },
                    "secondaryEmail": {
                      "description": "Secondary email address of the user.",
                      "type": "string",
                      "maxLength": 255
                    },
                    "department": {
                      "$ref": "#/components/schemas/RefPubReqDto"
                    },
                    "status": {
                      "description": "Whether the API user needs to be active <code>true</code> or disabled <code>false</code>.",
                      "type": "boolean"
                    },
                    "customAttrsInfo": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      },
                      "description": "Additional custom attributes information."
                    }
                  }
                }
              }
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ]
        }
      },
      "/users:bulkdelete": {
        "post": {
          "description": "Deletes multiple users in a single request.<p><strong>Note:</strong> A maximum of 1,000 users can be deleted in a single API request. After deletion, the users cannot be recovered.</p>",
          "operationId": "UsersOps_bulkDelete",
          "parameters": [],
          "responses": {
            "200": {
              "description": "The request was successful, and the users have been deleted.",
              "content": {
                "application/json": {
                  "schema": {
                    "description": "String confirmation returned after successful deletion.",
                    "type": "string"
                  }
                }
              }
            },
            "400": {
              "description": "The request contains invalid syntax or missing required fields.",
              "content": {
                "application/json": {
                  "schema": {
                    "description": "Standard validation error payload.",
                    "$ref": "#/components/schemas/Zscaler.Core.ValidationError"
                  }
                }
              }
            },
            "401": {
              "description": "Authentication failed or missing authorization credentials.\n\nThe request requires a valid Bearer Token. However, either no token was provided, or the provided token is invalid or expired.",
              "content": {
                "application/json": {
                  "schema": {
                    "description": "Standard authentication error payload.",
                    "$ref": "#/components/schemas/Zscaler.Core.UnauthorizedError"
                  }
                }
              }
            }
          },
          "tags": [
            "Users"
          ],
          "requestBody": {
            "description": "JSON array of user reference objects to be deleted.",
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "description": "Array of references to users targeted for deletion.",
                  "type": "array",
                  "items": {
                    "description": "Reference object identifying a user to delete.",
                    "$ref": "#/components/schemas/RefPubReqDto"
                  }
                }
              }
            }
          },
          "security": [
            {
              "BearerAuth": []
            }
          ]
        }
      },
