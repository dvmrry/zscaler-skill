  "blocks": [
    {
      "text": "The features available in the ZPC Admin Portal are classified as modules and global modules. Users can access data in these modules depending on their roles and permissions. To learn more, see About Roles."
    },
    {
      "item": "Global Modules: Data is not segregated by cloud accounts and business units are not applicable for these modules.",
      "depth": 0,
      "strong": [
        [
          0,
          14
        ]
      ]
    },
    {
      "item": "Modules: Data can be filtered by cloud accounts that are associated with business units. The business unit filters are applicable for these modules.",
      "depth": 0,
      "strong": [
        [
          0,
          7
        ]
      ]
    },
