  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "Microsegmentation allows admins to configure, edit, and delete namespaces at any time, as long as they are custom-type namespaces. You cannot delete cloud and machine learning (ML) namespaces."
    },
    {
      "heading": "Prerequisites",
      "level": 1
    },
    {
      "text": "Enable policy enforcement for your organization. To learn more, see Enabling Microsegmentation Policy Settings."
    },
    {
      "heading": "Deleting Custom Namespaces",
      "level": 1
    },
    {
      "text": "To delete a custom namespace for a tag:"
    },
    {
      "item": "From the navigation menu, go to Zero Trust Cloud > Microsegmentation > Tag Management.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          48
        ],
        [
          51,
          68
        ],
        [
          71,
          85
        ]
      ]
    },
    {
      "item": "Click the More icon (vertical ellipsis) on the chosen namespace.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          14
        ]
      ]
    },
    {
      "item": "Click Delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Delete Namespace window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          20
        ]
      ]
    },
    {
      "item": "In the Delete Namespace window:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          23
        ]
      ]
    },
    {
      "item": "Enter CONFIRM.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Delete.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The page reloads and your namespace is removed from the list."
    }
  ]
}
