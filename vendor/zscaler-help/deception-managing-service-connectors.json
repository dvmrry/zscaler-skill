    {
      "text": "You can edit or delete Service Connectors configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a Service Connector",
      "level": 1
    },
    {
      "text": "To edit a Service Connector:"
    },
    {
      "item": "Go to Orchestrate > Service Connectors.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          38
        ]
      ]
    },
    {
      "item": "In the table, select the Service Connector you want to modify, and then click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          82,
          86
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Service Connector Details window, modify the fields as necessary.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          32
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting a Service Connector",
      "level": 1
    },
    {
      "text": "To delete a Service Connector:"
    },
    {
      "item": "Go to Orchestrate > Service Connectors.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          38
        ]
      ]
    },
    {
      "item": "In the table, select the Service Connector you want to delete, and then click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          82,
          88
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "item": "When you delete a Service Connector, all SIEM integrations with the Service Connector are deleted.",
      "depth": 0
    }
  ]
}
