  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete file templates that you configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a File Template",
      "level": 1
    },
    {
      "text": "To edit a file template:"
    },
    {
      "item": "Go to Miragemaker > Files > File Template.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          25
        ],
        [
          28,
          41
        ]
      ]
    },
    {
      "item": "Under Actions, click the Edit icon for the template you want to modify.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          29
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the File Template Details window, modify the required fields.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          28
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The default file templates cannot be edited."
    },
    {
      "heading": "Deleting a File Template",
      "level": 1
    },
    {
      "text": "To delete a file template:"
    },
    {
      "item": "Go to Miragemaker > File > File Templates.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          24
        ],
        [
          27,
          41
        ]
      ]
    },
    {
      "item": "Under Actions, click the Delete icon for the template you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          31
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "text": "The default file templates cannot be deleted."
    }
  ]
}
