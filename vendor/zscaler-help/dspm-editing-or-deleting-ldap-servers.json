    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can modify or delete an LDAP server as required."
    },
    {
      "heading": "Editing an LDAP Server",
      "level": 1
    },
    {
      "text": "To edit an LDAP server:"
    },
    {
      "item": "From the navigation menu, go to Data Security > DSPM > Service Registration.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          45
        ],
        [
          48,
          52
        ],
        [
          55,
          75
        ]
      ]
    },
    {
      "item": "On the Service Registration page, select the LDAP Servers tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          27
        ],
        [
          45,
          57
        ]
      ]
    },
    {
      "item": "Do one of the following:",
      "depth": 0,
      "number": 3
    },
    {
      "item": "Click the Actions icon (), and select Edit for the required LDAP server.",
      "depth": 1,
      "strong": [
        [
          10,
          17
        ],
        [
          38,
          42
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click the name of the LDAP server to open the LDAP Server details drawer, then click Actions, and select Edit.",
      "depth": 1,
      "strong": [
        [
          85,
          92
        ],
        [
          105,
          109
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "The Edit LDAP Server drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          20
        ]
      ]
    },
    {
      "item": "In the Edit LDAP Server drawer, update the following sections as required:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          23
        ]
      ]
    },
    {
      "item": "Server Information:",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          0,
          18
        ]
      ]
    },
    {
      "item": "Server Logical Name: Update the name to identify the server in DSPM.",
      "depth": 1,
      "strong": [
        [
          0,
          19
        ]
      ]
    },
    {
      "item": "Connection Attributes:",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          0,
          21
        ]
      ]
    },
    {
      "item": "Hostname: Update the server's IP address or FQDN.",
      "depth": 2,
      "number": 1,
      "strong": [
        [
          0,
          8
        ]
      ]
    },
    {
      "item": "Domain Name: Update the domain name associated with the server.",
      "depth": 2,
      "number": 2,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "Authentication:",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          0,
          14
        ]
      ]
    },
    {
      "item": "Secret Provider Type: This field is autopopulated with the provider used to manage authentication secrets, typically set to Zscaler DSPM.",
      "depth": 2,
      "number": 1,
      "strong": [
        [
          0,
          20
        ],
        [
          124,
          136
        ]
      ]
    },
    {
      "item": "Username: Update the username used to authenticate access to the LDAP server.",
      "depth": 2,
      "number": 2,
      "strong": [
        [
          0,
          8
        ]
      ]
    },
    {
      "item": "Password: Update the password associated with the username.",
      "depth": 2,
      "number": 3,
      "strong": [
        [
          0,
          8
        ]
      ]
    },
    {
      "item": "Root CA Cert (Optional):",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          0,
          23
        ]
      ]
    },
    {
      "item": "If your LDAP server uses a certificate, update the PEM file to verify the LDAP server's SSL certificate for secure connections.",
      "depth": 1
    },
    {
      "item": "Data Center Association:",
      "depth": 1,
      "number": 5,
      "strong": [
        [
          0,
          23
        ]
      ]
    },
    {
      "item": "Data Center: Choose the data center associated with the LDAP server.",
      "depth": 2,
      "number": 1,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "The LDAP server is updated."
    },
    {
      "heading": "Deleting an LDAP Server",
      "level": 1
    },
    {
      "text": "To delete an LDAP server:"
    },
    {
      "item": "Go to Data Security > DSPM > Service Registration.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          19
        ],
        [
          22,
          26
        ],
        [
          29,
          49
        ]
      ]
    },
    {
      "item": "On the Service Registration page, select the LDAP Servers tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          27
        ],
        [
          45,
          57
        ]
      ]
    },
    {
      "item": "Do one of the following:",
      "depth": 0,
      "number": 3
    },
    {
      "item": "Click the Actions icon (), and select Delete for the required LDAP server.",
      "depth": 1,
      "strong": [
        [
          10,
          17
        ],
        [
          38,
          44
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click the name of the LDAP server to open the LDAP Server details drawer, then click Actions, and select Delete.",
      "depth": 1,
      "strong": [
        [
          85,
          92
        ],
        [
          105,
          111
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "The Delete LDAP Server confirmation window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          22
        ]
      ]
    },
    {
      "item": "In the Delete LDAP Server confirmation window, read the message, and then enter CONFIRM in the text box.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          25
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Delete.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The LDAP server is deleted from the Zscaler Admin Console."
    }
  ]
}
