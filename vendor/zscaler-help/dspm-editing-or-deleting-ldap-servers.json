  "schema_version": 1,
  "kind": "help-article",
  "title": "Editing or Deleting LDAP Servers",
  "source": {
    "url": "https://help.zscaler.com/dspm/editing-or-deleting-ldap-servers",
    "node": "1540322",
    "revision": "3242934",
