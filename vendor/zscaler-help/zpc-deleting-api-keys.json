  "blocks": [
    {
      "text": "To delete an API key:"
    },
    {
      "item": "Go to Administration > Authentication & Authorization > API Keys.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          37
        ],
        [
          38,
          53
        ],
        [
          56,
          64
        ]
      ]
    },
    {
      "item": "Locate the key you want to delete in the table, click the Menu icon, and then click Delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          58,
          62
        ],
        [
          84,
          90
        ]
      ]
    },
    {
      "text": "The Delete API Key window appears.",
      "strong": [
        [
          4,
          18
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the Delete API Key window, confirm you want to delete the API key, and then click Delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          21
        ],
        [
          85,
          91
        ]
      ]
    },
    {
      "text": "Deleting an API key cannot be undone. If you delete an API key, that API key is permanently deleted and a new one must be created."
    }
  ]
}
