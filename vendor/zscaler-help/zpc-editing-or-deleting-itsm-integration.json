    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "You can edit or delete any ITSM integration that you've configured."
    },
    {
      "heading": "Editing an ITSM Integration",
      "level": 1
    },
    {
      "text": "To edit an ITSM integration:"
    },
    {
      "item": "Go to Administration > Integrations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          35
        ]
      ]
    },
    {
      "item": "On the Integrations page, click the Edit icon for the ITSM integration that you wish to edit.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          19
        ],
        [
          36,
          40
        ]
      ]
    },
    {
      "item": "In the Edit Integration window:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          23
        ]
      ]
    },
    {
      "item": "Change the ServiceName.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          11,
          22
        ]
      ]
    },
    {
      "item": "Click Reset Validation to validate the ServiceNow hostname and credentials if required.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          6,
          22
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting and ITSM Integration",
      "level": 1
    },
    {
      "text": "To delete an ITSM integration:"
    },
    {
      "item": "Go to Administration > Integrations.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          35
        ]
      ]
    },
    {
      "item": "On the Integrations page, click the Delete icon for the ITSM integration that you wish to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          19
        ],
        [
          36,
          42
        ]
      ]
    },
    {
      "item": "A confirmation message appears. Click Delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          38,
          44
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "text": "You cannot delete an integration if it is associated with alert rules. You need to move the alert rules to another integration, then you can delete this integration. To learn more, see About Alert Rules."
    }
  ]
}
