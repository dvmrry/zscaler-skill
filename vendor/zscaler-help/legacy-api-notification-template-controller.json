      "/public/v2/notification-templates": {
        "get": {
          "summary": "List notification templates",
          "description": "Retrieves a list of notification templates with optional keyword filtering and pagination support.",
          "tags": [
            "notification-template-controller"
          ],
          "operationId": "listNotificationTemplates",
          "parameters": [
            {
              "name": "keyword",
              "in": "query",
              "required": false,
              "description": "Search keyword to filter notification templates by name or other attributes.",
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "offset",
              "description": "Number of results to skip for pagination.",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 0
              }
            },
            {
              "name": "limit",
              "description": "Maximum number of results to return per page.",
              "in": "query",
              "required": false,
              "schema": {
                "type": "integer",
                "format": "int32",
                "default": 50
              }
            }
          ],
          "responses": {
            "200": {
              "description": "OK",
              "content": {
                "application/json": {
                  "schema": {
                    "description": "Response object containing an array of notification templates and pagination metadata.",
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "post": {
          "summary": "Create notification template",
          "description": "Creates a new notification template with specified configuration for Internet & SaaS (ZIA) and Private Access (ZPA) notifications.",
          "tags": [
            "notification-template-controller"
          ],
          "operationId": "createNotificationTemplate",
          "requestBody": {
            "description": "Notification template configuration payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationTemplateContractV2"
                }
              }
            },
            "required": true
          },
          "responses": {
            "201": {
              "description": "CREATED",
              "content": {
                "application/json": {
                  "schema": {
                    "description": "Response object containing the newly created notification template details.",
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "components": {
      "schemas": {
        "NotificationTemplateContractV2": {
          "type": "object",
          "description": "Notification template configuration for defining user notifications in Internet & SaaS (ZIA) and Private Access (ZPA).",
          "properties": {
            "id": {
              "description": "Unique identifier of the notification template.",
              "type": "integer",
              "format": "int64"
            },
            "name": {
              "description": "Name of the notification template.",
              "type": "string"
            },
            "isDefaultTemplate": {
              "description": "Indicates whether this is the default notification template.",
              "type": "boolean"
            },
            "enableClient": {
              "description": "Enables notifications on the client application.",
              "type": "boolean"
            },
            "enableZia": {
              "description": "Enables Internet & SaaS (ZIA) (Zero Trust Internet Access) notifications.",
              "type": "boolean"
            },
            "enableAppUpdates": {
              "description": "Enables notifications for application updates.",
              "type": "boolean"
            },
            "enableServiceStatus": {
              "description": "Enables notifications for service status changes.",
              "type": "boolean"
            },
            "durationInSeconds": {
              "description": "Duration in seconds for which the notification is displayed.",
              "type": "integer",
              "format": "int32"
            },
            "enablePersistent": {
              "description": "Indicates whether the notification is persistent and remains visible until dismissed.",
              "type": "boolean"
            },
            "enableDoNotDisturb": {
              "description": "Enables do-not-disturb mode for notifications.",
              "type": "boolean"
            },
            "createdBy": {
              "description": "User ID of the creator of this notification template.",
              "type": "integer",
              "format": "int64"
            },
            "editedBy": {
              "description": "User ID of the user who last edited this notification template.",
              "type": "integer",
              "format": "int64"
            },
            "createTime": {
              "description": "Timestamp indicating when the notification template was created.",
              "type": "string"
            },
            "updateTime": {
              "description": "Timestamp indicating when the notification template was last updated.",
              "type": "string"
            },
            "ziaNotificationTemplate": {
              "description": "Internet & SaaS (ZIA)-specific notification template configuration.",
              "$ref": "#/components/schemas/ZiaNotificationTemplateV2"
            },
            "zpaNotificationTemplate": {
              "description": "Private Access (ZPA)-specific notification template configuration.",
              "$ref": "#/components/schemas/ZpaNotificationTemplateV2"
            }
          }
        },
        "ZiaNotificationTemplateV2": {
          "type": "object",
          "description": "Internet & SaaS (ZIA)-specific notification template configuration for firewall, DNS, and IPS notifications.",
          "properties": {
            "enableZiaFirewall": {
              "description": "Enables firewall notifications in Internet & SaaS (ZIA).",
              "type": "boolean"
            },
            "enableZiaFirewallPopup": {
              "description": "Enables popup notifications for firewall events in Internet & SaaS (ZIA).",
              "type": "boolean"
            },
            "enableZiaDNS": {
              "description": "Enables DNS notifications in Internet & SaaS (ZIA).",
              "type": "boolean"
            },
            "enableZiaDNSPopup": {
              "description": "Enables popup notifications for DNS events in Internet & SaaS (ZIA).",
              "type": "boolean"
            },
            "enableZiaIPS": {
              "description": "Enables IPS (Intrusion Prevention System) notifications in Internet & SaaS (ZIA).",
              "type": "boolean"
            },
            "enableZiaIPSPopup": {
              "description": "Enables popup notifications for IPS events in Internet & SaaS (ZIA).",
              "type": "boolean"
            },
            "enableZiaPersistent": {
              "description": "Enables persistent notifications in Internet & SaaS (ZIA) that remain visible until dismissed.",
              "type": "boolean"
            }
          }
        },
        "ZpaNotificationTemplateV2": {
          "description": "Private Access (ZPA)-specific notification template configuration for device posture and re-authentication.",
          "type": "object",
          "properties": {
            "enableDevicePostureFailure": {
              "description": "Enables notifications when device posture check fails.",
              "type": "boolean"
            },
            "enableZpaReauth": {
              "description": "Enables reauthentication notifications in Private Access (ZPA).",
              "type": "boolean"
            },
            "zpaReauthIntervalInMinutes": {
              "description": "Interval in minutes between Private Access (ZPA) re-authentication notifications.",
              "type": "integer",
              "format": "int32"
            },
            "delayPostureFailureSeconds": {
              "description": "Delay in seconds before displaying device posture failure notifications.",
              "type": "integer",
              "format": "int32"
            }
          }
        }
      }
    }
  }
}
