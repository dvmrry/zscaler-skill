  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "You can add external routers that are used in the Border Gateway Protocol (BGP) session for Network Connectors. You can add up to 64 routers."
    },
    {
      "text": "To add an external router:"
    },
    {
      "item": "Go to Private Access > VPN (for Legacy Apps) > External Routers.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          44
        ],
        [
          47,
          63
        ]
      ]
    },
    {
      "item": "Click Add External Router.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          25
        ]
      ]
    },
    {
      "item": "The Add External Router drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          23
        ]
      ]
    },
    {
      "item": "In the Add External Router drawer:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          26
        ]
      ]
    },
    {
      "item": "Name: Enter a name for the external router.",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Router AS Number: Enter the autonomous system number (ASN) for the external router. This number is assigned to the routers for BGP.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          0,
          16
        ]
      ]
    },
    {
      "item": "Router IP Address: Enter the IP address of the internal router you want the Network Connector to peer with.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          0,
          17
        ]
      ]
    },
    {
      "item": "MD5 (Optional): Enter the BGP MD5 authentication password. The same value must be configured on both BGP peers.",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          0,
          14
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
