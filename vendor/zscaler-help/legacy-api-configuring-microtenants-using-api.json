      "depth": 0
    },
    {
      "item": "\"id\": \"72057594038622872\",",
      "depth": 0
    },
    {
      "item": "\"name\": \"security-new\"",
      "depth": 0
    },
    {
      "item": "},",
      "depth": 0
    },
