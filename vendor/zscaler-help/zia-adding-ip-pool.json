  "blocks": [
    {
      "text": "You can configure custom IP pools for Zscaler Extranet Application Support. Only extranet-type IP pools can be created."
    },
    {
      "text": "To access Extranet Application Support, contact your Zscaler Account team."
    },
    {
      "text": "To add an IP pool:"
    },
    {
      "item": "From the navigation menu, go to Internet Access > Resources > IP & FQDN Groups.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          47
        ],
        [
          50,
          59
        ],
        [
          62,
          78
        ]
      ]
    },
    {
      "item": "Select the IP Pool tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          11,
          18
        ]
      ]
    },
    {
      "item": "Click Add IP Pool.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          17
        ]
      ]
    },
    {
      "item": "The Add IP Pool drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          15
        ]
      ]
    },
    {
      "item": "In the Add IP Pool drawer:",
      "depth": 0,
      "number": 4
    },
    {
      "item": "Name: Enter a name for the IP pool.",
      "depth": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "IP Addresses: Enter IP addresses as a subnet or range of addresses.",
      "depth": 1,
      "strong": [
        [
          0,
          12
        ]
      ]
    },
    {
      "item": "You can add a maximum of only one IP address range for an IP pool.",
      "depth": 1
    },
    {
      "item": "Description: (Optional) Enter a description for the IP pool.",
      "depth": 1,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save and activate the change.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
