      "number": 1,
      "strong": [
        [
          6,
          19
        ],
        [
          22,
          26
        ],
        [
          29,
          43
        ]
      ]
    },
    {
      "item": "The Cloud Accounts page appears.",
      "depth": 0,
      "strong": [
        [
          4,
          18
        ]
      ]
    },
    {
      "item": "On the Cloud Accounts page, click the required cloud account (AWS, Azure, or GCP).",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          21
        ]
      ]
    },
    {
      "item": "Click Manage, and then select On Demand Validation from the drop-down menu.",
