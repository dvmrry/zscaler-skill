    {
      "text": "You can review the Adaptive Access profiles over a period of time for their effectiveness, and modify or delete the profiles as required."
    },
    {
      "heading": "Editing an Adaptive Access Profile",
      "level": 1
    },
    {
      "text": "To edit an Adaptive Access profile:"
    },
    {
      "item": "Go to Policies > Common Configuration > Adaptive Access > Profiles.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          37
        ],
        [
          40,
          55
        ],
        [
          58,
          66
        ]
      ]
    },
    {
      "item": "On the Profiles page, click the Edit icon for the required profile.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          15
        ],
        [
          32,
          36
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Edit Profiles window, modify the values as required.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          20
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Update.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "heading": "Deleting an Adaptive Access Profile",
      "level": 1
    },
    {
      "text": "To delete an Adaptive Access profile:"
    },
    {
      "item": "Go to Policies > Common Configuration > Adaptive Access > Profiles.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          37
        ],
        [
          40,
          55
        ],
        [
          58,
          66
        ]
      ]
    },
    {
      "item": "On the Profiles page, click the Delete icon for the required profile.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          15
        ],
        [
          32,
          38
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the Confirmation window, enter YES, then click Delete.",
