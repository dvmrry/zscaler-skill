    {
      "text": "This article provides information on how to configure a dynamic Virtual Desktop Infrastructure (VDI) group. To learn more, see About VDI Groups."
    },
    {
      "text": "To add a VDI group:"
    },
    {
      "item": "From the navigation menu, go to Infrastructure > Client Connector > VDI Device Management > VDI Groups.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          46
        ],
        [
          49,
          65
        ],
        [
          68,
          89
        ],
        [
          92,
          102
        ]
      ]
    },
    {
      "item": "Click Add Dynamic VDI Group.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          27
        ]
      ]
    },
    {
      "item": "In the Add Dynamic VDI Group drawer:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          28
        ]
      ]
    },
    {
      "item": "On the General tab:",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          7,
          14
        ]
      ]
    },
    {
      "item": "Name: Enter a name for the VDI group.",
      "depth": 2,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "MTU: Enter the Maximum Transmission Unit (MTU) value for the devices in the VDI group. The default value is 1,400 bytes.",
      "depth": 2,
      "strong": [
        [
          0,
          3
        ]
      ]
    },
    {
      "item": "Description: (Optional) Enter a description for the VDI group.",
      "depth": 2,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "On the Devices Criteria tab, from the Add Criteria drop-down menu, select one or more options:",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          7,
          23
        ],
        [
          38,
          50
        ]
      ]
    },
    {
      "item": "Locations: Select one or more locations to be associated with the VDI group.",
      "depth": 2,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
      "item": "OS Type: Select an operating system (OS) type for the VDI group. Only WINDOWS_OS is currently supported.",
      "depth": 2,
      "strong": [
        [
          0,
          7
        ],
        [
          70,
          80
        ]
      ]
    },
    {
      "item": "Hostname Prefix: Enter the hostname prefix that Zscaler Client Connector for VDI detects.",
      "depth": 2,
      "strong": [
        [
          0,
          15
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "On the VDI Forwarding Profile tab, from the drop-down menu, select a VDI forwarding profile that is applied to the group.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          7,
          29
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    },
    {
      "item": "On the Review tab, confirm that the information is correct, then click Save.",
      "depth": 1,
      "number": 4,
      "strong": [
        [
          7,
          13
        ],
        [
          71,
          75
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 1
    }
  ]
}
