    {
      "text": "To delete a backup:"
    },
    {
      "item": "Go to Administration > Back Up and Restore > Private Access.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          42
        ],
        [
          45,
          59
        ]
      ]
    },
    {
      "item": "Locate the Backup Name within the table and click the Delete () icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          11,
          22
        ],
        [
          54,
          60
        ]
      ]
    },
    {
      "item": "The Confirm: Delete Action window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          26
        ]
      ]
    },
    {
      "item": "Click Delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "Deleting a backup also deletes the linked restore activities. For example, after deleting a backup, information about who restored the backup and the restore reports are deleted."
    }
  ]
}
