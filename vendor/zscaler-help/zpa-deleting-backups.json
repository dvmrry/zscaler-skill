    {
      "text": "To delete a backup:"
    },
    {
      "item": "From the navigation menu, go to Administration > Back Up and Restore > Private Access.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          46
        ],
        [
          49,
          68
        ],
        [
          71,
          85
        ]
      ]
    },
    {
      "item": "Locate the Backup Name within the table you want to delete, and click the Delete () icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          11,
          22
        ],
        [
          74,
          80
        ]
      ]
    },
    {
      "item": "The Confirm: Delete Action window appears.",
      "depth": 0,
      "strong": [
        [
          4,
          26
        ]
      ]
    },
    {
      "item": "Click Delete.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "Deleting a backup also deletes the linked restore activities. For example, after deleting a backup, information about who restored the backup and the restore reports are deleted."
    }
  ]
}
