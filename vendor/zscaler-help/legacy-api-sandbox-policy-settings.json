{
  "schema_version": 1,
  "kind": "help-api-spec",
  "title": "Sandbox Policy & Settings",
  "source": {
    "url": "https://help.zscaler.com/legacy-apis/sandbox-policy-settings",
    "node": "1403026",
    "revision": "3228655",
    "file_url": "https://help.zscaler.com/sites/default/files/api-docs/Sandbox%20Policy%20%26%20Settings_7.json?VersionId=u6pspQ.q2hXtch2fD7O8DNVJ4cgdNiSf",
    "updated": "2026-08-31",
    "updated_basis": "file-last-modified"
  },
  "captured_at": "2026-11-03",
  "spec": {
    "swagger": "2.0",
    "info": {
      "version": "v1",
      "title": "ZIA Cloud Service and Sandbox Submission APIs",
      "description": "API Reference Guide for the ZIA Cloud Service and Sandbox Submission APIs\n"
    },
    "host": "zsapi.[zscaler-cloud-name]",
    "basePath": "/api/v1",
    "schemes": [
      "https"
    ],
    "tags": [
      {
        "name": "Sandbox Policy & Settings"
      }
    ],
    "paths": {
      "/sandboxRules": {
        "get": {
          "tags": [
            "Sandbox Policy & Settings"
          ],
          "description": "Retrieves the list of all Sandbox policy rules configured in the ZIA Admin Portal. To learn more, see <a href=\"/zia/about-sandbox\" target=\"_blank\">About Sandbox</a>.",
          "operationId": "BARuleResource_getRules",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/BARule"
                }
              }
            }
          }
        },
        "post": {
          "tags": [
            "Sandbox Policy & Settings"
          ],
          "description": "Adds a Sandbox policy rule. To learn more, see <a href=\"/zia/configuring-sandbox-policy\" target=\"_blank\">Configuring the Sandbox Policy</a>.",
          "operationId": "BARuleResource_addRule",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "in": "body",
              "name": "body",
              "description": "Sandbox policy configuration",
              "required": true,
              "schema": {
                "$ref": "#/definitions/BARule"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/BARule"
              }
            }
          }
        }
      },
      "/sandboxRules/{ruleId}": {
        "get": {
          "tags": [
            "Sandbox Policy & Settings"
          ],
          "description": "Retrieves the Sandbox policy rule information based on the specified ID",
          "operationId": "BARuleResource_getRuleById",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "ruleId",
              "in": "path",
              "description": "Unique identifier of the Sandbox policy rule",
              "required": true,
              "type": "integer",
              "format": "int32"
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/BARule"
              }
            }
          }
        },
        "put": {
          "tags": [
            "Sandbox Policy & Settings"
          ],
          "description": "Updates the Sandbox policy rule configuration for the specified ID",
          "operationId": "BARuleResource_updateRule",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "ruleId",
              "description": "Unique identifier of the Sandbox policy rule",
              "in": "path",
              "required": true,
              "type": "integer",
              "format": "int32"
            },
            {
              "in": "body",
              "name": "body",
              "description": "Sandbox policy configuration",
              "required": true,
              "schema": {
                "$ref": "#/definitions/BARule"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/BARule"
              }
            }
          }
        },
        "delete": {
          "tags": [
            "Sandbox Policy & Settings"
          ],
          "description": "Deletes the Sandbox policy rule based on the specified ID",
          "operationId": "BARuleResource_deleteRule",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "name": "ruleId",
              "description": "Unique identifier of the Sandbox policy rule",
              "in": "path",
              "required": true,
              "type": "integer",
              "format": "int32"
            }
          ],
          "responses": {
            "default": {
              "description": "Successful Operation"
            }
          }
        }
      },
      "/behavioralAnalysisAdvancedSettings": {
        "get": {
          "tags": [
            "Sandbox Policy & Settings"
          ],
          "description": "<p>Gets the custom list of MD5 file hashes that are blocked by Sandbox</p>",
          "operationId": "BaAdvancedSettingsResource_getCustomFileHash",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/BaAdvancedSettings"
              }
            }
          }
        },
        "put": {
          "tags": [
            "Sandbox Policy & Settings"
          ],
          "description": "<p>Updates the custom list of MD5 file hashes that are blocked by Sandbox. This overwrites a previously generated blocklist. If you need to completely erase the blocklist, submit an empty list.</p> <p><b>Note:</b> Only the file types that are supported by Sandbox analysis can be blocked using MD5 hashes.</p>",
          "operationId": "BaAdvancedSettingsResource_updateCustomFileHash",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "parameters": [
            {
              "in": "body",
              "name": "body",
              "required": false,
              "schema": {
                "$ref": "#/definitions/BaAdvancedSettings"
              }
            }
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/BaAdvancedSettings"
              }
            }
          }
        }
      },
      "/behavioralAnalysisAdvancedSettings/fileHashCount": {
        "get": {
          "tags": [
            "Sandbox Policy & Settings"
          ],
          "description": "<p>Gets the used and unused quota for blocking MD5 file hashes with Sandbox</p>",
          "operationId": "BaAdvancedSettingsResource_getCustomFileHashQuota",
          "consumes": [
            "application/json"
          ],
          "produces": [
            "application/json"
          ],
          "responses": {
            "200": {
              "description": "Successful Operation",
              "schema": {
                "$ref": "#/definitions/CustomFileHashQuota"
              }
            }
          }
        }
      }
    },
    "definitions": {
      "BARule": {
        "type": "object",
        "description": "Sandbox policy rule configuration details. To learn more, see <a href=\"/zia/configuring-sandbox-policy\" target=\"_blank\">Configuring the Sandbox Policy</a>.",
        "required": [
          "fileTypes",
          "name",
          "order"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32",
            "description": "Unique identifier generated for the rule"
          },
          "name": {
            "type": "string",
            "description": "The name of the Sandbox rule"
          },
          "protocols": {
            "type": "array",
            "description": "The protocols to which the rule applies",
            "items": {
              "type": "string",
              "enum": [
                "ANY_RULE",
                "SMRULEF_CASCADING_ALLOWED",
                "FOHTTP_RULE",
                "FTP_RULE",
                "HTTPS_RULE",
                "HTTP_RULE"
              ]
            }
          },
          "order": {
            "type": "integer",
            "format": "int32",
            "description": "Policy rules are evaluated in ascending numerical order (Rule 1 before Rule 2, and so on), and this field specifies the order of execution for the rule."
          },
          "baPolicyCategories": {
            "type": "array",
            "description": "The threat categories to which the rule applies",
            "items": {
              "type": "string",
              "enum": [
                "ADWARE_BLOCK",
                "BOTMAL_BLOCK",
                "ANONYP2P_BLOCK",
                "RANSOMWARE_BLOCK",
                "OFFSEC_TOOLS_BLOCK",
                "SUSPICIOUS_BLOCK"
              ]
            }
          },
          "description": {
            "type": "string",
            "description": "The description of the rule"
          },
          "locations": {
            "type": "array",
            "description": "The locations to which the rule applies",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "locationGroups": {
            "type": "array",
            "description": "The location groups to which the rule applies",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "groups": {
            "type": "array",
            "description": "The user groups to which the rule applies",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "departments": {
            "type": "array",
            "description": "The departments to which the rule applies",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "users": {
            "type": "array",
            "description": "The users to which the rule applies",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "urlCategories": {
            "type": "array",
            "description": "The URL categories to which the rule applies",
            "items": {
              "$ref": "#/definitions/UrlCategoryForPolicy"
            }
          },
          "fileTypes": {
            "type": "array",
            "description": "The file types to which the rule applies",
            "items": {
              "type": "string",
              "enum": [
                "FTCATEGORY_FLASH",
                "FTCATEGORY_JAVA_APPLET",
                "FTCATEGORY_HTA",
                "FTCATEGORY_ZIP",
                "FTCATEGORY_TAR",
                "FTCATEGORY_BZIP2",
                "FTCATEGORY_RAR",
                "FTCATEGORY_ISO",
                "FTCATEGORY_P7Z",
                "FTCATEGORY_SCZIP",
                "FTCATEGORY_DMG",
                "FTCATEGORY_WINDOWS_EXECUTABLES",
                "FTCATEGORY_MICROSOFT_INSTALLER",
                "FTCATEGORY_WINDOWS_LIBRARY",
                "FTCATEGORY_PYTHON",
                "FTCATEGORY_POWERSHELL",
                "FTCATEGORY_VISUAL_BASIC_SCRIPT",
                "FTCATEGORY_BAT",
                "FTCATEGORY_JPEG",
                "FTCATEGORY_PNG",
                "FTCATEGORY_WINDOWS_SCRIPT_FILES",
                "FTCATEGORY_APK",
                "FTCATEGORY_MS_POWERPOINT",
                "FTCATEGORY_MS_WORD",
                "FTCATEGORY_MS_EXCEL",
                "FTCATEGORY_MS_RTF",
                "FTCATEGORY_PDF_DOCUMENT"
              ]
            }
          },
          "cbiProfile": {
            "description": "The cloud browser isolation profiles to which the rule applies. This field is applicable only when the rule action is set to isolate.",
            "$ref": "#/definitions/BrowserIsolationProfile"
          },
          "cbiProfileId": {
            "type": "integer",
            "description": "Unique identifier of the cloud browser isolation profiles to which the rule applies",
            "format": "int32"
          },
          "state": {
            "type": "string",
            "description": "The state of the rule indicating whether it is enabled or disabled",
            "enum": [
              "DISABLED",
              "ENABLED"
            ]
          },
          "timeWindows": {
            "type": "array",
            "description": "The time intervals during which the rule applies",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "rank": {
            "type": "integer",
            "description": "The admin rank specified for the rule based on your assigned admin rank. Admin rank determines the rule order that can be specified for the rule. Admin rank can be configured if it is enabled in the Advanced Settings. To learn more, see <a href=\"/zia/about-admin-rank\" target=\"_blank\">About Admin Rank</a>.",
            "format": "int32"
          },
          "lastModifiedTime": {
            "type": "integer",
            "description": "The timestamp when the rule was last modified",
            "format": "int32"
          },
          "lastModifiedBy": {
            "$ref": "#/definitions/EntityReference",
            "description": "The admin who last modified the rule"
          },
          "accessControl": {
            "type": "string",
            "description": "The admin’s access privilege to this rule based on the assigned role",
            "enum": [
              "NONE",
              "READ_ONLY",
              "READ_WRITE"
            ]
          },
          "baRuleAction": {
            "type": "string",
            "description": "The action configured for the rule that must take place if the traffic matches the rule criteria",
            "enum": [
              "ALLOW",
              "BLOCK"
            ]
          },
          "firstTimeEnable": {
            "type": "boolean",
            "description": "A Boolean value indicating whether a First-Time Action is specifically configured for the rule. The First-Time Action takes place when users download unknown files. The action to be applied is specified using the firstTimeOperation field."
          },
          "firstTimeOperation": {
            "type": "string",
            "description": "The action that must take place when users download unknown files for the first time",
            "enum": [
              "ALLOW_SCAN",
              "QUARANTINE",
              "ALLOW_NOSCAN",
              "QUARANTINE_ISOLATE"
            ]
          },
          "mlActionEnabled": {
            "type": "boolean",
            "description": "A Boolean value indicating whether to enable or disable the AI Instant Verdict option to have the Zscaler service use AI analysis to instantly assign threat scores to unknown files. This option is available to use only with specific rule actions such as Quarantine and Allow and Scan for First-Time Action."
          },
          "labels": {
            "type": "array",
            "description": "The label associated with the rule",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "devices": {
            "type": "array",
            "description": "The list of devices to which the rule applies. This field specifies devices that are managed using Zscaler Client Connector. If no value is set, this field is ignored during the policy evaluation.",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "deviceGroups": {
            "type": "array",
            "description": "The list of device groups to which the rule applies. This field is applicable for devices that are managed using Zscaler Client Connector. If no value is set, this field is ignored during the policy evaluation.",
            "items": {
              "$ref": "#/definitions/EntityReference"
            }
          },
          "zpaAppSegments": {
            "type": "array",
            "description": "The list of ZPA application segments to which the rule applies. This field is applicable only for the ZPA Gateway forwarding method.",
            "items": {
              "$ref": "#/definitions/AppSegment"
            }
          },
          "byThreatScore": {
            "type": "integer",
            "format": "int32"
          },
          "defaultRule": {
            "type": "boolean",
            "description": "A Boolean value that indicates whether the rule is marked as the default rule."
          }
        }
      },
      "BaAdvancedSettings": {
        "type": "object",
        "properties": {
          "md5HashValueList": {
            "type": "array",
            "description": "A custom list of unique MD5 file hashes that must be blocked by Sandbox. A maximum of 10,000 MD5 file hashes can be blocked.",
            "items": {
              "$ref": "#/definitions/UrlDetails"
            }
          }
        },
        "description": "Advanced Sandbox Settings"
      },
      "CustomFileHashQuota": {
        "type": "object",
        "properties": {
          "blockedFileHashesCount": {
            "type": "integer",
            "format": "int32",
            "description": "<p>The number of unique MD5 file hashes that are blocked by Sandbox.</p>",
            "readOnly": true
          },
          "remainingFileHashes": {
            "type": "integer",
            "format": "int32",
            "description": "Unused quota for blocking MD5 file hashes.",
            "readOnly": true
          }
        },
        "description": "Used and unused quota for blocking MD5 file hashes."
      },
      "EntityReference": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "A unique identifier for an entity"
          },
          "name": {
            "type": "string",
            "description": "The configured name of the entity",
            "readOnly": true
          },
          "externalId": {
            "type": "string",
            "description": "An external identifier used for an entity that is managed outside of ZIA. Examples include <code>zpaServerGroup</code> and <code>zpaAppSegments</code>. This field is not applicable to ZIA-managed entities."
          },
          "extensions": {
            "type": "object",
            "description": "Additional information about the entity",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "description": "This is an immutable reference to an entity that mainly consists of an ID and name"
      },
      "UrlCategoryForPolicy": {
        "type": "object",
        "properties": {
          "val": {
            "type": "integer",
            "format": "int32"
          },
          "mask": {
            "type": "integer",
            "format": "int32"
          },
          "urlSupercategory": {
            "type": "string",
            "enum": [
              "ANY",
              "NONE",
              "ADVANCED_SECURITY",
              "ENTERTAINMENT_AND_RECREATION",
              "NEWS_AND_MEDIA",
              "USER_DEFINED",
              "EDUCATION",
              "BUSINESS_AND_ECONOMY",
              "JOB_SEARCH",
              "INFORMATION_TECHNOLOGY",
              "INTERNET_COMMUNICATION",
              "OFFICE_365",
              "CUSTOM_SUPERCATEGORY",
              "CUSTOM_BP",
              "CUSTOM_BW",
              "MISCELLANEOUS",
              "TRAVEL",
              "VEHICLES",
              "GOVERNMENT_AND_POLITICS",
              "GLOBAL_INT",
              "GLOBAL_INT_BP",
              "GLOBAL_INT_BW",
              "GLOBAL_INT_OFC365",
              "ADULT_MATERIAL",
              "DRUGS",
              "GAMBLING",
              "VIOLENCE",
              "WEAPONS_AND_BOMBS",
              "TASTELESS",
              "MILITANCY_HATE_AND_EXTREMISM",
              "ILLEGAL_OR_QUESTIONABLE",
              "SOCIETY_AND_LIFESTYLE",
              "HEALTH",
              "SPORTS",
              "SPECIAL_INTERESTS_SOCIAL_ORGANIZATIONS",
              "GAMES",
              "SHOPPING_AND_AUCTIONS",
              "SOCIAL_AND_FAMILY_ISSUES",
              "RELIGION",
              "SECURITY"
            ]
          },
          "deprecated": {
            "type": "boolean"
          },
          "backendName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "userConfiguredName": {
            "type": "string"
          },
          "comments": {
            "type": "string"
          }
        }
      },
      "BrowserIsolationProfile": {
        "type": "object",
        "description": "<p>Information about browser isolation profile. To learn more, see <a href=\"/isolation/what-isolation\" target=\"_blank\">What Is Isolation?</a> and <a href=\"/isolation/creating-zia-isolation-profile-isolation\" target=\"_blank\">Creating Isolation Profiles for ZIA</a>.</p>",
        "properties": {
          "id": {
            "type": "string",
            "description": "<p>The universally unique identifier (UUID) for the browser isolation profile</p>"
          },
          "name": {
            "type": "string",
            "description": "<p>Name of the browser isolation profile</p>"
          },
          "url": {
            "type": "string",
            "description": "<p>The browser isolation profile URL</p>"
          },
          "defaultProfile": {
            "type": "boolean",
            "description": "<p>(Optional) Indicates whether this is a default browser isolation profile. Zscaler sets this field.</p>  "
          }
        }
      },
      "AppSegment": {
        "type": "object",
        "description": "Application Segment information",
        "properties": {
          "id": {
            "type": "integer",
            "description": "A unique identifier assigned to the Application Segment",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "description": "The name of the Application Segment"
          },
          "externalId": {
            "type": "integer",
            "description": "Indicates the external ID. Applicable only when this reference is of an external entity.",
            "format": "int64"
          },
          "zpaTenantId": {
            "type": "integer",
            "description": "ID of the ZPA tenant where the Application Segment is configured",
            "format": "int64"
          }
        }
      },
      "UrlDetails": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The URL that has a match in one or more existing custom URL categories"
          },
          "urlComment": {
            "type": "string",
            "description": "Additional information about the URL. This is an optional field."
          },
          "type": {
            "type": "string",
            "description": "This field is for Zscaler internal use only",
            "enum": [
              "MALWARE",
              "CUSTOM_FILEHASH_ALLOW",
              "CUSTOM_FILEHASH_DENY"
            ]
          }
        }
      }
    }
  }
}
