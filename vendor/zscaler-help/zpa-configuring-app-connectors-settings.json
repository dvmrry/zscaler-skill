  "blocks": [
    {
      "text": "The App Connector Settings allow you to enable Auto Delete for App Connectors with a disconnected status."
    },
    {
      "text": "To configure your App Connector settings:"
    },
    {
      "item": "Go to Private Access > Private Infrastructure > App Connectors.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          45
        ],
        [
          48,
          62
        ]
      ]
    },
    {
      "item": "Click the Settings icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          18
        ]
      ]
    },
    {
      "item": "The App Connector Settings drawer appears.",
      "depth": 0,
      "strong": [
        [
          4,
          26
        ]
      ]
    },
    {
      "item": "Select Enabled to allow Auto Delete to delete App Connectors with a disconnected status. Auto Delete is set to Disabled by default.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          14
        ],
        [
          24,
          35
        ],
        [
          89,
          100
        ],
        [
          111,
          119
        ]
      ]
    },
    {
      "item": "Set the specific expiration date for App Connectors with a disconnected status to be deleted.",
      "depth": 0,
      "number": 4
    },
    {
      "item": "(Optional) To delete disabled App Connectors at the set time, select the Include disabled App Connector checkbox.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          73,
          103
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
