  "schema_version": 1,
  "kind": "help-article",
  "title": "Changing the Status of Zscaler SIMs",
  "source": {
    "url": "https://help.zscaler.com/zscaler-cellular/changing-status-zscaler-sims",
    "node": "1519086",
    "revision": "3254094",
    "updated": "2026-10-30",
    "updated_basis": "pdf-last-modified"
  },
  "captured_at": "2026-11-04",
  "blocks": [
    {
      "text": "You can modify the status of the Zscaler SIMs—both physical SIMs and eSIMs—provisioned to your organization from the SIMs page."
    },
    {
      "text": "To change the status of Zscaler SIMs:"
    },
    {
      "item": "From the navigation menu, go to Infrastructure > Cellular > SIMs.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          32,
          46
        ],
        [
          49,
          57
        ],
        [
          60,
          64
        ]
      ]
    },
    {
      "item": "The SIMs page appears.",
      "depth": 0,
      "strong": [
        [
          4,
          8
        ]
      ]
    },
    {
      "item": "On the SIMs page, you can:",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          11
        ]
      ]
    },
    {
      "item": "Modify the status of a single SIM",
      "depth": 1
    },
    {
      "item": "Locate and select the SIM card whose status you want to modify.",
      "depth": 2,
      "number": 1
    },
    {
      "item": "In the Manage column, click the Edit icon.",
      "depth": 2,
      "number": 2,
      "strong": [
        [
          7,
          13
        ],
        [
          32,
          36
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "Alternatively, you can go to the SIM Details page by clicking the ICCID link and select Update Status from the Update drop-down menu in the top-right corner.",
      "depth": 2,
      "strong": [
        [
          33,
          36
        ],
        [
          37,
          44
        ],
        [
          66,
          71
        ],
        [
          88,
          101
        ],
        [
          111,
          117
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "The Update Status window appears.",
      "depth": 2,
      "strong": [
        [
          4,
          17
        ]
      ]
    },
    {
      "item": "In the Update Status window:",
      "depth": 2,
      "number": 3,
      "strong": [
        [
          7,
          20
        ]
      ]
    },
    {
      "item": "Select the Active or Inactive status to either activate or inactivate the SIM.",
      "depth": 3,
      "number": 1,
      "strong": [
        [
          11,
          17
        ],
        [
          21,
          29
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 3
    },
    {
      "item": "Click Save.",
      "depth": 3,
      "number": 2,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "The SIMs are activated or deactivated based on your selection.",
      "depth": 2
    },
    {
      "item": "Modify the status of multiple SIMs",
      "depth": 1
    },
    {
      "item": "Locate and select the SIM cards whose status you want to modify.",
      "depth": 2,
      "number": 1
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "The SIM cards you select must be of the same status.",
      "depth": 2
    },
    {
      "item": "Click Update and select Update Status.",
      "depth": 2,
      "number": 2,
      "strong": [
        [
          6,
          12
        ],
        [
          24,
          37
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 2
    },
    {
      "item": "The Update Status window appears.",
      "depth": 2,
      "strong": [
        [
          4,
          17
        ]
      ]
    },
    {
      "item": "In the Update Status window:",
      "depth": 2,
      "number": 3,
      "strong": [
        [
          7,
          20
        ]
      ]
    },
    {
      "item": "Select the Active or Inactive status to either activate or inactivate the SIM.",
      "depth": 3,
      "number": 1,
      "strong": [
        [
          11,
          17
        ],
        [
          21,
          29
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 3
    },
    {
      "item": "Click Save.",
      "depth": 3,
      "number": 2,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "The SIMs are activated or deactivated based on your selection.",
      "depth": 2
    }
  ]
}
