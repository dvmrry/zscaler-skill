    {
      "text": "You can edit or delete a SAML identity provider (IdP) configuration in the Zscaler ITDR Admin Portal."
    },
    {
      "heading": "Editing a SAML IdP Configuration",
      "level": 1
    },
    {
      "text": "To edit a SAML IdP configuration:"
    },
    {
      "item": "Go to Settings > Users & Roles > IdP Providers.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          30
        ],
        [
          33,
          46
        ]
      ]
    },
    {
      "item": "In the table, locate a SAML IdP configuration you want to modify, and then click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          85,
          89
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the SAML Provider Details window, modify the required fields.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          28
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "heading": "Deleting a SAML IdP Configuration",
      "level": 1
    },
    {
      "text": "To delete a SAML IdP Configuration:"
    },
    {
      "item": "Go to Settings > Users & Roles > IdP Providers.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          30
        ],
        [
          33,
          46
        ]
      ]
    },
    {
      "item": "In the table, locate a SAML IdP configuration you want to delete, and then click the Delete icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          85,
          91
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    }
  ]
}
