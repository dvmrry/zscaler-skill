    "paths": {
      "/mgmtconfig/v1/admin/customers/{customerId}/managedBrowserProfile/search": {
        "get": {
          "tags": [
            "Browser Profiles"
          ],
          "description": "Gets a list of managed browser profiles for the specified customer.",
          "operationId": "getAllManagedBrowserProfiles",
          "parameters": [
            {
              "name": "customerId",
              "in": "path",
              "description": "The unique identifier of the ZPA tenant.",
              "required": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            },
            {
              "name": "search",
              "in": "query",
              "description": "The search string used to support search by features and fields for the API.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "string"
              }
            },
            {
              "name": "page",
              "in": "query",
              "description": "Specifies the page number.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int32"
              },
              "example": "1"
            },
            {
              "name": "pagesize",
              "in": "query",
              "description": "Specifies the page size. If not provided, the default page size is 20. The max page size is 500.",
              "required": false,
              "allowEmptyValue": true,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int32"
              },
              "example": "20"
            },
            {
              "name": "microtenantId",
              "in": "query",
              "description": "The unique identifier of the Microtenant for the ZPA tenant. If you are within a Microtenant, you must pass the microtenantId field when making an API call to retrieve data from that Microtenant. The microtenantId can be obtained from the API Keys page, or can be obtained programmatically using the ZPA cloud service API. Access to certain operations is limited when you are within a Microtenant. If you are within the Default Microtenant, pass microtenantId as 0 when making requests to retrieve data from the Default Microtenant. If the microtenantId is not passed in the request when creating or updating a resource, then the resource is created or updated in the Default Microtenant.",
              "required": false,
              "explode": false,
              "schema": {
                "type": "integer",
                "format": "int64"
              }
            }
          ],
