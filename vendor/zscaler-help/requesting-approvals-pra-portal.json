  "schema_version": 1,
  "kind": "help-article",
  "title": "Requesting Approvals in the PRA Portal",
  "source": {
    "url": "https://help.zscaler.com/zpa/requesting-approvals-pra-portal",
    "node": "1520621",
    "revision": "3222122"
  },
  "captured_at": "2026-10-18",
  "blocks": [
    {
      "text": "After the admin has enabled privileged requests in a portals policy, you can access the My Requests page in the PRA Portal."
    },
    {
      "text": "To create a privileged approval request:"
    },
    {
      "item": "Click the My Approvals icon on the PRA Portal home page.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          10,
          22
        ]
      ]
    },
    {
      "item": "Click the My Requests tab.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          21
        ]
      ]
    },
    {
      "item": "Click Add Request.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          17
        ]
      ]
    },
    {
      "text": "The Create Approvals page appears.",
      "strong": [
        [
          4,
          20
        ]
      ]
    },
    {
      "item": "On the Create Approvals page:",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          23
        ]
      ]
    },
    {
      "item": "Select a Microtenant from the drop-down menu. The Default Microtenant is automatically selected.",
      "depth": 1,
      "number": 1
    },
    {
      "item": "Select privileged consoles.",
      "depth": 1,
      "number": 2
    },
    {
      "item": "Click Next.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Select a start date in the calendar.",
      "depth": 0,
      "number": 4
    },
    {
      "text": "See image."
    },
    {
      "item": "Select the duration that you want this privileged approval to last.",
      "depth": 0,
      "number": 5
    },
    {
      "item": "(Optional) Enter a reason for access.",
      "depth": 0,
      "number": 6
    },
    {
      "item": "Click Next.",
      "depth": 0,
      "number": 7,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "Review the privileged approval request.",
      "depth": 0,
      "number": 8
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "text": "The saved privileged approval request appears on the My Requests page and is ready to be reviewed by an approver."
    }
  ]
}
