  "blocks": [
    {
      "text": "You can edit or delete a deployed strategy in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a Deployed Strategy",
      "level": 1
    },
    {
      "text": "To edit a deployed strategy:"
    },
    {
      "item": "Go to Deceive > Deploy Strategy.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          13
        ],
        [
          16,
          31
        ]
      ]
    },
    {
      "item": "Locate the deployed strategy that you want to modify, and click the Edit icon under the Actions column.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          68,
          72
        ],
        [
          88,
          95
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the Deploy Network Strategy window, modify the required fields on each tab, and then click Next.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          30
        ],
        [
          94,
          98
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "Click Create Decoys or Create Decoys & Deploy.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          19
        ],
        [
          23,
          45
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "heading": "Deleting a Deployed Strategy",
      "level": 1
    },
    {
      "text": "To delete a deployed strategy:"
    },
    {
      "item": "Go to Deceive > Deploy Strategy.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          13
        ],
        [
          16,
          31
        ]
      ]
    },
    {
      "item": "Locate the deployed strategy that you want to delete, and click the Delete icon under the Actions column.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          68,
          74
        ],
        [
          90,
          97
        ]
      ]
    },
    {
      "text": "See image."
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    }
  ]
}
