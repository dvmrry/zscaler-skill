  "captured_at": "2026-11-03",
  "blocks": [
    {
      "text": "You can edit or delete SCADA/IoT datasets that you configured in the Zscaler Deception Admin Portal."
    },
    {
      "heading": "Editing a SCADA/IoT Dataset",
      "level": 1
    },
    {
      "text": "To edit a SCADA/IoT dataset:"
    },
    {
      "item": "Go to Miragemaker > SCADA/IoT Datasets.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          38
        ]
      ]
    },
    {
      "item": "Under Actions, click the Edit icon for the dataset you want to modify.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          29
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the SCADA/IoT Dataset Details window, modify the Name or upload a different file as required.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          32
        ],
        [
          52,
          56
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Submit.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          12
        ]
      ]
    },
    {
      "text": "The default SCADA/IoT datasets cannot be edited."
    },
    {
      "heading": "Deleting a SCADA/IoT Dataset",
      "level": 1
    },
    {
      "text": "To delete a SCADA/IoT dataset:"
    },
    {
      "item": "Go to Miragemaker > SCADA/IoT Datasets.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          38
        ]
      ]
    },
    {
      "item": "Under Actions, click the Delete icon for the dataset you want to delete.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          13
        ],
        [
          25,
          31
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "In the confirmation window, click OK.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          34,
          36
        ]
      ]
    },
    {
      "text": "The default SCADA/IoT datasets cannot be deleted."
    }
  ]
}
