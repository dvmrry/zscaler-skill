  "blocks": [
    {
      "text": "After onboarding a cloud account, you can select the services that must be scanned by AI Security. AI Security permissions are restricted to monitor and scan the data only in the selected services."
    },
    {
      "text": "To select the services:"
    },
    {
      "item": "Go to Administration > Cloud Accounts.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          22
        ],
        [
          23,
          37
        ]
      ]
    },
    {
      "item": "Select the cloud account.",
      "depth": 0,
      "number": 2
    },
    {
      "item": "Click Manage, and then select Manage Services.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          12
        ],
        [
          30,
          45
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "On the Manage services to monitor page, select the services that must be monitored and scanned.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          33
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Next.",
      "depth": 0,
      "number": 5,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "On the Configure regions for monitoring and scanner configuration page, select the region where the orchestrator template must be deployed and provide the corresponding region details based on the network configuration selected.",
      "depth": 0,
      "number": 6,
      "strong": [
        [
          7,
          65
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "On the Apply Changes page, download and deploy the template.",
      "depth": 0,
      "number": 7,
      "strong": [
        [
          7,
          20
        ]
      ]
    }
  ]
}
