    {
      "text": "You can obfuscate various types of information that appear in the Zscaler Admin Console by enabling obfuscation for an admin role with permissions that expose that type of information."
    },
    {
      "text": "To configure obfuscation:"
    },
    {
      "item": "On the Role Management page (Administration > Role Management > Role Management), click the name of the role that you want to enable obfuscation for.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          29,
          43
        ],
        [
          46,
          61
        ],
        [
          64,
          79
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "You can only enable obfuscation for roles with Internet & SaaS or Digital Experience permissions that expose information types that can be obfuscated.",
      "depth": 0
    },
    {
      "item": "On the Obfuscation tab, click Add Obfuscation.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          7,
          18
        ],
        [
          30,
          45
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The Configure Obfuscation pane appears.",
      "depth": 0,
      "strong": [
        [
          4,
          25
        ]
      ]
    },
    {
      "item": "In the Configure Obfuscation pane, you can select to obfuscate the following information:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          28
        ]
      ]
    },
    {
      "item": "Digital Experience:",
      "depth": 1
    },
    {
      "item": "Username",
      "depth": 2,
      "strong": [
        [
          0,
          8
        ]
      ]
    },
    {
      "item": "Device Name",
      "depth": 2,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "Wi-Fi Name",
      "depth": 2,
      "strong": [
        [
          0,
          10
        ]
      ]
    },
    {
      "item": "IP Address",
      "depth": 2,
      "strong": [
        [
          0,
          10
        ]
      ]
    },
    {
      "item": "Location Name",
      "depth": 2,
      "strong": [
        [
          0,
          13
        ]
      ]
    },
    {
      "item": "Internet & SaaS:",
      "depth": 1
    },
    {
      "item": "Username",
      "depth": 2,
      "strong": [
        [
          0,
          8
        ]
      ]
    },
    {
      "item": "Device Name",
      "depth": 2,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "AI Prompt",
      "depth": 2,
      "strong": [
        [
          0,
          9
        ]
      ]
    },
    {
      "item": "Click Save and activate the change.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
