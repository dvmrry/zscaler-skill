    {
      "text": "You can disable support users from accessing the Zscaler ITDR Admin Portal."
    },
    {
      "text": "Disabling access to support users might cause delayed assistance from the Zscaler Support team. Zscaler Support might request you to enable access when you submit a help ticket for troubleshooting issues."
    },
    {
      "text": "To disable access to support users:"
    },
    {
      "item": "Go to Settings > Users & Roles > Settings.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          14
        ],
        [
          17,
          30
        ],
        [
          33,
          41
        ]
      ]
    },
    {
      "item": "Under Support Access Settings, select Disable Support Access.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          6,
          29
        ],
        [
          38,
          60
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          6,
          10
        ]
      ]
    },
    {
      "item": "In the Action Required window, click Confirm.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          7,
          22
        ],
        [
          37,
          44
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    }
  ]
