    {
      "text": "You can download both default and custom file templates individually as a ZIP file."
    },
    {
      "text": "To download a file template:"
    },
    {
      "item": "Go to Miragemaker > Files > File Templates.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          17
        ],
        [
          20,
          25
        ],
        [
          28,
          42
        ]
      ]
    },
    {
      "item": "Click the Download icon for the template that you want to download.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          10,
          18
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "The file template is downloaded to your system as a ZIP file.",
      "depth": 0
    }
  ]
}
