  "blocks": [
    {
      "text": "To edit a deployed Network Connector:"
    },
    {
      "item": "Go to Private Access > VPN (for Legacy Apps) > Network Connectors.",
      "depth": 0,
      "number": 1,
      "strong": [
        [
          6,
          20
        ],
        [
          23,
          44
        ],
        [
          47,
          65
        ]
      ]
    },
    {
      "item": "Locate the Network Connector you want to edit, and click the Edit icon.",
      "depth": 0,
      "number": 2,
      "strong": [
        [
          61,
          65
        ]
      ]
    },
    {
      "item": "The Edit Network Connector page appears.",
      "depth": 0,
      "strong": [
        [
          4,
          26
        ]
      ]
    },
    {
      "item": "On the Edit Network Connector page:",
      "depth": 0,
      "number": 3,
      "strong": [
        [
          7,
          29
        ]
      ]
    },
    {
      "item": "Name: Update the name of the Network Connector. The name cannot contain special characters, with the exception of periods (.), hyphens (-), and underscores (_).",
      "depth": 1,
      "number": 1,
      "strong": [
        [
          0,
          4
        ]
      ]
    },
    {
      "item": "Status: Enable or disable the Network Connector.",
      "depth": 1,
      "number": 2,
      "strong": [
        [
          0,
          6
        ]
      ]
    },
    {
      "item": "Description: (Optional) Enter a description for the Network Connector.",
      "depth": 1,
      "number": 3,
      "strong": [
        [
          0,
          11
        ]
      ]
    },
    {
      "item": "See image.",
      "depth": 0
    },
    {
      "item": "Click Save.",
      "depth": 0,
      "number": 4,
      "strong": [
        [
          6,
          10
        ]
      ]
    }
  ]
}
