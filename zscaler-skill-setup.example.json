{
  "runtimeData": {
    "mountPath": "_data",
    "source": "${ZSCALER_SKILL_OVERLAY_SOURCE}",
    "ref": "main",
    "mode": "checkout"
  },
  "overlaySubmission": {
    "repoUrl": "${ZSCALER_SKILL_OVERLAY_REPO}",
    "defaultBranch": "main",
    "branchPrefix": "artifact-submission/",
    "mode": "pull-request",
    "allowedRoots": [
      "_data/cases",
      "_data/schemas",
      "_data/iac"
    ],
    "requireExplicitApproval": true
  }
}
