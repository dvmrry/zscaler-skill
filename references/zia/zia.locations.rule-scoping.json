    "sublocations-are-nameable": {
      "statement": "Because a sublocation is a location, a rule's `locations` array can name a sublocation directly, as well as through a group.",
      "tier": "B",
      "derived_from": [
        "rules-take-both",
        "zia.locations.sublocations:what-it-is"
      ],
      "conditions": "Derived; the rule schemas describe the array as locations and do not mention sublocations."
    },
    "authentication-is-a-location-setting": {
      "statement": "Authentication is enforced by the location's own setting (`authRequired`, Enforce Authentication), which the service checks when traffic arrives from a known location.",
      "tier": "A",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1locations/get/responses/200/content/application~1json/schema/items/properties/authRequired",
          "expect": {
            "description": "<p>Enforce Authentication. Required when ports are enabled, IP Surrogate is enabled, or Kerberos Authentication is enabled.</p>",
            "x-applicableTo": "BOTH"
          }
        },
        {
          "source": "zscaler-help",
          "path": "about-locations.json",
          "quotes": [
            "For example, the service checks whether the location has authentication enabled and proceeds accordingly."
          ]
        }
      ]
    },
    "per-rule-caps": {
      "statement": "Any rule type is limited to 32 locations and 32 location groups.",
      "tier": "A",
      "evidence": [
        {
          "source": "zscaler-help",
          "path": "ranges-limitations-zia.json",
          "quotes": [
            "| Locations per Rule | 32 locations |",
            "| Location Groups per Rule | 32 groups |"
          ]
        }
      ]
    },
    "dynamic-group-for-populations": {
      "statement": "To cover a changing population such as all corporate locations in one city, scoping a rule to a dynamic group (for example name starts with NYC and a Location Type condition) lets new matching locations join the rule's scope with no edit to the rule.",
      "tier": "B",
      "derived_from": [
        "zia.locations.groups:two-types",
        "zia.locations.group-assignment:dynamic-auto-update"
      ],
      "conditions": "Derived from automatic group updating; the example conditions are illustrative."
    }
