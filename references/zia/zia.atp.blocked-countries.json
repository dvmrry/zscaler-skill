{
  "schema_version": 1,
  "id": "zia.atp.blocked-countries",
  "title": "ATP Blocked Countries: server location, not user location",
  "aliases": [
    "country blocking",
    "blocked countries",
    "suspicious destinations protection",
    "blockedCountries",
    "blocked accessing a site hosted abroad",
    "geo block zia"
  ],
  "binds": [
    "zia/advanced-threat-settings#blockedCountries",
    "zia/advanced-threat-settings#blockCountriesCapture"
  ],
  "related": [
    {
      "rel": "see-also",
      "to": "zia.atp"
    },
    {
      "rel": "see-also",
      "to": "zia.atp.categories"
    },
    {
      "rel": "see-also",
      "to": "zia.atp.security-exceptions"
    },
    {
      "rel": "see-also",
      "to": "zia.atp.enforcement-order"
    }
  ],
  "prose": [
    {
      "text": "{{web-server-location}} {{not-user-location}}"
    },
    {
      "text": "{{allowlist-overrides}} See [[zia.atp.security-exceptions]]."
    },
    {
      "label": "In the API.",
      "text": "{{wire-values}}"
    },
    {
      "text": "The check runs after Security Exceptions and before IPS signature detection: [[zia.atp.enforcement-order]]. The log's evidence for the block is described in [[zia.atp.block-diagnosis]]."
    }
  ],
  "checks": [
    {
      "do": "Whether the country that matters is the destination server's, not the user's, and whether that country is selected.",
      "uses": [
        "web-server-location",
        "not-user-location"
      ]
    },
    {
      "do": "Whether the country value sent through the API is one of the ANY, NONE or COUNTRY_ codes the enum accepts.",
      "uses": [
        "wire-values",
        "country-validation"
      ]
    },
    {
      "do": "Whether the URL is under Security Exceptions, which skips the country check.",
      "uses": [
        "allowlist-overrides"
      ]
    }
  ],
  "claims": {
    "web-server-location": {
      "statement": "Blocked Countries allows or blocks requests to any country in the world, based on the ISO3166 mapping of countries to their IP address space. Websites are blocked based on the location of the web server.",
      "tier": "A",
      "evidence": [
        {
          "source": "zscaler-help",
          "path": "configuring-advanced-threat-protection-policy.json",
          "quotes": [
            "Blocked Countries: Choose to Allow or Block requests to any country in the world based on ISO3166 mapping of countries to their IP address space. Websites are blocked based on the location of the web server."
          ]
        }
      ]
    },
    "not-user-location": {
      "statement": "The user's own country does not enter the decision: a user in a non-blocked country is still blocked from a site whose server is in a blocked country.",
      "tier": "B",
      "derived_from": [
        "web-server-location"
      ],
      "conditions": "Derived from the page saying sites are blocked by web server location."
    },
    "allowlist-overrides": {
      "statement": "An allowlisted URL on a server in a blocked country is still reachable, and the country check is skipped for URLs under Security Exceptions.",
      "tier": "A",
      "evidence": [
        {
          "source": "zscaler-help",
          "path": "configuring-advanced-threat-protection-policy.json",
          "quotes": [
            "For example, if a URL on the allowlist is hosted on a web server in a blocked country, the service allows users to download content from that website."
          ]
        },
        {
          "source": "zscaler-help",
          "path": "Understanding_Policy_Enforcement.txt",
          "quotes": [
            "as a suspicious destination under your Advanced Threat Protection policy. If the user's requested URL falls under Security Exceptions, the service skips this policy and moves to the next one."
          ],
          "after": "This is a user request to retrieve a resource from the web (e.g., a web page)."
        }
      ]
    },
    "wire-values": {
      "statement": "In the API, blockedCountries is an array of strings drawn from an enum of ANY, NONE and COUNTRY_ codes such as COUNTRY_US; blockCountriesCapture is its Capture flag.",
      "tier": "A",
