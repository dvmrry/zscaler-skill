{
  "schema_version": 1,
  "id": "zia.iot",
  "title": "ZIA IoT Report and IoT policy",
  "aliases": [
    "iot",
    "iot report",
    "iot devices",
    "iot visibility",
    "iot discovery policy",
    "device visibility"
  ],
  "binds": [
    "zia/locations#iotDiscoveryEnabled",
    "zia/locations#iotEnforcePolicySet"
  ],
  "related": [
    {
      "rel": "scoped-by",
      "to": "zia.iot.discovery",
      "because": "zia.iot.discovery:per-location-enable"
    },
    {
      "rel": "scoped-by",
      "to": "zia.locations.groups",
      "because": "zia.iot.policy-use:group-is-by-location"
    },
    {
      "rel": "interacts-with",
      "to": "zia.cloud-app-control.rule-types",
      "because": "zia.iot.policy-use:cac-iot-needs-enforce"
    },
    {
      "rel": "configured-via",
      "to": "zia/locations"
    },
    {
      "rel": "configured-via",
      "to": "shared.analytics.graphql"
    },
    {
      "rel": "see-also",
      "to": "zia.iot.classification"
    },
    {
      "rel": "see-also",
      "to": "zia.iot.policy-use"
    },
    {
      "rel": "see-also",
      "to": "zia.iot.api-surface"
    }
  ],
  "prose": [
    {
      "text": "IoT questions come in four kinds."
    },
    {
      "steps": [
        {
          "label": "Why is a location or device missing from the report, and what does the report mean?",
          "text": "[[zia.iot.discovery]]."
        },
        {
          "label": "What does a type, category, classification, UUID or Unknown mean?",
          "text": "[[zia.iot.classification]]."
        },
        {
          "label": "Can a rule target IoT devices, and what must a location enable first?",
          "text": "[[zia.iot.policy-use]]."
        },
        {
          "label": "How do I pull the data programmatically?",
          "text": "[[zia.iot.api-surface]]."
        }
      ]
    },
    {
      "text": "The predefined IoT Traffic Group is in [[zia.locations.groups]] and the Cloud App Control IoT predefined rules are in [[zia.cloud-app-control.rule-types]]; they are linked here, not repeated."
    }
  ]
}
