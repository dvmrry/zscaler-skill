            "when action.type is 'BLOCK', neither decryptSubActions nor doNotDecryptSubActions can be set",
            "when action.type is 'BLOCK', showEUNATP cannot be set",
            "when action.type is 'BLOCK' and overrideDefaultCertificate is false, sslInterceptionCert cannot be set"
          ]
        }
      ],
      "gaps": [
        "zia.sdk-go.service-defects:ssl-action-api-contract"
      ]
    },
