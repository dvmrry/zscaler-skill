{
  "schema_version": 1,
  "id": "zia/saas-security-activity-log",
  "kind": "log",
  "product": "zia",
  "title": "ZIA SaaS Security Activity log (NSS SaaS Security Activity feed)",
  "names": {
    "nss": "saas-security-activity"
  },
  "aliases": [
    "nss saas security activity log",
    "zia saas security activity logs"
  ],
  "evidence": [
    {
      "source": "zscaler-help",
      "path": "zia-nss-feed-output-format-saas-security-activity-logs.json",
      "quotes": [
        "The SaaS Security activity Nanolog Streaming Service (NSS) feed specifies the data from the SaaS Security activity logs"
      ]
    }
  ],
  "fields": {
    "time": {
      "type": "string",
      "description": "The time and date of the transaction. This excludes the time zone.",
      "evidence": [
        {
          "source": "zscaler-help",
          "path": "zia-nss-feed-output-format-saas-security-activity-logs.json",
          "quotes": [
            "| %s{time} | The time and date of the transaction. This excludes the time zone. | Mon Oct"
          ]
        }
      ]
    },
    "tz": {
      "type": "string",
      "description": "The time zone. This is the same as the time zone you specified when you configured the NSS feed.",
      "evidence": [
        {
          "source": "zscaler-help",
          "path": "zia-nss-feed-output-format-saas-security-activity-logs.json",
          "quotes": [
            "| %s{tz} | The time zone. This is the same as the time zone you specified when you"
