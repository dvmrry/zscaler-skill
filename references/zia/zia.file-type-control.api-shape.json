{
  "schema_version": 1,
  "id": "zia.file-type-control.api-shape",
  "title": "File Type Control API shape: rules, categories and custom types",
  "aliases": [
    "file type control api",
    "fileTypeRules",
    "filteringAction",
    "fileTypeCategories",
    "customFileTypes",
    "file type enum",
    "ftp protocols token FOHTTP_RULE",
    "zia_file_type_control_rules"
  ],
  "binds": [
    "zia/file-type-rules",
    "zia/custom-file-types"
  ],
  "related": [
    {
      "rel": "see-also",
      "to": "zia.file-type-control"
    },
    {
      "rel": "see-also",
      "to": "zia.file-type-control.criteria"
    },
    {
      "rel": "interacts-with",
      "to": "zia.terraform.field-fidelity"
    },
    {
      "rel": "interacts-with",
      "to": "zia.terraform.data-source-fidelity"
    }
  ],
  "prose": [
    {
      "label": "The rule resource.",
      "text": "{{rule-crud}} {{filtering-action-enum}} {{size-in-kb}}"
    },
    {
      "label": "Protocols.",
      "text": "{{protocols-enum}} {{protocol-token-mapping}}"
    },
    {
      "label": "File types.",
      "text": "{{file-types-deprecated}} {{file-types-contract-enum}} {{categories-lookup}} Terraform's data source for it has its own failure behavior: [[zia.terraform.data-source-fidelity:file-type-categories-swallow-enum-failure]]."
    },
    {
      "label": "Custom types.",
      "text": "{{custom-file-types}} The update path is open {{divergence:custom-file-type-update-path}}."
    },
    {
      "text": "The help page and the Python SDK disagree on the maximum rule name length {{divergence:rule-name-length}}. Which field combinations the API accepts is open {{gap:filtering-action-dependencies}}."
    },
    {
      "text": "A Terraform defect sends `passwordProtected` as false on every write; see [[zia.terraform.field-fidelity:file-type-password-protected-never-mapped]]."
    }
  ],
  "checks": [
    {
      "do": "Which file-type representation a rule uses, the deprecated fileTypes list or fileTypeCategories.",
      "uses": [
        "file-types-deprecated"
      ]
    },
    {
      "do": "Whether a passwordProtected false on a Terraform-managed rule reflects an admin choice, since the provider sends it on every write.",
      "uses": [
        "zia.terraform.field-fidelity:non-omitempty-bools-force-false"
      ]
    }
  ],
  "claims": {
    "rule-crud": {
      "statement": "File Type Control is a rule resource: `GET` and `POST` on `/fileTypeRules`, and `GET`, `PUT` and `DELETE` on `/fileTypeRules/{ruleId}`, with a reduced `GET /fileTypeRules/lite`.",
      "tier": "A",
      "binds": [
        "zia/file-type-rules"
      ],
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/get",
          "expect": {
            "operationId": "File Type Rule Resource Get Rules"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post",
          "expect": {
            "operationId": "File Type Rule Resource Add Rule"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules~1{ruleId}/get",
          "expect": {
            "operationId": "File Type Rule Resource Get Rule By ID"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules~1{ruleId}/put",
          "expect": {
            "operationId": "File Type Rule Resource Update Rule"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules~1{ruleId}/delete",
          "expect": {
            "operationId": "File Type Rule Resource Delete Rule"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules~1lite/get",
          "expect": {
            "operationId": "File Type Rule Resource Get Summary"
          }
        }
      ]
    },
    "filtering-action-enum": {
      "statement": "The action field is `filteringAction`, not a generic `action`, with values BLOCK, CAUTION and ALLOW. `operation` takes UPLOAD, DOWNLOAD or UPLOAD_DOWNLOAD, and `state` takes ENABLED or DISABLED.",
      "tier": "A",
      "binds": [
        "zia/file-type-rules#filteringAction",
        "zia/file-type-rules#operation",
        "zia/file-type-rules#state"
      ],
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/filteringAction",
          "expect": {
            "type": "string",
            "enum": [
              "BLOCK",
              "CAUTION",
              "ALLOW"
            ]
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/operation",
          "expect": {
            "type": "string",
            "enum": [
              "UPLOAD",
              "DOWNLOAD",
              "UPLOAD_DOWNLOAD"
            ]
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/state",
          "expect": {
            "type": "string",
            "enum": [
              "DISABLED",
              "ENABLED"
            ]
          }
        }
      ]
    },
    "protocols-enum": {
      "statement": "`protocols` takes ANY_RULE, SMRULEF_CASCADING_ALLOWED, FOHTTP_RULE, FTP_RULE, HTTPS_RULE and HTTP_RULE. The Python SDK model stores it as an unconstrained list of strings.",
      "tier": "A",
      "binds": [
        "zia/file-type-rules#protocols"
      ],
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/protocols/items",
          "expect": {
            "type": "string",
            "enum": [
              "ANY_RULE",
              "SMRULEF_CASCADING_ALLOWED",
              "FOHTTP_RULE",
              "FTP_RULE",
              "HTTPS_RULE",
              "HTTP_RULE"
            ]
          }
        },
        {
          "source": "sdk-python",
          "path": "zscaler/zia/models/filetyperules.py",
          "quotes": [
            "self.protocols = ZscalerCollection.form_list(config[\"protocols\"] if \"protocols\" in config else [], str)"
          ]
        }
      ]
    },
    "protocol-token-mapping": {
      "statement": "The four protocol choices in the console map to the contract tokens as FTP over HTTP = FOHTTP_RULE, HTTP = HTTP_RULE, HTTPS = HTTPS_RULE and Native FTP = FTP_RULE. The console choices that require a Firewall subscription are FTP over HTTP and Native FTP.",
      "tier": "B",
      "binds": [
        "zia/file-type-rules#protocols"
      ],
      "evidence": [
        {
          "source": "zscaler-help",
          "path": "configuring-file-type-control-policy.json",
          "quotes": [
            "FTP over HTTP: Files from FTP over HTTP websites. (Requires Firewall subscription.)",
            "HTTP: Files from HTTP websites.",
            "Native FTP: Files from native FTP servers. (Requires Firewall subscription.)"
          ]
        }
      ],
      "conditions": "The token-to-label pairing is inferred from the names; no source lists the mapping. The legacy page read FTP_RULE as 'FTP' in general and omitted FOHTTP_RULE."
    },
    "size-in-kb": {
      "statement": "`minSize`, `maxSize` and `sizeQuota` are in KB; `timeQuota` is in minutes. `minSize` and `maxSize` default to 0 in the Python model.",
      "tier": "A",
      "binds": [
        "zia/file-type-rules#minSize",
        "zia/file-type-rules#maxSize",
        "zia/file-type-rules#sizeQuota",
        "zia/file-type-rules#timeQuota"
      ],
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/sizeQuota",
          "expect": {
            "type": "integer",
            "description": "Size quota in KB, beyond which the policy must be applied. If not set, size quota is not enforced. Ignored if action is BLOCK."
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/timeQuota",
          "expect": {
            "type": "integer",
            "description": "Time quota in minutes, after which the policy must be applied. If not set, no time quota is enforced. Ignored if action is BLOCK."
          }
        },
        {
          "source": "sdk-python",
          "path": "zscaler/zia/models/filetyperules.py",
          "quotes": [
            "self.min_size = config[\"minSize\"] if \"minSize\" in config else 0",
            "self.max_size = config[\"maxSize\"] if \"maxSize\" in config else 0"
          ]
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/minSize",
          "expect": {
            "description": "Minimum file size (in KB) used for evaluation of the FTP rule"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/maxSize",
          "expect": {
            "description": "Maximum file size (in KB) used for evaluation of the FTP rule"
          }
        }
      ]
    },
    "file-types-deprecated": {
      "statement": "The contract marks `fileTypes` as replaced by `fileTypeCategories`, a list of objects with `id`, `name` and `parent`, and recommends moving to the new attribute. The Python model has `fileTypes` only.",
      "tier": "A",
      "binds": [
        "zia/file-type-rules#fileTypes"
      ],
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/fileTypes",
          "expect": {
            "description": "This field is replaced with <b>fileTypeCategories</b>. Zscaler recommends updating your API configurations to use the <b>fileTypeCategories</b> attribute in place of fileTypes."
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/fileTypeCategories/items/properties/parent",
          "expect": {
            "type": "string"
          }
        },
        {
          "source": "sdk-python",
          "path": "zscaler/zia/models/filetyperules.py",
          "quotes": [
            "self.file_types = ZscalerCollection.form_list(config[\"fileTypes\"] if \"fileTypes\" in config else [], str)",
            "current_obj_format = { \"id\": self.id, \"protocols\": self.protocols, \"order\": self.order, \"timeQuota\": self.time_quota, \"sizeQuota\": self.size_quota, \"description\": self.description, \"locations\": [loc.request_format() for loc in (self.locations or [])],",
            "\"locationGroups\": [loc_group.request_format() for loc_group in (self.location_groups or [])], \"departments\": [dept.request_format() for dept in (self.departments or [])], \"groups\": [group.request_format() for group in (self.groups or [])],",
            "\"users\": [user.request_format() for user in (self.users or [])], \"devices\": [device.request_format() for device in (self.devices or [])], \"deviceGroups\": [dg.request_format() for dg in (self.device_groups or [])], \"timeWindows\": [window.request_format() for window in (self.time_windows or [])],",
            "\"labels\": [label.request_format() for label in (self.labels or [])], \"zpaAppSegments\": [zpa.request_format() for zpa in (self.zpa_app_segments or [])], \"urlCategories\": self.url_categories, \"fileTypes\": self.file_types, \"deviceTrustLevels\": self.device_trust_levels, \"minSize\": self.min_size,",
            "\"maxSize\": self.max_size, \"filteringAction\": self.filtering_action, \"capturePCAP\": self.capture_pcap, \"operation\": self.operation, \"activeContent\": self.active_content, \"unscannable\": self.unscannable, \"state\": self.state, \"rank\": self.rank, \"lastModifiedTime\": self.last_modified_time,",
            "\"lastModifiedBy\": self.last_modified_by, \"accessControl\": self.access_control, \"name\": self.name, \"cloudApplications\": self.cloud_applications, \"passwordProtected\": self.password_protected, }"
          ]
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/fileTypeCategories",
          "expect": {
            "type": "array"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/fileTypeCategories/items/properties/id",
          "expect": {
            "description": "File type ID"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1fileTypeRules/post/requestBody/content/application~1json/schema/properties/fileTypeCategories/items/properties/name",
          "expect": {
            "description": "File type description"
          }
        }
      ]
    },
    "file-types-contract-enum": {
      "statement": "The contract's `fileTypes` vocabulary is a closed list beginning ANY and NONE followed by FTCATEGORY_* tokens (JAVASCRIPT, FLASH, ZIP and so on, ending FTCATEGORY_TS). The Terraform provider declares `file_types` as an unconstrained set of strings, so it does not check values against this list.",
      "tier": "A",
      "binds": [
        "zia/file-type-rules#fileTypes"
      ],
