    "grade-rubric": {
      "statement": "GRE tunnel and PAC file grades are A when issues affect under 10% of the items, B between 10% and 90%, and C above 90%; with none present the grade is No Grade.",
      "tier": "A",
      "evidence": [
        {
          "source": "zscaler-help",
          "path": "about-system-audit-report.json",
          "after": "Information is sorted on Failover missing, followed by Primary missing, followed by both tunnels missing.",
          "quotes": [
            "| No GRE tunnels | No Grade |",
            "| Issues with less than 10% of all GRE tunnels | A |",
            "| Other issues between 10% and 90% of all GRE tunnels | B |",
            "| Issues with more than 90% of all GRE tunnels | C |"
          ]
        },
        {
          "source": "zscaler-help",
          "path": "about-system-audit-report.json",
          "after": "In this section, Zscaler checks all PAC files to see if they use",
          "quotes": [
            "| No PAC files | No Grade |",
            "| Issues with less than 10% of all PAC files | A |",
            "| Other issues between 10% and 90% of all PAC files | B |",
            "| Issues with more than 90% of all PAC files | C |"
          ]
        }
      ]
    },
    "rba-limited": {
      "statement": "The Python SDK comment states that the config audit returns the code RBA_LIMITED with the message \"Functional scope restriction requires Reports\" when the Reports functional scope is missing.",
      "tier": "A",
      "evidence": [
        {
          "source": "sdk-python",
          "path": "zscaler/zia/system_audit.py",
          "quotes": [
            "Returning {\"code\":\"RBA_LIMITED\",\"message\":\"Functional scope restriction requires Reports\"}"
          ]
        }
      ]
    },
    "python-models": {
      "statement": "The Python SDK exposes the report as SystemAuditReportAPI.get_config_audit (client.zia.system_audit) and models the nested objects AuthFrequency, IPVisibility (totalGreLocations, recommendation, details, locationsWithNat) and PacFile (totalPacFiles, pacWithStaticIPs).",
      "tier": "A",
      "evidence": [
        {
          "source": "sdk-python",
          "path": "zscaler/zia/models/system_audit.py",
          "quotes": [
            "class AuthFrequency(ZscalerObject):",
            "class IPVisibility(ZscalerObject):",
            "self.total_gre_locations = config[\"totalGreLocations\"] if \"totalGreLocations\" in config else None",
            "self.recommendation = config[\"recommendation\"] if \"recommendation\" in config else None",
            "self.details = config[\"details\"] if \"details\" in config else None",
            "config[\"locationsWithNat\"] if \"locationsWithNat\" in config else [], str",
            "class PacFile(ZscalerObject):",
            "self.total_pac_files = config[\"totalPacFiles\"]",
            "self.pac_with_static_ips = ZscalerCollection.form_list("
          ]
        },
        {
          "source": "sdk-python",
          "path": "zscaler/zia/system_audit.py",
          "quotes": [
            "class SystemAuditReportAPI(APIClient):",
            "def get_config_audit(self, query_params: Optional[dict] = None)"
          ]
        },
        {
          "source": "sdk-python",
          "path": "zscaler/zia/zia_service.py",
          "quotes": [
            "def system_audit(self) -> SystemAuditReportAPI:"
          ]
        }
      ]
    },
    "grade-is-snapshot": {
      "statement": "A System Audit Report grade describes the configuration as of the date the report was run, not the configuration as it is now.",
      "tier": "B",
      "derived_from": [
        "monthly"
      ],
      "conditions": "The report is generated on the first of the month and presents analysis as of that date; assumes no on-demand refresh exists, which no source mentions."
