{
  "schema_version": 1,
  "id": "zia.audit-logs.config-audit",
  "title": "The ZIA configuration audit (System Audit Report) endpoint",
  "aliases": [
    "configAudit",
    "system audit report",
    "zia config grade",
    "ConfigAudit python",
    "RBA_LIMITED"
  ],
  "related": [
    {
      "rel": "depends-on",
      "to": "shared.oneapi.authentication",
      "because": "zia.audit-logs.config-audit:oneapi-only"
    },
    {
      "rel": "depends-on",
      "to": "shared.admin-rbac.zia",
      "because": "zia.audit-logs.config-audit:rba-limited"
    },
    {
      "rel": "see-also",
      "to": "zia.audit-logs"
    },
    {
      "rel": "see-also",
      "to": "zia.audit-logs.report-api"
    }
  ],
  "prose": [
    {
      "text": "Despite the name, this is not a change history. {{not-a-trail}} For who-changed-what use [[zia.audit-logs.what-is-recorded]]."
    },
    {
      "label": "Access.",
      "text": "{{oneapi-only}} {{rba-limited}} The scope behavior is documented for this endpoint only; the audit-report endpoints are an open question in [[zia.audit-logs.report-api]] (gap `reports-scope`)."
    },
    {
      "label": "Timing.",
      "text": "{{monthly}} {{grade-is-snapshot}}"
    },
    {
      "label": "Response.",
      "text": "{{grades}} {{recommendations}} {{grade-rubric}}"
    },
    {
      "label": "SDK.",
      "text": "{{python-models}}"
    }
  ],
  "checks": [
    {
      "do": "Whether a grade is quoted with its `reportTimestamp` and `dataPresent`, which show the date it describes and whether data was present.",
      "uses": [
        "recommendations",
        "monthly"
      ]
    }
  ],
  "claims": {
    "not-a-trail": {
      "statement": "The configAudit endpoint returns the System Audit Report, which grades the configuration overall and in each area it checks: GRE tunnels, PAC files, authentication frequency, PAC file sizes, Microsoft 365 One Click and IP visibility.",
      "tier": "A",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1configAudit/get",
          "expect": {
            "description": "<p>Retrieves the System Audit Report. To learn more, see <a href=\"https://help.zscaler.com/zia/about-system-audit-report\" target=\"_blank\">About the System Audit Report</a>.</p><p><b>Note</b>: This endpoint is accessible via <a href=\"https://automate.zscaler.com/docs/api-reference-and-guides/guides/UnderstandingOneAPI\" target=\"_blank\">Zscaler OneAPI</a> only.</p>"
          }
        },
        {
          "source": "zscaler-help",
          "path": "about-system-audit-report.json",
          "quotes": [
            "The System Audit Report highlights the status of GRE tunnels, PAC files, authentication frequency, PAC file sizes, Microsoft 365 One Click, and IP visibility.",
            "View your overall grade and grades in each area"
          ]
        }
      ]
    },
    "oneapi-only": {
      "statement": "The configAudit, configAudit/ipVisibility and configAudit/pacFile endpoints are accessible via Zscaler OneAPI only.",
      "tier": "A",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1configAudit/get",
          "expect": {
            "description": "<p>Retrieves the System Audit Report. To learn more, see <a href=\"https://help.zscaler.com/zia/about-system-audit-report\" target=\"_blank\">About the System Audit Report</a>.</p><p><b>Note</b>: This endpoint is accessible via <a href=\"https://automate.zscaler.com/docs/api-reference-and-guides/guides/UnderstandingOneAPI\" target=\"_blank\">Zscaler OneAPI</a> only.</p>"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1configAudit~1ipVisibility/get",
          "expect": {
            "description": "<p>Retrieves the IP visibility audit report.</p><p><b>Note</b>: This endpoint is accessible via <a href=\"https://automate.zscaler.com/docs/api-reference-and-guides/guides/UnderstandingOneAPI\" target=\"_blank\">Zscaler OneAPI</a> only.</p>"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1configAudit~1pacFile/get",
          "expect": {
            "description": "<p>Retrieves the PAC file audit report.</p><p><b>Note</b>: This endpoint is accessible via <a href=\"https://automate.zscaler.com/docs/api-reference-and-guides/guides/UnderstandingOneAPI\" target=\"_blank\">Zscaler OneAPI</a> only.</p>"
          }
        }
      ]
    },
    "monthly": {
      "statement": "The report runs on the first of every month and presents the analysis as of that date; if the previous month's report is unavailable the console shows the month before it.",
      "tier": "A",
      "evidence": [
        {
          "source": "zscaler-help",
          "path": "about-system-audit-report.json",
          "quotes": [
            "The report runs on the first of every month, and the analysis is presented on everything as of that date.",
            "In some cases, the previous month's report will be unavailable to view.",
            "you'll be shown the month prior to the previous month's report"
          ]
        }
      ]
    },
    "grades": {
