    "protocols-spec": {
      "statement": "The API schema lists these rule protocol values: ANY_RULE, DOHTTPS_RULE, TUNNELSSL_RULE, HTTP_PROXY, FOHTTP_RULE, FTP_RULE, HTTPS_RULE, HTTP_RULE, SSL_RULE and TUNNEL_RULE.",
      "tier": "A",
      "binds": [
        "zia/bandwidth-control-rules#protocols"
      ],
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zia.openapi.json",
          "pointer": "/paths/~1bandwidthControlRules/post/requestBody/content/application~1json/schema/properties/protocols/items",
          "expect": {
            "enum": [
              "ANY_RULE",
              "DOHTTPS_RULE",
              "TUNNELSSL_RULE",
              "HTTP_PROXY",
              "FOHTTP_RULE",
              "FTP_RULE",
              "HTTPS_RULE",
              "HTTP_RULE",
              "SSL_RULE",
              "TUNNEL_RULE"
            ]
          }
        }
      ]
    },
    "protocols-terraform": {
      "statement": "The Terraform bandwidth rule resource requires at least one protocol and validates it with the URL Filtering protocol list, which adds SMRULEF_ZPA_BROKERS_RULE, TCP_RULE, UDP_RULE, WEBSOCKETSSL_RULE and WEBSOCKET_RULE to the API list.",
      "tier": "A",
      "binds": [
