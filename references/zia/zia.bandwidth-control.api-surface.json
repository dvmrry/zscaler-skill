  "divergences": {
    "protocol-vocabulary": {
      "summary": "Which protocol values a Bandwidth Control rule accepts",
      "positions": [
        {
          "evidence": {
            "source": "api-specs",
            "path": "automate-zscaler/openapi/zia.openapi.json",
            "pointer": "/paths/~1bandwidthControlRules/post/requestBody/content/application~1json/schema/properties/protocols/items",
            "expect": {
              "enum": [
                "ANY_RULE",
                "DOHTTPS_RULE",
                "TUNNELSSL_RULE",
                "HTTP_PROXY",
                "FOHTTP_RULE",
                "FTP_RULE",
                "HTTPS_RULE",
                "HTTP_RULE",
                "SSL_RULE",
                "TUNNEL_RULE"
              ]
            }
          },
          "says": "The API schema lists ten values and none of WEBSOCKET_RULE, WEBSOCKETSSL_RULE, TCP_RULE, UDP_RULE or SMRULEF_ZPA_BROKERS_RULE."
        },
        {
          "evidence": {
            "source": "tf-zia",
            "path": "zia/validator.go",
            "quotes": [
              "\"HTTP_PROXY\", \"FOHTTP_RULE\", \"FTP_RULE\", \"HTTPS_RULE\", \"HTTP_RULE\", \"SSL_RULE\", \"TUNNEL_RULE\", \"WEBSOCKETSSL_RULE\","
            ],
            "after": "var supportedURLFilteringProtocols = []string{"
          },
          "says": "The provider validates against the URL Filtering list, which includes the WebSocket values."
        }
      ],
      "impact": "A configuration using a value only the provider accepts may be rejected by the service, and a value the provider rejects cannot be sent through Terraform even if the service accepts it."
    },
    "locations-per-rule": {
      "summary": "How many locations one rule can reference",
      "positions": [
        {
          "evidence": {
            "source": "tf-zia",
            "path": "zia/resource_zia_bandwidth_control_rules.go",
            "quotes": [
              "setIDsSchemaTypeCustom(intPtr(8), \"Name-ID pairs of locations for which rule must be applied\")"
            ]
          },
          "says": "The Terraform schema caps locations at 8 per bandwidth rule."
        },
        {
          "evidence": {
            "source": "zscaler-help",
            "path": "ranges-limitations-zia.md",
            "quotes": [
              "Locations per Rule | 32 locations"
            ]
          },
          "says": "Ranges and Limitations lists 32 locations per rule for all policy rule types."
        }
      ],
      "impact": "A rule that needs 9 to 32 locations cannot be written through the provider; use location groups (32) or split the rule, even if the service would accept more."
    },
    "file-size-field-name": {
      "summary": "Name of the file-size field on a class",
      "positions": [
        {
          "evidence": {
            "source": "api-specs",
            "path": "automate-zscaler/openapi/zia.openapi.json",
            "pointer": "/paths/~1bandwidthClasses/post/requestBody/content/application~1json/schema/properties/getfileSize",
            "expect": {
              "description": "The file size for a bandwidth class"
            }
          },
          "says": "The API schema names the field getfileSize."
        },
        {
          "evidence": {
            "source": "sdk-python",
            "path": "zscaler/zia/models/bandwidth_classes.py",
            "quotes": [
              "self.file_size = config[\"fileSize\"] if \"fileSize\" in config else None"
            ]
          },
          "says": "The Python SDK model reads fileSize."
        }
      ],
      "impact": "One of the two spellings may never be populated; code that reads or writes the Large Files size should confirm the wire name against a live response."
    }
  },
