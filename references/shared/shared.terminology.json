  "gaps": {
    "unverified-aliases": {
      "kind": "semantic",
      "title": "Older names and abbreviations with no captured source",
      "status": "open",
      "detail": "Unverified legacy statements from the terminology table, kept as leads: App Connector was the ZPA connector or ZAC; Business Continuity Cloud is also BC Cloud or BCP Cloud; ZDX was Zscaler Digital Experience Monitoring; the console's Diagnostics Session is the same thing the API and SDK call a deep trace; App Profile was Device Profile; Authentication Levels are named AL1-AL4; OneAPI is also the Zero Trust Cloud API; Cloud Connector is also Cloud Connector VM or Zscaler for Workloads, and the SDK name ztw expands to Zero Trust Workload; ECG stands for Edge Connector Group; SIPA is also Customer-Managed Dedicated IP; ZPA Gateway is the SIPA Gateway; Zero Trust Browser is also Cloud Browser Isolation (CBI); Zscaler Cellular is ZCell; AI Guard was named ZGuard; SaaS Application Control is the newer name of Cloud App Control (CAC); Unified was the Zscaler Experience Center; the Admin Console was the per-product ZIA and ZPA Admin Portals. Names a source does show are claims in shared.terminology.product-names (client.zguard, client.zbi, ecgroup, deep trace, ZTC) or held elsewhere (the webForwardingProfile and /web/policy paths in zcc.api.forwarding-profile-wire and zcc.api.web-policy-wire; the 32-level, depth-4 authentication level limit in zia.authentication.step-up:level-limits). Area-specific facts in the same rows (counts, versions, availability dates) remain in the linked area docs.",
      "blocks": "confirming that an older term means the same component",
      "resolves_with": [
        "source-read",
        "code-read"
      ]
    }
  }
