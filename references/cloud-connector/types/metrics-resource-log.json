{
  "schema_version": 1,
  "id": "ztw/metrics-resource-log",
  "kind": "log",
  "product": "ztw",
  "title": "Cloud & Branch Connector Metrics (Resource) log (NSS feed)",
  "aliases": [
    "cloud connector resource metrics log",
    "cbc resource metrics"
  ],
  "evidence": [
    {
      "source": "zscaler-help",
      "path": "cbc-nss-feed-output-format-metrics-logs.json",
      "quotes": [
        "The Metrics Nanolog Streaming Service (NSS) feed specifies the data from the Metrics logs that the NSS sends to the"
