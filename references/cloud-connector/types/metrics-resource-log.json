      "type": "integer",
      "description": "Event time in epoch format (example: 1691667599) [Date/Time]"
    },
    "ss": {
      "type": "integer",
      "description": "Second of timestamp (0–59) (example: 59) [Date/Time]"
    },
    "mm": {
      "type": "integer",
      "description": "Minute of timestamp (0–59) (example: 39) [Date/Time]"
    },
