      "type": "string",
      "description": "The time zone. This is the time zone you specified when you configured the NSS feed. (example: GMT) [Date/Time]"
    },
    "time": {
      "type": "string",
      "description": "Time at which events are generated (example: Thu Nov 14 11:39:59 2024) [Date/Time]"
    },
    "eventtime": {
      "type": "string",
      "description": "The time and date of the transaction. This excludes the time zone. (example: Thu Nov 14 11:40:01 2024) [Date/Time]"
    },
