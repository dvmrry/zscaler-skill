      "expectedFindings": [
        {
          "id": "provenance-yaml-shape",
          "failureMode": "input shape",
          "minimumSeverity": "High",
          "expectedSignals": [
            "flow mappings and alternate indentation must parse",
            "wrong types and duplicate fields or keys must fail explicitly"
