{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "type.schema.json",
  "title": "Object types (config and log)",
  "description": "Config types are generated into references/_meta/types/<product>.json from the zscalerctl export and the provider surface layer, never hand-edited. Log types are authored, one per file, at references/<scope>/types/<name>.json with evidence per field.",
  "oneOf": [
    { "$ref": "#/$defs/generated-file" },
    { "$ref": "#/$defs/authored-file" }
  ],
  "$defs": {
    "generated-file": {
      "type": "object",
      "required": ["schema_version", "generated_by", "inputs", "types"],
      "properties": {
        "schema_version": { "const": 1 },
        "generated_by": { "type": "string" },
        "inputs": { "type": "object", "additionalProperties": { "type": "string" } },
        "types": { "type": "object", "additionalProperties": { "$ref": "#/$defs/type" } }
      },
      "additionalProperties": false
    },
    "authored-file": {
      "type": "object",
      "required": ["schema_version", "id", "kind", "product", "title", "fields", "evidence"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "common.schema.json#/$defs/type-id" },
        "kind": { "const": "log" },
        "product": { "$ref": "common.schema.json#/$defs/segment" },
        "title": { "type": "string", "minLength": 1 },
        "names": { "$ref": "#/$defs/names" },
        "aliases": { "$ref": "common.schema.json#/$defs/aliases" },
        "fields": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/field" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } },
        "status_codes": {
          "description": "ZPA LSS log types: the status codes the LSS API's status-codes example lists under the log type, keyed by code, each with the attributes the response gives; the user activity log's also take the session status codes help article's rows (`help`). Generated by scripts/gen-log-types.mjs.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/status-code" }
        },
        "policy_reasons": {
          "description": "The ZIA web log: the rows of the Policy Reasons help article, keyed by reason string, which the reason field's documentation points to. The article does not say which log types carry each string. Generated by scripts/gen-log-types.mjs.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/policy-reason" }
        }
      },
      "additionalProperties": false
    },
    "policy-reason": {
      "type": "object",
      "required": ["rows", "evidence"],
      "properties": {
        "rows": {
          "description": "Each article row for the reason, with the feature column; a reason in two rows keeps both.",
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["feature", "description"],
            "properties": { "feature": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 } },
            "additionalProperties": false
          }
        },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } }
      },
      "additionalProperties": false
    },
    "status-code": {
      "type": "object",
      "required": ["evidence"],
      "properties": {
        "error_type": { "type": "string" },
        "name": { "type": "string" },
        "admin_action": { "type": "string" },
        "status": { "type": "string" },
        "help": {
          "description": "The rows of the Private Access session status codes help article that list the code (a code can have more than one), each with the table it is in. Kept beside the LSS API attributes, which can name or class the code differently.",
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["class", "session_status", "description"],
            "properties": {
              "class": { "enum": ["Error", "Info", "Policy Block"] },
              "session_status": { "type": "string" },
              "description": { "type": "string" },
              "resolution": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/evidence" } }
      },
      "additionalProperties": false
    },
    "names": {
      "type": "object",
      "properties": {
        "zscalerctl": { "type": "string" },
        "terraform": { "type": "string", "description": "The provider resource that manages the object." },
        "terraform_data_source": { "type": "string", "description": "The provider data source that reads it." },
        "api": { "type": "string" },
        "nss": { "type": "string" }
      },
      "additionalProperties": false
    },
    "type": {
      "type": "object",
      "required": ["id", "kind", "product", "fields"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/type-id" },
        "kind": { "enum": ["config", "log"] },
        "product": { "$ref": "common.schema.json#/$defs/segment" },
        "title": { "type": "string" },
        "names": { "$ref": "#/$defs/names" },
        "aliases": { "$ref": "common.schema.json#/$defs/aliases" },
        "live": {
          "type": "object",
          "required": ["command"],
          "properties": { "command": { "type": "string", "pattern": "^zscalerctl " } },
          "additionalProperties": false
        },
        "iac": {
          "type": "object",
          "properties": {
            "generate": { "type": "boolean" },
            "adopt": { "type": "boolean" },
            "fetch_query": { "type": "object", "additionalProperties": { "type": "string" } },
            "skip_if": { "type": "array", "items": { "type": "object" } },
            "unsupported_if": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["provider", "reason"],
                "oneOf": [
                  { "required": ["match"] },
                  { "required": ["match_any_nonempty"] }
                ],
                "properties": {
                  "match": { "description": "Unsupported when the record has these values.", "type": "object" },
                  "match_any_nonempty": { "description": "Unsupported when any of these fields is non-empty.", "type": "array", "items": { "type": "string" } },
                  "provider": { "type": "string" },
                  "reason": { "type": "string" },
                  "evidence": { "type": "array", "items": { "type": "string" } }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/field" } }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "type": { "type": ["string", "null"] },
        "description": { "type": "string" },
        "classification": { "type": "string" },
        "references": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/type-id" }, "uniqueItems": true },
        "origin": { "enum": ["api", "zscalerctl"] },
        "terraform": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["provider-missing", "adoption-omitted", "conditional"] },
            "source": { "type": "string" },
            "reason": { "type": "string" }
          },
          "additionalProperties": false
        },
        "label": { "type": "string" },
        "default_format": {
          "description": "ZPA LSS log fields: how the vendor's default template for the log type writes the field (its json entry and csv token), from the LSS API article's log formats example. Absent when the default template omits the field.",
          "type": "object",
          "required": ["json"],
          "properties": { "json": { "type": "string" }, "csv": { "type": "string" } },
          "additionalProperties": false
        },
        "evidence": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/evidence" } }
      },
      "additionalProperties": false
    }
  }
}
