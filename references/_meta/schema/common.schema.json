{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions: the ID grammar and evidence anchors",
  "description": "The ID grammar is the stability contract (design doc: Identifiers). '.' is hierarchy, ':' is an item inside a subject, '/' is a type, '#' is a field.",
  "$defs": {
    "segment": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "subject-id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+$" },
    "item-id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+:[a-z0-9]+(-[a-z0-9]+)*$" },
    "item-ref": {
      "description": "A local item name (inside its own subject file) or a qualified item ID.",
      "type": "string",
      "pattern": "^([a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*)+:)?[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "type-id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$" },
    "field-id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*#[A-Za-z_][A-Za-z0-9_]*(\\[\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\])?)*$"
    },
    "field-path": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\[\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\])?)*$" },
    "bind-target": {
      "description": "A type or a field.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*(#[A-Za-z_][A-Za-z0-9_]*(\\[\\])?(\\.[A-Za-z_][A-Za-z0-9_]*(\\[\\])?)*)?$"
    },
    "node-id": {
      "description": "Any public node: subject, item, type, or field.",
      "type": "string",
      "anyOf": [
        { "$ref": "#/$defs/subject-id" },
        { "$ref": "#/$defs/item-id" },
        { "$ref": "#/$defs/bind-target" }
      ]
    },
    "company-id": { "type": "string", "pattern": "^company(\\.[a-z0-9]+(-[a-z0-9]+)*)+$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evidence": {
      "description": "A citation. Anchored by quotes (each found exactly once after whitespace normalization) or by a JSON Pointer. No line numbers or SHAs are stored.",
      "type": "object",
      "required": ["source", "path"],
      "properties": {
        "source": { "$ref": "#/$defs/segment" },
        "path": { "type": "string", "minLength": 1 },
        "quotes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 8, "maxLength": 320 }
        },
        "pointer": { "type": "string", "pattern": "^(/[^/]*)*$" },
        "at": {
          "description": "Submodule sources only: the git refs (tags or commits) at which the quotes must be found, e.g. the audited tag and \"HEAD\" (the pinned commit). Without it, quotes anchor at the pin. A bump that removes the code fails the HEAD anchor: a candidate fix.",
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(HEAD|[A-Za-z0-9._/-]+)$" }
        },
        "after": {
          "description": "A unique quote that sets context (e.g. a function signature). Each of `quotes` then resolves to its first occurrence after this anchor, instead of having to be unique in the whole file.",
          "type": "string", "minLength": 8, "maxLength": 320
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false,
      "oneOf": [
        { "required": ["quotes"] },
        { "required": ["pointer"] }
      ]
    }
  }
}
