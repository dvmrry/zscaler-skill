    "federate-application": {
      "statement": "`PUT /application/federate` federates an existing application segment from a host partner with one or more guest partners, and its body requires `applicationGid` and `guestGids`.",
      "tier": "A",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1customers~1{customerId}~1application~1federate/put",
          "expect": {
            "operationId": "Federate Application",
            "description": "Federates an existing application segment from a host partner with one or more guest partners."
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1customers~1{customerId}~1application~1federate/put/requestBody/content/application~1json/schema",
          "expect": {
            "required": [
              "applicationGid",
              "guestGids"
            ]
          }
        }
      ]
    },
