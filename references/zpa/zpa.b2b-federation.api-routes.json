      "statement": "`GET /policySet/rules/policyType/GLOBAL_POLICY/guest/{guest_id}` returns a paginated list of policy rules a partner customer created on applications federated to it, sanitized to hide sensitive information.",
      "tier": "A",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1customers~1{customerId}~1policySet~1rules~1policyType~1GLOBAL_POLICY~1guest~1{guest_id}/get",
          "expect": {
