    },
    "token-expiry-range-values": {
      "statement": "The create-token body declares `expiryTimeInSeconds` with a numeric minimum of 3600 and maximum of 86400.",
      "tier": "A",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1customers~1{customerId}~1tenant-federation~1token/post/requestBody/content/application~1json/schema/properties/expiryTimeInSeconds",
          "expect": {
            "minimum": 3600,
            "maximum": 86400
          }
        }
      ]
    },
    "federation-state-status-meaning": {
      "statement": "The federation-state `status` path parameter is documented as ACTIVE (i.e., Active) or INACTIVE (i.e., Pause), so the console's Pause corresponds to INACTIVE.",
      "tier": "A",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1customers~1{customerId}~1tenant-federation~1{federation_id}~1federation-state~1{status}/put/parameters/[name=status]",
          "expect": {
            "description": "The federation status is ACTIVE (i.e., Active) or INACTIVE (i.e., Pause).",
            "name": "status"
          }
        }
      ]
    }
  },
  "divergences": {
    "token-expiry-range": {
      "summary": "The create-token field description gives a minimum of 33,600 seconds while the same field's schema minimum is 3600.",
      "positions": [
        {
          "evidence": {
            "source": "api-specs",
            "path": "automate-zscaler/openapi/zpa.openapi.json",
            "pointer": "/paths/~1mgmtconfig~1v1~1customers~1{customerId}~1tenant-federation~1token/post/requestBody/content/application~1json/schema/properties/expiryTimeInSeconds",
