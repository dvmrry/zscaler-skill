{
  "schema_version": 1,
  "id": "zpa.b2b-federation.api-routes",
  "title": "B2B Federation API routes",
  "aliases": [
    "tenant-federation api",
    "create federation token api",
    "verify federation token api",
    "request approval api",
    "update provisioning state",
    "federation-state",
    "federate application api",
    "application/host",
    "GLOBAL_POLICY guest",
    "expiryTimeInSeconds"
  ],
  "related": [
    {
      "rel": "depends-on",
      "to": "zpa.b2b-federation.trust-workflow"
    },
    {
      "rel": "see-also",
      "to": "zpa.b2b-federation.sdk-contract"
    },
    {
      "rel": "interacts-with",
      "to": "zpa.microtenants.api-scoping"
    }
  ],
  "prose": [
    {
      "text": "The routes are published in the Automate ZPA specification and are not entitlement checks."
    },
    {
      "label": "Base and scope.",
      "text": "{{federation-base-path}} {{microtenant-id-optional}}"
    },
    {
      "label": "Application routes.",
      "text": "{{federate-application}} {{list-federated-from-host}}"
    },
    {
      "label": "Trust routes.",
      "text": "{{create-token}} {{verify-token}} {{request-approval}} {{update-notes}}"
    },
    {
      "label": "State routes.",
      "text": "{{provisioning-state}} {{federation-state}} {{federation-state-status-meaning}} {{delete-provisioning}}"
    },
    {
      "label": "Read routes.",
      "text": "{{list-provisionings}} {{list-partners}} {{partner-policy-rules}}"
    },
    {
      "label": "Token lifetime.",
      "text": "{{token-expiry-range-values}} The description disagrees {{divergence:token-expiry-range}}."
    },
    {
      "label": "Acceptance.",
      "text": "Whether a tenant accepts these calls is open {{gap:live-acceptance}}. The scope parameter is in [[zpa.microtenants.api-scoping]], and SDK coverage of these routes is in [[zpa.b2b-federation.sdk-contract]]."
    }
  ],
  "checks": [
    {
      "do": "Which route performs the step, and whether the operation is on the non-admin federation base.",
      "uses": [
        "federation-base-path",
        "create-token",
        "verify-token",
        "request-approval",
        "provisioning-state",
        "federation-state"
      ]
    },
    {
      "do": "The token lifetime a caller sends, because the specification states two different minimums.",
      "uses": [
        "create-token",
        "token-expiry-range"
      ]
    },
    {
      "do": "Whether the `microtenantId` query parameter is sent and what omitting it does.",
      "uses": [
        "microtenant-id-optional",
        "zpa.microtenants.api-scoping:omitted-scope-defaults-default"
      ]
    },
    {
      "do": "Whether the call is documented to work on this tenant, which the routes alone do not show.",
      "uses": [
        "live-acceptance"
      ]
    }
  ],
  "claims": {
    "federation-base-path": {
      "statement": "The federation operations are published under `/mgmtconfig/v1/customers/{customerId}` (not the `/admin/customers` base used by the Microtenant operations), against the server `https://api.zsapi.net/zpa`, which is the `/zpa` prefix the SDKs write into the same paths.",
      "tier": "B",
      "conditions": "The route equivalence between `/zpa/mgmtconfig/v1/customers/...` in the SDKs and the published `/mgmtconfig/v1/customers/...` is inferred from the server URL ending in `/zpa`; no request was sent to either form.",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/servers/[description=ZPA Endpoints]",
          "expect": {
            "url": "https://api.zsapi.net/zpa"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1customers~1{customerId}~1application~1federate/put",
          "expect": {
            "operationId": "Federate Application"
          }
        },
        {
          "source": "sdk-go",
          "path": "zscaler/zpa/services/federated_application/federated_application.go",
          "quotes": [
            "mgmtconfigV1 = \"/zpa/mgmtconfig/v1/customers/\""
          ]
        }
      ]
    },
