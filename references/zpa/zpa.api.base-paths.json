    "v2-segment-under-v1": {
      "statement": "Some Go SDK routes carry v2 as a path segment appended to the v1 base rather than using the v2 base: the Source IP Anchoring IP ranges (/v2/ipRanges), customer domains (/v2/associationtype) and SSO login options (/v2/ssoLoginOptions).",
      "tier": "A",
      "evidence": [
        {
          "source": "sdk-go",
          "path": "zscaler/zpa/services/c2c_ip_ranges/c2c_ip_ranges.go",
          "quotes": [
            "ipRangesEndpoint = \"/v2/ipRanges\"",
            "mgmtConfig       = \"/zpa/mgmtconfig/v1/admin/customers/\""
          ]
        },
        {
          "source": "sdk-go",
          "path": "zscaler/zpa/services/customer_domain_controller/customer_domain_controller.go",
          "quotes": [
            "customerDomainControllerEndpoint = \"/v2/associationtype\""
          ]
        },
        {
          "source": "sdk-go",
          "path": "zscaler/zpa/services/admin_sso_controller/admin_sso_controller.go",
          "quotes": [
            "ssoLoginEndpoint = \"/v2/ssoLoginOptions\""
          ]
        }
      ]
    },
