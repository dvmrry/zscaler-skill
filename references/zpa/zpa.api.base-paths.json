  "gaps": {
    "legacy-host-accepts-zpa-prefix": {
      "kind": "semantic",
      "title": "Whether a legacy ZPA cloud host accepts the /zpa prefix",
      "status": "open",
      "former_ids": [
        "zpa-38"
      ],
      "detail": "Unverified legacy statement: whether the live legacy host expects the /zpa prefix that Go service constants carry. Both SDKs strip the prefix in legacy mode, so the hosts are only known to be called without it; nothing shows what a host does with a prefixed path.",
      "blocks": "building raw legacy requests from OneAPI paths",
      "resolves_with": [
        "lab-test",
        "support-ticket"
      ]
    }
