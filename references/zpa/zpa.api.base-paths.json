{
  "schema_version": 1,
  "id": "zpa.api.base-paths",
  "title": "ZPA API base paths: hosts, the /zpa prefix, v1 and v2 versions, userconfig and cbiconfig",
  "aliases": [
    "config.private.zscaler.com",
    "mgmtconfig v1 v2",
    "/zpa prefix legacy",
    "customerId in every path",
    "api.zsapi.net/zpa",
    "userconfig scimgroup base",
    "cbiconfig base",
    "mgmtConfigV2",
    "ZPA legacy host"
  ],
  "binds": [
    "zpa/microtenants"
  ],
  "related": [
    {
      "rel": "see-also",
      "to": "zpa.api.authentication"
    },
    {
      "rel": "see-also",
      "to": "zpa.api.legacy-endpoints"
    },
    {
      "rel": "see-also",
      "to": "zpa.api.policy-wire"
    },
    {
      "rel": "see-also",
      "to": "zpa.b2b-federation.api-routes"
    },
    {
      "rel": "see-also",
      "to": "zpa.log-receivers.api"
    }
  ],
  "prose": [
    {
      "text": "Every ZPA route carries the tenant's customer ID in its path, and the same route is written with a /zpa prefix on OneAPI and without it on the legacy hosts. The endpoint and method listing itself is generated, not restated here."
    },
    {
      "label": "One path shape, three families.",
      "text": "{{customer-id-in-path}} {{oneapi-prefix}}"
    },
    {
      "label": "Legacy hosts.",
      "text": "{{legacy-hosts}} {{go-service-constants}} {{go-strips-prefix}} {{python-strips-prefix}}"
    },
    {
      "label": "Versions are not only v1.",
      "text": "{{v2-packages}} {{v2-openapi}} {{v2-segment-under-v1}}"
    },
    {
      "label": "Other bases.",
      "text": "{{userconfig-cbi}} The federation routes use a different customer base, held in [[zpa.b2b-federation.api-routes:federation-base-path]], and the receiver routes are in [[zpa.log-receivers.api:endpoints]]."
    },
    {
      "label": "Open.",
      "text": "Whether a legacy cloud host serves a route that still carries the /zpa prefix is not shown by any source {{gap:legacy-host-accepts-zpa-prefix}}."
    }
  ],
  "checks": [
    {
      "do": "Which base a failing call used: the OneAPI /zpa prefix on api.zsapi.net, or a legacy cloud host without the prefix.",
      "uses": [
        "oneapi-prefix",
        "legacy-hosts",
        "go-strips-prefix"
      ]
    },
    {
      "do": "Whether the resource is one of the packages on the v2 base, since an assumption that only LSS uses v2 is wrong.",
      "uses": [
        "v2-packages",
        "v2-openapi"
      ]
    },
    {
      "do": "Whether a path with a v2 segment sits under the v1 base rather than the v2 base.",
      "uses": [
        "v2-segment-under-v1"
      ]
    }
  ],
  "claims": {
    "customer-id-in-path": {
      "statement": "Operations under `/customers/{customerId}` in the mgmtconfig v1 and v2, userconfig and cbiconfig path families take the customer ID as a required path parameter, as the application, posture, SCIM group and CBI regions reads show.",
      "tier": "A",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1admin~1customers~1{customerId}~1application/get/parameters/[name=customerId]",
          "expect": {
            "in": "path",
            "required": true
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v2~1admin~1customers~1{customerId}~1posture/get/parameters/[name=customerId]",
          "expect": {
            "in": "path",
            "required": true
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1userconfig~1v1~1customers~1{customerId}~1scimgroup~1idpId~1{idpId}/get/parameters/[name=customerId]",
          "expect": {
            "in": "path",
            "required": true
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1cbiconfig~1cbi~1api~1customers~1{customerId}~1regions/get/parameters/[name=customerId]",
          "expect": {
            "in": "path",
            "required": true
          }
        }
      ]
    },
    "oneapi-prefix": {
      "statement": "The ZPA OpenAPI document gives paths without a prefix (for example /mgmtconfig/v1/admin/customers/{customerId}/application) under the server https://api.zsapi.net/zpa, so the OneAPI route is /zpa/mgmtconfig/....",
      "tier": "A",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/servers/[description=ZPA Endpoints]",
          "expect": {
            "url": "https://api.zsapi.net/zpa"
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1admin~1customers~1{customerId}~1application/get/parameters/[name=customerId]",
          "expect": {
            "in": "path",
            "required": true
          }
        }
      ]
    },
    "legacy-hosts": {
      "statement": "The Python SDK's legacy host table maps cloud names to config hosts: PRODUCTION to config.private.zscaler.com, ZPATWO to config.zpatwo.net, BETA to config.zpabeta.net, GOV to config.zpagov.net, GOVUS to config.zpagov.us and PREVIEW to config.zpapreview.net.",
      "tier": "A",
      "evidence": [
        {
          "source": "sdk-python",
          "path": "zscaler/constants.py",
          "quotes": [
            "ZPA_BASE_URLS = {",
            "\"PRODUCTION\": \"https://config.private.zscaler.com\",",
            "\"ZPATWO\": \"https://config.zpatwo.net\",",
            "\"BETA\": \"https://config.zpabeta.net\",",
            "\"PREVIEW\": \"https://config.zpapreview.net\","
          ]
        },
        {
          "source": "sdk-python",
          "path": "zscaler/constants.py",
          "quotes": [
            "\"PRODUCTION\": \"https://config.private.zscaler.com\",",
            "\"GOV\": \"https://config.zpagov.net\",",
            "\"GOVUS\": \"https://config.zpagov.us\","
          ]
        },
        {
          "source": "sdk-python",
          "path": "zscaler/zpa/legacy.py",
          "quotes": [
            "from zscaler.constants import DEV_AUTH_URL, ZPA_BASE_URLS",
            "self.baseurl = ZPA_BASE_URLS.get(cloud, ZPA_BASE_URLS[\"PRODUCTION\"])"
          ]
        }
      ]
    },
    "go-service-constants": {
      "statement": "Go SDK service packages build ZPA paths from constants that begin /zpa/mgmtconfig/v1/admin/customers/ (and /zpa/userconfig, /zpa/cbiconfig), so the SDK's paths carry the OneAPI /zpa prefix; the legacy client strips it before sending.",
      "conditions": "Changed from 'whichever client is used', which contradicted go-strips-prefix; the legacy request path's prefix removal was added as evidence.",
      "tier": "A",
      "evidence": [
        {
          "source": "sdk-go",
          "path": "zscaler/zparequests.go",
          "quotes": [
            "if client.oauth2Credentials.UseLegacyClient {",
            "return client.oauth2Credentials.LegacyClient.ZpaClient.NewRequestDo(method, removeOneApiEndpointPrefix(endpoint), options, body, v)"
          ]
        },
        {
          "source": "sdk-go",
          "path": "zscaler/utils.go",
          "quotes": [
            "if strings.HasPrefix(endpoint, \"/zpa\") {",
            "return strings.TrimPrefix(endpoint, \"/zpa\")"
          ]
        },
        {
          "source": "sdk-go",
          "path": "zscaler/zpa/services/step_up_auth/step_up_auth.go",
          "quotes": [
            "mgmtConfig = \"/zpa/mgmtconfig/v1/admin/customers/\""
          ]
        },
        {
          "source": "sdk-go",
          "path": "zscaler/zpa/services/scimgroup/zpa_scim_group.go",
          "quotes": [
            "userConfig        = \"/zpa/userconfig/v1/customers/\""
          ]
        },
        {
          "source": "sdk-go",
          "path": "zscaler/zpa/services/cloudbrowserisolation/cbiregions/cbiregions.go",
          "quotes": [
            "cbiConfig          = \"/zpa/cbiconfig/cbi/api/customers/\""
          ]
        }
      ]
    },
    "go-strips-prefix": {
      "statement": "When the Go SDK is in legacy mode its ZPA request path removes the /zpa prefix from the endpoint before sending to the legacy ZPA client.",
      "tier": "A",
      "evidence": [
        {
          "source": "sdk-go",
          "path": "zscaler/zparequests.go",
          "quotes": [
            "return client.oauth2Credentials.LegacyClient.ZpaClient.NewRequestDo(method, removeOneApiEndpointPrefix(endpoint), options, body, v)"
          ]
        },
        {
          "source": "sdk-go",
          "path": "zscaler/utils.go",
          "quotes": [
            "if strings.HasPrefix(endpoint, \"/zpa\") {",
            "return strings.TrimPrefix(endpoint, \"/zpa\")"
          ]
        }
      ]
    },
    "python-strips-prefix": {
      "statement": "The Python SDK's service modules build ZPA paths with a /zpa/mgmtconfig/v1/admin/customers/{customer_id} base, and its executor removes /zpa from the URL when the legacy client is in use.",
      "tier": "A",
      "evidence": [
        {
          "source": "sdk-python",
          "path": "zscaler/zpa/oauth2_user_code.py",
          "quotes": [
            "self._zpa_base_endpoint = f\"/zpa/mgmtconfig/v1/admin/customers/{customer_id}\""
          ]
        },
        {
          "source": "sdk-python",
          "path": "zscaler/request_executor.py",
          "quotes": [
            "\"admin\", \"/zia\", \"/zpa\", \"/zcc\","
          ],
          "after": "def remove_oneapi_endpoint_prefix(self, endpoint: str) -> str:"
        },
        {
          "source": "sdk-python",
          "path": "zscaler/request_executor.py",
          "quotes": [
            "if self.use_legacy_client: endpoint = self.remove_oneapi_endpoint_prefix(endpoint)"
          ]
        }
      ]
    },
    "v2-packages": {
      "statement": "The Go SDK reaches the mgmtconfig v2 base, not only for log receivers, for posture profiles, identity providers, SAML attributes, trusted networks, enrollment certificates, Browser Access certificates, segment group update, user portal link bulk update and v2 policy rule create and update.",
      "tier": "A",
      "evidence": [
