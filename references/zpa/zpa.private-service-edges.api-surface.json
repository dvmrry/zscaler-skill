  "gaps": {
    "group-post-not-in-spec": {
      "kind": "semantic",
      "title": "OpenAPI document lacks POST /serviceEdgeGroup",
      "status": "open",
      "detail": "The OpenAPI document lists GET, then GET, PUT and DELETE by ID for service edge groups but no POST on the collection, while the Go SDK, Python SDK and Terraform provider create groups with POST. Resolve by reading the current API reference.",
      "blocks": "citing the create call from the specification",
      "resolves_with": [
        "source-read"
      ]
    },
    "sdk-only-paths": {
      "kind": "semantic",
      "title": "Python SDK paths absent from the OpenAPI document",
      "status": "open",
      "detail": "The Python SDK calls GET /privateCloudControllerGroup/summary and PUT /privateCloudController/{id}/restart; neither is in the OpenAPI document. Their behavior rests on the SDK alone.",
      "blocks": "relying on those paths",
      "resolves_with": [
        "source-read"
      ]
    },
    "schedule-default-cadence": {
      "kind": "semantic",
      "title": "Default cadence when the schedule is first enabled",
      "status": "partial",
      "former_ids": [
        "zpa-53"
      ],
      "detail": "The provider documents frequency days and the interval values, but no source says what is applied before a schedule is configured. Resolve with the Admin Console Auto Delete setting.",
      "blocks": "stating the out-of-the-box deletion behavior",
      "resolves_with": [
        "lab-test",
        "tenant-data"
      ]
    }
  }
