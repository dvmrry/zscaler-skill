    "schedule-endpoints": {
      "statement": "The auto-delete schedule is read with GET /serviceEdgeSchedule, which returns one schedule object rather than a list, created with POST /serviceEdgeSchedule and updated with PUT /serviceEdgeSchedule/{id}; the body carries frequency, frequencyInterval, deleteDisabled and enabled, and an optional microtenantId query parameter applies.",
      "tier": "A",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1admin~1customers~1{customerId}~1serviceEdgeSchedule/get",
