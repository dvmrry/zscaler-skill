{
  "schema_version": 1,
  "id": "zpa.private-service-edges.api-surface",
  "title": "Management API endpoints for Private Service Edges, groups and schedules",
  "aliases": [
    "serviceEdge api",
    "serviceEdgeGroup endpoint",
    "serviceEdgeSchedule",
    "bulkDelete service edges",
    "privateCloudController api",
    "service edge api create",
    "service edge auto delete api",
    "pse api"
  ],
  "binds": [
    "zpa/service-edges",
    "zpa/service-edge-groups"
  ],
  "related": [
    {
      "rel": "depends-on",
      "to": "zpa.private-service-edges.enrollment",
      "because": "zpa.private-service-edges.api-surface:instances-not-created"
    },
    {
      "rel": "see-also",
      "to": "zpa.private-service-edges.groups"
    },
    {
      "rel": "see-also",
      "to": "zpa.private-service-edges"
    },
    {
      "rel": "see-also",
      "to": "zpa.private-service-edges.terraform"
    },
    {
      "rel": "see-also",
      "to": "zpa.private-service-edges.private-cloud-controller"
    },
    {
      "rel": "see-also",
      "to": "zpa.terraform.resource-fidelity"
    },
    {
      "rel": "see-also",
      "to": "zpa.api.service-edges-wire"
    }
  ],
  "prose": [
    {
      "text": "The management API addresses instances, groups and the auto-delete schedule as separate resources."
    },
    {
      "label": "Instances.",
      "text": "{{instance-endpoints}} {{instances-not-created}}"
    },
    {
      "label": "Groups.",
      "text": "{{group-endpoints}} The collection POST is not in the specification {{gap:group-post-not-in-spec}}."
    },
    {
      "label": "Auto-delete schedule.",
      "text": "{{schedule-endpoints}} {{schedule-fields}} The accepted values are in [[zpa.private-service-edges.groups:schedule-values]]; the default cadence is open {{gap:schedule-default-cadence}}. Provider defects in the schedule resource: [[zpa.terraform.resource-fidelity:schedule-read-never-sets-id]]."
    },
    {
      "label": "Private Cloud Controllers.",
      "text": "{{private-cloud-endpoints}} Two SDK calls have no specification entry {{gap:sdk-only-paths}}."
    },
    {
      "text": "[[zpa.api.service-edges-wire:schedule-post-204-with-body-schema]]"
    }
  ],
  "checks": [
    {
      "do": "Which endpoint the operation uses: instances under /serviceEdge, groups under /serviceEdgeGroup, auto-delete under /serviceEdgeSchedule, and Private Cloud Controllers under their own paths.",
      "uses": [
        "instance-endpoints",
        "group-endpoints",
        "schedule-endpoints",
        "private-cloud-endpoints"
      ]
    },
    {
      "do": "Whether an operation has no OpenAPI entry, so its behavior rests on the SDK alone.",
      "uses": [
        "sdk-only-paths",
        "group-post-not-in-spec",
        "instances-not-created"
      ]
    }
  ],
  "claims": {
    "instance-endpoints": {
      "statement": "Individual Private Service Edge instances are listed with GET /serviceEdge, read, updated and deleted by ID under /serviceEdge/{id}, and deleted in bulk with POST /serviceEdge/bulkDelete.",
      "tier": "A",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1admin~1customers~1{customerId}~1serviceEdge/get",
          "expect": {
            "description": "Gets all the configured Service Edge details for the specified customer."
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1admin~1customers~1{customerId}~1serviceEdge~1{serviceEdgeId}/put",
          "expect": {
            "description": "Updates the Service Edge details for the specified ID."
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1admin~1customers~1{customerId}~1serviceEdge~1{serviceEdgeId}/delete",
          "expect": {
            "description": "Deletes the Service Edge for the specified ID."
          }
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1admin~1customers~1{customerId}~1serviceEdge~1bulkDelete/post",
          "expect": {
            "description": "Bulk deletes the Service Edges for the specified customer."
          }
        },
        {
          "source": "sdk-python",
          "path": "zscaler/zpa/service_edges.py",
          "quotes": [
            "{self._zpa_base_endpoint}/serviceEdge/bulkDelete"
          ]
        },
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1admin~1customers~1{customerId}~1serviceEdge~1{serviceEdgeId}/get",
          "expect": {
            "description": "Gets the Service Edge details for the specified ID."
          }
        }
      ],
      "binds": [
        "zpa/service-edges"
      ]
    },
    "instances-not-created": {
      "statement": "The API has no create call for a Private Service Edge instance: an instance appears when it enrolls.",
      "tier": "B",
      "evidence": [
        {
          "source": "api-specs",
          "path": "automate-zscaler/openapi/zpa.openapi.json",
          "pointer": "/paths/~1mgmtconfig~1v1~1admin~1customers~1{customerId}~1serviceEdge/get",
          "expect": {
            "description": "Gets all the configured Service Edge details for the specified customer."
          }
        },
        {
          "source": "zscaler-help",
          "path": "about-private-service-edges.json",
          "quotes": [
            "View a list of all deployed Private Service Edges."
          ]
        }
      ],
      "conditions": "Absence: the OpenAPI document lists only GET on /serviceEdge and the SDKs have no add method for instances; the console lists only deployed instances."
    },
