{
  "schema_version": 1,
  "id": "zpa.server-groups",
  "title": "ZPA server groups",
  "aliases": [
    "server group",
    "zpa server group",
    "serverGroup",
    "app server group",
    "server group vs segment group",
    "segment group vs server group",
    "dynamic server discovery",
    "dynamicDiscovery",
    "segment server groups"
  ],
