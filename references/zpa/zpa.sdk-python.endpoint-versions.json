{
  "schema_version": 1,
  "id": "zpa.sdk-python.endpoint-versions",
  "title": "Which ZPA base path each Python SDK method uses",
  "aliases": [
    "saml attribute v2 list",
    "trusted network v2",
    "update_group_v2",
    "customers/{id}/v2 suffix",
    "userconfig base path scim",
    "ip ranges write methods",
    "associationtype lowercase customer domain"
  ],
  "related": [
    {
      "rel": "see-also",
      "to": "zpa.saml-attributes.api-surface"
    },
    {
      "rel": "see-also",
      "to": "zpa.scim.api-surface"
    },
    {
      "rel": "see-also",
      "to": "zpa.trusted-networks.object"
    },
