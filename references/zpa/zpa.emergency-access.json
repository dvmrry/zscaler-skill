  "prose": [
    {
      "text": "Emergency Access is for third-party users who have no account in the tenant's own identity setup. Questions about it come down to five things, in this order."
    },
    {
      "steps": [
        {
          "label": "Is it enabled?",
          "text": "Limited availability, the settings and Microtenant rules: [[zpa.emergency-access.configuration]]."
        },
        {
          "label": "Where does the user live, and how do they sign in?",
          "text": "[[zpa.emergency-access.identity]]."
        },
        {
          "label": "What state is the user in?",
          "text": "[[zpa.emergency-access.users]]."
        },
        {
          "label": "What does it cover?",
          "text": "PRA only, approvals, audit: [[zpa.emergency-access.scope]]."
        },
        {
          "label": "Which calls?",
          "text": "[[zpa.emergency-access.api-surface]]."
        }
      ]
    }
