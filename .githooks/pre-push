#!/usr/bin/env bash
# pre-push — run the local checks CI enforces before allowing a push.
#
# The fast gate is deterministic and does not require network access or every
# vendor submodule. Run `npm run check:full` explicitly before merge.
#
# Catches failures BEFORE they hit main. Bypass with `git push --no-verify` if
# you need to (e.g., pushing a known-broken WIP branch); CI remains the backstop.
#
# Activate once per clone:
#   git config core.hooksPath .githooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "▸ pre-push: running the fast deterministic gate..."
echo

if ! node scripts/check-fast.mjs; then
  echo
  echo "✗ pre-push: fast gate failed — push blocked."
  echo "  Fix the issues above and retry, or override with:"
  echo "    git push --no-verify"
  exit 1
fi
echo
echo "✓ pre-push: all checks pass."
